@if (Block is { } block)
{
    var look = CutTextTrack.StyleOf(block);
    <div class="cut-tl-inspector" data-testid="cut-tl-text-inspector">
        <span class="cut-tl-inspector-kicker">@(block.Kind == CutTextKind.SceneCard ? "Card" : "Title")</span>
        <label class="cut-tl-inspector-group cut-tl-inspector-text">
            <span>Text</span>
            <textarea maxlength="80"
                      aria-label="Text content"
                      data-testid="cut-tl-text-content"
                      disabled="@Busy"
                      @onfocus="() => FieldFocusChanged.InvokeAsync(true)"
                      @onblur="() => FieldFocusChanged.InvokeAsync(false)"
                      @onchange="OnTextAsync">@block.Text</textarea>
        </label>
        <div class="cut-tl-inspector-group" data-testid="cut-tl-text-position">
            <span>Place</span>
            @foreach (var choice in CutTextStyle.PositionChoices)
            {
                <button type="button"
                        class="@(look.Position == choice.Value ? "is-on" : "")"
                        disabled="@Busy"
                        @onclick="() => SetAsync(s => s.Position = choice.Value)">@choice.Label</button>
            }
        </div>
        <label class="cut-tl-inspector-group cut-tl-inspector-font">
            <span>Font</span>
            <select data-testid="cut-tl-text-font"
                    aria-label="Font"
                    disabled="@Busy"
                    value="@CutTextStyle.WireFont(look.Font)"
                    @onchange="OnFontAsync">
                @foreach (var choice in CutTextStyle.FontChoices)
                {
                    <option value="@CutTextStyle.WireFont(choice.Value)">@choice.Label</option>
                }
            </select>
        </label>
        <div class="cut-tl-inspector-group" data-testid="cut-tl-text-align">
            <span>Align</span>
            @foreach (var choice in CutTextStyle.AlignChoices)
            {
                <button type="button"
                        class="@(look.Align == choice.Value ? "is-on" : "")"
                        disabled="@Busy"
                        @onclick="() => SetAsync(s => s.Align = choice.Value)">@choice.Label</button>
            }
        </div>
        <div class="cut-tl-inspector-group" data-testid="cut-tl-text-size">
            <span>Size</span>
            @foreach (var choice in CutTextStyle.SizeChoices)
            {
                <button type="button"
                        class="@(look.Size == choice.Value ? "is-on" : "")"
                        disabled="@Busy"
                        @onclick="() => SetAsync(s => s.Size = choice.Value)">@choice.Label</button>
            }
        </div>
        <div class="cut-tl-inspector-group" data-testid="cut-tl-text-color">
            <span>Color</span>
            @foreach (var choice in CutTextStyle.ColorChoices)
            {
                <button type="button"
                        class="@(look.Color == choice.Value ? "is-on" : "")"
                        disabled="@Busy"
                        @onclick="() => SetAsync(s => s.Color = choice.Value)">@choice.Label</button>
            }
        </div>
        <div class="cut-tl-inspector-group" data-testid="cut-tl-text-background">
            <span>Bar</span>
            @foreach (var choice in CutTextStyle.BackgroundChoices)
            {
                <button type="button"
                        class="@(look.Background == choice.Value ? "is-on" : "")"
                        disabled="@Busy"
                        @onclick="() => SetAsync(s => s.Background = choice.Value)">@choice.Label</button>
            }
        </div>
        <div class="cut-tl-inspector-group" data-testid="cut-tl-text-fade">
            <span>Fade</span>
            @foreach (var choice in CutTextStyle.FadeChoices)
            {
                <button type="button"
                        class="@(look.Fade == choice.Value ? "is-on" : "")"
                        disabled="@Busy"
                        @onclick="() => SetAsync(s => s.Fade = choice.Value)">@choice.Label</button>
            }
        </div>
        <label class="cut-tl-inspector-group cut-tl-inspector-duration">
            <span>Time</span>
            <input @ref="_durationInput"
                   type="number"
                   min="@CutCard.MinHoldSeconds"
                   step="0.1"
                   value="@DurationValue"
                   aria-label="Duration"
                   data-testid="cut-tl-text-duration"
                   disabled="@Busy"
                   @onfocus="() => FieldFocusChanged.InvokeAsync(true)"
                   @onblur="() => FieldFocusChanged.InvokeAsync(false)"
                   @onchange="OnDurationAsync" />
        </label>
        <button type="button"
                class="cut-tl-inspector-del"
                title="Delete text"
                data-testid="cut-tl-text-del"
                disabled="@Busy"
                @onclick="OnDelete">Delete</button>
    </div>
}

@code {
    [Parameter] public CutTextBlock? Block { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback StyleChanged { get; set; }
    [Parameter] public EventCallback<string?> TextChanged { get; set; }
    [Parameter] public EventCallback<double> DurationChanged { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback<bool> FieldFocusChanged { get; set; }

    private ElementReference _durationInput = default;

    private string DurationValue =>
        Block is { } block
            ? block.Seconds.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)
            : "";

    internal async Task FocusDurationAsync()
    {
        if (!CutElementFocus.IsReady(_durationInput))
            return;
        await FieldFocusChanged.InvokeAsync(true);
        await CutElementFocus.TryFocusAsync(_durationInput);
    }

    private async Task SetAsync(Action<CutTextStyle> edit)
    {
        if (Block is not { } block || Busy)
            return;
        CutTextTrack.SetStyle(block, edit);
        await StyleChanged.InvokeAsync();
    }

    private Task OnFontAsync(ChangeEventArgs e) =>
        SetAsync(s => s.Font = CutTextStyle.ParseFont(Convert.ToString(e.Value, System.Globalization.CultureInfo.InvariantCulture)));

    private Task OnTextAsync(ChangeEventArgs e) =>
        TextChanged.InvokeAsync(Convert.ToString(e.Value, System.Globalization.CultureInfo.InvariantCulture));

    private async Task OnDurationAsync(ChangeEventArgs e)
    {
        var raw = Convert.ToString(e.Value, System.Globalization.CultureInfo.InvariantCulture);
        if (!double.TryParse(raw, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var seconds))
            return;
        await DurationChanged.InvokeAsync(seconds);
    }
}
