@namespace PageToMovie.Web.Components

<div class="voice-dictation @(_popoverOpen ? "voice-dictation--open" : "")"
     data-testid="@TestId">
    <button type="button"
            class="btn btn-sm @(_listening ? "btn-danger" : "btn-outline-secondary") py-0 px-2 voice-dictation-btn"
            title="@(_listening ? L["VoiceDictation.Stop"] : Title)"
            disabled="@(!Supported || Disabled)"
            data-testid="@(TestId)-btn"
            aria-expanded="@(_popoverOpen ? "true" : "false")"
            @onclick="ToggleAsync">
        @if (_listening)
        {
            <span aria-hidden="true">●</span><span> @L["VoiceDictation.Stop"]</span>
        }
        else
        {
            <span aria-hidden="true">🎤</span><span> @Label</span>
        }
    </button>

    @if (_popoverOpen && CoachMode)
    {
        <div class="voice-dictation-scrim"
             data-testid="@(TestId)-scrim"
             @onclick="CancelAsync"></div>
        <div class="voice-dictation-popover voice-dictation-popover--modal shadow"
             role="dialog"
             aria-modal="true"
             aria-label="Voice edit coach"
             data-testid="@(TestId)-popover"
             @onclick:stopPropagation="true">
            <div class="voice-dictation-popover__head">
                <span class="voice-dictation-popover__status @(_listening ? "is-live" : "")">
                    @(_listening ? L["VoiceDictation.Listening"] : L["VoiceDictation.EditBeforeGenerate"])
                </span>
                <button type="button"
                        class="btn btn-link btn-sm text-muted p-0"
                        @onclick="CancelAsync"
                        data-testid="@(TestId)-close">
                    @L["Common.Cancel"]
                </button>
            </div>

            <div class="voice-dictation-wave" aria-hidden="true" data-testid="@(TestId)-wave">
                @for (var i = 0; i < WaveBarCount; i++)
                {
                    var h = WaveHeight(i);
                    <span class="voice-dictation-wave__bar"
                          style="height: @(h.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                }
            </div>

            <label class="form-label small mb-1">@L["VoiceDictation.Tweak"]</label>
            <textarea class="form-control form-control-sm mb-2"
                      rows="3"
                      disabled="@Disabled"
                      value="@_draft"
                      @oninput="OnDraftInput"
                      placeholder="@L["VoiceDictation.Placeholder"]"
                      data-testid="@(TestId)-draft"></textarea>

            <div class="voice-dictation-tips">
                <div class="voice-dictation-tips__label">@L["VoiceDictation.TrySaying"]</div>
                <div class="voice-dictation-tips__chips">
                    @foreach (var tip in Suggestions ?? Array.Empty<string>())
                    {
                        var chip = tip;
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary voice-dictation-chip"
                                disabled="@Disabled"
                                @onclick="() => ApplySuggestionToDraft(chip)"
                                data-testid="@(TestId)-chip">
                            @chip
                        </button>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="CancelAsync">
                    @L["Common.Cancel"]
                </button>
                <button type="button"
                        class="btn btn-sm btn-primary"
                        disabled="@(Disabled || string.IsNullOrWhiteSpace(_draft))"
                        @onclick="UseDraftAsync"
                        data-testid="@(TestId)-use">
                    @L["VoiceDictation.UseThis"]
                </button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <span class="small text-warning ms-1">@_error</span>
    }
</div>
