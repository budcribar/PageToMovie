@namespace PageToMovie.Web.Components

<div class="character-look-panel" data-testid="@TestId">
    <div class="mb-2">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label small mb-0">Description</label>
            <VoiceDictationButton Text="@Description"
                                  TextChanged="OnDescriptionVoice"
                                  FieldId="@DescFieldId"
                                  Disabled="@Busy"
                                  Label="Dictate"
                                  Title="Speak the character description"
                                  TestId="@DescVoiceTestId" />
        </div>
        <textarea class="form-control form-control-sm"
                  rows="3"
                  disabled="@Busy"
                  value="@Description"
                  @oninput="OnDescriptionInput"
                  placeholder="Age, build, face, hair, wardrobe…"></textarea>
    </div>
    <div class="mb-2">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label small mb-0">Visual lock</label>
            <VoiceDictationButton Text="@VisualLock"
                                  TextChanged="OnVisualLockVoice"
                                  FieldId="@VlockFieldId"
                                  Disabled="@Busy"
                                  Label="Dictate"
                                  Title="Speak traits that must stay the same in every clip"
                                  TestId="@VlockVoiceTestId" />
        </div>
        <textarea class="form-control form-control-sm"
                  rows="3"
                  disabled="@Busy"
                  value="@VisualLock"
                  @oninput="OnVisualLockInput"
                  placeholder="Must not drift between scenes…"></textarea>
    </div>
    @if (ShowImageEditInstruction)
    {
        <div class="mb-2 border border-secondary-subtle rounded p-2">
            <div class="d-flex justify-content-between align-items-center mb-1 gap-2">
                <label class="form-label small mb-0">Edit the portrait with words</label>
                <VoiceDictationButton Text="@ImageEditInstruction"
                                      TextChanged="OnImageEditVoice"
                                      FieldId="@ImgEditFieldId"
                                      Replace="true"
                                      Disabled="@Busy"
                                      Label="Dictate edit"
                                      Title="Speak how to change the locked face, then generate looks"
                                      TestId="@ImgEditVoiceTestId" />
            </div>
            <textarea class="form-control form-control-sm"
                      rows="2"
                      disabled="@Busy"
                      value="@ImageEditInstruction"
                      @oninput="OnImageEditInput"
                      placeholder="e.g. make hair shorter, older face, blue cloak…"></textarea>
            <div class="form-text">Dictate or type a change, then generate looks from the preferred plate.</div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <div class="form-text">@Hint</div>
    }
    @if (Actions is not null)
    {
        <div class="d-flex flex-wrap gap-2 mt-2">@Actions</div>
    }
</div>
