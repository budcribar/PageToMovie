@namespace PageToMovie.Web.Components
@inject IAppLocalizer L

<div class="char-pick__card @(Selected ? "is-chosen" : null)"
     data-testid="@(TestId ?? "char-pick-card")">
    @if (OnFrameClick.HasDelegate)
    {
        <button type="button"
                class="char-pick__frame char-pick__frame--zoomable"
                disabled="@FrameDisabled"
                title="@FrameTitle"
                aria-label="@(FrameAriaLabel ?? Label)"
                @onclick="OnFrameClick">
            @if (!string.IsNullOrWhiteSpace(ImageUrl))
            {
                <img src="@ImageUrl" alt="@Label" loading="lazy" />
            }
            else
            {
                <span class="text-muted small">@L["Common.NoImage"]</span>
            }
            @if (ShowZoomBadge)
            {
                <span class="char-pick__zoom-badge" aria-hidden="true">@ZoomBadgeText</span>
            }
        </button>
    }
    else
    {
        <div class="char-pick__frame" @onclick="OnSelect">
            @if (!string.IsNullOrWhiteSpace(ImageUrl))
            {
                <img src="@ImageUrl" alt="@Label" loading="lazy" />
            }
            else
            {
                <span class="text-muted small">@L["Common.NoImage"]</span>
            }
        </div>
    }
    <span class="char-pick__label">@Label</span>
    <div class="d-flex flex-wrap gap-1 justify-content-center">
        @if (ShowUseButton)
        {
            <button type="button"
                    class="btn btn-sm btn-primary char-pick__use"
                    data-testid="@UseTestId"
                    disabled="@UseDisabled"
                    title="@UseTitle"
                    @onclick="OnUse">
                @UseLabel
            </button>
        }
        @ExtraActions
    </div>
</div>
