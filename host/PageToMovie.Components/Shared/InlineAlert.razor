@namespace PageToMovie.Web.Components
@inject IAppLocalizer L

@if (_visible && (ChildContent is not null || !string.IsNullOrEmpty(Message)))
{
    <div class="alert alert-@EffectiveVariant @(Dismissible ? "alert-dismissible" : "") @CssClass" role="alert" @attributes="AdditionalAttributes">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @Message
        }
        @if (Dismissible)
        {
            <button type="button" class="btn-close" aria-label="@L["Common.Close"]" @onclick="Dismiss"></button>
        }
    </div>
}
