@namespace PageToMovie.Web.Components

@if (ChildContent is not null || !string.IsNullOrEmpty(Message))
{
    <div class="alert alert-@Variant @CssClass" @attributes="AdditionalAttributes">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @Message
        }
    </div>
}
