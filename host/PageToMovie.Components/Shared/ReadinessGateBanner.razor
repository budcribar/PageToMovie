@namespace PageToMovie.Web.Components

@if (Visible)
{
    <p class="@CssClass" data-testid="@TestId" @attributes="AdditionalAttributes">
        @(string.IsNullOrWhiteSpace(Reason) ? FallbackReason : Reason)
        @if (!string.IsNullOrWhiteSpace(ActionHref))
        {
            <a href="@ActionHref">@ActionLabel</a>
        }
        @ChildContent
    </p>
}
