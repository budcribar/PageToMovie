@namespace PageToMovie.Web.Components
@using System.Linq

@if (Visible)
{
    <div class="card mb-3 @BorderClass @CssClass"
         data-testid="@TestId"
         data-job-status="@Status"
         data-job-kind="@Kind"
         data-job-running="@(IsActive ? "true" : "false")">
        <div class="card-body py-2">
            <div class="d-flex justify-content-between flex-wrap gap-2 align-items-center">
                <div class="small">
                    <span class="visually-hidden" data-testid="@(StatusTestId ?? $"{TestId}-status")">@Status</span>
                    @if (!string.IsNullOrWhiteSpace(Message))
                    {
                        <span>@Message</span>
                    }
                    else if (Indeterminate)
                    {
                        <span>Working…</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(DisplayElapsed) && IsActive)
                    {
                        <span class="text-muted ms-2" data-testid="@(TestId)-elapsed">@DisplayElapsed</span>
                    }
                    @if (!Indeterminate && Total > 0 && IsActive)
                    {
                        <span class="text-muted ms-1">@Index / @Total</span>
                    }
                </div>
                @if (ShowCancel)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            data-testid="@(CancelTestId ?? $"{TestId}-cancel")"
                            disabled="@CancelDisabled"
                            @onclick="OnCancel">
                        @CancelLabel
                    </button>
                }
            </div>
            @if (ShowProgressBar)
            {
                var pct = EffectivePercent();
                var barHeight = Indeterminate || IsActive ? "0.85rem" : "0.5rem";
                var barClasses = ProgressBarClasses;
                <div class="d-flex align-items-center gap-2 mt-2">
                    <div class="progress flex-grow-1 mb-0" style="height: @barHeight;">
                        <div class="@barClasses"
                             role="progressbar"
                             style="width: @(pct)%"
                             aria-valuenow="@pct"
                             aria-valuemin="0"
                             aria-valuemax="100"></div>
                    </div>
                    @if (IsActive || Indeterminate)
                    {
                        <span class="small text-muted text-nowrap" data-testid="@(TestId)-percent">@pct%</span>
                    }
                </div>
                @if (IsActive && Total > 0)
                {
                    <div class="small text-muted mt-1" data-testid="@(TestId)-fraction">
                        @Index of @Total
                    </div>
                }
            }
            @if (!string.IsNullOrEmpty(DetailMessage))
            {
                <div class="form-text mt-1">@DetailMessage</div>
            }
            @if (ShowLog && LogLines is { Count: > 0 })
            {
                <details class="mt-2" open="@OpenLogByDefault">
                    <summary class="small text-muted" style="cursor:pointer">@LogSummary</summary>
                    <pre class="small mb-0 mt-1" style="max-height: 160px; overflow: auto;">@string.Join("\n", LogLines.TakeLast(LogMaxLines))</pre>
                </details>
            }
            @ChildContent
        </div>
    </div>
}