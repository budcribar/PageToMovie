@namespace PageToMovie.Web.Components

<div class="character-voice-panel" data-testid="@TestId">
    <div class="mb-2">
        <label class="form-label small mb-1">Voice label</label>
        <input class="form-control form-control-sm"
               disabled="@Busy"
               value="@VoiceLabel"
               @oninput="OnLabelInput" />
    </div>
    <div class="mb-2">
        <label class="form-label small mb-1">Voice profile</label>
        <textarea class="form-control form-control-sm"
                  rows="3"
                  disabled="@Busy"
                  value="@VoiceProfile"
                  @oninput="OnProfileInput"></textarea>
    </div>
    @if (!string.IsNullOrWhiteSpace(PreviewUrl))
    {
        <audio class="w-100 mb-2" controls src="@PreviewUrl"></audio>
    }
    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <div class="form-text">@Hint</div>
    }
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-danger py-1 px-2 small mt-2 mb-0">@Error</div>
    }
    @if (Actions is not null)
    {
        <div class="d-flex flex-wrap gap-2 mt-2">@Actions</div>
    }
</div>
