@namespace PageToMovie.Web.Components

<div class="@CssClass"
     data-testid="@(TestId ?? "scene-row")"
     data-scene-number="@SceneNumber">
    <div class="card-body py-2">
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (ShowCheckbox)
            {
                <input type="checkbox"
                       class="form-check-input"
                       checked="@Selected"
                       @onchange="OnCheckboxChanged" />
            }
            <span class="fw-semibold">S@(SceneNumber.ToString("D2"))</span>
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <span class="text-muted small">@Title</span>
            }
            @if (!string.IsNullOrWhiteSpace(StatusText))
            {
                <span class="badge text-bg-secondary">@StatusText</span>
            }
            @if (Actions is not null)
            {
                <div class="ms-auto d-flex flex-wrap gap-1">@Actions</div>
            }
        </div>
        @ChildContent
    </div>
</div>
