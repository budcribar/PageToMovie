@namespace PageToMovie.Web.Components

@if (HasContent)
{
    <div class="@CssClass" data-testid="@TestId" @attributes="AdditionalAttributes">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <div class="fw-semibold mb-1">@Title</div>
        }
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="small">@Message</div>
        }
        @if (OnAction.HasDelegate)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary mt-2" @onclick="OnAction">
                @(string.IsNullOrWhiteSpace(ActionLabel) ? "Continue" : ActionLabel)
            </button>
        }
        else if (!string.IsNullOrWhiteSpace(ActionHref))
        {
            <a class="small d-inline-block mt-1" href="@ActionHref">@(ActionLabel ?? "Open →")</a>
        }
        @ChildContent
    </div>
}
