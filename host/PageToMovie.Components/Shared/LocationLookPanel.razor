@namespace PageToMovie.Web.Components

<div class="location-look-panel" data-testid="@TestId">
    @* ── Description: stable seed for new looks (not rewritten when you tweak the plate) ── *@
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label small mb-0">Description</label>
            <VoiceDictationButton Text="@Description"
                                  TextChanged="OnDescriptionVoice"
                                  FieldId="@DescFieldId"
                                  Disabled="@Busy"
                                  Label="Dictate"
                                  Title="Speak the set description (seed for new looks from text)"
                                  TestId="@DescVoiceTestId" />
        </div>
        <textarea class="form-control form-control-sm"
                  rows="3"
                  disabled="@Busy"
                  value="@Description"
                  @oninput="OnDescriptionInput"
                  placeholder="Architecture, materials, era, signature props, light…"></textarea>
        <div class="form-text">
            Written once from the book / extract. Used when you <strong>Generate 3 looks</strong> from text.
            Tweaking a locked plate (below) does <em>not</em> change this text.
        </div>
    </div>

    @* ── Plate tweak: image-only, only when a preferred plate exists ── *@
    @if (ShowImageEditInstruction)
    {
        <div class="mb-3 border border-info border-opacity-50 rounded p-2 bg-body-secondary bg-opacity-25"
             data-testid="loc-tweak-plate">
            <div class="d-flex justify-content-between align-items-center mb-1 gap-2">
                <label class="form-label small mb-0 fw-semibold">
                    Tweak locked plate
                    <span class="text-muted fw-normal">— picture only</span>
                </label>
                <VoiceDictationButton Text="@ImageEditInstruction"
                                      TextChanged="OnImageEditVoice"
                                      FieldId="@ImgEditFieldId"
                                      Replace="true"
                                      Disabled="@Busy"
                                      Label="Dictate edit"
                                      Title="Speak a change to the locked picture only (does not change description)"
                                      TestId="@ImgEditVoiceTestId" />
            </div>
            <textarea class="form-control form-control-sm"
                      rows="2"
                      disabled="@Busy"
                      value="@ImageEditInstruction"
                      @oninput="OnImageEditInput"
                      placeholder="e.g. make the trees a little taller, warmer late-day light…"></textarea>
            <div class="form-text mb-0">
                You already like the locked look — say how to adjust it (e.g. taller trees).
                Produces <strong>one</strong> new picture and locks it. Description stays as-is.
                Not happy? Dictate another edit and run again.
            </div>
        </div>
    }

    @* ── Visual lock: advanced, rarely edited by voice ── *@
    <details class="mb-2 small" data-testid="loc-visual-lock-advanced">
        <summary class="text-muted" style="cursor: pointer;">
            Advanced · consistency notes (optional)
        </summary>
        <div class="mt-2 ps-1">
            <label class="form-label small mb-1">Visual lock</label>
            <textarea class="form-control form-control-sm"
                      rows="2"
                      disabled="@Busy"
                      value="@VisualLock"
                      @oninput="OnVisualLockInput"
                      placeholder="Optional sticky rules, e.g. same courtyard layout, olive trees on the left…"></textarea>
            <div class="form-text">
                Extra “must not drift” lines for gen and video. Most of the time the description is enough —
                leave blank unless you need hard constraints.
            </div>
        </div>
    </details>

    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <div class="form-text">@Hint</div>
    }
    @if (Actions is not null)
    {
        <div class="d-flex flex-wrap gap-2 mt-2">@Actions</div>
    }
</div>
