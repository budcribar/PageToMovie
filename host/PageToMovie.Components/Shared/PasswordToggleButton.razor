@namespace PageToMovie.Web.Components
@*
  Show/hide toggle button that sits inside the password input-groups on the Login page. The same
  markup was repeated for the reset, sign-in, and confirm-password fields; the parent owns the
  shown/hidden state and the toggle handler, this renders the shared button.
*@

<button type="button"
        class="btn btn-outline-secondary password-toggle"
        @onclick="OnToggle"
        title="@(Shown ? "Hide password" : "Show password")"
        aria-label="@(Shown ? "Hide password" : "Show password")"
        aria-pressed="@Shown">
    @(Shown ? "Hide" : "Show")
</button>
