@namespace PageToMovie.Web.Components
@inject IAppLocalizer Localizer
@inject IJSRuntime JS
@implements IDisposable

<div class="d-inline-flex align-items-center gap-1 @WrapperClass">
    <span class="text-muted small d-none d-md-inline">🌐</span>
    <select class="form-select form-select-sm bg-dark text-light border-secondary shadow-sm"
            style="width: auto; min-width: 110px; font-size: 0.8rem;"
            value="@Localizer.CurrentCulture.Name"
            @onchange="OnLanguageChangedAsync">
        @foreach (var c in Localizer.SupportedCultures)
        {
            <option value="@c.Name">@GetLanguageDisplayName(c.Name)</option>
        }
    </select>
</div>
