@namespace PageToMovie.Web.Components
@inject IAppLocalizer L

@if (Visible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true"
         style="background:rgba(0,0,0,@BackdropOpacity);" @onclick="OnCancel">
        <div class="modal-dialog modal-dialog-centered @DialogClass" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close" aria-label="@L["Common.Close"]" @onclick="OnCancel"></button>
                </div>
                <div class="modal-body @BodyClass">
                    @ChildContent
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" disabled="@Busy" @onclick="OnCancel">
                        @(CancelLabel == "Cancel" ? L["Common.Cancel"] : CancelLabel)
                    </button>
                    <button type="button" class="btn btn-sm @ConfirmClass" data-testid="@ConfirmTestId"
                            disabled="@Busy" @onclick="OnConfirm">
                        @(ConfirmLabel == "Confirm" ? L["Common.Confirm"] : ConfirmLabel)
                    </button>
                </div>
            </div>
        </div>
    </div>
}
