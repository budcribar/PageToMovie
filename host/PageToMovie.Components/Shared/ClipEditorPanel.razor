@namespace PageToMovie.Web.Components

<div data-testid="@TestId">
    <div class="fw-semibold mb-2">@Title</div>
    <label class="form-label small">Prompt</label>
    <textarea class="form-control form-control-sm"
              rows="4"
              disabled="@Busy"
              value="@Prompt"
              @oninput="OnPromptInput"></textarea>
    @Fields
    @if (Actions is not null)
    {
        <div class="d-flex justify-content-end gap-2 mt-3">@Actions</div>
    }
</div>
