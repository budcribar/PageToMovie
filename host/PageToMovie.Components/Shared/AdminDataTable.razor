@namespace PageToMovie.Web.Components

<div class="@CssClass">
    @if (Toolbar is not null)
    {
        <div class="mb-2">@Toolbar</div>
    }
    @if (Loading)
    {
        <p class="text-muted small mb-0">Loading…</p>
    }
    else
    {
        <table class="@TableClass" data-testid="@TestId">
            @if (Header is not null)
            {
                <thead>@Header</thead>
            }
            <tbody>
                @if (IsEmpty)
                {
                    <EmptyTableRow ColSpan="EmptyColSpan" Message="@EmptyMessage" />
                }
                else
                {
                    @Rows
                }
            </tbody>
        </table>
    }
</div>
