@namespace PageToMovie.Web.Components
@using System.Linq

@if (Visible && Lines is { Count: > 0 })
{
    <details class="mt-2" data-testid="@TestId">
        <summary class="small text-muted" style="cursor:pointer">@Summary</summary>
        <pre class="small mb-0 mt-1" style="max-height: 160px; overflow: auto;">@string.Join("\n", Lines.TakeLast(MaxLines))</pre>
    </details>
}
