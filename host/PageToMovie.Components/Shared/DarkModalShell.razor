@namespace PageToMovie.Web.Components

@if (Visible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,@BackdropOpacity);" role="dialog" @attributes="AdditionalAttributes">
        <div class="modal-dialog @DialogClass">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header border-secondary @HeaderClass">
                    <h5 class="modal-title @TitleClass">@Title</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="OnClose"></button>
                </div>
                <div class="modal-body @BodyClass">
                    @ChildContent
                </div>
                @if (Footer is not null)
                {
                    <div class="modal-footer border-secondary">
                        @Footer
                    </div>
                }
            </div>
        </div>
    </div>
}
