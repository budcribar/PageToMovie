@inject IAppLocalizer L

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content bg-dark text-light border-secondary-subtle shadow-lg">
                <div class="modal-header bg-dark-subtle border-bottom border-secondary-subtle">
                    <h5 class="modal-title fw-bold text-light">
                        @ModalTitle
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body p-4">
                    @if (Mode == "import")
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">@L["ScreenplayEditor.OptionUploadFile"]</label>
                            <InputFile OnChange="HandleFileSelected" accept=".fountain,.txt" class="form-control form-control-sm bg-dark text-light border-secondary mb-2" />
                            @if (!string.IsNullOrEmpty(SelectedFileName))
                            {
                                <div class="alert alert-success py-1 px-2 small mb-3">
                                    <i class="bi bi-file-earmark-check me-1"></i> @L.Format("ScreenplayEditor.LoadedFileSummary", SelectedFileName, FountainText.Length)
                                </div>
                            }

                            <label class="form-label fw-semibold text-secondary small">@L["ScreenplayEditor.OptionPasteText"]</label>
                            <textarea class="form-control font-monospace bg-dark text-light border-secondary" rows="11" @bind="FountainText" @bind:event="oninput" placeholder="Title: The Tell-Tale Heart..."></textarea>
                        </div>
                    }
                    else if (Mode == "export-pdf")
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold text-secondary small mb-0">@L["ScreenplayEditor.PrintReadyPdf"]</label>
                                <ScreenplayEditor_ActionButton Variant="@ComponentVariant.Primary" Icon="bi-download" Text="@L["ScreenplayEditor.DownloadFile"]" OnClick="DownloadFile" />
                            </div>
                            <div class="alert alert-secondary py-3 px-3 small mb-0">
                                <i class="bi bi-file-earmark-pdf me-2"></i>
                                @L["ScreenplayEditor.PdfFormattedHelp"]
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold text-secondary small mb-0">@L["ScreenplayEditor.FormattedFountain"]</label>
                                <div class="d-flex align-items-center gap-2">
                                    @if (ShowCopyFeedback)
                                    {
                                        <ScreenplayEditor_BadgePill Variant="@ComponentVariant.Success" Text="@L["ScreenplayEditor.Copied"]" />
                                    }
                                    <ScreenplayEditor_ActionButton Variant="@ComponentVariant.OutlineInfo" Icon="bi-clipboard" Text="@L["ScreenplayEditor.CopyText"]" OnClick="CopyText" />
                                    <ScreenplayEditor_ActionButton Variant="@ComponentVariant.Primary" Icon="bi-download" Text="@L["ScreenplayEditor.DownloadFile"]" OnClick="DownloadFile" />
                                </div>
                            </div>
                            <textarea class="form-control font-monospace bg-dark text-light border-secondary" rows="14" readonly value="@FountainText"></textarea>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-dark-subtle border-top border-secondary-subtle">
                    @if (Mode == "import")
                    {
                        <button type="button" class="btn btn-info px-4 fw-semibold" @onclick="Import" disabled="@string.IsNullOrWhiteSpace(FountainText)">
                            @L["ScreenplayEditor.ImportIntoEditor"]
                        </button>
                    }
                    <button type="button" class="btn btn-outline-secondary px-4" @onclick="Close">@L["Common.Close"]</button>
                </div>
            </div>
        </div>
    </div>
}
