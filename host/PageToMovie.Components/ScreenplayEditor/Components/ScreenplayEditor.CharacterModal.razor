@inject IAppLocalizer L

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75);">
        <div class="modal-dialog @(SingleCharacterMode ? "modal-md" : "modal-lg") modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-dark text-light border-warning shadow-lg">
                <div class="modal-header bg-dark-subtle border-secondary-subtle py-2">
                    <h5 class="modal-title fw-bold text-light">
                        @if (SingleCharacterMode)
                        {
                            <span>@FocusName</span>
                        }
                        else
                        {
                            <span>@L["ScreenplayEditor.StoryCharacters"]</span>
                        }
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body p-3">
                    @if (FocusMissingFromCast)
                    {
                        <div class="alert alert-warning py-2 px-3 small mb-3" role="status">
                            @L.Format("ScreenplayEditor.FocusMissingFromCast", FocusName ?? "")
                        </div>
                    }

                    @if (!SingleCharacterMode)
                    {
                        <label class="form-label fw-semibold text-secondary small mb-1">@L["ScreenplayEditor.AddCharacter"]</label>
                        <div class="input-group input-group-sm mb-3">
                            <input type="text" class="form-control text-uppercase bg-dark text-light border-secondary" @bind="NewCharacterName" placeholder="e.g. BUSTER" />
                            <button class="btn btn-warning fw-semibold px-3" type="button" @onclick="AddCharacter" disabled="@string.IsNullOrWhiteSpace(NewCharacterName)">+ Add</button>
                        </div>
                    }

                    @if (!SingleCharacterMode)
                    {
                        var names = GetOrderedCharacterNames();
                        <label class="form-label fw-semibold text-secondary small">@L.Format("ScreenplayEditor.CastCount", names.Count)</label>
                    }
                    <div class="d-flex flex-column gap-2 overflow-auto" style="max-height: 420px;">
                        @{ var charaNames = GetOrderedCharacterNames(); }
                        @foreach (var charaName in charaNames)
                        {
                            var profile = Model.GetOrCreateCharacterProfile(charaName);
                            var isFocus = IsFocused(charaName);
                            var lockId = CardDomId(charaName);

                            <div id="@lockId"
                                 class="card bg-dark-subtle p-2 shadow-sm @(isFocus ? "border-warning border-2 spe-focus-card" : "border-secondary-subtle")">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom border-secondary-subtle">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <h6 class="mb-0 fw-bold text-warning text-uppercase">@charaName</h6>
                                        @if (profile.Speaks)
                                        {
                                             <span class="badge text-bg-success">@L["ScreenplayEditor.Speaks"]</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(profile.SpeciesKind))
                                        {
                                            <span class="badge text-bg-secondary">@profile.SpeciesKind</span>
                                        }
                                    </div>
                                    @if (!SingleCharacterMode)
                                    {
                                        <button class="btn btn-sm btn-outline-danger py-0 px-2" type="button" @onclick="() => RemoveCharacter(charaName)" title="@L["ScreenplayEditor.RemoveFromList"]">✕</button>
                                    }
                                </div>

                                <div class="mb-2">
                                    <label class="form-label text-secondary small mb-0">@L["ScreenplayEditor.Description"]</label>
                                    <textarea class="form-control form-control-sm bg-dark text-light border-secondary" rows="2"
                                              @bind="profile.Description" @bind:after="OnChanged"
                                              placeholder="Who they are and how they look…"></textarea>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label text-secondary small mb-0">@L["ScreenplayEditor.VisualLock"]</label>
                                    <textarea class="form-control form-control-sm bg-dark text-light border-secondary" rows="2"
                                              @bind="profile.VisualLockPrompt" @bind:after="OnChanged"
                                              placeholder="Appearance that must stay consistent…"></textarea>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label text-secondary small mb-0">@L["ScreenplayEditor.VisualMedium"]</label>
                                    <select class="form-select form-select-sm bg-dark text-light border-secondary"
                                            @bind="profile.VisualMedium" @bind:after="OnChanged">
                                        @foreach (var medium in Enum.GetValues<PageToMovie.Core.Models.VisualMedium>())
                                        {
                                            <option value="@medium">@medium</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-1">
                                    <label class="form-label text-secondary small mb-0">@L["ScreenplayEditor.WardrobeAlways"]</label>
                                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                                           @bind="profile.WardrobeAlways" @bind:after="OnChanged"
                                           placeholder="e.g. red collar; dark coat" />
                                </div>
                                @if (!string.IsNullOrWhiteSpace(profile.VoiceLabel) || !string.IsNullOrWhiteSpace(profile.VoiceProfile))
                                {
                                    <div class="small text-secondary mt-1">
                                        @L["ScreenplayEditor.VoiceLabel"]
                                        @if (!string.IsNullOrWhiteSpace(profile.VoiceLabel))
                                        {
                                            <strong class="text-light">@profile.VoiceLabel</strong>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(profile.VoiceProfile))
                                        {
                                            <span class="ms-1">— @profile.VoiceProfile</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (charaNames.Count == 0)
                        {
                            <div class="text-secondary small border border-secondary-subtle rounded p-3">
                                @L["ScreenplayEditor.NoCastYet"]
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer bg-dark-subtle border-secondary-subtle py-2">
                    <a class="btn btn-outline-warning btn-sm me-auto"
                       href="@FullCastHref"
                       data-testid="char-modal-open-cast"
                       title="Looks, voice, and locked plates live on Cast">
                        @(string.IsNullOrWhiteSpace(FocusName) ? L["ScreenplayEditor.OpenCastEditor"] : $"Open Cast · {FocusName} →")
                    </a>
                    <button type="button" class="btn btn-primary btn-sm px-4 fw-semibold" @onclick="Close">@L["Common.Done"]</button>
                </div>
            </div>
        </div>
    </div>
}