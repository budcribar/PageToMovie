<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <!-- blazor.web.js + WASM boot assets: host provides framework static assets;
         client is PageToMovie.Web (Sdk.BlazorWebAssembly). -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PageToMovie.Tests" />
  </ItemGroup>

  <!-- Microsoft.AspNetCore.OpenApi pulled vulnerable Microsoft.OpenApi 2.0.0 (GHSA-v5pm-xwqc-g5wc).
       We don't use MapOpenApi/Swagger yet, so omit it. When re-adding OpenAPI later, pin
       Microsoft.OpenApi >= 2.7.5 (or 3.5.4+) as a direct PackageReference. -->

  <ItemGroup>
    <ProjectReference Include="..\PageToMovie.Engine\PageToMovie.Engine.csproj" />
    <ProjectReference Include="..\PageToMovie.Core\PageToMovie.Core.csproj" />
    <ProjectReference Include="..\PageToMovie.Fakes\PageToMovie.Fakes.csproj" />
    <ProjectReference Include="..\PageToMovie.Web\PageToMovie.Web.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- Admin JWT login (Phase B) -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.21.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- Host Blazor WebAssembly UI (PageToMovie.Web) -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
  </ItemGroup>

  <!-- Copy fake video fixtures next to API output for FakeGrokVideoClient -->
  <Target Name="CopyFakeFixtures" AfterTargets="Build">
    <ItemGroup>
      <_FakeFixtures Include="..\PageToMovie.Fakes\Fixtures\**\*.*" Condition="Exists('..\PageToMovie.Fakes\Fixtures')" />
    </ItemGroup>
    <Copy SourceFiles="@(_FakeFixtures)" DestinationFolder="$(OutDir)Fixtures\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_FakeFixtures)' != ''" />
  </Target>

</Project>
