<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PageToMovie.Fountain</RootNamespace>
    <Description>Shared Fountain screenplay lexer + parser. Pure System.Text; no I/O, no other product deps.</Description>
    <!-- Compiles Core's TimeoutSafeRegex.cs as FountainRegex without a Core project reference. -->
    <DefineConstants>$(DefineConstants);PAGETOMOVIE_FOUNTAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\PageToMovie.Core\Utils\TimeoutSafeRegex.cs" Link="TimeoutSafeRegex.cs" />
  </ItemGroup>

</Project>
