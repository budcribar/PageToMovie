<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RootNamespace>PageToMovie.Cut</RootNamespace>
    <AssemblyName>PageToMovie.Cut</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PageToMovie.Cut.Components\PageToMovie.Cut.Components.csproj" />
  </ItemGroup>

  <!-- Loader SSoT is Web. Copy at build so Cut does not commit a second copy (Sonar CPD). -->
  <Target Name="CopyWebFfmpegToCut" BeforeTargets="ResolveStaticWebAssetsConfiguration;CoreCompile">
    <PropertyGroup>
      <_WebJsDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../PageToMovie.Web/wwwroot/js'))</_WebJsDir>
      <_CutJsDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)wwwroot/js'))</_CutJsDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(_WebJsDir)/pagetomovie-ffmpeg.js')"
           Text="Cut needs PageToMovie.Web/wwwroot/js/pagetomovie-ffmpeg.js (ffmpeg loader SSoT)." />
    <MakeDir Directories="$(_CutJsDir)/ffmpeg" />
    <Copy SourceFiles="$(_WebJsDir)/pagetomovie-ffmpeg.js" DestinationFolder="$(_CutJsDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <_WebFfmpeg Include="$(_WebJsDir)/ffmpeg/**/*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebFfmpeg)"
          DestinationFiles="@(_WebFfmpeg->'$(_CutJsDir)/ffmpeg/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
