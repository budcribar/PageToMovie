<div @ref="_root"
     class="cut-tl"
     data-testid="cut-timeline"
     tabindex="0"
     @onkeydown="OnKey"
     @onkeydown:preventDefault="PreventTitleKey">
    <div class="cut-tl-transport">
        <button type="button" class="cut-tl-icon" title="Skip to start" disabled="@Busy" @onclick="OnSkipStart">⏮</button>
        <button type="button" class="cut-tl-icon" title="Back 5s" disabled="@Busy" @onclick="OnStepBack">⏪</button>
        <button type="button"
                class="@CutTransport.PlayButtonClass(IsPlaying)"
                title="@CutTransport.PlayTitle(IsPlaying)"
                data-testid="cut-tl-play"
                disabled="@PlayOrStopDisabled"
                @onclick="OnPlay">@CutTransport.PlayGlyph(IsPlaying)</button>
        <button type="button" class="cut-tl-icon" title="Forward 5s" disabled="@Busy" @onclick="OnStepForward">⏩</button>
        <button type="button"
                class="cut-tl-icon @CutTransport.ScissorsClass"
                title="Split at playhead"
                data-testid="cut-tl-scissors"
                disabled="@SplitDisabled"
                @onclick="OnSplit">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="6.2" cy="7" r="2.35" fill="none" stroke="currentColor" stroke-width="1.8" />
                <circle cx="6.2" cy="17" r="2.35" fill="none" stroke="currentColor" stroke-width="1.8" />
                <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                      d="M8.2 8.4 20 18.2M8.2 15.6 20 5.8" />
            </svg>
        </button>
        <span class="cut-tl-clock">@PlayheadClock / @TotalClock</span>
        @if (HasRange)
        {
            <button type="button" class="cut-btn cut-btn-ghost cut-tl-del" disabled="@Busy" @onclick="DeleteRangeAsync">
                Delete @CutTimelineLayout.Clock(RangeHi - RangeLo)
            </button>
        }
    </div>

    <div class="cut-tl-scroll" @ref="_scroll">
        <div class="cut-tl-inner"
             @ref="_inner"
             style="width: @(Math.Max(Layout.WidthPx, 240))px"
             @onpointermove="OnPointerMove"
             @onpointerup="OnPointerUp">
            <div class="cut-tl-ruler" data-testid="cut-tl-ruler" @onpointerdown="BeginRulerAsync">
                @foreach (var mark in Layout.Ruler)
                {
                    <span class="cut-tl-tick @(mark.Major ? "is-major" : "")" style="left: @(mark.Px)px">
                        @if (mark.Major)
                        {
                            <span>@mark.Label</span>
                        }
                    </span>
                }
                @if (HasRange)
                {
                    <div class="cut-tl-range" style="left: @(RangeLo * _pxPerSec)px; width: @(Math.Max(RangePx, 2))px">
                        <span class="cut-tl-range-pill">@CutTimelineLayout.Clock(RangeHi - RangeLo)</span>
                    </div>
                }
                <button type="button"
                        class="@CutTransport.PlayheadClass"
                        style="left: @(PlayheadSec * _pxPerSec)px"
                        title="Playhead"
                        data-testid="cut-tl-playhead"
                        @onpointerdown:stopPropagation="true"
                        @onpointerdown="BeginPlayheadAsync"></button>
            </div>

            <div class="cut-tl-scenes" data-testid="cut-tl-scenes">
                @foreach (var band in Layout.Scenes)
                {
                    <div class="cut-tl-scene"
                         style="left: @(band.StartPx)px; width: @(Math.Max(band.WidthPx, 28))px"
                         data-testid="cut-tl-scene"
                         title="@band.Label">
                        <span>@band.Label</span>
                    </div>
                }
            </div>

            <div class="cut-tl-video" data-testid="cut-tl-video">
                @foreach (var block in Layout.VideoBlocks)
                {
                    var first = Clips[block.FirstIndex];
                    var last = Clips[block.LastIndex];
                    <div class="cut-tl-clip is-scene @(CutTimelineLayout.BlockContains(block, Selected, Clips) ? "is-selected" : "") @(block.Missing ? "is-missing" : "")"
                         style="left: @(block.StartPx)px; width: @(Math.Max(block.WidthPx, 28))px"
                         data-testid="cut-tl-clip"
                         data-scene="@block.Label"
                         title="@block.Label"
                         @onclick="e => SelectSceneBlockAsync(e, block)">
                        <div class="cut-tl-film">
                            @foreach (var frame in block.Filmstrip)
                            {
                                <img src="@frame" alt="" />
                            }
                        </div>
                        <span class="cut-tl-clip-name">@block.Label</span>
                        <span class="cut-tl-speaker" aria-hidden="true">🔊</span>
                        @if (block.TrimIn)
                        {
                            <button type="button"
                                    class="cut-tl-handle is-in"
                                    data-testid="cut-tl-handle-in"
                                    title="Trim in"
                                    @onpointerdown:stopPropagation="true"
                                    @onpointerdown="e => BeginTrimAsync(e, first, true)"></button>
                        }
                        @if (block.TrimOut)
                        {
                            <button type="button"
                                    class="cut-tl-handle is-out"
                                    data-testid="cut-tl-handle-out"
                                    title="Trim out"
                                    @onpointerdown:stopPropagation="true"
                                    @onpointerdown="e => BeginTrimAsync(e, last, false)"></button>
                        }
                    </div>
                }
                @foreach (var tick in Layout.Joins)
                {
                    <div class="cut-tl-join-wrap" style="left: @(tick.AtPx)px">
                        <button type="button"
                                class="@JoinClass(tick)"
                                data-testid="cut-tl-join"
                                title="@CutTransitionMap.TickLabel(tick.Kind)"
                                @onclick="() => ToggleJoinMenu(tick.AfterIndex)">
                            @CutTransitionMap.TickLabel(tick.Kind)
                        </button>
                        @if (_joinMenu == tick.AfterIndex)
                        {
                            <div class="cut-tl-join-menu">
                                @foreach (var kind in CutTimelineLayout.EditableJoins)
                                {
                                    <button type="button"
                                            class="@(kind == tick.Kind ? "is-on" : "")"
                                            @onclick="() => SetJoinAsync(tick.AfterIndex, kind)">
                                        @CutTransitionMap.TickLabel(kind)
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="cut-tl-text @(HasText ? "" : "is-empty")"
                 data-testid="cut-tl-text"
                 @onpointerdown="OnTextRowDownAsync">
                <button type="button"
                        class="@CutTransport.TextAddClass"
                        title="Add text"
                        data-testid="cut-tl-text-add"
                        style="z-index: @CutTransport.TextAddZIndex"
                        @onpointerdown:stopPropagation="true"
                        @onclick="() => AddTextAtAsync(PlayheadSec)">+</button>
                @if (!HasText)
                {
                    <span class="cut-tl-text-empty">+ Add text</span>
                }
                @foreach (var block in TextBlocks)
                {
                        var selected = block.Id == _selectedTextId;
                        <div class="@CutTransport.TextClipClass @(selected ? "is-selected" : "") @(block.Kind == CutTextKind.SceneCard ? "is-card" : "")"
                             style="left: @(block.StartPx)px; width: @(Math.Max(block.WidthPx, 36))px"
                             data-testid="cut-tl-text-clip"
                             title="@block.Text"
                             @onpointerdown:stopPropagation="true"
                             @onpointerdown="() => SelectText(block)"
                             @oncontextmenu:preventDefault="true"
                             @oncontextmenu="e => OpenTitleMenu(e, block)">
                            @if (selected)
                            {
                                <input class="cut-tl-text-label"
                                       @ref="_textLabelInput"
                                       value="@block.Text"
                                       maxlength="80"
                                       aria-label="Text"
                                       data-testid="cut-tl-text-label"
                                       @onpointerdown:stopPropagation="true"
                                       @onkeydown:stopPropagation="true"
                                       @onfocus="() => _textFieldFocused = true"
                                       @onblur="() => _textFieldFocused = false"
                                       @onchange="e => SetTextLabelAsync(block, e)" />
                            }
                            else
                            {
                                <span class="cut-tl-text-label">@block.Text</span>
                            }
                            <button type="button"
                                    class="cut-tl-handle is-in"
                                    data-testid="cut-tl-text-handle-in"
                                    title="Trim text"
                                    @onpointerdown:stopPropagation="true"
                                    @onpointerdown="e => BeginTextTrimAsync(e, block, true)"></button>
                            <button type="button"
                                    class="cut-tl-handle is-out"
                                    data-testid="cut-tl-text-handle-out"
                                    title="Trim text"
                                    @onpointerdown:stopPropagation="true"
                                    @onpointerdown="e => BeginTextTrimAsync(e, block, false)"></button>
                        </div>
                }
            </div>

            <div class="cut-tl-audio" data-testid="cut-tl-audio">
                @if (ShowMusic)
                {
                    <div class="cut-tl-music"
                         style="left: @(MusicLeftPx)px; width: @(MusicWidthPx)px"
                         data-testid="cut-tl-music"
                         title="@MusicLabel"
                         @onpointerdown:stopPropagation="true"
                         @onpointerdown="BeginMusicMoveAsync">
                        <span class="cut-tl-music-name">@MusicLabel</span>
                        <button type="button"
                                class="cut-tl-handle is-in"
                                data-testid="cut-tl-music-handle-in"
                                title="Trim music in"
                                @onpointerdown:stopPropagation="true"
                                @onpointerdown="e => BeginMusicTrimAsync(e, true)"></button>
                        <button type="button"
                                class="cut-tl-handle is-out"
                                data-testid="cut-tl-music-handle-out"
                                title="Trim music out"
                                @onpointerdown:stopPropagation="true"
                                @onpointerdown="e => BeginMusicTrimAsync(e, false)"></button>
                    </div>
                }
                else
                {
                    <span class="cut-tl-audio-empty">+ Add audio</span>
                }
            </div>
        </div>
    </div>

    <CutTimeline_TextInspector @ref="_inspector"
                               Block="SelectedTextBlock"
                               Busy="Busy"
                               StyleChanged="OnEdited"
                               DurationChanged="SetTextDurationAsync"
                               OnDelete="DeleteSelectedTextAsync"
                               FieldFocusChanged="OnInspectorFieldFocus" />

    <CutTimeline_TextMenu Open="_menuOpen"
                          X="_menuX"
                          Y="_menuY"
                          Busy="Busy"
                          CanPaste="_clipboard is not null"
                          CanSplit="CanSplitSelectedTitle"
                          OnDuplicate="DuplicateSelectedTitleAsync"
                          OnCopy="CopySelectedTitle"
                          OnPaste="PasteTitleAsync"
                          OnDelete="DeleteSelectedTextAsync"
                          OnSplit="SplitSelectedTitleAsync"
                          OnEditDuration="EditDurationAsync"
                          Close="CloseTitleMenu" />

    <div class="cut-tl-chrome">
        <div class="cut-tl-zoom" data-testid="cut-tl-zoom">
            <button type="button" class="cut-tl-icon" title="Zoom out" data-testid="cut-tl-zoom-out" @onclick="ZoomOut">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="10.5" cy="10.5" r="6.25" fill="none" stroke="currentColor" stroke-width="2" />
                    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M15.3 15.3 21 21" />
                    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M7.6 10.5h5.8" />
                </svg>
            </button>
            <button type="button" class="cut-tl-icon" title="Zoom in" data-testid="cut-tl-zoom-in" @onclick="ZoomIn">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="10.5" cy="10.5" r="6.25" fill="none" stroke="currentColor" stroke-width="2" />
                    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M15.3 15.3 21 21" />
                    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M7.6 10.5h5.8M10.5 7.6v5.8" />
                </svg>
            </button>
            <button type="button" class="cut-tl-icon" title="Fit timeline" data-testid="cut-tl-fit" @onclick="FitAsync">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="currentColor" d="M3 5h2v14H3V5zm16 0h2v14h-2V5z" />
                    <path fill="currentColor" d="M8.2 11.1h7.6v1.8H8.2z" />
                    <path fill="currentColor" d="M9.4 7.8 5.8 12l3.6 4.2V7.8zm5.2 0v8.4L18.2 12 14.6 7.8z" />
                </svg>
            </button>
            <input type="range"
                   class="cut-tl-zoom-slider"
                   min="@CutTimelineLayout.MinPxPerSec"
                   max="@CutTimelineLayout.MaxPxPerSec"
                   step="1"
                   value="@_pxPerSec"
                   title="Zoom"
                   aria-label="Zoom"
                   data-testid="cut-tl-zoom-slider"
                   @oninput="OnZoomSlider" />
        </div>
    </div>
</div>
