@page "/"
@inject CutFolderService Folder
@inject CutComposeService Compose

<PageTitle>Cut</PageTitle>

<div class="cut-toolbar">
    <button type="button" class="cut-btn" @onclick="PickFolderAsync" disabled="@_busy">Pick folder</button>
    <button type="button" class="cut-btn cut-btn-ghost" @onclick="PickFilesAsync" disabled="@_busy">Choose MP4s</button>
    <button type="button" class="cut-btn cut-btn-ghost" @onclick="SaveFinishAsync" disabled="@(_busy || !Folder.CanWrite)">Save cut</button>
    @if (Folder.HasFolder)
    {
        <span>@Folder.FolderName · @Folder.Clips.Count clip@(Folder.Clips.Count == 1 ? "" : "s")</span>
    }
    else
    {
        <span class="cut-muted">Finish Film’s current takes — trim, joins, cards, music</span>
    }
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="cut-error" role="alert">@_error</div>
}
@if (!string.IsNullOrWhiteSpace(SavedNote))
{
    <p class="cut-ok">@SavedNote</p>
}

@if (Folder.Clips.Count > 0)
{
    <div class="cut-stage">
        <section class="cut-preview" aria-label="Preview">
            @if (_selected is null)
            {
                <p class="cut-muted">Select a clip.</p>
            }
            else
            {
                <div class="cut-takes" aria-label="Takes">
                    @foreach (var take in _selected.Takes)
                    {
                        var isActive = take.Take == _selected.ActiveTakeNumber && take.Take == _selected.SelectedTakeNumber;
                        <button type="button"
                                class="cut-take @(isActive ? "is-active is-using" : "")"
                                disabled="@(take.Missing || _busy)"
                                @onclick="() => SelectTakeAsync(take.Take)">
                            @if (isActive)
                            {
                                <text>★ Active · Take @take.Take</text>
                            }
                            else
                            {
                                <text>Take @take.Take</text>
                            }
                        </button>
                    }
                </div>
                @if (_selected.Missing)
                {
                    <p class="cut-error">@(_selected.MissingReason ?? "This clip is missing.")</p>
                }
                else
                {
                    <div class="cut-preview-stage">
                        <video @ref="MoviePlayer"
                               class="cut-preview-video @(ShowMovie ? "" : "is-off")"
                               src="@ActiveMovieUrl"
                               playsinline
                               preload="auto"></video>
                        <video @ref="ClipPlayer"
                               class="cut-preview-video @(ShowMovie ? "is-off" : "")"
                               src="@_selected.PreviewUrl"
                               playsinline
                               preload="metadata"
                               @onloadedmetadata="OnPreviewMetadataAsync"></video>
                        @if (ShowComposeOverlay)
                        {
                            <div class="cut-compose-overlay" data-testid="cut-compose-overlay" role="status" aria-live="polite">
                                <div class="cut-compose-spinner" aria-hidden="true"></div>
                                <p class="cut-compose-copy">@ProgressMessage @ProgressPercent%</p>
                            </div>
                        }
                    </div>
                }
                <p class="cut-muted">
                    @if (_selected.HasDuration)
                    {
                        <text>@FormatSec(_selected.SlicedDurationSec)s on the track · file @FormatSec(_selected.DurationSec)s</text>
                    }
                    else
                    {
                        <text>Reading length…</text>
                    }
                </p>
                @if (_selected.RangeDeletes.Count > 0)
                {
                    <div class="cut-range">
                        @foreach (var span in _selected.RangeDeletes)
                        {
                            <button type="button" class="cut-span" @onclick="() => RemoveRangeDelete(span)">
                                @FormatSec(span.Start)–@FormatSec(span.End) ✕
                            </button>
                        }
                    </div>
                }
            }
        </section>

        <CutTimeline Clips="Folder.Clips"
                     Selected="_selected"
                     SelectedChanged="Select"
                     PlayheadSec="_playhead"
                     PlayheadChanged="OnPlayheadAsync"
                     TextClips="Folder.TextClips"
                     HasAudio="Compose.HasAudio"
                     AudioName="Compose.AudioFileName"
                     Busy="TransportLocked"
                     PlayDisabled="PlayDisabled"
                     IsPlaying="IsPlaying"
                     OnPlay="TogglePlayAsync"
                     OnSkipStart="SkipStartAsync"
                     OnSplit="SplitAtPlayheadAsync"
                     OnStepBack="() => StepAsync(-5)"
                     OnStepForward="() => StepAsync(5)"
                     OnEdited="OnTimelineEdited" />

        <section class="cut-card cut-mix">
            <div class="cut-drop">
                <InputFile OnChange="OnAudioAsync" accept="audio/*,.wav,.mp3,.m4a,.aac" />
                @if (Compose.HasAudio)
                {
                    <p class="cut-ok">@Compose.AudioFileName</p>
                    <button type="button" class="cut-btn cut-btn-ghost" @onclick="ClearAudioAsync" disabled="@_busy">Remove</button>
                }
                else
                {
                    <p class="cut-muted">Drop music or a wav. Mixed under the whole movie.</p>
                }
            </div>
            <div class="cut-actions">
                <button type="button" class="cut-btn cut-btn-ghost" @onclick="ExportAsync" disabled="@ExportDisabled">Make movie</button>
            </div>
            @if (_exporting && !string.IsNullOrWhiteSpace(ProgressMessage))
            {
                <p class="cut-muted">@ProgressText</p>
                <div class="cut-progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ProgressPercent">
                    <span style="width:@(ProgressPercent)%"></span>
                </div>
            }
        </section>
    </div>
}
