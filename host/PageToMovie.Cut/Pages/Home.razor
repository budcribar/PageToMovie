@page "/"
@inject CutFolderService Folder
@inject CutComposeService Compose

<PageTitle>Cut</PageTitle>

<div class="cut-toolbar">
    <button type="button" class="cut-btn" @onclick="PickFolderAsync" disabled="@_busy">Pick folder</button>
    <button type="button" class="cut-btn cut-btn-ghost" @onclick="PickFilesAsync" disabled="@_busy">Choose MP4s</button>
    <button type="button" class="cut-btn cut-btn-ghost" @onclick="SaveFinishAsync" disabled="@(_busy || !Folder.CanWrite)">Save cut</button>
    @if (Folder.HasFolder)
    {
        <span>@Folder.FolderName · @Folder.Clips.Count clip@(Folder.Clips.Count == 1 ? "" : "s")</span>
    }
    else
    {
        <span class="cut-muted">Finish Film’s current takes — trim, joins, cards, music</span>
    }
    <div @ref="_audioPickerHost" class="cut-file-sr" aria-hidden="true">
        <InputFile @key="_audioInputKey"
                   OnChange="OnAudioAsync"
                   accept="audio/*,.wav,.mp3,.m4a,.aac" />
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="cut-error" role="alert">@_error</div>
}
@if (!string.IsNullOrWhiteSpace(SavedNote))
{
    <p class="cut-ok">@SavedNote</p>
}

@if (Folder.Clips.Count > 0)
{
    <div class="cut-stage">
        <section class="cut-preview" aria-label="Preview">
            @if (_selected is null)
            {
                <p class="cut-muted">Select a clip.</p>
            }
            else if (_selected.Missing)
            {
                <p class="cut-error">@(_selected.MissingReason ?? "This clip is missing.")</p>
            }
            @if (CutTransport.CanPlay(Folder.Clips))
            {
                <div class="cut-preview-stage">
                    <CutPreviewVideos @ref="_preview"
                                      Freeze="IsPlaying"
                                      ClipSrc="@ClipPlayerSrc"
                                      MovieSrc="@MoviePlayerSrc"
                                      ShowMovie="ShowMovie"
                                      OnClipMetadata="OnPreviewMetadataAsync" />
                    <div @ref="TextOverlay"
                         class="cut-text-overlay is-off"
                         data-testid="cut-text-overlay"
                         aria-hidden="true"
                         @onclick="OnLiveOverlayClickAsync"
                         @oncontextmenu="OnLiveOverlayContextMenuAsync"
                         @oncontextmenu:preventDefault="true">
                        <p class="cut-text-overlay-line"></p>
                    </div>
                    @if (ShowSelectedTitleOverlay && SelectedTitle is { } picked)
                    {
                        var look = picked.Style;
                        <div class="cut-text-overlay is-picked"
                             data-testid="cut-text-overlay-picked"
                             @onclick="() => Timeline?.SelectTitle(picked.Id)"
                             @oncontextmenu="e => OnPickedOverlayContextMenuAsync(e, picked.Id)"
                             @oncontextmenu:preventDefault="true">
                            <p class="cut-text-overlay-line @(look.HasBar ? "has-bar" : "")"
                               style="color: @look.ColorHex; font-size: @(look.FontPx)px; font-family: @look.CssFont; text-align: @look.CssAlign; left: @look.OverlayLeft; right: @look.OverlayRight; transform: @look.OverlayTransform; top: @((look.Y / 7.2).ToString(System.Globalization.CultureInfo.InvariantCulture))%">@picked.DisplayText</p>
                        </div>
                    }
                    @if (ShowComposeOverlay)
                    {
                        <div class="cut-compose-overlay" data-testid="cut-compose-overlay" role="status" aria-live="polite">
                            <div class="cut-compose-spinner" aria-hidden="true"></div>
                            <p class="cut-compose-copy">@ProgressMessage @ProgressPercent%</p>
                        </div>
                    }
                </div>
            }
            @if (_selected is not null)
            {
                <p class="cut-muted">
                    @if (ShowPreviewLength)
                    {
                        <text>@PreviewLengthText</text>
                    }
                    else
                    {
                        <text>Reading length…</text>
                    }
                </p>
                @if (_selected.RangeDeletes.Count > 0)
                {
                    <div class="cut-range">
                        @foreach (var span in _selected.RangeDeletes)
                        {
                            <button type="button" class="cut-span" @onclick="() => RemoveRangeDelete(span)">
                                @FormatSec(span.Start)–@FormatSec(span.End) ✕
                            </button>
                        }
                    </div>
                }
            }
        </section>

        <CutTimeline @ref="Timeline"
                     Clips="Folder.Clips"
                     Selected="_selected"
                     SelectedChanged="Select"
                     PlayheadSec="_playhead"
                     PlayheadChanged="OnPlayheadAsync"
                     TextClips="Folder.TextClips"
                     SelectedTextId="_selectedTextId"
                     SelectedTextIdChanged="OnSelectedTextId"
                     HasAudio="Compose.HasAudio"
                     AudioName="@Compose.AudioFileName"
                     Music="Compose.Music"
                     Busy="TransportLocked"
                     PlayDisabled="PlayDisabled"
                     IsPlaying="IsPlaying"
                     OnPlay="TogglePlayAsync"
                     OnSkipStart="SkipStartAsync"
                     OnSplit="SplitAtPlayheadAsync"
                     OnStepBack="() => StepAsync(-5)"
                     OnStepForward="() => StepAsync(5)"
                     OnEdited="OnTimelineEdited"
                     OnMusicEdited="OnMusicEditedAsync"
                     OnMusicRemoved="ClearAudioAsync"
                     OnAddAudio="OpenAudioPickerAsync"
                     OnExport="ExportAsync" />
    </div>
}
