<div class="card mb-4 border-secondary-subtle bg-dark-subtle shadow-sm">
    <div class="card-header bg-secondary-subtle text-light d-flex justify-content-between align-items-center py-2 px-3 border-bottom border-secondary-subtle">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-5">📋</span>
            <h5 class="mb-0 fw-bold text-light">Story Metadata & Title Page</h5>
        </div>
        <ScreenplayEditor_ActionButton Variant="outline-light" Text="@(IsCollapsed ? "Show Details ▾" : "Collapse ▴")" OnClick="ToggleCollapse" />
    </div>
    @if (!IsCollapsed)
    {
        <div class="card-body p-3 text-light">
            <div class="row g-3">
                <ScreenplayEditor_StyledInput CssClass="col-md-6" Label="Film / Story Title" @bind-Value="Metadata.Title" OnChanged="OnChanged" Placeholder="e.g. The Tell-Tale Heart" />
                <ScreenplayEditor_StyledInput CssClass="col-md-6" Label="Author / Screenwriter" @bind-Value="Metadata.Author" OnChanged="OnChanged" Placeholder="e.g. Edgar Allan Poe" />
                <ScreenplayEditor_StyledInput CssClass="col-md-6" Label="Credit Line" @bind-Value="Metadata.Credit" OnChanged="OnChanged" Placeholder="e.g. Written by" />
                <ScreenplayEditor_StyledInput CssClass="col-md-6" Label="Source Material" @bind-Value="Metadata.Source" OnChanged="OnChanged" Placeholder="e.g. Based on the short story by Edgar Allan Poe" />
                <ScreenplayEditor_StyledInput CssClass="col-md-6" Label="Draft Date / Version" @bind-Value="Metadata.DraftDate" OnChanged="OnChanged" Placeholder="e.g. 2026-08-09" />
                <ScreenplayEditor_StyledInput CssClass="col-md-6" Label="Contact Info" @bind-Value="Metadata.Contact" OnChanged="OnChanged" Placeholder="e.g. contact@pagetomovie.com" />
            </div>
        </div>
    }
</div>
