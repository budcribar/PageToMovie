<div class="border border-secondary-subtle rounded p-2 mb-2 bg-dark text-light shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
        <div class="d-flex align-items-center gap-2">
            <select class="form-select form-select-sm fw-bold border-secondary bg-dark text-light" style="width: 140px;" @bind="Beat.BeatType" @bind:after="OnChanged">
                <option value="@BeatType.Action">🎬 Action</option>
                <option value="@BeatType.Dialogue">🗣️ Dialogue</option>
                <option value="@BeatType.Parenthetical">💬 Parenthetical</option>
                <option value="@BeatType.Transition">🎞️ Transition</option>
            </select>
            @if (Beat.BeatType == BeatType.Dialogue)
            {
                <input type="text" class="form-control form-control-sm text-uppercase fw-bold border-secondary bg-dark text-light" style="width: 180px;" @bind="Beat.Speaker" @bind:after="OnChanged" placeholder="SPEAKER" />
                <select class="form-select form-select-sm border-secondary bg-dark text-light" style="width: 110px;" @bind="Beat.SpeakerExt" @bind:after="OnChanged">
                    <option value="@SpeakerExtension.None">(None)</option>
                    <option value="@SpeakerExtension.VO">V.O.</option>
                    <option value="@SpeakerExtension.OS">O.S.</option>
                    <option value="@SpeakerExtension.CONTD">CONT'D</option>
                </select>
            }
        </div>
        <div class="d-flex align-items-center gap-1">
            <ScreenplayEditor_ActionButton Variant="@ComponentVariant.OutlineSecondary" Text="▲" Title="Move Up" Disabled="@IsFirst" OnClick="MoveUp" />
            <ScreenplayEditor_ActionButton Variant="@ComponentVariant.OutlineSecondary" Text="▼" Title="Move Down" Disabled="@IsLast" OnClick="MoveDown" />
            <ScreenplayEditor_ActionButton Variant="@ComponentVariant.OutlineDanger" Text="✕" Title="Delete Beat" OnClick="Delete" />
        </div>
    </div>

    @if (Beat.BeatType == BeatType.Action)
    {
        <textarea class="form-control form-control-sm border-secondary bg-dark text-light" rows="2" @bind="Beat.ActionText" @bind:after="OnChanged" placeholder="Visual action description..."></textarea>
    }
    else if (Beat.BeatType == BeatType.Dialogue)
    {
        <input type="text" class="form-control form-control-sm mb-1 fst-italic border-secondary bg-dark text-light" @bind="Beat.Parenthetical" @bind:after="OnChanged" placeholder="(parenthetical direction, e.g. whispering)" />
        <textarea class="form-control form-control-sm border-secondary bg-dark text-light" rows="2" @bind="Beat.SpokenText" @bind:after="OnChanged" placeholder="Spoken dialogue line..."></textarea>
    }
    else if (Beat.BeatType == BeatType.Parenthetical)
    {
        <input type="text" class="form-control form-control-sm fst-italic border-secondary bg-dark text-light" @bind="Beat.Parenthetical" @bind:after="OnChanged" placeholder="(whispering)" />
    }
    else if (Beat.BeatType == BeatType.Transition)
    {
        <input type="text" class="form-control form-control-sm text-uppercase fw-bold border-secondary bg-dark text-light" @bind="Beat.TransitionText" @bind:after="OnChanged" placeholder="CUT TO:" />
    }
</div>
