@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content bg-dark text-light border-secondary-subtle shadow-lg">
                <div class="modal-header bg-dark-subtle border-bottom border-secondary-subtle">
                    <h5 class="modal-title fw-bold text-light">
                        @(Mode == "import" ? "📥 Import Fountain Screenplay" : "📤 Export Fountain Screenplay")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body p-4">
                    @if (Mode == "import")
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Option 1: Select & Upload .fountain File</label>
                            <InputFile OnChange="HandleFileSelected" accept=".fountain,.txt" class="form-control form-control-sm bg-dark text-light border-secondary mb-3" />
                            
                            <label class="form-label fw-semibold text-secondary small">Option 2: Or Paste Fountain Screenplay Text</label>
                            <textarea class="form-control font-monospace bg-dark text-light border-secondary" rows="12" @bind="FountainText" placeholder="Title: The Tell-Tale Heart..."></textarea>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold text-secondary small mb-0">Formatted Fountain Screenplay</label>
                                <div class="d-flex align-items-center gap-2">
                                    @if (ShowCopyFeedback)
                                    {
                                        <span class="badge text-bg-success px-2 py-1">Copied!</span>
                                    }
                                    <button class="btn btn-sm btn-outline-info" type="button" @onclick="CopyText">📋 Copy Text</button>
                                    <button class="btn btn-sm btn-primary" type="button" @onclick="DownloadFile">💾 Download .fountain File</button>
                                </div>
                            </div>
                            <textarea class="form-control font-monospace bg-dark text-light border-secondary" rows="14" readonly value="@FountainText"></textarea>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-dark-subtle border-top border-secondary-subtle">
                    @if (Mode == "import")
                    {
                        <button type="button" class="btn btn-info px-4 fw-semibold" @onclick="Import" disabled="@string.IsNullOrWhiteSpace(FountainText)">
                            Import into Editor
                        </button>
                    }
                    <button type="button" class="btn btn-outline-secondary px-4" @onclick="Close">Close</button>
                </div>
            </div>
        </div>
    </div>
}
