<div class="card mb-2 border-secondary-subtle bg-dark-subtle shadow-sm" id="scene-card-@Scene.SceneNumber">
    <!-- Single Clean Line Header Row -->
    <div class="card-header bg-dark text-light d-flex flex-nowrap align-items-center gap-1 py-1 px-2 border-bottom border-secondary-subtle overflow-hidden">
        <button class="btn btn-sm btn-link text-light text-decoration-none p-0 me-1 flex-shrink-0" type="button" @onclick="ToggleCollapse" title="Toggle Scene Details">
            @(Scene.IsCollapsed ? "▶" : "▼")
        </button>

        <span class="badge text-bg-warning fw-bold flex-shrink-0">Scene @Scene.SceneNumber</span>

        <button class="btn btn-sm btn-outline-info py-0 px-1 text-nowrap flex-shrink-0" style="height: 26px; font-size: 0.75rem;" type="button" @onclick="OnEditLocationsClick" title="Manage / Edit Story Locations">
            ⚙ Locations
        </button>

        <select class="form-select form-select-sm fw-bold border-secondary bg-dark text-light py-0 px-1 flex-shrink-0" style="width: 85px; height: 26px; font-size: 0.8rem;" @bind="Scene.Env" @bind:after="OnChanged">
            <option value="@SceneEnvironment.INT">INT.</option>
            <option value="@SceneEnvironment.EXT">EXT.</option>
            <option value="@SceneEnvironment.INT_EXT">INT./EXT.</option>
        </select>
        
        <!-- Location Dropdown (e.g. SUBURBAN BACKYARD) -->
        <select class="form-select form-select-sm text-uppercase fw-bold border-secondary bg-dark text-light py-0 px-2 flex-grow-1 text-truncate" style="min-width: 120px; height: 26px; font-size: 0.8rem;" @bind="Scene.Location" @bind:after="OnChanged">
            @if (!AvailableLocations.Contains(Scene.Location) && !string.IsNullOrWhiteSpace(Scene.Location))
            {
                <option value="@Scene.Location">@Scene.Location (Current)</option>
            }
            @foreach (var loc in AvailableLocations)
            {
                <option value="@loc">@loc</option>
            }
        </select>

        <select class="form-select form-select-sm fw-bold border-secondary bg-dark text-light py-0 px-1 flex-shrink-0" style="width: 120px; height: 26px; font-size: 0.8rem;" @bind="Scene.TimeOfDayEnum" @bind:after="OnChanged">
            <option value="@TimeOfDay.DAY">DAY</option>
            <option value="@TimeOfDay.NIGHT">NIGHT</option>
            <option value="@TimeOfDay.CONTINUOUS">CONTINUOUS</option>
            <option value="@TimeOfDay.MOMENTS_LATER">MOMENTS LATER</option>
            <option value="@TimeOfDay.DAWN">DAWN</option>
            <option value="@TimeOfDay.DUSK">DUSK</option>
        </select>
    </div>
    
    @if (Scene.IsCollapsed)
    {
        <div class="card-body py-1 px-2 bg-dark-subtle text-secondary small d-flex justify-content-between align-items-center">
            <span>Summary: <strong>@Scene.HeaderText</strong></span>
            <span class="badge text-bg-dark border border-secondary-subtle">@Scene.Beats.Count Beats</span>
        </div>
    }
    else
    {
        <div class="card-body p-2 text-light">
            <div class="mb-1">
                @if (Scene.Beats.Count == 0)
                {
                    <div class="bg-dark border border-secondary-subtle text-secondary rounded text-center py-2 small mb-2">No beats in this scene yet. Use the dropdown at the bottom left to add one.</div>
                }
                else
                {
                    @for (var i = 0; i < Scene.Beats.Count; i++)
                    {
                        var index = i;
                        var beat = Scene.Beats[index];
                        <ScreenplayEditor_BeatEditor Beat="beat"
                                                     Index="index"
                                                     IsFirst="@(index == 0)"
                                                     IsLast="@(index == Scene.Beats.Count - 1)"
                                                     AvailableCharacters="AvailableCharacters"
                                                     OnChangedCallback="OnChanged"
                                                     OnEditCharactersClick="OnEditCharactersClick"
                                                     OnDeleteCallback="() => DeleteBeat(index)"
                                                     OnReorderBeats="ReorderBeats" />
                    }
                }

                <!-- Bottom Left Add Beat Type Selector Dropdown -->
                <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top border-secondary-subtle">
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select form-select-sm bg-dark text-success border-success fw-bold py-0 px-2" style="width: 170px; height: 28px; font-size: 0.82rem;" value="" @onchange="OnInsertBeatSelected">
                            <option value="" disabled selected>➕ Add Beat...</option>
                            <option value="Action">🎬 Action</option>
                            <option value="Dialogue">🗣️ Dialogue</option>
                            <option value="Transition">🎞️ Transition</option>
                        </select>
                    </div>
                    <span class="text-secondary small font-monospace">@Scene.Beats.Count Beats Total</span>
                </div>
            </div>
        </div>
    }
</div>
