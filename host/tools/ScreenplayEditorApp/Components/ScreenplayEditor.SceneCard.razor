<div class="card mb-4 border-secondary-subtle bg-dark-subtle shadow-sm">
    <div class="card-header bg-dark text-light d-flex justify-content-between align-items-center flex-wrap gap-2 py-2 px-3 border-bottom border-secondary-subtle">
        <div class="d-flex align-items-center gap-2 flex-grow-1">
            <span class="badge text-bg-warning fw-bold">Scene @Scene.SceneNumber</span>
            <select class="form-select form-select-sm fw-bold border-secondary bg-dark text-light" style="width: 120px;" @bind="Scene.Environment" @bind:after="OnChanged">
                <option value="INT.">INT.</option>
                <option value="EXT.">EXT.</option>
                <option value="INT./EXT.">INT./EXT.</option>
            </select>
            <input type="text" class="form-control form-control-sm text-uppercase fw-bold border-secondary bg-dark text-light flex-grow-1" @bind="Scene.Location" @bind:after="OnChanged" placeholder="LOCATION NAME" />
            <select class="form-select form-select-sm fw-bold border-secondary bg-dark text-light" style="width: 140px;" @bind="Scene.TimeOfDay" @bind:after="OnChanged">
                <option value="DAY">DAY</option>
                <option value="NIGHT">NIGHT</option>
                <option value="CONTINUOUS">CONTINUOUS</option>
                <option value="MOMENTS LATER">MOMENTS LATER</option>
                <option value="DAWN">DAWN</option>
                <option value="DUSK">DUSK</option>
            </select>
        </div>
        <div class="btn-group btn-group-sm">
            <button class="btn btn-outline-secondary" type="button" title="Move Scene Up" disabled="@IsFirst" @onclick="MoveUp">▲</button>
            <button class="btn btn-outline-secondary" type="button" title="Move Scene Down" disabled="@IsLast" @onclick="MoveDown">▼</button>
            <button class="btn btn-outline-danger" type="button" title="Delete Scene & Script Text" @onclick="Delete">✕ Delete Scene</button>
        </div>
    </div>
    <div class="card-body p-3 text-light">
        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0 fw-bold text-secondary">Scene Beats & Actions (@Scene.Beats.Count)</h6>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-sm btn-outline-info" type="button" @onclick="() => AddBeat(BeatType.Action)">+ Action</button>
                    <button class="btn btn-sm btn-outline-success" type="button" @onclick="() => AddBeat(BeatType.Dialogue)">+ Dialogue</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => AddBeat(BeatType.Transition)">+ Transition</button>
                </div>
            </div>
            @if (Scene.Beats.Count == 0)
            {
                <div class="bg-dark border border-secondary-subtle text-secondary rounded text-center py-3 small mb-0">No beats in this scene yet. Click <strong>+ Action</strong> or <strong>+ Dialogue</strong> above to add one.</div>
            }
            else
            {
                @for (var i = 0; i < Scene.Beats.Count; i++)
                {
                    var index = i;
                    var beat = Scene.Beats[index];
                    <ScreenplayEditor_BeatEditor Beat="beat"
                                                 IsFirst="@(index == 0)"
                                                 IsLast="@(index == Scene.Beats.Count - 1)"
                                                 OnChangedCallback="OnChanged"
                                                 OnMoveUpCallback="() => MoveBeatUp(index)"
                                                 OnMoveDownCallback="() => MoveBeatDown(index)"
                                                 OnDeleteCallback="() => DeleteBeat(index)" />
                }
            }
        </div>
    </div>
</div>
