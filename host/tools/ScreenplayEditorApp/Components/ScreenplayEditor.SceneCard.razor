<div class="card mb-3 border-secondary-subtle bg-dark-subtle shadow-sm" id="scene-card-@Scene.SceneNumber">
    <div class="card-header bg-dark text-light d-flex justify-content-between align-items-center flex-wrap gap-2 py-1 px-2 border-bottom border-secondary-subtle">
        <div class="d-flex align-items-center gap-2 flex-grow-1 flex-wrap">
            <button class="btn btn-sm btn-link text-light text-decoration-none p-0 me-1" type="button" @onclick="ToggleCollapse" title="Toggle Scene Details">
                @(Scene.IsCollapsed ? "▶" : "▼")
            </button>
            <ScreenplayEditor_BadgePill Variant="@ComponentVariant.Warning" Text="@($"Scene {Scene.SceneNumber}")" />
            
            <select class="form-select form-select-sm fw-bold border-secondary bg-dark text-light py-0 px-2" style="width: 110px; height: 28px;" @bind="Scene.Env" @bind:after="OnChanged">
                <option value="@SceneEnvironment.INT">INT.</option>
                <option value="@SceneEnvironment.EXT">EXT.</option>
                <option value="@SceneEnvironment.INT_EXT">INT./EXT.</option>
            </select>
            
            <!-- Location Dropdown from Master Locations -->
            <select class="form-select form-select-sm text-uppercase fw-bold border-secondary bg-dark text-light py-0 px-2 flex-grow-1" style="min-width: 140px; height: 28px;" @bind="Scene.Location" @bind:after="OnChanged">
                @if (!AvailableLocations.Contains(Scene.Location) && !string.IsNullOrWhiteSpace(Scene.Location))
                {
                    <option value="@Scene.Location">@Scene.Location (Current)</option>
                }
                @foreach (var loc in AvailableLocations)
                {
                    <option value="@loc">@loc</option>
                }
            </select>

            <button class="btn btn-sm btn-outline-info py-0 px-1" type="button" @onclick="OnEditLocationsClick" title="Manage / Edit Story Locations">
                ⚙ Locations
            </button>
            
            <select class="form-select form-select-sm fw-bold border-secondary bg-dark text-light py-0 px-2" style="width: 135px; height: 28px;" @bind="Scene.TimeOfDayEnum" @bind:after="OnChanged">
                <option value="@TimeOfDay.DAY">DAY</option>
                <option value="@TimeOfDay.NIGHT">NIGHT</option>
                <option value="@TimeOfDay.CONTINUOUS">CONTINUOUS</option>
                <option value="@TimeOfDay.MOMENTS_LATER">MOMENTS LATER</option>
                <option value="@TimeOfDay.DAWN">DAWN</option>
                <option value="@TimeOfDay.DUSK">DUSK</option>
            </select>
        </div>
        <div class="d-flex align-items-center gap-1">
            <ScreenplayEditor_ActionButton Variant="@ComponentVariant.OutlineDanger" Text="✕ Delete" Title="Delete Scene" OnClick="Delete" />
        </div>
    </div>
    
    @if (Scene.IsCollapsed)
    {
        <div class="card-body py-1 px-2 bg-dark-subtle text-secondary small d-flex justify-content-between align-items-center">
            <span>Summary: <strong>@Scene.HeaderText</strong></span>
            <span class="badge text-bg-dark border border-secondary-subtle">@Scene.Beats.Count Beats</span>
        </div>
    }
    else
    {
        <div class="card-body p-2 text-light">
            <div class="mb-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h6 class="mb-0 fw-bold text-secondary small">Scene Beats & Actions (@Scene.Beats.Count)</h6>
                    <div class="btn-group btn-group-sm">
                        <ScreenplayEditor_ActionButton Variant="@ComponentVariant.OutlineInfo" Text="+ Action" OnClick="() => AddBeat(BeatType.Action)" />
                        <ScreenplayEditor_ActionButton Variant="@ComponentVariant.OutlineSuccess" Text="+ Dialogue" OnClick="() => AddBeat(BeatType.Dialogue)" />
                        <ScreenplayEditor_ActionButton Variant="@ComponentVariant.OutlineSecondary" Text="+ Transition" OnClick="() => AddBeat(BeatType.Transition)" />
                    </div>
                </div>
                @if (Scene.Beats.Count == 0)
                {
                    <div class="bg-dark border border-secondary-subtle text-secondary rounded text-center py-2 small mb-0">No beats in this scene yet. Click <strong>+ Action</strong> or <strong>+ Dialogue</strong> above to add one.</div>
                }
                else
                {
                    @for (var i = 0; i < Scene.Beats.Count; i++)
                    {
                        var index = i;
                        var beat = Scene.Beats[index];
                        <ScreenplayEditor_BeatEditor Beat="beat"
                                                     Index="index"
                                                     IsFirst="@(index == 0)"
                                                     IsLast="@(index == Scene.Beats.Count - 1)"
                                                     AvailableCharacters="AvailableCharacters"
                                                     OnChangedCallback="OnChanged"
                                                     OnDeleteCallback="() => DeleteBeat(index)"
                                                     OnReorderBeats="ReorderBeats" />
                    }
                }
            </div>
        </div>
    }
</div>
