@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-light border-warning shadow-lg">
                <div class="modal-header bg-dark-subtle border-secondary-subtle">
                    <h5 class="modal-title fw-bold text-light">👥 Story Characters Manager</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <label class="form-label fw-semibold text-secondary small">Add New Character</label>
                    <div class="input-group input-group-sm mb-3">
                        <input type="text" class="form-control text-uppercase bg-dark text-light border-secondary" @bind="NewCharacterName" placeholder="e.g. BUSTER" />
                        <button class="btn btn-warning" type="button" @onclick="AddCharacter" disabled="@string.IsNullOrWhiteSpace(NewCharacterName)">+ Add Character</button>
                    </div>

                    <label class="form-label fw-semibold text-secondary small">Master Cast & Dialogue Speakers (@Characters.Count)</label>
                    <div class="list-group list-group-flush border border-secondary-subtle rounded overflow-auto" style="max-height: 300px;">
                        @for (var i = 0; i < Characters.Count; i++)
                        {
                            var index = i;
                            var chara = Characters[index];
                            <div class="list-group-item bg-dark text-light border-secondary-subtle d-flex justify-content-between align-items-center py-2 px-3">
                                <span class="fw-bold font-monospace text-uppercase text-warning">@chara</span>
                                <div class="d-flex align-items-center gap-2">
                                    <button class="btn btn-sm btn-outline-danger py-0 px-2" type="button" @onclick="() => RemoveCharacter(index)" title="Delete Character">✕ Delete</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer bg-dark-subtle border-secondary-subtle">
                    <button type="button" class="btn btn-primary btn-sm px-4" @onclick="Close">Done</button>
                </div>
            </div>
        </div>
    </div>
}
