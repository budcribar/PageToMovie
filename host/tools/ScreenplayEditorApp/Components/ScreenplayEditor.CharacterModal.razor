@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-dark text-light border-warning shadow-lg">
                <div class="modal-header bg-dark-subtle border-secondary-subtle">
                    <h5 class="modal-title fw-bold text-light">👥 Cast, Voice Clones & Image Reference Locks</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <label class="form-label fw-semibold text-secondary small">Add New Character to Cast</label>
                    <div class="input-group input-group-sm mb-4">
                        <input type="text" class="form-control text-uppercase bg-dark text-light border-secondary" @bind="NewCharacterName" placeholder="e.g. BUSTER" />
                        <button class="btn btn-warning fw-semibold px-3" type="button" @onclick="AddCharacter" disabled="@string.IsNullOrWhiteSpace(NewCharacterName)">+ Add Character</button>
                    </div>

                    <label class="form-label fw-semibold text-secondary small">Master Characters & Voice/Image Sidecar Packages (@Characters.Count)</label>
                    <div class="d-flex flex-column gap-3 overflow-auto" style="max-height: 450px;">
                        @for (var i = 0; i < Characters.Count; i++)
                        {
                            var index = i;
                            var chara = Characters[index];
                            <div class="card bg-dark-subtle border-secondary-subtle p-3 shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary-subtle">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-5">🎭</span>
                                        <h5 class="mb-0 fw-bold text-warning text-uppercase">@chara</h5>
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger py-0 px-2" type="button" @onclick="() => RemoveCharacter(index)" title="Remove Character from Cast">✕ Delete</button>
                                </div>

                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-secondary small mb-1">🗣️ Voice Clone / TTS Style</label>
                                        <select class="form-select form-select-sm bg-dark text-light border-secondary">
                                            <option value="eleven_multilingual_v2">ElevenLabs · Multilingual V2 (Default)</option>
                                            <option value="eleven_turbo_v2">ElevenLabs · Turbo V2</option>
                                            <option value="suno_v5">Suno V5.5 Voice Clone</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-secondary small mb-1">🖼️ Locked Reference Images</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-dark text-info border-secondary">3 Images Attached</span>
                                            <button class="btn btn-outline-info" type="button">Manage Plates</button>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-semibold text-secondary small mb-1">🎨 Visual Appearance & Wardrobe Lock</label>
                                        <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="e.g. Hero character in dark leather jacket, stubble beard" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer bg-dark-subtle border-secondary-subtle">
                    <button type="button" class="btn btn-primary btn-sm px-4 fw-semibold" @onclick="Close">Done</button>
                </div>
            </div>
        </div>
    </div>
}
