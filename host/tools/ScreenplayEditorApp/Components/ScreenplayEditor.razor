<div class="container-fluid py-4 px-md-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 pb-3 border-bottom">
        <div>
            <span class="badge text-bg-primary fs-6 mb-1">PageToMovie · Structured Screenplay Editor</span>
            <h2 class="mb-0 fw-bold">@(!string.IsNullOrWhiteSpace(Model.Metadata.Title) ? Model.Metadata.Title : "Untitled Screenplay")</h2>
            <p class="text-muted small mb-0">
                Author: <strong>@(!string.IsNullOrWhiteSpace(Model.Metadata.Author) ? Model.Metadata.Author : "Unknown")</strong> ·
                Scenes: <strong>@Model.Scenes.Count</strong> ·
                Total Beats: <strong>@TotalBeats</strong>
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-primary btn-sm" type="button" @onclick="OpenImportModal">📥 Import Fountain</button>
            <button class="btn btn-primary btn-sm" type="button" @onclick="OpenExportModal">📤 Export Fountain</button>
            <button class="btn btn-success btn-sm" type="button" @onclick="AddScene">+ Add Scene</button>
        </div>
    </div>

    <ScreenplayEditor_MetadataHeader Metadata="Model.Metadata" OnChangedCallback="OnChanged" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0 fw-bold">Scenes (@Model.Scenes.Count)</h4>
        <button class="btn btn-sm btn-outline-success" type="button" @onclick="AddScene">+ Add Scene</button>
    </div>

    @if (Model.Scenes.Count == 0)
    {
        <div class="alert alert-info text-center p-4">
            <h5 class="alert-heading fw-bold">No scenes in screenplay</h5>
            <p class="mb-3">Click <strong>+ Add Scene</strong> above to create your first scene, or click <strong>Import Fountain</strong> to load a screenplay file.</p>
            <button class="btn btn-primary btn-sm" type="button" @onclick="AddScene">+ Add Scene</button>
        </div>
    }
    else
    {
        @for (var i = 0; i < Model.Scenes.Count; i++)
        {
            var index = i;
            var scene = Model.Scenes[index];
            <ScreenplayEditor_SceneCard Scene="scene"
                                        IsFirst="@(index == 0)"
                                        IsLast="@(index == Model.Scenes.Count - 1)"
                                        OnChangedCallback="OnChanged"
                                        OnMoveUpCallback="() => MoveSceneUp(index)"
                                        OnMoveDownCallback="() => MoveSceneDown(index)"
                                        OnDeleteCallback="() => DeleteScene(index)" />
        }
    }

    <ScreenplayEditor_FountainModal @bind-IsOpen="ShowFountainModal"
                                    Mode="@FountainModalMode"
                                    FountainText="@FountainModalText"
                                    OnImportCallback="HandleFountainImport" />
</div>
