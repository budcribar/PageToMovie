<div class="container-fluid py-2 px-md-3">
    <!-- Compact Studio Header (Max 2 Rows) -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-2 border-bottom border-secondary-subtle">
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <ScreenplayEditor_BadgePill Variant="@ComponentVariant.Primary" Text="PageToMovie" />
                <h5 class="mb-0 fw-bold text-light text-nowrap">Screenplay Editor</h5>
            </div>
            <span class="text-secondary small d-none d-md-inline">
                Title: <strong class="text-light">@(!string.IsNullOrWhiteSpace(Model.Metadata.Title) ? Model.Metadata.Title : "Untitled")</strong> ·
                Author: <strong class="text-light">@(!string.IsNullOrWhiteSpace(Model.Metadata.Author) ? Model.Metadata.Author : "Unknown")</strong> ·
                Scenes: <strong class="text-light">@Model.Scenes.Count</strong> ·
                Beats: <strong class="text-light">@TotalBeats</strong>
            </span>
        </div>

        <!-- Right Side: Hamburger Menu & Add Scene Action -->
        <div class="d-flex align-items-center gap-2">
            <ScreenplayEditor_ActionButton Variant="@ComponentVariant.Success" Icon="bi-plus-lg" Text="Add Scene" OnClick="AddScene" />

            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Studio Menu">
                    <i class="bi bi-list fs-5 align-middle"></i> Menu
                </button>
                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow-lg">
                    <li><h6 class="dropdown-header">Story Setup</h6></li>
                    <li>
                        <button class="dropdown-item" type="button" @onclick="OpenLocationModal">
                            <i class="bi bi-geo-alt text-info me-2"></i> Edit Story Locations...
                        </button>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">Screenplay Exchange</h6></li>
                    <li>
                        <button class="dropdown-item" type="button" @onclick="OpenImportModal">
                            <i class="bi bi-box-arrow-in-down text-info me-2"></i> Import Fountain...
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item" type="button" @onclick="OpenExportModal">
                            <i class="bi bi-box-arrow-up-right text-primary me-2"></i> Export Fountain...
                        </button>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">View Controls</h6></li>
                    <li>
                        <button class="dropdown-item" type="button" @onclick="ShowAllScenesView">
                            <i class="bi bi-card-list text-warning me-2"></i> @(ActiveViewMode == "all" ? "Switch to Single Scene Inspector" : "Show All Scenes View")
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item" type="button" @onclick="CollapseAllScenes">
                            <i class="bi bi-arrows-collapse me-2"></i> Collapse All Scenes
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item" type="button" @onclick="ExpandAllScenes">
                            <i class="bi bi-arrows-expand me-2"></i> Expand All Scenes
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Two-Column Master-Detail Layout -->
    <div class="row g-3">
        <!-- Column 1: Left Outline Navigation Sidebar -->
        <div class="@(IsSidebarCompact ? "col-auto" : "col-md-3")">
            <ScreenplayEditor_OutlineSidebar Scenes="Model.Scenes"
                                              ActiveView="@ActiveViewMode"
                                              SelectedSceneIndex="SelectedSceneIndex"
                                              @bind-IsCompact="IsSidebarCompact"
                                              OnSelectMetadata="SelectMetadataView"
                                              OnSelectScene="SelectSceneView"
                                              OnAddScene="AddScene"
                                              OnDeleteScene="DeleteScene"
                                              OnReorderScenes="ReorderScenes" />
        </div>

        <!-- Column 2: Right Active View Inspector -->
        <div class="@(IsSidebarCompact ? "col" : "col-md-9")">
            @if (ActiveViewMode == "metadata")
            {
                <ScreenplayEditor_MetadataHeader Metadata="Model.Metadata" OnChangedCallback="OnChanged" />
            }
            else if (ActiveViewMode == "scene" && Model.Scenes.Count > 0 && SelectedSceneIndex >= 0 && SelectedSceneIndex < Model.Scenes.Count)
            {
                var scene = Model.Scenes[SelectedSceneIndex];
                <div class="mb-2 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <ScreenplayEditor_ActionButton Variant="@ComponentVariant.OutlineSecondary" Text="◄ Prev Scene" Disabled="@(SelectedSceneIndex == 0)" OnClick="SelectPreviousScene" />
                        <ScreenplayEditor_ActionButton Variant="@ComponentVariant.OutlineSecondary" Text="Next Scene ►" Disabled="@(SelectedSceneIndex >= Model.Scenes.Count - 1)" OnClick="SelectNextScene" />
                    </div>
                    <span class="text-secondary small">Viewing Scene <strong>@(SelectedSceneIndex + 1)</strong> of <strong>@Model.Scenes.Count</strong></span>
                </div>

                <ScreenplayEditor_SceneCard Scene="scene"
                                            IsFirst="@(SelectedSceneIndex == 0)"
                                            IsLast="@(SelectedSceneIndex == Model.Scenes.Count - 1)"
                                            AvailableLocations="Model.GetAllLocations()"
                                            AvailableCharacters="Model.GetAllCharacters()"
                                            OnChangedCallback="OnChanged"
                                            OnEditLocationsClick="OpenLocationModal"
                                            OnDeleteCallback="() => DeleteScene(SelectedSceneIndex)" />
            }
            else if (ActiveViewMode == "all" || Model.Scenes.Count == 0)
            {
                <ScreenplayEditor_MetadataHeader Metadata="Model.Metadata" OnChangedCallback="OnChanged" />

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <h5 class="mb-0 fw-bold text-light">Scenes</h5>
                        <ScreenplayEditor_BadgePill Variant="@ComponentVariant.Secondary" Text="@Model.Scenes.Count.ToString()" />
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (Model.Scenes.Count > 0)
                        {
                            <ScreenplayEditor_ActionButton Variant="@ComponentVariant.OutlineSecondary" Text="Collapse All" OnClick="CollapseAllScenes" />
                            <ScreenplayEditor_ActionButton Variant="@ComponentVariant.OutlineSecondary" Text="Expand All" OnClick="ExpandAllScenes" />
                        }
                        <ScreenplayEditor_ActionButton Variant="@ComponentVariant.Success" Icon="bi-plus-lg" Text="Add Scene" OnClick="AddScene" />
                    </div>
                </div>

                @if (Model.Scenes.Count == 0)
                {
                    <div class="card bg-dark-subtle border-secondary-subtle text-center p-5 mb-4 shadow-sm">
                        <div class="card-body">
                            <div class="display-6 text-info mb-3">🎬</div>
                            <h5 class="fw-bold text-light">No scenes in screenplay</h5>
                            <p class="text-secondary mb-0">
                                Use the <strong class="text-success">+ Add Scene</strong> button above to create your first scene, or click <strong class="text-info">Import Fountain</strong> in the menu to load an existing screenplay file.
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    @for (var i = 0; i < Model.Scenes.Count; i++)
                    {
                        var index = i;
                        var scene = Model.Scenes[index];
                        <ScreenplayEditor_SceneCard Scene="scene"
                                                    IsFirst="@(index == 0)"
                                                    IsLast="@(index == Model.Scenes.Count - 1)"
                                                    AvailableLocations="Model.GetAllLocations()"
                                                    AvailableCharacters="Model.GetAllCharacters()"
                                                    OnChangedCallback="OnChanged"
                                                    OnEditLocationsClick="OpenLocationModal"
                                                    OnDeleteCallback="() => DeleteScene(index)" />
                    }
                }
            }
        </div>
    </div>

    <ScreenplayEditor_FountainModal @bind-IsOpen="ShowFountainModal"
                                     Mode="@FountainModalMode"
                                     FountainText="@FountainModalText"
                                     OnImportCallback="HandleFountainImport" />

    <ScreenplayEditor_LocationModal @bind-IsOpen="ShowLocationModal"
                                     Locations="Model.MasterLocations"
                                     OnChangedCallback="OnChanged" />
</div>
