<div class="card bg-dark-subtle border-secondary-subtle h-100 shadow-sm">
    <div class="card-header bg-dark text-light d-flex justify-content-between align-items-center py-1 px-2 border-bottom border-secondary-subtle">
        <div class="d-flex align-items-center gap-1 overflow-hidden">
            @if (!IsCompact)
            {
                <div class="btn-group btn-group-sm" role="group" aria-label="Outline mode">
                    <button type="button"
                            class="btn py-0 px-2 @(OutlineTab == "scenes" ? "btn-primary" : "btn-outline-secondary")"
                            @onclick='() => SetTab("scenes")'>Scenes</button>
                    <button type="button"
                            class="btn py-0 px-2 @(OutlineTab == "cast" ? "btn-warning" : "btn-outline-secondary")"
                            @onclick='() => SetTab("cast")'>Cast</button>
                    <button type="button"
                            class="btn py-0 px-2 @(OutlineTab == "locations" ? "btn-info text-dark" : "btn-outline-secondary")"
                            @onclick='() => SetTab("locations")'>Locs</button>
                </div>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1"
                        title="Cycle Scenes / Cast / Locations"
                        @onclick="ToggleOutlineTab">
                    @(OutlineTab == "scenes" ? "S" : OutlineTab == "cast" ? "C" : "L")
                </button>
            }
        </div>
        <div class="d-flex align-items-center gap-1">
            @if (!IsCompact && OutlineTab == "scenes")
            {
                <button type="button"
                        class="btn btn-sm btn-outline-success py-0 px-2 spe-outline-add"
                        title="Add scene at the end"
                        @onclick="OnAddScene">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                </button>
            }
            <button class="btn btn-sm btn-outline-secondary py-0 px-2" type="button" @onclick="ToggleCompact" title="@(IsCompact ? "Expand Sidebar" : "Shrink Sidebar")">
                @(IsCompact ? "⟫" : "⟪")
            </button>
        </div>
    </div>

    <div class="card-body p-2 overflow-auto" style="max-height: calc(100vh - 180px);">
        @if (OutlineTab == "cast")
        {
            <div class="d-flex flex-column gap-1">
                @if (Characters.Count == 0)
                {
                    <p class="text-secondary small px-1 mb-0">
                        No cast yet — character classifier seeds load from Stage‑1.
                    </p>
                    <button type="button" class="btn btn-sm btn-outline-warning" @onclick="OpenCastEditor">
                        Open Characters…
                    </button>
                }
                else
                {
                    <div class="small text-secondary px-1 mb-1">@Characters.Count · classifier cast</div>
                    @foreach (var name in Characters)
                    {
                        var isFocus = !string.IsNullOrWhiteSpace(FocusedCharacter)
                            && name.Equals(FocusedCharacter, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="btn btn-sm text-start w-100 d-flex align-items-center gap-2 py-1 @(isFocus ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")"
                                title="Edit @name"
                                @onclick="() => SelectCharacter(name)">
                            <i class="bi bi-person-fill flex-shrink-0" aria-hidden="true"></i>
                            @if (!IsCompact)
                            {
                                <span class="text-truncate font-monospace small">@name</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">@Initials(name)</span>
                            }
                        </button>
                    }
                }
            </div>
        }
        else if (OutlineTab == "locations")
        {
            <div class="d-flex flex-column gap-1">
                @if (Locations.Count == 0)
                {
                    <p class="text-secondary small px-1 mb-0">
                        No locations yet — from scene headings and location seeds.
                    </p>
                    <button type="button" class="btn btn-sm btn-outline-info" @onclick="OpenLocationEditor">
                        Open Locations…
                    </button>
                }
                else
                {
                    <div class="small text-secondary px-1 mb-1">@Locations.Count · places</div>
                    @foreach (var name in Locations)
                    {
                        var isFocus = !string.IsNullOrWhiteSpace(FocusedLocation)
                            && name.Equals(FocusedLocation, StringComparison.OrdinalIgnoreCase);
                        var sceneCount = Scenes.Count(s =>
                            !string.IsNullOrWhiteSpace(s.Location)
                            && s.Location.Equals(name, StringComparison.OrdinalIgnoreCase));
                        <button type="button"
                                class="btn btn-sm text-start w-100 d-flex align-items-center gap-2 py-1 @(isFocus ? "btn-info text-dark fw-bold" : "btn-outline-secondary text-light")"
                                title="Edit @name"
                                @onclick="() => SelectLocation(name)">
                            <i class="bi bi-geo-alt-fill flex-shrink-0" aria-hidden="true"></i>
                            @if (!IsCompact)
                            {
                                <span class="text-truncate font-monospace small flex-grow-1">@name</span>
                                @if (sceneCount > 0)
                                {
                                    <span class="badge text-bg-secondary">@sceneCount</span>
                                }
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">@Initials(name)</span>
                            }
                        </button>
                    }
                }
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-1">
                <button type="button"
                        class="btn btn-sm text-start w-100 d-flex align-items-center gap-2 py-1 @(ActiveView == "metadata" ? "btn-primary fw-bold" : "btn-outline-secondary text-light")"
                        @onclick="SelectMetadata"
                        title="Story Metadata & Title Page">
                    <span class="small">📋</span>
                    @if (!IsCompact)
                    {
                        <span class="text-truncate small">Metadata</span>
                    }
                </button>

                <hr class="my-1 border-secondary-subtle" />

                @if (Scenes.Count == 0)
                {
                    @if (!IsCompact)
                    {
                        <p class="text-secondary small px-1 mb-0">No scenes. Use + to add one.</p>
                    }
                }
                else
                {
                    @foreach (var block in BuildOutlineBlocks())
                    {
                        var gTitle = block.GroupTitle;
                        var gScenes = block.Scenes;
                        var collapsed = gScenes.Count > 0 && gScenes[0].IsGroupCollapsed;
                        var allSelected = gScenes.Count > 0 && gScenes.All(s => s.IsSelected);

                        <div class="d-flex align-items-center gap-1 w-100 rounded px-1 py-0 spe-group-header border border-secondary-subtle">
                            <button type="button"
                                    class="btn btn-sm spe-outline-icon text-secondary"
                                    title="@(collapsed ? "Expand" : "Collapse") group"
                                    @onclick="() => ToggleGroup(gTitle)">
                                <i class="bi @(collapsed ? "bi-chevron-right" : "bi-chevron-down")" aria-hidden="true"></i>
                            </button>
                            <input type="checkbox"
                                   class="form-check-input my-0 flex-shrink-0 spe-outline-check"
                                   checked="@allSelected"
                                   @onchange="e => ToggleGroupSelect(gScenes, e)"
                                   title="Select all scenes in group" />
                            @if (EditingGroupTitle == gTitle)
                            {
                                <input type="text"
                                       class="form-control form-control-sm bg-dark text-light border-secondary py-0 px-1 flex-grow-1"
                                       style="height: 1.4rem; font-size: 0.75rem;"
                                       @bind="GroupRenameDraft"
                                       @bind:event="oninput"
                                       @onkeydown="e => OnGroupRenameKey(e, gTitle)"
                                       @onblur="() => CommitGroupRename(gTitle)" />
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-sm text-start flex-grow-1 min-w-0 p-0 border-0 bg-transparent text-info text-truncate small fw-semibold"
                                        title="Click: select group · Double-click: rename"
                                        @onclick="() => SelectGroupScenes(gScenes)"
                                        @ondblclick="() => BeginGroupRename(gTitle)">
                                    @if (!IsCompact)
                                    {
                                        <span>@gTitle</span>
                                        <span class="text-secondary fw-normal ms-1">(@gScenes.Count)</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-info text-dark">@gScenes.Count</span>
                                    }
                                </button>
                            }
                        </div>

                        @if (!collapsed)
                        {
                            @for (var si = 0; si < gScenes.Count; si++)
                            {
                                var scene = gScenes[si];
                                var index = Scenes.IndexOf(scene);
                                if (index < 0) continue;

                                <div class="d-flex align-items-center gap-1 w-100 rounded border px-1 py-0 spe-outline-row @(scene.IsSelected ? "bg-primary text-white border-primary" : "bg-dark text-light border-secondary-subtle")"
                                     draggable="true"
                                     @ondragstart="() => HandleDragStart(index)"
                                     @ondragover:preventDefault
                                     @ondrop="() => HandleDrop(index)"
                                     title="@scene.HeaderText — drag to reorder">

                                    <input type="checkbox"
                                           class="form-check-input my-0 flex-shrink-0 spe-outline-check"
                                           @bind="scene.IsSelected"
                                           @bind:after="OnSelectionChanged"
                                           title="Select scene" />

                                    <button type="button"
                                            class="btn btn-sm text-start flex-grow-1 min-w-0 p-0 border-0 bg-transparent text-reset text-truncate spe-outline-label"
                                            @onclick="() => SelectScene(index)">
                                        <span class="badge @(scene.IsSelected ? "text-bg-dark" : "text-bg-warning") me-1 fw-bold">@scene.SceneNumber</span>
                                        @if (!IsCompact)
                                        {
                                            <span class="small font-monospace">@scene.HeaderText</span>
                                        }
                                    </button>

                                    <div class="d-flex align-items-center flex-shrink-0 spe-outline-actions">
                                        <button type="button"
                                                class="btn btn-sm spe-outline-icon text-info"
                                                title="Preview scene @scene.SceneNumber"
                                                @onclick="() => PreviewScene(index)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi bi-play-fill" aria-hidden="true"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm spe-outline-icon text-success"
                                                title="Insert scene after @scene.SceneNumber"
                                                @onclick="() => InsertAfter(index)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm spe-outline-icon text-danger"
                                                title="Delete scene @scene.SceneNumber"
                                                @onclick="() => RequestDelete(index)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    }
                }

                <hr class="my-1 border-secondary-subtle" />

                <button type="button"
                        class="btn btn-sm text-start w-100 d-flex align-items-center gap-2 py-1 @(ActiveView == "credits" ? "btn-info fw-bold text-dark" : "btn-outline-secondary text-light")"
                        @onclick="SelectCredits"
                        title="Final Credits & Closing Copyright">
                    <span class="small">🎬</span>
                    @if (!IsCompact)
                    {
                        <span class="text-truncate small">Credits</span>
                    }
                </button>

                @if (IsCompact)
                {
                    <button type="button" class="btn btn-sm btn-outline-success w-100 mt-2 py-0" @onclick="OnAddScene" title="Add Scene">+</button>
                }
            </div>
        }
    </div>
</div>

@if (DeletingIndex >= 0 && DeletingIndex < Scenes.Count)
{
    var deletingScene = Scenes[DeletingIndex];
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-light border-danger shadow-lg">
                <div class="modal-header bg-danger text-white py-2">
                    <h5 class="modal-title fw-bold">Delete Scene @deletingScene.SceneNumber?</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="mb-1">Delete <strong>Scene @deletingScene.SceneNumber: @deletingScene.HeaderText</strong>?</p>
                    <p class="text-secondary small mb-0">Removes all @deletingScene.Beats.Count beats in this scene.</p>
                </div>
                <div class="modal-footer py-2 border-secondary-subtle">
                    <button type="button" class="btn btn-danger btn-sm px-3" @onclick="ConfirmDelete">Yes, Delete</button>
                    <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CancelDelete">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@if (PreviewingIndex >= 0 && PreviewingIndex < Scenes.Count)
{
    var previewScene = Scenes[PreviewingIndex];
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content bg-dark text-light border-info shadow-lg">
                <div class="modal-header bg-info text-dark py-2">
                    <h5 class="modal-title fw-bold">Preview: Scene @previewScene.SceneNumber</h5>
                    <button type="button" class="btn-close" @onclick="ClosePreview"></button>
                </div>
                <div class="modal-body p-4 font-monospace">
                    <h5 class="fw-bold text-center text-uppercase mb-4">@previewScene.HeaderText</h5>
                    @foreach (var beat in previewScene.Beats)
                    {
                        if (beat.BeatType == BeatType.Action)
                        {
                            <p class="mb-3 text-light">@beat.ActionText</p>
                        }
                        else if (beat.BeatType == BeatType.Sound)
                        {
                            <p class="mb-3 text-info fst-italic">(SOUND: @beat.ActionText)</p>
                        }
                        else if (beat.BeatType == BeatType.Dialogue)
                        {
                            <div class="text-center my-2">
                                <strong class="text-warning text-uppercase">@beat.Speaker @beat.Extension</strong>
                                @if (!string.IsNullOrEmpty(beat.Parenthetical))
                                {
                                    <div class="fst-italic text-secondary">@beat.Parenthetical</div>
                                }
                                <div class="text-light">@beat.SpokenText</div>
                            </div>
                        }
                        else if (beat.BeatType == BeatType.Transition)
                        {
                            <p class="text-end fw-bold text-info my-3">@beat.TransitionText</p>
                        }
                    }
                </div>
                <div class="modal-footer py-2 border-secondary-subtle">
                    <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="ClosePreview">Close</button>
                </div>
            </div>
        </div>
    </div>
}
