@inherits PageToMovie.Web.Components.PageSliceComponent
@* Page-local to Review — finish (trims, titles, music). Built only when this tab is selected. *@
@inject ActiveProjectState ActiveProject

@if (_fetching)
{
    <div class="alert alert-info py-2 px-3 mb-2 d-flex align-items-center gap-2"
         data-testid="review-finish-fetching-clips">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span>
            Getting the rest of the clips onto this computer so they can go in the movie…
            @if (MediaFolder.SyncTotal > 0)
            {
                <text>@MediaFolder.SyncCurrent of @MediaFolder.SyncTotal.</text>
            }
        </span>
    </div>
}
else if (Missing() is { } gap)
{
    <div class="alert alert-warning py-2 px-3 mb-2" data-testid="review-finish-missing-clips">
        <div class="mb-1">
            <strong>This cut has @gap.Local of @gap.Planned clips.</strong>
            @if (gap.NotMade > 0)
            {
                <span>
                    @gap.NotMade @(gap.NotMade == 1 ? "clip has" : "clips have") not been made yet —
                    finish @(gap.NotMade == 1 ? "it" : "them") on the Film step first.
                </span>
            }
            @if (gap.NotHere > 0)
            {
                <span>
                    @gap.NotHere @(gap.NotHere == 1 ? "clip is" : "clips are") finished but could not be
                    brought onto this computer@(string.IsNullOrWhiteSpace(_fetchError) ? "" : $" — {_fetchError}").
                </span>
            }
        </div>
        @if (gap.NotHere > 0)
        {
            <button type="button" class="btn btn-sm btn-warning"
                    data-testid="review-finish-retry-clips"
                    @onclick="FetchMissingClipsAsync">
                Try again
            </button>
        }
    </div>
}

<PageToMovie.Cut.Pages.CutEditor HostProjectPrefix="@ActiveProject.ProjectId"
                                 AutoAttachHostFolder="true" />
