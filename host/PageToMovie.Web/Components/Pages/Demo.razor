@page "/demo"
@inject EngineApiClient Engine
@inject AdminSessionService Session
@inject NavigationManager Nav
@inject IAppLocalizer L
@inject ActiveProjectState ActiveProject
@using PageToMovie.Core.Models
@using PageToMovie.Core.Util

<PageTitle>@L["DemoPage.Title"]</PageTitle>

<div class="demo-page">
    <header class="demo-hero mb-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="min-w-0">
                <div class="ptm-adapt-kicker mb-0">Studio · Public gallery</div>
                <h1 class="ptm-adapt-title fs-4 mb-0">@L["Nav.Demo"]</h1>
            </div>
            @if (!_loading && _demos.Count > 0)
            {
                <div class="d-flex align-items-center gap-3 flex-shrink-0">
                    <span class="demo-hero-meta mb-0">@_demos.Count film@(_demos.Count == 1 ? "" : "s") on the wall</span>
                    <div class="demo-sort btn-group btn-group-sm" role="group" aria-label="Sort gallery">
                        <button type="button"
                                class="btn @(_sort == "top" ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="SortByTopAsync">@L["DemoPage.MostStars"]</button>
                        <button type="button"
                                class="btn @(_sort == "new" ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="SortByNewAsync">@L["DemoPage.Newest"]</button>
                    </div>
                </div>
            }
        </div>
        <div class="small text-muted mt-1">
            @L["DemoPage.Subtitle"]
            @if (!Session.IsLoggedIn)
            {
                <span> · Sign in to star.</span>
            }
        </div>
    </header>

    <InlineAlert Message="@_error" />
    <InlineAlert Message="@_message" Variant="info" />

    @if (_loading)
    {
        <CenteredSpinner WrapperClass="demo-loading" CaptionClass="text-muted mb-0 mt-2">
            <Caption>Loading the gallery…</Caption>
        </CenteredSpinner>
    }
    else if (_demos.Count == 0)
    {
        <div class="demo-empty card">
            <div class="card-body text-center py-5">
                <div class="demo-empty-icon" aria-hidden="true">🎬</div>
                <h2 class="h4 mb-2">No published films yet</h2>
                <p class="text-muted mb-0 mx-auto" style="max-width: 28rem;">
                    @if (!string.IsNullOrWhiteSpace(_youtubeSyncHint))
                    {
                        @_youtubeSyncHint
                    }
                    else
                    {
                        <text>No films on the wall yet. Publish from Review, or admin: connect the PageToMovieStudio channel and sync under Admin.</text>
                    }
                </p>
            </div>
        </div>
    }
    else
    {
        @* Bootstrap row-cols: 1 / 2 / 3 columns — reliable with the app's Bootstrap CSS *@
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 demo-grid">
            @foreach (var d in _demos)
            {
                <div class="col d-flex" @key="d.Id">
                    <Demo_FilmCard Film="d"
                                   IsHighlight="@(_highlightId == d.Id)"
                                   Busy="_busy"
                                   IsReported="@_reported.Contains(d.Id)"
                                   OnToggleStar="ToggleStarAsync"
                                   OnFork="ForkDemoAsync"
                                   OnReport="ReportAsync"
                                   OnDelete="DeleteAsync" />
                </div>
            }
        </div>
    }
</div>
