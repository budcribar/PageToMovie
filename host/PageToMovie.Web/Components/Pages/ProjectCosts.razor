@page "/cost/breakdown"
@inject EngineApiClient Engine
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject IAppLocalizer L
@using System.Globalization
@using static PageToMovie.Web.Components.CostFormatting

<PageTitle>@L["ProjectCostsPage.Title"]</PageTitle>

<StudioPageHeader Kicker="Studio · Estimate" Title="@L["ProjectCostsPage.Title"]">
    @L["ProjectCostsPage.Subtitle"]
</StudioPageHeader>

<InlineAlert Message="@_error" />

@if (_report is null)
{
    <p class="text-muted">@L["Common.Loading"]</p>
}
else
{
    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-sm btn-outline-secondary" href="cost" data-testid="breakdown-back-estimate">← @L["Nav.Estimate"]</a>
    </div>

    @if (_report.Scenarios.Count > 0)
    {
        <div class="card mb-3 border-secondary border-opacity-25">
            <div class="card-body py-2">
                <div class="small text-muted mb-2">Video cost changes a lot with resolution — pick one:</div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var r in _report.Scenarios)
                    {
                        var active = string.Equals(r.Resolution, _draftRes, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="btn btn-sm @(active ? "btn-primary" : "btn-outline-secondary")"
                                disabled="@_busy"
                                @onclick="() => SetDraftResolutionAsync(r.Resolution)">
                            <span class="fw-semibold">@r.Resolution</span>
                            <span class="ms-1">@Usd(r.FullFilmUsd)</span>
                            <span class="text-muted ms-1 small">(@Usd(r.RatePerSec)/s)</span>
                        </button>
                    }
                </div>
                <div class="form-text mb-0">
                    Full-film numbers above include cast, planning, and optional voice; these chips are video-heavy scenarios at catalog rates for the selected video model.
                </div>
            </div>
        </div>
    }

    <CascadingValue Value="this" IsFixed="true">
        <ProjectCostsEstimateSection />
        <ProjectCostsSpentSection />
        <ProjectCostsCategoryCards />
        <ProjectCostsAdvancedSection />
    </CascadingValue>
}
