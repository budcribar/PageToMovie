@* Page-local to Review — play tab (WIP/scene/clip + full movie) *@
@inject StudioCapabilityState Caps
@inject AdminSessionService Session
@inject IAppLocalizer L
@inject EngineApiClient Engine
@inject ClientMediaFolderService MediaFolder
@using Microsoft.AspNetCore.Components
@using PageToMovie.Core.Models


@if (Share!._youTubeUpload is not null)
{
    <p class="small text-muted mb-3" data-testid="review-youtube-last-upload">
        Last YouTube upload: <strong>@Share!._youTubeUpload.Title</strong> (@Share!._youTubeUpload.PrivacyStatus, @Share!._youTubeUpload.UploadedAt.ToLocalTime().ToString("g")) —
        <a href="@Share!._youTubeUpload.Url" target="_blank" rel="noopener">@Share!._youTubeUpload.Url</a>
        @if (Session.IsAdmin)
        {
            <a href="#" class="ms-2" @onclick="Share!.DisconnectYouTubeAsync" @onclick:preventDefault="true">(disconnect channel)</a>
        }
    </p>
}



@if (Playback!._showWipPlayer && Playback!._clientStitching)
{
    <div class="card mb-3 border-secondary">
        <div class="card-body py-2 small text-muted">
            Combining full cut in browser… @Playback!._clientStitchStatus
        </div>
    </div>
}
else if (Playback!._showWipPlayer && (!string.IsNullOrEmpty(Playback!._clientWipUrl) || Playback!._wipExists))
{
    <div class="card mb-3 border-success">
        <div class="card-header d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
            <span>
                @if (!string.IsNullOrEmpty(Playback!._clientWipUrl))
                {
                    <span>WIP preview <span class="badge bg-info text-dark ms-1">client stitch</span></span>
                }
                else
                {
                    <span>WIP movie <code class="small">@(Playback!._wipPath ?? "assets/movie_wip.mp4")</code></span>
                    @if (Playback!._wipStale)
                    {
                        <span class="badge bg-warning text-dark ms-1">stale</span>
                    }
                    else
                    {
                        <span class="badge bg-success ms-1">current</span>
                    }
                }
            </span>
            @if (string.IsNullOrEmpty(Playback!._clientWipUrl) && !string.IsNullOrEmpty(Playback!._wipUpdatedAt))
            {
                <span class="small text-muted">updated @Playback!._wipUpdatedAt · @Review.FormatBytes(Playback!._wipBytes)</span>
            }
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Playback!.HideWipPlayerAsync">Hide</button>
        </div>
        <div class="card-body py-2">
            @{ var wipNeedsRebuild = Playback!._wipStale && string.IsNullOrEmpty(Playback!._clientWipUrl); }
            @if (wipNeedsRebuild && MediaFolder.IsSyncing)
            {
                <MediaDownloadProgress Label="Downloading media to rebuild the movie…"
                                       CurrentFile="@MediaFolder.SyncCurrentFile" Current="@MediaFolder.SyncCurrent"
                                       Total="@MediaFolder.SyncTotal" Percent="@MediaFolder.SyncPercent" />
            }
            else if (wipNeedsRebuild && !MediaFolder.IsConnected)
            {
                <div class="py-3 text-center text-muted">
                    <p class="mb-2">@Playback!._wipReason — connect your local media folder to rebuild this movie from your synced clips.</p>
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="Playback!.ConnectFolderForWipAsync">Connect folder</button>
                </div>
            }
            else
            {
                @if (wipNeedsRebuild && !string.IsNullOrEmpty(Playback!._wipReason))
                {
                    <p class="small text-warning mb-2">@Playback!._wipReason — showing the last built copy, not current.</p>
                }
                <video controls playsinline autoplay="@(!wipNeedsRebuild)"
                       style="width:100%;max-height:70vh;background:#000;border-radius:0.35rem;"
                       src="@(string.IsNullOrEmpty(Playback!._clientWipUrl) ? Playback!.WipServerSrc() : Playback!._clientWipUrl)"
                       @key="Playback!._wipVideoKey"
                       onloadeddata="this.play().catch(function(){})">
                    Your browser does not support HTML5 video.
                </video>
                @if (string.IsNullOrEmpty(Playback!._clientWipUrl))
                {
                    <div class="mt-2">
                        <a href="@Engine.WipMovieUrl(Host._projectId)" target="_blank" rel="noopener" class="small text-muted">Open in new tab</a>
                    </div>
                }
            }
        </div>
    </div>
}

@if (Playback!._showScenePlayer && Playback!._playingScene is int playSn && !Playback!._clientStitching)
{
    <div class="card mb-3 border-primary">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span>
                Scene
                <code class="small">S@(playSn.ToString("D2"))</code>
                @if (!string.IsNullOrEmpty(Playback!._clientSceneUrl))
                {
                    <span class="badge bg-info text-dark ms-1">client stitch</span>
                }
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Playback!.HideScenePlayerAsync">Hide</button>
        </div>
        <div class="card-body py-2">
            <video controls playsinline autoplay
                   style="width:100%;max-height:70vh;background:#000;border-radius:0.35rem;"
                   src="@(string.IsNullOrEmpty(Playback!._clientSceneUrl) ? Playback!.SceneServerSrc(playSn) : Playback!._clientSceneUrl)"
                   @key="Playback!._sceneVideoKey"
                   onloadeddata="this.play().catch(function(){})">
                Your browser does not support HTML5 video.
            </video>
            <p class="small text-muted mb-0 mt-2">
                @if (string.IsNullOrEmpty(Playback!._clientSceneUrl))
                {
                    <a href="@Engine.CompositeVideoUrl(Host._projectId, playSn)" target="_blank" rel="noopener">Open in new tab</a>
                }
                else
                {
                    <span>Stitched in browser from clips (not written to disk).</span>
                }
            </p>
        </div>
    </div>
}
else if (Playback!._showScenePlayer && Playback!._clientStitching)
{
    <div class="card mb-3 border-secondary">
        <div class="card-body py-2 small text-muted">
            Combining scene in browser… @Playback!._clientStitchStatus
        </div>
    </div>
}

@if (Playback!._showClipPlayer && Playback!._playingClipScene is int clipSn && Playback!._playingClipNum is int clipCn)
{
    <div class="card mb-3 border-info">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span>
                Clip
                <code class="small">S@(clipSn.ToString("D2"))C@(clipCn.ToString("D2"))</code>
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Playback!.HideClipPlayer">Hide</button>
        </div>
        <div class="card-body py-2">
            <video controls playsinline autoplay
                   style="width:100%;max-height:50vh;background:#000;border-radius:0.35rem;"
                   src="@Playback!.ClipServerSrc(clipSn, clipCn)"
                   @key="Playback!._clipVideoKey"
                   onloadeddata="this.play().catch(function(){})">
                Your browser does not support HTML5 video.
            </video>
            <p class="small text-muted mb-0 mt-2">
                <a href="@Engine.ClipVideoUrl(Host._projectId, clipSn, clipCn)" target="_blank" rel="noopener">Open in new tab</a>
                · after regen, <strong>Play scene</strong> stitches the updated cut in the browser
            </p>
        </div>
    </div>
}

    <div class="card mb-3 border-success shadow-lg text-white" style="background-color: #0f172a !important; border-color: #10b981 !important;">
        <div class="card-header border-secondary d-flex justify-content-between align-items-center py-2.5" style="background-color: #1e293b !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">🎬</span>
                <span class="fw-bold fs-6">Full Movie Player</span>
                @if (string.IsNullOrEmpty(Playback!._clientWipUrl) && !string.IsNullOrEmpty(Playback!._wipUpdatedAt))
                {
                    <span class="badge bg-dark border border-secondary text-white-50">updated @Playback!._wipUpdatedAt · @Review.FormatBytes(Playback!._wipBytes)</span>
                }
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="List!.SetTabReview">Back to Review</button>
        </div>
        <div class="card-body p-3">
            @if (Playback!._clientStitching)
            {
                <div class="p-5 text-center text-info">
                    <div class="spinner-border text-info me-2" role="status"></div>
                    <div class="fw-semibold mt-2">Stitching full movie preview in browser…</div>
                    <div class="small text-muted mt-1">@Playback!._clientStitchStatus</div>
                </div>
            }
            else
            {
                <video controls playsinline autoplay
                       style="width:100%;max-height:75vh;background:#000;border-radius:0.5rem;"
                       src="@(string.IsNullOrEmpty(Playback!._clientWipUrl) ? Playback!.WipServerSrc() : Playback!._clientWipUrl)"
                       @key="Playback!._wipVideoKey">
                    Your browser does not support HTML5 video.
                </video>
                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-secondary flex-wrap gap-2">
                    <span class="small text-muted">
                        @if (!string.IsNullOrEmpty(Playback!._clientWipUrl))
                        {
                            <span>Stitched directly in browser from scene clips</span>
                        }
                        else
                        {
                            <span>Saved movie file on server</span>
                        }
                    </span>
                    <div class="d-flex gap-2">
                        @if (string.IsNullOrEmpty(Playback!._clientWipUrl))
                        {
                            <a href="@Engine.WipMovieUrl(Host._projectId)" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">Open MP4 in new tab</a>
                        }
                        <button type="button" class="btn btn-sm btn-info text-white" @onclick="List!.SetTabShare">
                            Share film →
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
