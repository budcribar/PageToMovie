@using Microsoft.AspNetCore.Components

<div class="clip-compare-container p-4 text-light" style="background: #121519; border-radius: 12px; border: 1px solid #282e38;">
    <h4 class="fw-bold mb-3" style="color: #6366f1;">🔍 Multi-Version Clip Prompt & Video Comparison</h4>
    <p class="text-secondary small">Compare video results and prompt iterations side-by-side across Git revision history.</p>

    <div class="row g-4 mt-2">
        <!-- Version A (Left) -->
        <div class="col-md-6">
            <div class="p-3" style="background: #1c2128; border-radius: 8px; border: 1px solid #30363d;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-secondary fw-bold">Version A (Previous Commit)</span>
                    <span class="small text-muted">@VersionAHash</span>
                </div>
                <div class="video-preview-box mb-3 text-center" style="background: #000; border-radius: 6px; height: 220px; display: flex; align-items: center; justify-content: center;">
                    @if (!string.IsNullOrWhiteSpace(VersionAVideoUrl))
                    {
                        <video src="@VersionAVideoUrl" controls style="max-height: 100%; max-width: 100%; border-radius: 6px;"></video>
                    }
                    else
                    {
                        <div class="text-muted small">No video file</div>
                    }
                </div>
                <div class="prompt-box p-3" style="background: #0d1117; border-radius: 6px; font-family: monospace; font-size: 0.85rem; color: #8b949e;">
                    <strong>Prompt Text:</strong>
                    <div class="mt-1">@VersionAPrompt</div>
                </div>
            </div>
        </div>

        <!-- Version B (Right) -->
        <div class="col-md-6">
            <div class="p-3" style="background: #1c2128; border-radius: 8px; border: 1px solid #4f46e5;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-primary fw-bold">Version B (Current Commit)</span>
                    <span class="small text-muted">@VersionBHash</span>
                </div>
                <div class="video-preview-box mb-3 text-center" style="background: #000; border-radius: 6px; height: 220px; display: flex; align-items: center; justify-content: center;">
                    @if (!string.IsNullOrWhiteSpace(VersionBVideoUrl))
                    {
                        <video src="@VersionBVideoUrl" controls style="max-height: 100%; max-width: 100%; border-radius: 6px;"></video>
                    }
                    else
                    {
                        <div class="text-muted small">No video file</div>
                    }
                </div>
                <div class="prompt-box p-3" style="background: #0d1117; border-radius: 6px; font-family: monospace; font-size: 0.85rem; color: #e6edf3;">
                    <strong>Prompt Text:</strong>
                    <div class="mt-1" style="color: #a5d6ff;">@VersionBPrompt</div>
                </div>
            </div>
        </div>
    </div>
</div>
