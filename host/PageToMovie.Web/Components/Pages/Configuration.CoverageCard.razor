@* Page-local to Configuration — studio API coverage card (starts collapsed) *@
@using Microsoft.AspNetCore.Components

<div class="card mb-3" id="api-keys" data-testid="studio-coverage-card">
    <details class="ptm-cfg-section" open="@IsStudioOpen">
        <summary class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 ptm-cfg-summary"
                 @onclick="ToggleStudioCoverage"
                 @onclick:preventDefault="true">
            <span>Studio coverage</span>
            @{
                var cov = Coverage.BuildCoverageRows();
                var needed = cov.Count(c => c.Required && !c.OptionalOff);
                var ready = cov.Count(c => c.Required && !c.OptionalOff && c.KeyReady);
                var missing = cov.Where(c => c.Required && !c.OptionalOff && !c.KeyReady).ToList();
            }
            @if (missing.Count == 0)
            {
                <span class="badge text-bg-success">@ready/@needed required ready</span>
            }
            else
            {
                <span class="badge text-bg-warning text-dark">@missing.Count missing · @ready/@needed ready</span>
            }
        </summary>
        <div class="card-body">
            <p class="small text-muted mb-3">
                For each job: choose a <strong>provider</strong> (who holds the key), then a <strong>model</strong> from that provider.
                Add a provider only when you need another key. Model lists only show what that provider can run.
                <span class="d-block mt-1">Video review is optional — Script & planning (e.g. xAI) is enough to write a screenplay; review only unlocks QA on clips.</span>
            </p>

            <InlineAlert Message="@Keys._apiKeyFeedback" Variant="success" CssClass="py-2 px-3 small" />

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" data-testid="capability-coverage">
                    <thead>
                        <tr class="small text-muted">
                            <th style="min-width:9rem">Job</th>
                            <th style="min-width:10rem">Provider</th>
                            <th style="min-width:12rem">Model</th>
                            <th>Status</th>
                            <th style="min-width:10rem">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in cov)
                        {
                            var providers = Coverage.ProvidersForCoverage(c.Id).ToList();
                            var providerModels = Coverage.ModelsForCoverageProvider(c.Id, c.ProviderId).ToList();
                            var editing = string.Equals(Coverage._coverageEditId, c.Id, StringComparison.OrdinalIgnoreCase);
                            var isOptionalJob = c.Id is "music" or "voice" or "review";
                            <tr @key="@($"cov-row-{c.Id}")" class="@(c.OptionalOff ? "opacity-75" : "")" data-testid="coverage-@c.Id">
                                <td>
                                    <div class="fw-semibold small">@c.Label</div>
                                    <div class="text-muted" style="font-size:0.75rem;">@c.Hint</div>
                                </td>
                                <td>
                                    @{
                                        // Optional jobs default to "none" (off). Still show provider picker so a key
                                        // can be wired without a hidden empty dropdown.
                                        var showProviderPicker = !c.OptionalOff || isOptionalJob;
                                    }
                                    @if (showProviderPicker && providers.Count > 0)
                                    {
                                        var provSelected = SupportedModelCatalog.NormalizeProviderId(c.ProviderId);
                                        @* Stable key per job only — do not include selection in @key (remount mid-diff
                                           with keyed <option>s caused "return wrong pooled instance"). *@
                                        <select class="form-select form-select-sm"
                                                @key="@($"cov-prov-{c.Id}")"
                                                data-testid="coverage-provider-@c.Id"
                                                disabled="@(Host._busy || string.IsNullOrEmpty(Host._projectId))"
                                                value="@provSelected"
                                                @onchange="e => Coverage.OnCoverageProviderChangedAsync(c.Id, e.Value?.ToString())">
                                            @if (string.IsNullOrWhiteSpace(provSelected)
                                                 || !providers.Any(pr => string.Equals(
                                                     SupportedModelCatalog.NormalizeProviderId(pr.ProviderId),
                                                     provSelected, StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <option value="">Choose provider…</option>
                                            }
                                            @foreach (var pr in providers)
                                            {
                                                var pid = SupportedModelCatalog.NormalizeProviderId(pr.ProviderId);
                                                <option value="@pid">
                                                    @Configuration.ConfigurationCatalog.FriendlyProviderLabel(pid)@(pr.IsConfigured ? " · key saved" : " · no key")
                                                </option>
                                            }
                                        </select>
                                    }
                                    else if (c.OptionalOff)
                                    {
                                        <span class="small text-muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">@Configuration.ConfigurationCatalog.FriendlyProviderLabel(c.ProviderId)</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var showModelPicker = !c.OptionalOff || isOptionalJob;
                                        var modelChoices = providerModels.ToList();
                                        // Always offer Off for optional jobs so users can enable then disable without a separate control.
                                        if (isOptionalJob
                                            && !modelChoices.Any(m => string.Equals(m.Id, "none", StringComparison.OrdinalIgnoreCase)))
                                        {
                                            modelChoices.Insert(0, new SupportedModelDto
                                            {
                                                Id = "none",
                                                DisplayName = c.Id switch
                                                {
                                                    "music" => "Off (no background music)",
                                                    "voice" => "Off (no voice clone)",
                                                    _ => "Off (no video review)",
                                                },
                                                Provider = "None",
                                                ProviderId = "none",
                                            });
                                        }
                                    }
                                    @if (showModelPicker && modelChoices.Count > 0 && (!string.IsNullOrWhiteSpace(c.ProviderId) || isOptionalJob))
                                    {
                                        var modelSelected = Coverage.GetCoverageModelId(c.Id);
                                        @* Remount model list only when the provider (option set) changes. *@
                                        <select class="form-select form-select-sm"
                                                @key="@($"cov-model-{c.Id}-{SupportedModelCatalog.NormalizeProviderId(c.ProviderId)}")"
                                                data-testid="coverage-model-@c.Id"
                                                disabled="@(Host._busy || string.IsNullOrEmpty(Host._projectId))"
                                                value="@modelSelected"
                                                @onchange="e => Coverage.OnCoverageModelChangedAsync(c.Id, e.Value?.ToString())">
                                            @if (string.IsNullOrWhiteSpace(c.ProviderId) && isOptionalJob)
                                            {
                                                <option value="none">Off — pick a provider to enable</option>
                                            }
                                            else
                                            {
                                                @foreach (var m in modelChoices)
                                                {
                                                    <option value="@m.Id">
                                                        @Configuration.ConfigurationCoverage.ModelOptionLabel(m)
                                                    </option>
                                                }
                                            }
                                        </select>
                                        @if (string.IsNullOrEmpty(Host._projectId))
                                        {
                                            <div class="form-text">Select a project to save.</div>
                                        }
                                        else if (string.IsNullOrWhiteSpace(c.ProviderId) && isOptionalJob)
                                        {
                                            <div class="form-text">Choose a provider (left), or Add provider if your key is not listed.</div>
                                        }
                                    }
                                    else if (c.OptionalOff)
                                    {
                                        <span class="small text-muted">Off</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(c.ProviderId))
                                    {
                                        <span class="small text-muted">No models for this provider in the catalog</span>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">Pick a provider first</span>
                                    }
                                </td>
                                <td class="small">
                                    @if (c.OptionalOff)
                                    {
                                        <span class="badge text-bg-secondary">Off</span>
                                    }
                                    else if (!c.Required && !c.KeyReady)
                                    {
                                        <span class="badge text-bg-secondary">Optional</span>
                                    }
                                    else if (c.KeyReady)
                                    {
                                        <span class="badge text-bg-success">Ready</span>
                                    }
                                    else if (string.IsNullOrWhiteSpace(c.ProviderId))
                                    {
                                        <span class="badge text-bg-secondary">—</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">Need key</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-testid="coverage-add-provider-@c.Id"
                                                disabled="@Host._busy"
                                                title="Add another provider key for this job"
                                                @onclick="() => Keys.BeginAddProvider(c.Id)"
                                                @onclick:stopPropagation="true">
                                            Add provider
                                        </button>
                                        @if (!c.OptionalOff && !c.KeyReady && !string.IsNullOrWhiteSpace(c.ProviderId))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-primary"
                                                    data-testid="coverage-add-key-@c.Id"
                                                    disabled="@Host._busy"
                                                    @onclick="() => Keys.BeginAddKeyForProvider(c.Id, c.ProviderId)"
                                                    @onclick:stopPropagation="true">
                                                Add key
                                            </button>
                                        }
                                        else if (!c.OptionalOff && c.KeyReady && !string.IsNullOrWhiteSpace(c.ProviderId))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    data-testid="coverage-change-key-@c.Id"
                                                    disabled="@Host._busy"
                                                    title="Replace only the @Configuration.ConfigurationCatalog.FriendlyProviderLabel(c.ProviderId) key"
                                                    @onclick="() => Keys.BeginReplaceKey(c.Id, c.ProviderId)"
                                                    @onclick:stopPropagation="true">
                                                Replace key
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-testid="coverage-remove-key-@c.Id"
                                                    disabled="@Host._busy"
                                                    title="Remove personal key for this provider"
                                                    @onclick="() => Keys.ClearProviderKeyAsync(c.ProviderId)"
                                                    @onclick:stopPropagation="true">
                                                Remove key
                                            </button>
                                        }
                                        @if (isOptionalJob)
                                        {
                                            @if (!c.OptionalOff)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-link text-muted px-1"
                                                        disabled="@(Host._busy || string.IsNullOrEmpty(Host._projectId))"
                                                        @onclick="() => Coverage.TurnOffOptionalAsync(c.Id)"
                                                        @onclick:stopPropagation="true">
                                                    Turn off
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                            @if (editing)
                            {
                                <tr @key="@($"cov-edit-{c.Id}")" class="table-active" data-testid="coverage-key-panel-@c.Id">
                                    <td colspan="5" class="bg-dark bg-opacity-25">
                                        <div class="p-2">
                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                                <div class="small fw-semibold">
                                                    @if (Coverage._coverageKeyMode == "replace")
                                                    {
                                                        <span>Replace key · <span class="text-primary">@Configuration.ConfigurationCatalog.FriendlyProviderLabel(Coverage._coverageKeyProviderId)</span></span>
                                                    }
                                                    else if (Coverage._coverageKeyMode == "add-key")
                                                    {
                                                        <span>Add key · <span class="text-primary">@Configuration.ConfigurationCatalog.FriendlyProviderLabel(Coverage._coverageKeyProviderId)</span></span>
                                                    }
                                                    else
                                                    {
                                                        <span>Add provider for <span class="text-primary">@c.Label</span></span>
                                                    }
                                                </div>
                                                <button type="button" class="btn btn-sm btn-link" @onclick="Keys.CancelAddKey">Cancel</button>
                                            </div>
                                            <p class="small text-muted mb-2">
                                                @if (Coverage._coverageKeyMode is "replace" or "add-key")
                                                {
                                                    <span>Only this provider — paste a new key or remove the saved one.</span>
                                                }
                                                else if (c.Id == "music")
                                                {
                                                    <span>
                                                        Pick a provider for this job.
                                                        <strong>Suno API (sunoapi.org)</strong> and <strong>AI Music API (aimusicapi.ai)</strong> are different keys
                                                        (Suno is the model family).
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>Pick a provider that can run this job, then paste its key (or use a saved one).</span>
                                                }
                                            </p>
                                            <div class="row g-2">
                                                @foreach (var p in Keys.ProvidersForKeyPanel(c.Id))
                                                {
                                                    var selected = string.Equals(Coverage._coverageKeyProviderId, p.ProviderId, StringComparison.OrdinalIgnoreCase);
                                                    <div class="col-md-6 col-lg-4">
                                                        <div class="border rounded p-2 h-100 @(selected ? "border-primary" : "")"
                                                             data-testid="coverage-provider-@p.ProviderId">
                                                            <div class="d-flex justify-content-between align-items-start gap-1 mb-1">
                                                                <div class="fw-semibold small">@Configuration.ConfigurationCatalog.FriendlyProviderLabel(p.ProviderId)</div>
                                                                @if (p.IsConfigured)
                                                                {
                                                                    <span class="badge text-bg-success">Has key</span>
                                                                }
                                                            </div>
                                                            @if (!selected)
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-sm @(p.IsConfigured ? "btn-primary" : "btn-outline-primary")"
                                                                        data-testid="coverage-pick-@p.ProviderId"
                                                                        @onclick="() => Coverage.ChooseProviderForCoverageAsync(p.ProviderId, c.Id)">
                                                                    @(p.IsConfigured ? "Use this key" : "Select")
                                                                </button>
                                                                @if (p.IsConfigured)
                                                                {
                                                                    <div class="form-text">Uses your saved @Configuration.ConfigurationCatalog.FriendlyProviderLabel(p.ProviderId) key and switches the model to match.</div>
                                                                }
                                                            }
                                                            else if (p.IsConfigured)
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-sm btn-primary mb-2"
                                                                        data-testid="coverage-use-saved-@p.ProviderId"
                                                                        disabled="@Host._busy"
                                                                        @onclick="() => Coverage.UseSavedProviderForCoverageAsync(p.ProviderId, c.Id)">
                                                                    Use saved key
                                                                </button>
                                                                <div class="form-text mb-2">Already on file — no need to paste again unless you want to replace it.</div>
                                                                <label class="form-label small mb-1">Replace API key (optional)</label>
                                                                <div class="input-group input-group-sm mb-1">
                                                                    <input type="@(Keys.IsKeyVisible(p.ProviderId) ? "text" : "password")"
                                                                           class="form-control font-monospace"
                                                                           placeholder="@Configuration.ConfigurationCatalog.ProviderPlaceholder(p.ProviderId)"
                                                                           value="@Keys.GetKeyInput(p.ProviderId)"
                                                                           @oninput="e => Keys.SetKeyInput(p.ProviderId, e.Value?.ToString())"
                                                                           disabled="@(Host._busy || Keys._apiKeySaving)" />
                                                                    <button class="btn btn-outline-secondary" type="button"
                                                                            title="@(Keys.IsKeyVisible(p.ProviderId) ? "Hide API key" : "Show API key")"
                                                                            aria-label="@(Keys.IsKeyVisible(p.ProviderId) ? "Hide API key" : "Show API key")"
                                                                            @onclick="() => Keys.ToggleKeyVisible(p.ProviderId)">
                                                                        @if (Keys.IsKeyVisible(p.ProviderId))
                                                                        {
                                                                            @* eye-slash *@
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                                                <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.218.288c-.332.404-.75.85-1.232 1.295l.772.772zm-2.151-2.151.772.772a.5.5 0 0 1 0 .707l-.48.48a.5.5 0 0 1-.707 0l-.772-.772a4 4 0 0 1-5.14-5.14l-.772-.772a.5.5 0 0 1 0-.707l.48-.48a.5.5 0 0 1 .707 0l.772.772A4 4 0 0 1 11.208 9.087z"/>
                                                                                <path d="M13.646 14.354a.5.5 0 0 1-.708 0l-12-12a.5.5 0 0 1 .708-.708l12 12a.5.5 0 0 1 0 .708M3.707 2.293l.773.772A7 7 0 0 0 0 8s3 5.5 8 5.5a7 7 0 0 0 3.935-1.206l.773.772A8 8 0 0 1 8 14.5C3 14.5 0 8 0 8a9 9 0 0 1 3.707-5.707"/>
                                                                            </svg>
                                                                        }
                                                                        else
                                                                        {
                                                                            @* eye *@
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                                                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.218.288c-.332.404-.75.85-1.232 1.295C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                                                                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                                                            </svg>
                                                                        }
                                                                    </button>
                                                                    <button class="btn btn-outline-primary" type="button"
                                                                            disabled="@(Host._busy || Keys._apiKeySaving || string.IsNullOrWhiteSpace(Keys.GetKeyInput(p.ProviderId)))"
                                                                            @onclick="() => Keys.SaveCoverageKeyAsync(p.ProviderId, c.Id)">
                                                                        Replace
                                                                    </button>
                                                                </div>
                                                                <button type="button" class="btn btn-link btn-sm text-danger p-0"
                                                                        disabled="@Host._busy"
                                                                        @onclick="() => Keys.ClearProviderKeyAsync(p.ProviderId)">
                                                                    Remove saved key
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <label class="form-label small mb-1">API key</label>
                                                                <div class="input-group input-group-sm mb-1">
                                                                    <input type="@(Keys.IsKeyVisible(p.ProviderId) ? "text" : "password")"
                                                                           class="form-control font-monospace"
                                                                           placeholder="@Configuration.ConfigurationCatalog.ProviderPlaceholder(p.ProviderId)"
                                                                           value="@Keys.GetKeyInput(p.ProviderId)"
                                                                           @oninput="e => Keys.SetKeyInput(p.ProviderId, e.Value?.ToString())"
                                                                           disabled="@(Host._busy || Keys._apiKeySaving)" />
                                                                    <button class="btn btn-outline-secondary" type="button"
                                                                            title="@(Keys.IsKeyVisible(p.ProviderId) ? "Hide API key" : "Show API key")"
                                                                            aria-label="@(Keys.IsKeyVisible(p.ProviderId) ? "Hide API key" : "Show API key")"
                                                                            @onclick="() => Keys.ToggleKeyVisible(p.ProviderId)">
                                                                        @if (Keys.IsKeyVisible(p.ProviderId))
                                                                        {
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                                                <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.218.288c-.332.404-.75.85-1.232 1.295l.772.772zm-2.151-2.151.772.772a.5.5 0 0 1 0 .707l-.48.48a.5.5 0 0 1-.707 0l-.772-.772a4 4 0 0 1-5.14-5.14l-.772-.772a.5.5 0 0 1 0-.707l.48-.48a.5.5 0 0 1 .707 0l.772.772A4 4 0 0 1 11.208 9.087z"/>
                                                                                <path d="M13.646 14.354a.5.5 0 0 1-.708 0l-12-12a.5.5 0 0 1 .708-.708l12 12a.5.5 0 0 1 0 .708M3.707 2.293l.773.772A7 7 0 0 0 0 8s3 5.5 8 5.5a7 7 0 0 0 3.935-1.206l.773.772A8 8 0 0 1 8 14.5C3 14.5 0 8 0 8a9 9 0 0 1 3.707-5.707"/>
                                                                            </svg>
                                                                        }
                                                                        else
                                                                        {
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                                                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.218.288c-.332.404-.75.85-1.232 1.295C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                                                                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                                                            </svg>
                                                                        }
                                                                    </button>
                                                                    <button class="btn btn-primary" type="button"
                                                                            disabled="@(Host._busy || Keys._apiKeySaving || string.IsNullOrWhiteSpace(Keys.GetKeyInput(p.ProviderId)))"
                                                                            @onclick="() => Keys.SaveCoverageKeyAsync(p.ProviderId, c.Id)">
                                                                        Save
                                                                    </button>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            @if (!Keys.ProvidersForKeyPanel(c.Id).Any())
                                            {
                                                <InlineAlert Variant="warning" CssClass="py-2 small mb-0" Message="No providers available for this job in the catalog." />
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @{
                var savedKeys = Keys.ProviderRows.Where(pr => pr.HasPersonalKey).ToList();
            }
            @if (savedKeys.Count > 0)
            {
                <details class="mt-3" data-testid="manage-saved-keys">
                    <summary class="small text-muted" style="cursor:pointer">Manage saved keys (@savedKeys.Count)</summary>
                    <div class="row g-2 mt-2">
                        @foreach (var p in savedKeys)
                        {
                            var used = Coverage.CoverageUsesForProvider(p.ProviderId);
                            <div class="col-md-6 col-lg-4">
                                <div class="border rounded p-2 small">
                                    <div class="fw-semibold">@p.DisplayName</div>
                                    @if (used.Count > 0)
                                    {
                                        <div class="text-success">In use: @string.Join(" · ", used)</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">Not used by current models</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.MaskedPersonalKey))
                                    {
                                        <div class="text-muted"><code>@p.MaskedPersonalKey</code></div>
                                    }
                                    <button type="button" class="btn btn-link btn-sm text-danger p-0 mt-1"
                                            disabled="@Host._busy"
                                            @onclick="() => Keys.ClearProviderKeyAsync(p.ProviderId)">
                                        Remove key
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </details>
            }
        </div>
    </details>
</div>
