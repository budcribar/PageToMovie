@inject ClientMediaFolderService MediaFolder
@inject IAppLocalizer L
@using Microsoft.AspNetCore.Components

<Admin_CollapsibleCard Title="⚡ Active Jobs & Resource Locks"
                               Expanded="Host._showJobsAndLocks"
                               ExpandedChanged="@(v =>
 Host._showJobsAndLocks = v)">
                    <div class="row g-3">
                        <div class="col-lg-7">
                            <div class="card border">
                                <div class="card-header d-flex justify-content-between py-2">
                                    <span class="fw-semibold">Jobs (running / queued)</span>
                                    <span class="badge text-bg-primary">@(Host._state.Jobs?.Count ?? 0)</span>
                                </div>
                                <div class="card-body p-0">
                                    @if (MediaFolder.IsSyncing)
                                    {
                                        <div class="p-3 border-bottom bg-light">
                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                                <div>
                                                    <span class="spinner-border spinner-border-sm text-primary me-2" role="status" aria-hidden="true"></span>
                                                    <strong>Syncing MP4 clips to client disk…</strong>
                                                    @if (!string.IsNullOrEmpty(MediaFolder.SyncCurrentFile))
                                                    {
                                                        <span class="text-muted ms-2"><code>@MediaFolder.SyncCurrentFile</code></span>
                                                    }
                                                </div>
                                                <div class="d-flex align-items-center gap-2" style="min-width: 180px;">
                                                    <div class="progress flex-grow-1" style="height: 6px;">
                                                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" style="width: @(MediaFolder.SyncPercent)%"></div>
                                                    </div>
                                                    <span class="small font-monospace">@MediaFolder.SyncCurrent / @MediaFolder.SyncTotal</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    @if (Host._state.Jobs?.Items is { Count: > 0 } items)
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-striped mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Job</th>
                                                        <th>User</th>
                                                        <th>Kind</th>
                                                        <th>Scene</th>
                                                        <th>Status</th>
                                                        <th>Progress</th>
                                                        <th>Age</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var j in items)
                                                    {
                                                        var selected = string.Equals(j.JobId, Host._logJobId, StringComparison.OrdinalIgnoreCase);
                                                        <tr class="@(selected ? "table-active" : null)">
                                                            <td class="font-monospace small">@(Admin.ShortId(j.JobId))</td>
                                                            <td>@(j.UserId ?? "—")</td>
                                                            <td>@(j.Kind ?? "—")</td>
                                                            <td>@(j.Scene?.ToString() ?? "—")</td>
                                                            <td>@(j.Status ?? "—")</td>
                                                            <td>@(j.Total > 0 ? $"{j.Index}/{j.Total}" : "—")</td>
                                                            <td>@Admin.FormatAge(j.AgeMs)</td>
                                                            <td class="text-nowrap">
                                                                <button class="btn btn-sm btn-outline-primary me-1"
                                                                        disabled="@(string.IsNullOrEmpty(j.JobId))"
                                                                        title="Load job log"
                                                                        @onclick="() => Host.LoadJobLogAsync(j.JobId!)">
                                                                    Log
                                                                </button>
                                                                <button class="btn btn-sm btn-outline-danger"
                                                                        disabled="@Host._busy || string.IsNullOrEmpty(j.JobId)"
                                                                        @onclick="() => Host.CancelJobAsync(j.JobId!)">
                                                                    Cancel
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted p-3 mb-0">No active jobs.</p>
                                    }

                                    <div class="border-top p-3">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                            <div class="small fw-semibold">Job log</div>
                                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                                <input class="form-control form-control-sm font-monospace"
                                                       style="width: 12rem;"
                                                       placeholder="Job id…"
                                                       @bind="Host._logJobIdInput"
                                                       @bind:event="oninput"
                                                       title="Paste a job id from Home / Characters or this table" />
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        disabled="@(string.IsNullOrWhiteSpace(Host._logJobIdInput))"
                                                        @onclick="() => Host.LoadJobLogAsync(Host._logJobIdInput.Trim())">
                                                    Load
                                                </button>
                                                @if (Host._jobLog is not null)
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="Host.ClearJobLog">Clear</button>
                                                }
                                            </div>
                                        </div>
                                        <InlineAlert Message="@Host._logError" Variant="warning" CssClass="py-1 small mb-2" />
                                        @if (Host._jobLog is null)
                                        {
                                            <p class="text-muted small mb-0">
                                                Click <strong>Log</strong> on a running job, or paste a job id.
                                                Cast “Build cast” is not a job (no log) — use Characters admin details after extract.
                                            </p>
                                        }
                                        else
                                        {
                                            <div class="small mb-2">
                                                <code>@Host._jobLog.JobId</code>
                                                · @(Host._jobLog.Kind ?? "—")
                                                · <span class="badge text-bg-secondary">@(Host._jobLog.Status ?? "—")</span>
                                                @if (!string.IsNullOrWhiteSpace(Host._jobLog.ProjectId))
                                                {
                                                    <span class="text-muted"> · @Host._jobLog.ProjectId</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(Host._jobLog.Message))
                                                {
                                                    <div class="text-muted mt-1">@Host._jobLog.Message</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(Host._jobLog.Error))
                                                {
                                                    <div class="text-danger mt-1">@Host._jobLog.Error</div>
                                                }
                                            </div>
                                            <pre class="small mb-0 p-2 rounded border bg-dark text-light"
                                                 style="max-height: 22rem; overflow: auto; white-space: pre-wrap;">@Host.JobLogText</pre>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="card border">
                                <div class="card-header d-flex justify-content-between py-2">
                                    <span class="fw-semibold">Locks</span>
                                    <span class="badge text-bg-secondary">@Host._locks.Count</span>
                                </div>
                                <div class="card-body p-0">
                                    @if (Host._locks.Count == 0)
                                    {
                                        <p class="text-muted p-3 mb-0 small">No active locks.</p>
                                    }
                                    else
                                    {
                                        <ul class="list-group list-group-flush small">
                                            @foreach (var l in Host._locks.Take(20))
                                            {
                                                <li class="list-group-item d-flex justify-content-between align-items-start py-2">
                                                    <div>
                                                        <code>@l.Resource</code>
                                                        <div>@l.UserId
                                                            @if (!string.IsNullOrEmpty(l.Reason))
                                                            {
                                                                <span class="text-muted"> · @l.Reason</span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <button class="btn btn-sm btn-outline-warning"
                                                            disabled="@Host._busy || string.IsNullOrEmpty(l.Resource)"
                                                            @onclick="() => Host.ReleaseLockAsync(l.Resource!)">
                                                        Force release
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
        
</Admin_CollapsibleCard>
