@page "/admin/book-cache"
@inject EngineApiClient Api
@inject AdminSessionService Session
@inject NavigationManager Nav
@inject IAppLocalizer L

<PageTitle>Admin — Book cache</PageTitle>

<div class="container-fluid py-3">
    <AdminPageHeader Title="@L["BookCache.Title"]">
        <Subtitle>
            Content-addressed <code>book_id</code> · shared <code>adaptation_conversion</code> artifacts ·
            xAI <code>file_id</code> / <code>last_response_id</code> (Responses multi-turn)
        </Subtitle>
        <Actions>
            <a href="/admin" class="btn btn-sm btn-outline-secondary">← Admin</a>
            <button class="btn btn-sm btn-outline-primary" @onclick="RefreshAsync" disabled="@_busy">
                @(_busy ? "Refreshing…" : "Refresh")
            </button>
        </Actions>
    </AdminPageHeader>

    @if (!Session.IsAdmin)
    {
        <InlineAlert Variant="warning">Admin session required. <a href="/admin/login">Sign in</a></InlineAlert>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <InlineAlert Message="@_error" />
        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync">Retry</button>
    }
    else if (_snap is null)
    {
        <p class="text-muted">Loading cache snapshot…</p>
    }
    else
    {
        <div class="row g-3 mb-4">
            <StatCard Label="Books" Value="@_snap.BookCount.ToString()"
                      CardClass="card h-100 border-0 shadow-sm" ValueClass="fs-4 fw-semibold">
                <Sub>@FormatBytes(_snap.TotalBookBytes) stored</Sub>
            </StatCard>
            <StatCard Label="Derived artifacts" Value="@_snap.ArtifactCount.ToString()"
                      CardClass="card h-100 border-0 shadow-sm" ValueClass="fs-4 fw-semibold">
                <Sub>adaptation_conversion, etc.</Sub>
            </StatCard>
            <StatCard Label="Provider file handles" Value="@_snap.ProviderFileCount.ToString()"
                      CardClass="card h-100 border-0 shadow-sm" ValueClass="fs-4 fw-semibold">
                <Sub>xAI file_id rows</Sub>
            </StatCard>
            <div class="col-6 col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted small">How it works</div>
                        <div class="small">
                            Same book bytes → same <code>book_id</code>.
                            Stage‑1 uploads once to xAI Files; retries chain with
                            <code>previous_response_id</code> so the full book is not re-billed.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Registered books</span>
                <span class="badge text-bg-secondary">@(_snap.Books?.Count ?? 0) shown</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle" style="font-size:0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th>@L["BookCache.BookName"]</th>
                            <th>book_id</th>
                            <th>@L["BookCache.Projects"]</th>
                            <th>Bytes</th>
                            <th>@L["BookCache.Artifacts"]</th>
                            <th>Links</th>
                            <th>xAI file_id</th>
                            <th>last_response_id</th>
                            <th>Expires</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_snap.Books is null || _snap.Books.Count == 0)
                        {
                            <EmptyTableRow ColSpan="10" CssClass="p-3" Message="No books registered yet. Prepare a book / run Stage‑1 to populate." />
                        }
                        else
                        {
                            @foreach (var b in _snap.Books)
                            {
                                <tr>
                                    <td class="fw-semibold text-wrap" style="max-width: 250px;">
                                        <span title="@b.BookTitle">@(string.IsNullOrWhiteSpace(b.BookTitle) ? "Untitled Book" : b.BookTitle)</span>
                                    </td>
                                    <td class="font-monospace" title="@b.Sha256">@ShortId(b.BookId)</td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(b.Projects))
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary font-monospace" title="Linked project(s)">@b.Projects</span>
                                        }
                                    </td>
                                    <td>@FormatBytes(b.ByteCount)</td>
                                    <td>@b.ArtifactCount</td>
                                    <td>@b.AccessLinkCount</td>
                                    <td class="font-monospace">
                                        @if (string.IsNullOrWhiteSpace(b.ProviderFileId))
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            <span title="@b.ProviderFileId">@ShortId(b.ProviderFileId)</span>
                                        }
                                    </td>
                                    <td class="font-monospace">
                                        @if (string.IsNullOrWhiteSpace(b.LastResponseId))
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else
                                        {
                                            <span title="@b.LastResponseId">@ShortId(b.LastResponseId)</span>
                                        }
                                    </td>
                                    <td>@FormatExpiry(b.FileExpiresAtUnix)</td>
                                    <td class="text-nowrap">@FormatWhen(b.CreatedAt)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Recent derived artifacts</span>
                <span class="badge text-bg-secondary">@(_snap.RecentArtifacts?.Count ?? 0)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle" style="font-size:0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th>artifact_id</th>
                            <th>book_id</th>
                            <th>Kind</th>
                            <th>Model</th>
                            <th>Prompt version</th>
                            <th>Temp</th>
                            <th>Size</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_snap.RecentArtifacts is null || _snap.RecentArtifacts.Count == 0)
                        {
                            <EmptyTableRow ColSpan="8" CssClass="p-3" Message="No adaptation artifacts yet." />
                        }
                        else
                        {
                            @foreach (var a in _snap.RecentArtifacts)
                            {
                                <tr>
                                    <td class="font-monospace" title="@a.ArtifactId">@ShortId(a.ArtifactId)</td>
                                    <td class="font-monospace" title="@a.BookId (@GetBookTitle(a.BookId))">@ShortId(a.BookId)</td>
                                    <td>@a.ArtifactKind</td>
                                    <td class="font-monospace">@a.ModelId</td>
                                    <td class="font-monospace small">@a.PromptVersion</td>
                                    <td>@a.Temperature.ToString("0.##")</td>
                                    <td>@FormatBytes(a.ContentBytes)</td>
                                    <td class="text-nowrap">@FormatWhen(a.CreatedAt)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
