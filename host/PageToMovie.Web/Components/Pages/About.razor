@page "/about"
@inject EngineApiClient Engine
@inject AdminSessionService Session
@inject Microsoft.Extensions.Options.IOptions<EngineApiOptions> EngineOpts
@inject IAppLocalizer L

<PageTitle>@L["Nav.About"] — PageToMovie</PageTitle>

<h1>@L["AboutPage.Title"]</h1>
<p class="lead">@L["AboutPage.Lead"]</p>
<p class="text-body-secondary">
    @L["AboutPage.Intro"]
</p>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">@L["AboutPage.HowItWorks"]</h2>
                <ol class="small mb-0 ps-3">
                    <li><strong>@L["Home.Book"]</strong> — @L["AboutPage.StepBook"]</li>
                    <li><strong>Look &amp; length</strong> — @L["AboutPage.StepLook"]</li>
                    <li><strong>@L["Nav.Cast"]</strong> — @L["AboutPage.StepCast"]</li>
                    <li><strong>@L["Nav.Film"]</strong> — @L["AboutPage.StepFilm"]</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Good to know</h2>
                <ul class="small mb-0 ps-3">
                    <li>You review and approve each step before spending on generation.</li>
                    <li>Your projects and media stay under your account.</li>
                    <li>Change the film’s length any time to trade off cost and detail.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@* ————— Technical / operational detail: admin only ————— *@
@if (Session.IsAdmin)
{
<InlineAlert Message="@_error" Variant="warning" CssClass="py-2" />

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>API status</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync" disabled="@_busy">Refresh</button>
            </div>
            <div class="card-body small">
                @if (_health is null && string.IsNullOrEmpty(_error))
                {
                    <p class="text-muted mb-0">Checking…</p>
                }
                else if (_health is not null)
                {
                    <div>Status: <strong class="text-success">OK</strong></div>
                    <div>Service: <code>@_health.Service</code></div>
                    <div>Workspace: <code class="text-break">@(_health.Workspace ?? "—")</code></div>
                    <div>Active project: <strong>@(_health.ActiveProject ?? "—")</strong></div>
                    <div>UseFakes: <strong>@(_health.UseFakes ? "ON" : "off")</strong></div>
                    <div>xAI configured: <strong>@(_health.XaiConfigured ? "yes" : "no")</strong></div>
                    <div>Caller: <code>@(_health.UserId ?? "—")</code>
                        @if (_health.IsAdmin) { <span class="badge text-bg-secondary ms-1">admin</span> }
                    </div>
                    <div class="mt-2 text-muted">Engine API: <code>@Engine.ApiBaseUrl</code></div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Capacity (from API)</div>
            <div class="card-body small">
                @if (_capacity?.Capacity is { } c)
                {
                    <div>MaxVideoInFlight: <strong>@c.MaxVideoInFlight</strong></div>
                    <div>MaxVideoInFlightPerUser: <strong>@c.MaxVideoInFlightPerUser</strong></div>
                    <div>MaxQueuePerUser: <strong>@c.MaxQueuePerUser</strong></div>
                    <div class="mt-2">Running jobs: <strong>@_capacity.RunningCount</strong></div>
                }
                else
                {
                    <p class="text-muted mb-0">Unavailable until API is up.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Architecture</div>
    <div class="card-body">
        <pre class="bg-light p-3 rounded mb-0 small" style="white-space:pre-wrap;">PageToMovie.Web (Blazor WASM · hosted by Api, same origin)
    │  REST + SignalR · media JWT (?mt=) · all video stitch/trim (ffmpeg.wasm)
    ▼
PageToMovie.Api  (:5088)
    │  Auth (JWT) · JobHub · credits · demo catalog · admin/ops
    ▼
PageToMovie.Engine
    · Book prepare · Stage 1/2 · Characters · multi-ref video
    · No native ffmpeg (browser ffmpeg.wasm only)
    · locks · worker pools · metrics · assets/video/scene_XX_clip_YY.mp4

Demo gallery     — YouTube-hosted shorts; report → auto-remove after 3
PageToMovie.Fakes     — fake Grok clients + MP4 fixtures (no xAI spend)
PageToMovie.LoadSim   — concurrent VUs against LoadSimBuster sandbox
PageToMovie.Tests     — unit tests</pre>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">App map</div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                <tr>
                    <th>Page</th>
                    <th>Purpose</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var route in AppRoutes.All.Where(r => !r.AdminOnly || Session.IsAdmin))
                {
                    <tr><td><a href="@route.Href">@route.Label</a></td><td>@route.Purpose</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Multi-user &amp; product notes</div>
    <div class="card-body small">
        <ul class="mb-2">
            <li><strong>Jobs</strong> — multi-job store; <code>GET /api/jobs?mine=1</code> (bare list → 400)</li>
            <li><strong>Identity</strong> — JWT; per-user credits and API keys</li>
            <li><strong>Locks</strong> — scene / WIP / stage / character exclusive locks</li>
            <li><strong>Workers</strong> — API pool + FFmpeg pool with capacity caps</li>
            <li><strong>Play / stitch</strong> — browser concatenates clip MP4s (no server WIP required to preview)</li>
            <li><strong>Demo</strong> — share from Review → upload to YouTube; gallery lists when YouTube id is set</li>
            <li><strong>Admin</strong> — users/credits, config, learning, demo moderation</li>
            <li><strong>LoadSim</strong> — uses checked-in <code>projects/LoadSimBuster</code></li>
        </ul>
        <p class="mb-0 text-muted">
            Docs: <code>host/docs/multi-user-100-plan.md</code>, <code>host/docs/loadsim-soak.md</code>, <code>host/README.md</code>
        </p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Run (local)</div>
    <div class="card-body">
        <pre class="bg-light p-3 rounded small mb-0" style="white-space:pre-wrap;"># Single process — API hosts the WASM UI (same origin)
cd host/PageToMovie.Api
$env:XAI_API_KEY = "…"   # optional if UseFakes
dotnet run                 # http://127.0.0.1:5088

# Optional: Web standalone for UI-only work (still needs API)
cd host/PageToMovie.Web
dotnet run --launch-profile http   # http://localhost:5079 → Api at 5088

# LoadSim (optional)
$env:PageToMovie_USE_FAKES = "true"
dotnet run --project host/PageToMovie.LoadSim -- --users 25 --duration 90</pre>
    </div>
</div>

<div class="small text-muted">
    Session user: <code>@Session.UserId</code>
    @if (Session.IsAdmin) { <span>· admin session</span> }
    · Engine base: <code>@(EngineOpts.Value.BaseUrl)</code>
</div>
}
