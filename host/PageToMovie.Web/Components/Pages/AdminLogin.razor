@page "/admin/login"
@inject EngineApiClient Api
@inject AdminSessionService Session
@inject NavigationManager Nav

<PageTitle>Admin login — PageToMovie</PageTitle>

<div class="container py-4" style="max-width: 28rem;">
    <AdminPageHeader Title="Admin login" />
    <p class="text-muted small">
        API login returns a JWT (not a browser cookie). Dev: <code>admin</code> / <code>admin</code>.
    </p>

    @if (_busy && string.IsNullOrEmpty(_error))
    {
        <p class="text-muted">@_status</p>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label">Username</label>
            <input class="form-control" @bind="_username" autocomplete="username" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="admin-password">Password</label>
            <div class="input-group">
                <input id="admin-password"
                       type="@(_showPassword ? "text" : "password")"
                       class="form-control"
                       @bind="_password"
                       autocomplete="current-password"
                       @onkeydown="OnKeyDown" />
                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="ToggleShowPassword"
                        title="@(_showPassword ? "Hide password" : "Show password")"
                        aria-label="@(_showPassword ? "Hide password" : "Show password")"
                        aria-pressed="@_showPassword">
                    @(_showPassword ? "Hide" : "Show")
                </button>
            </div>
        </div>
        <InlineAlert Message="@_error" CssClass="py-2" />
        <button type="button" class="btn btn-primary" @onclick="LoginAsync" disabled="@_busy">
            @(_busy ? "Signing in…" : "Sign in")
        </button>
        <p class="small text-muted mt-3 mb-0">
            Prefer <code>http://localhost:5079</code> (Web <strong>http</strong> profile).
        </p>
    }
</div>
