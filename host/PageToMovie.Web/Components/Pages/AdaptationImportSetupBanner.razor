@inherits PageToMovie.Web.Components.PageSliceComponent
@inject AdminSessionService Session
@inject IAppLocalizer L

@if (!Host.Gate.ImportReady)
{
    <div class="alert alert-warning d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4"
         data-testid="import-setup-required">
        <div>
            <strong>@L["Adaptation.SetupRequiredBeforeImport"]</strong>
            @Host.Gate._importBlockedReason
        </div>
        <a class="btn btn-sm btn-warning fw-semibold"
           href="configuration?focus=planning"
           data-testid="import-open-settings">@L["Adaptation.OpenSettingsLink"]</a>
    </div>
}
else if (AdaptationImport.ImportGate.IsUsablePlanningModel(Host.Status!.PlanningModel))
{
    <div class="mb-3 d-flex flex-wrap align-items-center gap-2" data-testid="import-planning-ready">
        <span class="badge text-bg-success">@L["Adaptation.ReadyToImport"]</span>
        @* Pipeline.Model name is provider jargon — admin only (respects the "view as user" toggle). *@
        @if (Session.IsAdmin)
        {
            <span class="badge text-bg-secondary fw-normal" data-testid="import-planning-model">@Host.Status.PlanningModel</span>
        }
        <a class="small link-secondary" href="configuration?focus=planning">@L["Adaptation.ChangeInSettings"]</a>
    </div>
}
