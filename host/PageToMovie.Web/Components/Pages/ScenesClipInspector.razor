@inherits PageToMovie.Web.Components.PageSliceComponent
@* Page-local to Scenes — the EXPANDED CLIP ROW body (Option B: the row is the clip surface).
   Player + verification one-liner + one action bar (AI Edit Video / Takes / Edit Clip Script) +
   an admin-only Details fold. Regen/Delete live at the scene level (check the clip, use the
   header's Regen (1) / the ⋯ menu) — one verb, one place. *@
@inject StudioCapabilityState Caps
@inject AdminSessionService Session
@inject IAppLocalizer L
@inject ClientMediaFolderService MediaFolder
@inject EngineApiClient Engine
@using Microsoft.AspNetCore.Components
@using PageToMovie.Core.Models


    @if (ClipForm._clip is not null)
    {
        <div class="border border-primary border-opacity-25 rounded bg-body-tertiary p-3 my-1" data-testid="clip-expansion">
            <div class="row">
                <div class="col-md-5 mb-3">
                    @if (ClipForm._clip.OnDisk)
                    {
                        @if (Playback._clipVideoLoading)
                        {
                            <MediaDownloadProgress Label="Checking for a newer local copy…" ShowProgress="false" />
                        }
                        else
                        {
                            <video controls playsinline autoplay
                                   style="width:100%; max-height:320px; background:#111; border-radius:0.35rem;"
                                   src="@(Playback._clipVideoUrl ?? Playback._clipServerVideoUrl)"
                                   @key="@($"clip-{ListState._detail.SceneNumber}-{ClipForm._clip.ClipNumber}-{Playback._clipVideoKey}")"
                                   onloadeddata="this.play().catch(function(){})"></video>
                        }
                        <div class="small text-muted mt-1">
                            @ClipForm._clip.FileName · @Scenes.FormatSize(ClipForm._clip.SizeBytes)
                            @if (ClipForm._clip.ActualDurationSeconds is double cad)
                            {
                                <span> · @Scenes.FormatClock(cad)</span>
                            }
                            · <a href="@Engine.ClipVideoUrl(Host._projectId, ListState._detail.SceneNumber, ClipForm._clip.ClipNumber)" target="_blank" rel="noopener">open clip URL</a>
                        </div>
                    }
                    else
                    {
                        <div class="border rounded p-4 text-center text-muted">
                            No video yet
                            @if (ClipSel.PreviousClipMissing(ClipForm._clip.ClipNumber))
                            {
                                <div class="small text-warning mt-2">
                                    Generate C@((ClipForm._clip.ClipNumber - 1).ToString("D2")) first — this clip continues from the previous video.
                                </div>
                            }
                            <div class="small mt-2">
                                Check this clip in the first column, then <strong>↻ Regen (1) selected clips</strong> above.
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-7">
                    @* One action bar — the rest of the clip's verbs live at scene level. *@
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <button class="btn btn-sm btn-outline-primary"
                                data-testid="clip-video-edit-open"
                                disabled="@(Host._busy || Gen.JobRunning || !ClipForm._clip.OnDisk || Scenes.ScenesClipRegen.ClipExceedsEditDurationCap(ClipForm._clip))"
                                title="@VideoEditTitle"
                                @onclick="ClipRegen.OpenVideoEditPrompt">
                            ✂️ AI Edit Video
                        </button>
                        <button class="btn btn-sm btn-outline-info"
                                disabled="@(Host._busy || Gen.JobRunning)"
                                title="View past takes & version comparison grid for this clip"
                                @onclick="() => ClipVer.OpenClipCompareAsync(ListState._detail.SceneNumber, ClipForm._clip.ClipNumber)">
                            🎬 Takes (@(ClipVer._clipVersions?.Count ?? 1))
                        </button>
                        <button class="btn btn-sm btn-outline-secondary"
                                data-testid="clip-edit-line"
                                disabled="@(Host._busy || Gen.JobRunning)"
                                title="Edit clip fields (dialogue, speaker, prompt, characters…)"
                                @onclick="() => ClipForm.OpenClipEditor(ClipForm._clip)">
                            Edit Clip Script
                        </button>
                        @if (!string.IsNullOrWhiteSpace(ClipForm._clip.Speaker))
                        {
                            <a class="btn btn-sm btn-outline-warning"
                               data-testid="clip-fix-cast"
                               title="Change this speaker's look on the Characters page"
                               href="@StudioDeepLinks.Characters(ClipForm._clip.Speaker, returnScene: ListState._detail.SceneNumber, returnClip: ClipForm._clip.ClipNumber)">
                                Fix cast look
                            </a>
                        }
                        <button class="btn btn-sm btn-outline-secondary ms-auto"
                                title="Collapse this clip"
                                @onclick="() => ClipForm.SelectClip(null)">✕</button>
                    </div>
                    @if (Gen._pendingTakeReasonScene == ListState._detail.SceneNumber
                         && Gen._pendingTakeReasonClip == ClipForm._clip.ClipNumber)
                    {
                        <div class="w-100 mb-2" data-testid="take-reason-strip">
                            <span class="small text-muted me-1">Why regen?</span>
                            @foreach (var reason in VideoTakeReasons.All)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary me-1 mb-1"
                                        data-testid="@($"take-reason-{reason}")"
                                        disabled="@Host._busy"
                                        @onclick="() => SubmitTakeReasonAsync(reason)">
                                    @VideoTakeReasons.Display(reason)
                                </button>
                            }
                            <button type="button" class="btn btn-sm btn-link text-muted mb-1"
                                    data-testid="take-reason-skip"
                                    @onclick="DismissTakeReason">Skip</button>
                            @if (!string.IsNullOrWhiteSpace(Gen._takeReasonSaved))
                            {
                                <span class="small text-success ms-1">@Gen._takeReasonSaved</span>
                            }
                        </div>
                    }

                    @* The spoken line (or silence) — the clip's content, click to edit. *@
                    <p class="small mb-1">
                        <strong>@(string.IsNullOrEmpty(ClipForm._clip.Speaker) ? "Silent" : Scenes.ShortChar(ClipForm._clip.Speaker))</strong>
                        @if (!string.IsNullOrEmpty(ClipForm._clip.Delivery))
                        {
                            <span class="text-muted">· @Scenes.ShortDelivery(ClipForm._clip.Delivery)</span>
                        }
                    </p>
                    @if (ClipForm._clip.Dialogue is { Length: > 0 } fullDlg)
                    {
                        <pre class="small bg-body border rounded p-2 mb-2" style="cursor:pointer;
                             max-height:120px; overflow:auto; white-space:pre-wrap; word-break:break-word;"
                             @onclick="() => ClipForm.OpenClipEditor(ClipForm._clip)" title="Click to edit">@fullDlg</pre>
                    }

                    @* Verification one-liner: expected vs heard + word diff (verdict chip is on the row). *@
                    @if (ClipForm._clip.DialogueVerification is { } ver
                         && (!string.IsNullOrWhiteSpace(ver.TranscribedDialogue) || !string.IsNullOrWhiteSpace(ver.DetectedSpeaker)))
                    {
                        <div class="p-2 mb-2 rounded bg-body border border-secondary-subtle x-small text-start">
                            <div class="mb-1">
                                <span class="fw-bold me-1">Speaker:</span>
                                <span>Expected <em>@(ver.ExpectedSpeaker ?? "None")</em></span>
                                @if (!string.IsNullOrWhiteSpace(ver.DetectedSpeaker))
                                {
                                    <span class="ms-1">· Heard <em>@ver.DetectedSpeaker</em></span>
                                }
                                <button type="button" class="btn btn-sm btn-link p-0 ms-2 align-baseline small"
                                        @onclick="() => Host.OpenVerificationModal(ListState._detail.SceneNumber, ClipForm._clip.ClipNumber, ver)">
                                    report
                                </button>
                            </div>
                            @Scenes.ScenesDialogueVerify.RenderDiffHtml(ver.ExpectedDialogue, ver.TranscribedDialogue)
                        </div>
                    }

                    @if (Session.IsAdmin)
                    {
                        <button type="button" class="btn btn-sm btn-link text-muted p-0 text-decoration-none"
                                data-testid="clip-details-toggle"
                                @onclick="() => _showDetails = !_showDetails">
                            @(_showDetails ? "▾" : "▸") Details (admin) — visual prompt · negative · plan
                        </button>
                        @if (_showDetails)
                        {
                            <div class="mt-2">
                                <h6 class="small">Visual prompt</h6>
                                <pre class="small bg-body border rounded p-2" style="max-height:200px; overflow:auto; white-space:pre-wrap;">@(ClipForm._clip.VisualPrompt is { Length: > 0 } vp ? vp : "—")</pre>
                                <h6 class="small mt-2">Negative</h6>
                                @if (!string.IsNullOrWhiteSpace(ClipForm._clip.NegativePrompt))
                                {
                                    <pre class="small bg-body border rounded p-2" style="max-height:80px; overflow:auto; white-space:pre-wrap;">@ClipForm._clip.NegativePrompt</pre>
                                    <div class="form-text small">Plus global bans at gen (text/watermarks/limbs/name tags…).</div>
                                }
                                else
                                {
                                    <p class="small text-muted mb-1">
                                        No clip-specific extras. Global bans still apply at video gen
                                        (no legible text, watermarks, logos, extra limbs, name tags…).
                                    </p>
                                }
                                @if (ClipForm._clip.CharactersOnScreen.Count > 0)
                                {
                                    <p class="small text-muted mb-1">on screen: @string.Join(", ", ClipForm._clip.CharactersOnScreen.Select(Scenes.ShortChar))</p>
                                }
                                <p class="small text-muted mb-0">
                                    subject: @(ClipForm._clip.PrimarySubject is { Length: > 0 } ps ? ps : "—")
                                    · continuation: @ClipForm._clip.Continuation
                                    · @ClipForm._clip.DurationSeconds s
                                </p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
