@inherits PageToMovie.Web.Components.PageSliceComponent
@using Microsoft.AspNetCore.Components

@* Default collapsed — expand only when running LoadSim / debugging traffic. *@
<Admin_CollapsibleCard Title="📊 LoadSim Performance & System Latency"
                               CssClass="loadsim-panel border-secondary"
                               Badge="@(Telemetry._loadSim?.Latest is null ? "idle" : "live")"
                               BadgeClass="@(Telemetry._loadSim?.Latest is null ? "text-bg-secondary" : "text-bg-success")"
                               Expanded="Ui._showLoadSim"
                               ExpandedChanged="@(async v => { Ui._showLoadSim = v; await Host.NotifyChangedAsync(); })">

@if (State._state.Http is { } http && http.NonAdminLast5Sec <= 2)
{
    <div class="alert alert-secondary py-2 small mb-3 border">
        <strong class="text-muted">HTTP Traffic Note:</strong>
        <span class="text-muted">LoadSim does not appear to be hitting this API (only admin poll).
        Check LoadSim console: “running…”, baseUrl <code>http://127.0.0.1:5088</code>, project <code>LoadSimBuster</code>.</span>
        @if (http.ByPrefixLast5Sec is { Count: > 0 } pref)
        {
            <div class="mt-1 font-monospace text-muted" style="font-size:0.75rem;">
                @foreach (var kv in pref.OrderByDescending(k => k.Value).Take(8))
                {
                    <span class="me-2">@kv.Key=@(kv.Value)</span>
                }
            </div>
        }
    </div>
}

@if (Telemetry._loadSim?.Latest is null)
                    {
                        <p class="small mb-0 text-muted" style="opacity:0.75;">
                            No LoadSim telemetry yet. Start LoadSim — it posts every 2s to
                            <code class="text-info">POST /api/loadsim/progress</code>.
                            This card stays collapsed until you need it.
                        </p>
                    }
                    else
                    {
                        var latest = Telemetry._loadSim.Latest;
                        <div class="row g-2 mb-3 text-center">
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val">@latest.ActionsTotal.ToString("N0")</div>
                                    <div class="loadsim-kpi__lbl">actions</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val">@latest.ActionsPerSec.ToString("0.0")</div>
                                    <div class="loadsim-kpi__lbl">actions/s</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val @(latest.ErrorRate > 0.01 ? "text-warning" : "text-success")">
                                        @((latest.ErrorRate * 100).ToString("0.00"))%
                                    </div>
                                    <div class="loadsim-kpi__lbl">error rate</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val">@latest.BrowseP95Ms<span class="fs-6">ms</span></div>
                                    <div class="loadsim-kpi__lbl">browse p95</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val">@latest.P50Ms<span class="fs-6">ms</span></div>
                                    <div class="loadsim-kpi__lbl">p50 latency</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val">@latest.JobsSubmitted</div>
                                    <div class="loadsim-kpi__lbl">jobs ok</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val">@latest.JobsRejected</div>
                                    <div class="loadsim-kpi__lbl">409 rejects</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val @(latest.Jobs5xx > 0 ? "text-danger" : "")">@latest.Jobs5xx</div>
                                    <div class="loadsim-kpi__lbl">5xx</div>
                                </div>
                            </div>
                        </div>
                        @if (Telemetry._chartWarning is { Length: > 0 } cw)
                        {
                            <InlineAlert Variant="warning" CssClass="py-1 small mb-2">
                                Charts failed to update: @cw
                                <button type="button" class="btn btn-sm btn-link p-0 ms-1 align-baseline" @onclick="Telemetry.UpdateChartsAsync">Retry</button>
                            </InlineAlert>
                        }
                        <div class="row g-3">
                            <div class="col-lg-6">
                                <div class="loadsim-chart-wrap">
                                    <div class="loadsim-chart-title">Throughput</div>
                                    <canvas id="chartLoadSimThroughput"></canvas>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="loadsim-chart-wrap">
                                    <div class="loadsim-chart-title">Latency &amp; errors</div>
                                    <canvas id="chartLoadSimLatency"></canvas>
                                </div>
                            </div>
                        </div>
                        @if (latest.ActionLatency is { Count: > 0 } al)
                        {
                            <div class="mt-3">
                                <div class="loadsim-chart-title mb-1">Per-action latency (p95 desc)</div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-dark loadsim-action-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>action</th>
                                                <th class="text-end">count</th>
                                                <th class="text-end">p50</th>
                                                <th class="text-end">p95</th>
                                                <th class="text-end">p99</th>
                                                <th class="text-end">errs</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var a in al)
                                            {
                                                <tr class="@(a.P95Ms >= 1000 ? "table-warning" : null)">
                                                    <td class="font-monospace">@a.Action</td>
                                                    <td class="text-end font-monospace">@a.Count.ToString("N0")</td>
                                                    <td class="text-end font-monospace">@a.P50Ms<span class="text-secondary">ms</span></td>
                                                    <td class="text-end font-monospace fw-semibold">@a.P95Ms<span class="text-secondary">ms</span></td>
                                                    <td class="text-end font-monospace">@a.P99Ms<span class="text-secondary">ms</span></td>
                                                    <td class="text-end font-monospace @(a.Errors > 0 ? "text-warning" : "")">@a.Errors</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }

                    <div class="row g-3 mt-1">
                        <div class="col-12">
                            <div class="loadsim-chart-wrap loadsim-chart-wrap--tall">
                                <div class="loadsim-chart-title">
                                    Process memory
                                    @if (State._state.Process is { } proc)
                                    {
                                        <span class="ms-2" style="font-weight:400; opacity:0.85;">
                                            WS <strong>@proc.WorkingSetMb</strong> MB · GC <strong>@proc.GcHeapMb</strong> MB · threads @proc.ThreadCount
                                        </span>
                                    }
                                </div>
                                <canvas id="chartProcessMemory"></canvas>
                            </div>
                        </div>
                    </div>
        
</Admin_CollapsibleCard>
