@* Page-local to Home — full-studio project card (picker, manage, process strip) *@
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject IAppLocalizer L
@using PageToMovie.Core.Models
@using Microsoft.AspNetCore.Components

<div class="card mb-3 home-studio-card" data-testid="home-studio-card">
    <div class="card-body py-3">
        @{
            var activeMeta = Host.Projects._projects.Projects.FirstOrDefault(p =>
                string.Equals(p.Id, Host.Projects._projects.Active?.Id, StringComparison.OrdinalIgnoreCase));
            var hasActive = ActiveProject.HasProject || !string.IsNullOrWhiteSpace(Host.Projects._projects.Active?.Id);
        }
        @if (hasActive)
        {
            @* Single studio bar: Project · name · visibility · New · Manage · [Setup if keys missing] *@
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2 home-active-toolbar">
                <span class="home-project-label text-muted small text-uppercase flex-shrink-0">Project</span>
                <select class="form-select form-select-sm home-project-select flex-grow-1"
                        style="min-width: 10rem; max-width: 22rem;"
                        data-testid="home-project-picker"
                        value="@(Host.Projects._projects.Active?.Id ?? ActiveProject.ProjectId)"
                        disabled="@Host._busy"
                        title="Project"
                        aria-label="Project"
                        @onchange="Host.Projects.OnPickerChangedAsync">
                    @foreach (var p in Host.Projects._projects.Projects)
                    {
                        <option @key="p.Id" value="@p.Id">@(p.Label ?? p.Title ?? p.Id)</option>
                    }
                </select>
                @if (activeMeta is not null)
                {
                    <span class="badge @Home.HomeProjects.VisibilityBadgeClass(activeMeta.VisibilityMode) small fw-normal flex-shrink-0"
                          title="Visibility">
                        @Home.HomeProjects.VisibilityBadgeText(activeMeta.VisibilityMode)
                    </span>
                }
                <button type="button"
                        class="btn btn-outline-primary btn-sm flex-shrink-0"
                        data-testid="home-new-project"
                        disabled="@Host._busy"
                        @onclick="Host.Projects.OpenNewProjectAsync"
                        title="New project">
                    + New
                </button>
                <button type="button"
                        class="btn btn-outline-secondary btn-sm flex-shrink-0"
                        data-testid="home-import-project"
                        disabled="@(Host._busy || Host.Import._importing)"
                        @onclick="Host.Import.ToggleImport"
                        title="Import a project zip">
                    Import
                </button>
                <button type="button"
                        class="btn btn-outline-secondary btn-sm flex-shrink-0"
                        data-testid="home-manage-projects"
                        aria-expanded="@(Host.Projects._manageExpanded ? "true" : "false")"
                        @onclick="Host.Projects.ToggleManageAsync">
                    Manage @(Host.Projects._manageExpanded ? "▴" : "▾")
                </button>
                @if (Host.Projects.NeedsApiSetup)
                {
                    <a href="configuration"
                       class="btn btn-warning btn-sm flex-shrink-0"
                       data-testid="home-setup-config"
                       title="Connect your AI API keys">
                        Setup keys
                    </a>
                }
            </div>

            @if (Host.Projects._manageExpanded && hasActive)
            {
                <div class="home-manage-panel mb-3 p-2 rounded border border-secondary border-opacity-25"
                     data-testid="home-manage-panel">
                    @{
                        var id = Host.Projects._projects.Active?.Id ?? ActiveProject.ProjectId ?? "";
                        var p = activeMeta ?? Host.Projects._projects.Projects.FirstOrDefault(x =>
                            string.Equals(x.Id, id, StringComparison.OrdinalIgnoreCase));
                        var canManage = Host.Projects.CanManageProject(p);
                    }
                    @if (p is not null)
                    {
                        <div class="home-manage-section">
                            <div class="home-manage-section__title">Project</div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                @if (!string.IsNullOrWhiteSpace(p.ParentProjectId) && canManage)
                                {
                                    <a class="btn btn-sm btn-outline-warning"
                                       href="projects/@id/review-contribution?originProjectId=@p.ParentProjectId">
                                        Diff
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@Host._busy"
                                            @onclick="() => Host.Projects.SyncOriginAsync(id, p.ParentProjectId!)">
                                        Sync origin
                                    </button>
                                }
                                @if (canManage)
                                {
                                    <select class="form-select form-select-sm w-auto"
                                            value="@p.VisibilityMode"
                                            disabled="@Host._busy"
                                            @onchange="(e) => Host.Projects.ChangeVisibilityAsync(id, e.Value?.ToString())">
                                        <option value="Private">Private</option>
                                        <option value="Public">Public (Read-Only)</option>
                                        <option value="Open">Public (Forkable)</option>
                                    </select>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@Host._busy"
                                            @onclick="Host.Projects.BeginRenameAsync">
                                        Rename
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            disabled="@(Host._busy || Host.Import._backingUp)"
                                            data-testid="home-backup-project"
                                            title="Download a full backup zip (project files + all media)"
                                            @onclick="Host.Import.BackupProjectAsync">
                                        @(Host.Import._backingUp ? "Backing up…" : "Download backup")
                                    </button>
                                    @if (Host.Import._backingUp)
                                    {
                                        <div class="w-100 mt-2" data-testid="home-backup-progress" style="min-width: 12rem; max-width: 24rem;">
                                            <div class="d-flex justify-content-between small text-muted mb-1">
                                                <span class="text-truncate pe-2">@(Host.Import._backupPhaseLabel ?? "Backing up…")</span>
                                                @if (Host.Import._backupPercent is { } backupPct)
                                                {
                                                    <span class="flex-shrink-0">@($"{backupPct:0}%")</span>
                                                }
                                            </div>
                                            <div class="progress" style="height: 0.5rem;" role="progressbar"
                                                 aria-valuemin="0" aria-valuemax="100"
                                                 aria-valuenow="@(Host.Import._backupPercent is { } v ? (int)v : 0)"
                                                 aria-label="Backup progress">
                                                @if (Host.Import._backupIndeterminate || Host.Import._backupPercent is null)
                                                {
                                                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                                                         style="width: 100%"></div>
                                                }
                                                else
                                                {
                                                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                                                         style="width: @(Math.Clamp(Host.Import._backupPercent.Value, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@Host._busy"
                                            @onclick="() => Host.Projects.OpenCollaboratorsModal(id)">
                                        Collaborate
                                    </button>
                                }
                                <button type="button" class="btn btn-sm btn-outline-danger ms-auto" disabled="@Host._busy"
                                        @onclick="() => Host.Projects.BeginDeleteAsync(id, p.Label ?? p.Title ?? id)">
                                    Delete
                                </button>
                            </div>
                        </div>

                        @if (canManage)
                        {
                            <div class="home-manage-section" data-testid="home-package-history">
                                <div class="home-manage-section__title">Package backup</div>
                                <p class="small text-muted mb-2 mb-md-1">
                                    Git snapshot of the project package (script, plan, config). Not the same as clip versions on Film.
                                </p>
                                <div class="d-flex flex-wrap align-items-center gap-2 small">
                                    @if (Host.Jobs._packageStatusLoading && Host.Jobs._packageStatus is null)
                                    {
                                        <span class="text-muted">Checking package status…</span>
                                    }
                                    else if (Host.Jobs._packageStatus is { GitAvailable: true })
                                    {
                                        <span>
                                            <span class="text-muted">Last package save</span>
                                            @if (!string.IsNullOrWhiteSpace(Host.Jobs._packageStatus.LastCommitHash))
                                            {
                                                <strong class="ms-1 font-monospace" data-testid="home-last-saved-hash">@Home.ShortHash(Host.Jobs._packageStatus.LastCommitHash)</strong>
                                            }
                                            else
                                            {
                                                <span class="ms-1 text-muted">—</span>
                                            }
                                            @if (Host.Jobs._packageStatus.LastCommitAtUtc is DateTime when)
                                            {
                                                <span class="text-muted ms-1" title="@when.ToString("u")">@Home.FormatRelativeUtc(when)</span>
                                            }
                                        </span>
                                        @if (Host.Jobs._packageStatus.HasUncommittedChanges)
                                        {
                                            <span class="badge text-bg-warning text-dark fw-normal" data-testid="home-package-dirty">
                                                Unsaved package changes
                                            </span>
                                        }
                                        @if (Host.Jobs.CanSavePackageRevision)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    data-testid="home-package-save-revision"
                                                    disabled="@Host._busy"
                                                    title="Commit the text package and push to remote backup when configured"
                                                    @onclick="() => Host.Projects.SaveRevisionAsync(Host.Jobs.ActivePackageProjectId)">
                                                Save package revision
                                            </button>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(Host.Jobs.PackageHistoryUrl)
                                             || (Host.Projects._historyUrls.TryGetValue(id, out var histUrl) && !string.IsNullOrWhiteSpace(histUrl)))
                                        {
                                            var openUrl = !string.IsNullOrWhiteSpace(Host.Jobs.PackageHistoryUrl)
                                                ? Host.Jobs.PackageHistoryUrl!
                                                : Host.Projects._historyUrls[id];
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    data-testid="home-package-history-link"
                                                    disabled="@Host._busy"
                                                    @onclick="() => Host.Projects.OpenHistoryAsync(openUrl)">
                                                Open remote history
                                            </button>
                                        }
                                    }
                                    else if (Host.Jobs._packageStatus is not null && !string.IsNullOrWhiteSpace(Host.Jobs._packageStatus.SkipReason))
                                    {
                                        <span class="text-muted" title="@Host.Jobs._packageStatus.SkipReason">Package backup off on this host</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Package backup unavailable.</span>
                                    }
                                </div>
                            </div>

                            <div class="home-manage-section" data-testid="home-checkpoints-section">
                                <div class="home-manage-section__title">Named checkpoints</div>
                                <Home_CheckpointsPanel />
                            </div>
                        }
                    }
                    else
                    {
                        <p class="small text-muted mb-0">No project details to manage.</p>
                    }
                </div>
            }

            @if (Host.Projects._showRename && hasActive)
            {
                <div class="border border-secondary border-opacity-50 rounded p-3 mt-2 bg-dark bg-opacity-75 text-white shadow-sm">
                    <div class="fw-semibold small text-light mb-2">Rename project</div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <input class="form-control form-control-sm flex-grow-1 bg-white text-dark border-secondary fw-medium"
                               style="min-width: 10rem; color: #111111 !important; background-color: #ffffff !important;"
                               data-testid="home-rename-project-name"
                               value="@Host.Projects._renameName"
                               @oninput="Host.Projects.OnRenameNameInput"
                               disabled="@Host._busy"
                               maxlength="80"
                               placeholder="New display name"
                               aria-label="Rename project" />
                        <button class="btn btn-success btn-sm"
                                data-testid="home-rename-project-save"
                                disabled="@(Host._busy || string.IsNullOrWhiteSpace(Host.Projects._renameName))"
                                @onclick="Host.Projects.ConfirmRenameAsync">
                            Save name
                        </button>
                        <button class="btn btn-outline-secondary btn-sm text-light border-secondary"
                                disabled="@Host._busy"
                                @onclick="Host.Projects.CancelRename">
                            Cancel
                        </button>
                    </div>
                    <div class="form-text text-muted mt-1">Changes the display name only — project id stays the same.</div>
                </div>
            }

            @if (Host.Projects._deleteId is not null)
            {
                <div class="border border-danger border-opacity-50 rounded p-3 mt-2 bg-dark bg-opacity-75 text-white shadow-sm">
                    <p class="small mb-2 text-white">
                        Delete <strong>@Host.Projects._deleteLabel</strong>? This removes the project folder and all its files.
                    </p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-danger btn-sm" disabled="@Host._busy" @onclick="Host.Projects.ConfirmDeleteAsync">Delete project</button>
                        <button class="btn btn-outline-secondary btn-sm" disabled="@Host._busy" @onclick="Host.Projects.CancelDelete">Cancel</button>
                    </div>
                </div>
            }

            <StudioProcessStrip Active="@Host.HomeActiveStep" FullStudio="true" />
        }
        else
        {
            @* Empty studio: brand + pick/create only. *@
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <div class="d-flex align-items-center gap-2 min-w-0">
                    <img src="/favicon.png" alt="" width="36" height="36" class="rounded-2 shadow-sm flex-shrink-0" />
                    <div class="min-w-0">
                        <div class="small text-muted">Full studio</div>
                        <h1 class="home-top__title mb-0">Choose a film</h1>
                        <div class="home-top__sub">Import a book, estimate, film</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm"
                            data-testid="home-import-project"
                            disabled="@(Host._busy || Host.Import._importing)"
                            @onclick="Host.Import.ToggleImport">
                        Import
                    </button>
                    <button class="btn btn-primary btn-sm"
                            data-testid="home-new-project"
                            disabled="@Host._busy"
                            @onclick="Host.Projects.OpenNewProjectAsync">
                        + New project
                    </button>
                </div>
            </div>

            @if (ActiveProject.Status is { XaiConfigured: false })
            {
                <StudioProcessStrip Active="setup" FullStudio="true" />
            }

            @if (Host.Projects._projects.Projects.Count == 0 && !Host.Projects._showNew)
            {
                <p class="small text-muted mb-0">No projects yet — create one to start Book → Estimate → Film.</p>
            }
            else if (Host.Projects._projects.Projects.Count > 0)
            {
                <div class="list-group project-list">
                    @foreach (var p in Host.Projects._projects.Projects)
                    {
                        var id = p.Id ?? "";
                        <button type="button"
                                class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-2"
                                data-testid="@($"home-project-{id}")"
                                disabled="@Host._busy"
                                @onclick="() => Host.Projects.OpenProjectAsync(id)">
                            <span class="text-truncate fw-semibold">@(p.Label ?? p.Title ?? id)</span>
                            <span class="badge @Home.HomeProjects.VisibilityBadgeClass(p.VisibilityMode) small fw-normal flex-shrink-0">
                                @Home.HomeProjects.VisibilityBadgeText(p.VisibilityMode)
                            </span>
                        </button>
                    }
                </div>
            }
        }

        @if (Host.Projects._showNew)
        {
            @* Modal next to the action — not buried under manage list / process strip. *@
            <div class="modal-backdrop fade show" style="z-index: 1050;" @onclick="Host.Projects.ToggleNewProjectAsync"></div>
            <div class="modal fade show d-block"
                 tabindex="-1"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="home-new-project-title"
                 style="z-index: 1055;"
                 data-testid="home-new-project-modal">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content bg-dark text-white border-secondary shadow">
                        <div class="modal-header border-secondary py-2">
                            <h5 class="modal-title fs-6 mb-0" id="home-new-project-title">Create new project</h5>
                            <button type="button"
                                    class="btn-close btn-close-white"
                                    disabled="@Host._busy"
                                    aria-label="Cancel"
                                    @onclick="Host.Projects.ToggleNewProjectAsync"></button>
                        </div>
                        <div class="modal-body">
                            @if (ActiveProject.Status is not null && !ActiveProject.Status.XaiConfigured)
                            {
                                <div class="alert alert-warning py-1 px-2 small mb-2">
                                    No AI provider connected yet — finish <strong>Setup</strong> (step 0) first.
                                    <a href="configuration" class="alert-link">Open Setup →</a>
                                </div>
                            }
                            <label class="form-label small text-muted mb-1" for="home-new-project-name">Project name</label>
                            <input @ref="NameInputRef"
                                   id="home-new-project-name"
                                   class="form-control form-control-sm bg-white text-dark border-secondary fw-medium"
                                   style="color: #111111 !important; background-color: #ffffff !important; caret-color: #000000 !important;"
                                   data-testid="home-new-project-name"
                                   value="@Host.Projects._newName"
                                   @oninput="Host.Projects.OnNewNameInput"
                                   @onkeydown="Host.Projects.OnNewNameKeyDown"
                                   disabled="@Host._busy"
                                   placeholder="Enter project name…"
                                   maxlength="80"
                                   autofocus
                                   aria-label="New project name" />
                        </div>
                        <div class="modal-footer border-secondary py-2">
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    disabled="@Host._busy"
                                    @onclick="Host.Projects.ToggleNewProjectAsync">
                                Cancel
                            </button>
                            <button type="button"
                                    class="btn btn-success btn-sm"
                                    data-testid="home-create-project"
                                    disabled="@(Host._busy || string.IsNullOrWhiteSpace(Host.Projects._newName))"
                                    @onclick="Host.Projects.CreateProjectAsync">
                                Create
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Host.Import._showImport)
        {
            <Home_ImportPanel />
        }
    </div>
</div>
