@inherits PageToMovie.Web.Components.PageSliceComponent
@* Page-local to Home — demo films showcase card. Heading is the /demo link. *@
@inject IAppLocalizer L
@using PageToMovie.Core.Util
@using Microsoft.AspNetCore.Components

<div class="card home-showcase-card mb-2" data-testid="home-demo-films-card">
    <div class="card-body py-2 px-3">
        <a href="/demo"
           class="home-showcase-heading small fw-semibold text-secondary text-uppercase text-decoration-none"
           data-testid="home-demo-films-heading">
            @L["Home.DemoFilms"]<span class="home-showcase-heading__arrow" aria-hidden="true"> →</span>
        </a>
        @if (Host.Costs._publicDemos.Count > 0)
        {
            <div class="home-showcase-thumbs" aria-label="Recent demo films">
                @foreach (var d in Host.Costs._publicDemos.Take(4))
                {
                    var yt = YouTubeVideoId.Extract(d.YoutubeId) ?? YouTubeVideoId.Extract(d.YoutubeUrl);
                    var href = DemoHref(yt, d);
                    var thumb = yt is not null
                        ? YouTubeVideoId.ThumbnailUrl(yt, "mqdefault")
                        : null;
                    <a class="home-showcase-thumb"
                       href="@href"
                       target="@(yt is not null || href.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? "_blank" : null)"
                       rel="@(yt is not null || href.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? "noopener noreferrer" : null)"
                       title="@d.Title">
                        @if (thumb is not null)
                        {
                            <img src="@thumb" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span class="home-showcase-thumb__ph" aria-hidden="true">▶</span>
                        }
                        <span class="home-showcase-thumb__label">@d.Title</span>
                    </a>
                }
            </div>
        }
    </div>
</div>
