@page "/simple-voice"
@using PageToMovie.Core.Models
@inject EngineApiClient Engine
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject ClientMediaFolderService MediaFolder
@inject ClientVoiceSubstitutionService VoiceSub
@inject NavigationManager Nav
@inject IJSRuntime Js
@using PageToMovie.Web.Services
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Read in your voice · PageToMovie</PageTitle>

@if (CatalogPending)
{
    <p class="small text-muted" data-testid="simple-voice-loading">Loading stories…</p>
}
else if (NothingReady)
{
    <StudioPageHeader Kicker="" Title="Nothing ready yet">
        No library books are ready.
    </StudioPageHeader>
    <p class="small text-muted mb-3" data-testid="simple-voice-nothing-ready">Nothing ready yet.</p>
    <a class="btn btn-link btn-sm px-0" href="/" data-testid="simple-voice-home">Home</a>
}
else
{
<StudioPageHeader Kicker="Easiest start" Title="Two steps · story and your voice">
    Pick a library book, record one sample, then make the movie.
    Pictures stay — you re-speak whichever character you pick.
</StudioPageHeader>

@if (!Session.IsLoggedIn)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span>Sign in to open a library book and save your voice sample.</span>
        <a class="btn btn-sm btn-primary" href="login?returnUrl=/simple-voice">Sign in</a>
    </div>
}

<StudioProcessStrip Active="@StripActive" SimpleMode="true" OnBack="OnStripBack" OnBackToStory="BackToPick" />

<InlineAlert Message="@_error" data-testid="simple-voice-error" />
@if (string.IsNullOrEmpty(_error))
{
    <InlineAlert Message="@_message" Variant="success" CssClass="py-2" data-testid="simple-voice-message" />
}

@* PickPhase takes StoriesLoading as a changing parameter so the spinner/error/list
   re-renders when the flag flips (IsFixed cascade would not notify on Host fields). *@
<CascadingValue Value="this" IsFixed="true">
    @if (_phase == Phase.Pick)
    {
        <SimpleVoicePickPhase StoriesLoading="_storiesLoading" Busy="_busy" />
    }
    else if (!Session.IsLoggedIn)
    {
        @* Record/movie need a session; bounce to pick + sign-in. *@
        <SimpleVoicePickPhase StoriesLoading="_storiesLoading" Busy="_busy" />
    }
    else if (_phase is Phase.Record or Phase.Done)
    {
        <SimpleVoiceRecordPhase />
    }
    else if (_phase == Phase.Movie)
    {
        <SimpleVoiceMoviePhase />
    }
</CascadingValue>
}
