@page "/simple-voice"
@using PageToMovie.Core.Models
@inject EngineApiClient Engine
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject ClientMediaFolderService MediaFolder
@inject ClientVoiceSubstitutionService VoiceSub
@inject NavigationManager Nav
@inject IJSRuntime Js
@using PageToMovie.Web.Services
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Read in your voice · PageToMovie</PageTitle>

<StudioPageHeader Kicker="Easiest start" Title="Two steps · story and your voice">
    Pick a library book, record one sample, then make the movie.
    Stock pictures stay as-is — we only re-speak the narrator as you.
</StudioPageHeader>

@if (!Session.IsLoggedIn)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span>Sign in to open a library book and save your voice sample.</span>
        <a class="btn btn-sm btn-primary" href="login?returnUrl=/simple-voice">Sign in</a>
    </div>
}
else
{
    <StudioProcessStrip Active="@(_phase == Phase.Movie ? "film" : _phase is Phase.Record or Phase.Done ? "cast" : "book")" SimpleMode="true" />

    <InlineAlert Message="@_error" data-testid="simple-voice-error" />
    @if (string.IsNullOrEmpty(_error))
    {
        <InlineAlert Message="@_message" Variant="success" CssClass="py-2" data-testid="simple-voice-message" />
    }

    @* ── Step 1: choose story ─────────────────────────────────────────── *@
    @if (_phase == Phase.Pick)
    {
        <div class="card border-primary border-opacity-50 mb-3" data-testid="simple-voice-pick">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge text-bg-primary">Step 1 of 2</span>
                    <span class="badge text-bg-secondary">Voice-only · low cost</span>
                </div>
                <h2 class="h5 mb-2">Choose a story</h2>
                <p class="small text-muted mb-3">
                    Pick a film — we make your own copy, then you record one sample and we put your voice on the narrator.
                </p>
                @if (_storiesLoading)
                {
                    <p class="small text-muted">Loading stories…</p>
                }
                else if (_forkableStories.Count == 0)
                {
                    <div class="alert alert-light border small mb-3">
                        No shareable stories yet. Mark a film “Public (Forkable)” in the full studio to see it here.
                    </div>
                }
                else
                {
                    <div class="list-group mb-3">
                        @foreach (var story in _forkableStories)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action"
                                    disabled="@_busy"
                                    data-testid="@($"simple-voice-story-{story.Id}")"
                                    @onclick="() => SelectStoryAsync(story)">
                                <div class="d-flex justify-content-between gap-2 align-items-center">
                                    <div class="fw-semibold text-start">@story.Title</div>
                                    <span class="small text-muted flex-shrink-0">Read in my voice →</span>
                                </div>
                            </button>
                        }
                    </div>
                }
                <a class="btn btn-link btn-sm px-0" href="/" data-testid="simple-voice-home">
                    Full studio instead
                </a>
            </div>
        </div>
    }

    @* ── Step 2: record narrator (no character list) ──────────────────── *@
    else if (_phase is Phase.Record or Phase.Done)
    {
        <div class="card border-primary border-opacity-50 mb-3" data-testid="simple-voice-record">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="badge text-bg-primary me-2">Step 2 of 3</span>
                    <span class="fw-semibold">Record your voice</span>
                    @if (!string.IsNullOrEmpty(_projectLabel))
                    {
                        <span class="text-muted small ms-2">· @_projectLabel</span>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="BackToPick">
                    ← Change story
                </button>
            </div>
            <div class="card-body">
                @if (_needsCharacterPick)
                {
                    <div data-testid="simple-voice-character-pick">
                        <p class="small text-muted mb-2">
                            This story doesn’t have a clear narrator — who do you want to voice?
                        </p>
                        <div class="list-group mb-2">
                            @foreach (var c in _narratorCandidates)
                            {
                                <button type="button"
                                        class="list-group-item list-group-item-action"
                                        disabled="@_busy"
                                        data-testid="@($"simple-voice-character-{c.Key}")"
                                        @onclick="() => PickCharacterAsync(c)">
                                    <div class="d-flex justify-content-between gap-2 align-items-center">
                                        <div class="fw-semibold text-start">@c.DisplayName</div>
                                        <span class="small text-muted flex-shrink-0">Voice this character →</span>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                }
                else if (!_voiceReady)
                {
                    @* The good "read along in your voice" recorder, shared with anywhere else that needs it. *@
                    <VoiceCaptureStep ProjectId="@_projectId" CharKey="@_narratorKey" OnComplete="OnVoiceReadyAsync" />
                }
                else
                {
                    <div class="d-flex flex-wrap align-items-center gap-2" data-testid="simple-voice-finish">
                        <div class="flex-grow-1">
                            <div class="fw-semibold">You’re set</div>
                            <div class="small text-muted">
                                We keep the pictures and put your voice on every line — no video regen.
                            </div>
                        </div>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-testid="simple-voice-rerecord"
                                disabled="@_busy"
                                @onclick="BeginReRecord">
                            🎙️ Re-record
                        </button>
                        <button type="button"
                                class="btn btn-primary btn-lg"
                                data-testid="simple-voice-make-movie"
                                disabled="@_busy"
                                @onclick="MakeMovieAsync">
                            Make my movie →
                        </button>
                    </div>
                }
            </div>
        </div>

        <p class="small text-muted mb-0">
            Want faces of family in the frame later?
            <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="SwitchToFullStudioAsync">
                Switch to full studio
            </button>
        </p>
    }

    @* ── Step 3: your movie ───────────────────────────────────────────── *@
    else if (_phase == Phase.Movie)
    {
        <div class="card border-primary border-opacity-50 mb-3" data-testid="simple-voice-movie">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="badge text-bg-primary me-2">Step 3</span>
                    <span class="fw-semibold">Your movie</span>
                    @if (!string.IsNullOrEmpty(_projectLabel))
                    {
                        <span class="text-muted small ms-2">· @_projectLabel</span>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        disabled="@_dubbing"
                        data-testid="simple-voice-movie-back"
                        @onclick="@(() => { _phase = Phase.Done; _dubbedUrl = null; _error = null; })">
                    ← Back to my voice
                </button>
            </div>
            <div class="card-body">
                @if (_dubbedUrl is not null)
                {
                    <div data-testid="simple-voice-result">
                        <div class="fw-semibold mb-1">Your movie, in your voice 🎉</div>
                        @if (!string.IsNullOrEmpty(_dubSummary))
                        {
                            <div class="small text-muted mb-2" data-testid="simple-voice-dub-summary">@_dubSummary</div>
                        }
                        <video class="w-100 rounded" style="max-height: 60vh; background:#000;"
                               src="@_dubbedUrl" controls autoplay playsinline
                               data-testid="simple-voice-player"></video>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button type="button" class="btn btn-primary"
                                    data-testid="simple-voice-download"
                                    @onclick="DownloadDubbedAsync">
                                Download
                            </button>
                            <button type="button" class="btn btn-outline-secondary"
                                    disabled="@_dubbing"
                                    data-testid="simple-voice-remake"
                                    @onclick="MakeMovieAsync">
                                Make again
                            </button>
                        </div>
                    </div>
                }
                else if (_dubbing)
                {
                    <div data-testid="simple-voice-progress">
                        <div class="fw-semibold mb-2">Making your movie…</div>
                        <div class="progress" role="progressbar" aria-label="Making your movie">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                 style="width: 100%"></div>
                        </div>
                        <div class="small text-muted mt-1">@(_dubStatus ?? "Working…")</div>
                    </div>
                }
                else
                {
                    <InlineAlert Variant="danger" CssClass="py-2 small mb-2"
                                 Message="@(_error ?? "Something went wrong making your movie.")"
                                 data-testid="simple-voice-movie-error" />
                    <BusyButton Label="Try again" Busy="_busy" CssClass="btn btn-primary" OnClick="MakeMovieAsync" />
                }
            </div>
        </div>
    }
}

@code {
    private enum Phase { Pick, Record, Done, Movie }

    private Phase _phase = Phase.Pick;
    private List<ForkableStoryDto> _forkableStories = new();
    private bool _storiesLoading = true;
    private bool _voiceReady; // narrator has a cloned voice (freshly captured or already applied) → show "make movie"
    private bool _dubbing;
    private string? _dubStatus;
    private string? _dubbedUrl;
    private string? _dubSummary;
    private string? _projectId;
    private string? _projectLabel;
    private string _narratorKey = "Character_Narrator";
    /// <summary>True when the story has no character confidently identified as the narrator — the
    /// user must pick which speaking character to voice instead of us silently guessing one.</summary>
    private bool _needsCharacterPick;
    private List<CharacterSummary> _narratorCandidates = new();
    private bool _busy;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _storiesLoading = true;
        try { _forkableStories = await Engine.ListForkableProjectsAsync(); }
        catch { /* empty list shown */ }
        finally { _storiesLoading = false; }

        // Resume mid-flow if active project is already on simple path.
        if (Session.IsLoggedIn
            && ActiveProject.IsSimpleVoice
            && !string.IsNullOrEmpty(ActiveProject.ProjectId))
        {
            _projectId = ActiveProject.ProjectId;
            _projectLabel = ActiveProject.Label;
            _phase = Phase.Record;
            await EnsureVoiceModelAsync();
            await ResolveNarratorKeyAsync();
            if (!_needsCharacterPick)
                await RefreshSampleStateAsync();
        }
    }

    private async Task SelectStoryAsync(ForkableStoryDto story)
    {
        if (!Session.IsLoggedIn)
        {
            Nav.NavigateTo("login?returnUrl=/simple-voice");
            return;
        }
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            // Make the user's own copy of the film (fork), then set up the voice step on it.
            var fork = await Engine.ForkProjectAsync(story.Id);
            var forkId = fork?.Id;
            if (string.IsNullOrEmpty(forkId))
                throw new InvalidOperationException("Could not open that story.");

            try { await Engine.SetStudioPathAsync(forkId, ProjectStudioPaths.SimpleVoice); }
            catch { /* older API */ }
            await ActiveProject.SelectAsync(Engine, forkId, fork?.Title ?? story.Title, studioPath: ProjectStudioPaths.SimpleVoice);

            _projectId = forkId;
            _projectLabel = fork?.Title ?? story.Title;
            _voiceReady = false;
            _dubbedUrl = null;
            _phase = Phase.Record;
            await EnsureVoiceModelAsync();
            await ResolveNarratorKeyAsync();
            if (!_needsCharacterPick)
                await RefreshSampleStateAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void BackToPick()
    {
        _phase = Phase.Pick;
        _voiceReady = false;
        _error = null;
        _message = null;
    }

    private async Task ResolveNarratorKeyAsync()
    {
        _narratorKey = "Character_Narrator";
        _needsCharacterPick = false;
        _narratorCandidates = new();
        if (string.IsNullOrEmpty(_projectId)) return;
        try
        {
            var dto = await Engine.GetCharactersAsync(_projectId);
            var list = dto?.Characters ?? new();
            if (list.Count == 0) return;

            var confident = list.FirstOrDefault(c =>
                                (c.Key?.Contains("narrator", StringComparison.OrdinalIgnoreCase) ?? false)
                                || (c.DisplayName?.Contains("narrator", StringComparison.OrdinalIgnoreCase) ?? false))
                            ?? list.FirstOrDefault(c => c.VoiceOnly);
            if (!string.IsNullOrEmpty(confident?.Key))
            {
                _narratorKey = confident!.Key;
                return;
            }

            // No character reads as "the narrator" — don't silently guess the first character in the
            // list (that could be anyone). Let the user pick who they want to voice instead.
            //
            // Deliberately NOT filtered to c.Speaks: that flag means "has a quoted-dialogue cue in
            // the screenplay", but pure third-person narration (e.g. a picture book with no spoken
            // lines at all) has no such character — filtering on it left every character excluded,
            // which silently fell through to the same list[0] guess this branch exists to avoid.
            _narratorCandidates = list;
            _needsCharacterPick = true;
        }
        catch
        {
            // Seed will be created on upload if cast not built yet.
        }
    }

    /// <summary>User picked who to voice when no narrator could be confidently identified.</summary>
    private async Task PickCharacterAsync(CharacterSummary c)
    {
        if (string.IsNullOrEmpty(c.Key)) return;
        _narratorKey = c.Key;
        _needsCharacterPick = false;
        _error = null;
        await EnsureVoiceModelAsync();
        await RefreshSampleStateAsync();
        StateHasChanged();
    }

    private async Task EnsureVoiceModelAsync()
    {
        if (string.IsNullOrEmpty(_projectId)) return;
        try
        {
            var cfgDto = await Engine.GetConfigAsync(_projectId);
            var map = cfgDto?.Config;
            string voice = "none";
            if (map is not null && map.TryGetValue("voice_model_name", out var el)
                && el.ValueKind == System.Text.Json.JsonValueKind.String)
                voice = el.GetString() ?? "none";
            if (!string.IsNullOrWhiteSpace(voice)
                && !voice.Equals("none", StringComparison.OrdinalIgnoreCase)
                && !voice.Equals("disabled", StringComparison.OrdinalIgnoreCase))
                return;
            var defaultClone = SupportedModelCatalog.FirstEnabledVoiceCloneModelId();
            if (string.IsNullOrWhiteSpace(defaultClone))
                return;
            await Engine.SaveConfigAsync(_projectId, new Dictionary<string, object?>
            {
                ["voice_model_name"] = defaultClone,
            });
        }
        catch { /* non-fatal */ }
    }

    private async Task RefreshSampleStateAsync()
    {
        _voiceReady = false;
        if (string.IsNullOrEmpty(_projectId)) return;
        try
        {
            var dto = await Engine.GetCharactersAsync(_projectId);
            var c = dto?.Characters?.FirstOrDefault(x =>
                string.Equals(x.Key, _narratorKey, StringComparison.OrdinalIgnoreCase));
            // Already-cloned narrator (a provider voice id exists) → skip capture, go to "make movie".
            if (c is not null && !string.IsNullOrEmpty(c.VoiceProviderVoiceId))
            {
                _voiceReady = true;
                _phase = Phase.Done;
            }
        }
        catch { /* ignore */ }
    }

    // Fired by <VoiceCaptureStep> once the cloned voice is built + applied — advance to "make movie".
    private async Task OnVoiceReadyAsync()
    {
        _voiceReady = true;
        _phase = Phase.Done;
        _error = null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Not happy with the take? Drop back into the recorder for the same character — a
    /// fresh &lt;VoiceCaptureStep&gt; instance re-runs its own phrase prep and replaces the sample.</summary>
    private void BeginReRecord()
    {
        _voiceReady = false;
        _error = null;
        _message = null;
    }

    private async Task MakeMovieAsync()
    {
        if (string.IsNullOrEmpty(_projectId)) return;
        // Clips + synthesized audio live in the browser media folder — it must be connected.
        if (!MediaFolder.IsConnected)
        {
            var connected = await MediaFolder.ConnectFolderAsync();
            if (!connected && !MediaFolder.IsConnected)
            {
                _error = "Connect your media folder so we can build your movie.";
                return;
            }
        }
        _phase = Phase.Movie; // step 3
        _dubbing = true;
        _busy = true;
        _error = null;
        _message = null;
        _dubbedUrl = null;
        _dubStatus = "Starting…";
        try
        {
            var res = await VoiceSub.DubMovieInMyVoiceAsync(
                _projectId,
                charKey: _narratorKey,
                onProgress: s => { _dubStatus = s; _ = InvokeAsync(StateHasChanged); });
            _dubSummary = $"{res.ClipsDubbed} scene(s) in your voice"
                          + (res.ClipsFailed > 0 ? $" · {res.ClipsFailed} skipped" : "");
            if (res.Ok && !string.IsNullOrWhiteSpace(res.DownloadUrl))
                _dubbedUrl = res.DownloadUrl;
            else
                _error = res.Error ?? "Could not make your movie.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _dubbing = false;
            _busy = false;
            _dubStatus = null;
        }
    }

    private async Task DownloadDubbedAsync()
    {
        if (string.IsNullOrWhiteSpace(_dubbedUrl)) return;
        var name = string.IsNullOrWhiteSpace(_projectLabel) ? "movie" : _projectLabel;
        await VoiceSub.DownloadAsync(_dubbedUrl, $"{name}-in-my-voice.mp4");
    }

    private async Task SwitchToFullStudioAsync()
    {
        if (!string.IsNullOrEmpty(_projectId))
        {
            try
            {
                await Engine.SetStudioPathAsync(_projectId, ProjectStudioPaths.Full);
                ActiveProject.Set(ActiveProject.ProjectId, ActiveProject.Label, ActiveProject.ParentProjectId, ProjectStudioPaths.Full);
            }
            catch { /* ignore */ }
        }
        Nav.NavigateTo("characters");
    }

}
