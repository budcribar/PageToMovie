@* Shared header + job log for Adaptation step pages *@
@inject AdminSessionService Session
@inject ActiveProjectState ActiveProject
@inject IAppLocalizer L

@if (Host is null)
{
    return;
}

@{
    // One title: prefer the screenplay/film title, else the project name — never both.
    var pageTitle = ResolvePageTitle();
    // Screenplay owns its own compact 2-row chrome — skip the page header stack there.
    var compactScreenplay = Step == "screenplay";
}

@if (!compactScreenplay)
{
    <div class="ptm-adapt-header d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
        <div>
            <span class="ptm-adapt-kicker">@(Step == "shots" ? "Studio · Film" : "Studio · Book")</span>
            <h1 class="mb-0 ptm-adapt-title">@pageTitle</h1>
            @if (Step == "shots")
            {
                <p class="ptm-adapt-lede mb-0">@L["Adaptation.ShotPlanLede"]</p>
            }
            else if (Step is "import" or "book")
            {
                <p class="ptm-adapt-lede mb-0">@L["Adaptation.BookLede"]</p>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            @HeaderActions
            @if (!string.IsNullOrEmpty(ActiveProject.ParentProjectId))
            {
                <span class="badge text-bg-info px-2 py-1 fs-6" title="Forked from @ActiveProject.ParentProjectId">Fork of @ActiveProject.ParentProjectId</span>
            }
        </div>
    </div>
}

@* Shot plan uses the top-level Film strip. Book steps no longer show a Look/Enrich/Fit/Screenplay
   sub-nav — those tools live on the screenplay card. *@
@if (Step is "shots")
{
    <StudioProcessStrip Active="film" FullStudio="true" />
}

@if (!string.IsNullOrEmpty(Host.Error))
{
    <div class="alert alert-danger">@Host.Error</div>
}
@* Hide completion/status noise while Import or a job is still running, and don't restate the
   outcome when the job panel below is already showing this exact message (one fact, one place). *@
@if (!string.IsNullOrEmpty(Host.Message) && !Host.SuppressGuidanceBanners && !MessageDuplicatesJobPanel && !Host.Busy)
{
    <InlineAlert Variant="info" Message="@Host.Message" />
}

@* In-page busy (e.g. screenplay approve) — not a background job, but can take many seconds.
   Skip on Import: that page already has its own progress card. *@
@if (Host.Busy && !Host.Jobs.JobRunning && Step is not "import" and not "book")
{
    <JobProgressCard Visible="true"
                     Indeterminate="true"
                     Message="@(string.IsNullOrWhiteSpace(Host.BusyMessage) ? "Working…" : Host.BusyMessage)"
                     TestId="busy-progress" />
}

@* Jobs.Job panel: live progress + Cancel while running.
   Admin: keep a quiet completion card with log (no animated full bar). *@
@if (ShowJobPanel)
{
    var (_, jobTot, waiting, displayIdx) = AdaptationPageBase.AdaptationStepUi.ComputeJobProgress(
        Host.Jobs.Job, Host.Jobs.ProgressIndex, Host.Jobs.ProgressTotal, Host.Jobs.JobRunning);
    var runPct = Host.Jobs.JobRunning
        ? AdaptationPageBase.AdaptationStepUi.ComputeProgressPercent(
            displayIdx, jobTot, waiting, Host.Jobs.JobRunning, Host.Jobs.Job.StartedAt)
        : (int?)null;
    var jobMsg = Host.Jobs.JobRunning
        ? AdaptationPageBase.AdaptationJobs.OperatorJobRunningMessage(Host.Jobs.Job)
        : AdaptationPageBase.AdaptationStepUi.OperatorJobDoneMessage(Host.Jobs.Job);
    var longHint = AdaptationPageBase.AdaptationStepUi.LongAdaptHint(Host.Jobs.Job, Host.Jobs.JobRunning);
    <JobProgressCard Visible="true"
                     Status="@Host.Jobs.Job.Status"
                     Message="@jobMsg"
                     DetailMessage="@longHint"
                     Index="displayIdx"
                     Total="jobTot"
                     Percent="runPct"
                     StartedAt="Host.Jobs.Job.StartedAt"
                     ShowCancel="@Host.Jobs.JobRunning"
                     CancelDisabled="false"
                     OnCancel="Host.Jobs.CancelAsync"
                     Kind="@Host.Jobs.Job.Kind"
                     ShowLog="@(Session.IsAdmin && Host.Jobs.Job?.Log is { Count: > 0 })"
                     OpenLogByDefault="@(Session.IsAdmin && !Host.Jobs.JobRunning)"
                     LogLines="Host.Jobs.Job.Log"
                     LogMaxLines="40"
                     TestId="job-panel"
                     StatusTestId="job-status"
                     CancelTestId="job-cancel" />
}

@if (Host.Status is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    @* Skip “Next” when it only restates the step you’re already on. Never on screenplay —
       that page’s Approve button is the next action; a banner is just another chrome row. *@
    @if (ShowNextBanner && !compactScreenplay)
    {
        <div class="alert @AdaptationPageBase.AdaptationStepUi.NextStepAlertClass(Host.Status.NextStep) py-2">
            <strong>Next:</strong> @AdaptationPageBase.AdaptationStepUi.NextStepLabel(Host.Status.NextStep)
            @if (!Host.Status.XaiConfigured && Host.Status.NextStep is "draft_screenplay" or "run_stage1" or "run_stage2" or "replan_stage2")
            {
                <span class="ms-2">· <a href="configuration">Connect service</a></span>
            }
        </div>
    }

    @ChildContent
}
