@* Shared header + step strip + job log for Adaptation step pages *@
@inject AdminSessionService Session
@inject ActiveProjectState ActiveProject
@inject IAppLocalizer L

@if (Host is null)
{
    return;
}

<div class="ptm-adapt-header d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
    <div>
        <span class="ptm-adapt-kicker">@(Step == "shots" ? "Studio · Film" : "Studio · Book pipeline")</span>
        <h1 class="mb-0 ptm-adapt-title">@(Step == "shots" ? L["ScenesPage.RebuildShotPlan"] : L["Adaptation.BookAndScreenplay"])</h1>
        <p class="ptm-adapt-lede mb-0">
            @(Step == "shots"
                ? L["Adaptation.ShotPlanLede"]
                : L["Adaptation.BookLede"])
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (!string.IsNullOrEmpty(Host.ProjectLabel))
        {
            <span class="badge text-bg-secondary px-2 py-1 fs-6">@Host.ProjectLabel</span>
        }
        @if (!string.IsNullOrEmpty(ActiveProject.ParentProjectId))
        {
            <span class="badge text-bg-info px-2 py-1 fs-6" title="Forked from @ActiveProject.ParentProjectId">🍴 Fork of @ActiveProject.ParentProjectId</span>
        }
    </div>
</div>

@* ---- Book sub-steps: a light drill-down of the top-level "Book" step. Cast & Film live on the
     top-level strip, not here. Editing (Screenplay) is last so the automatic passes don't clobber it. ---- *@
@{
    var stepsLocked = Host.JobRunning;
    var importActive = Step == "import" || Step == "book";
    var lookActive = Step == "look";
    var embellishActive = Step == "embellish";
    var trimActive = Step == "trim";
    var screenplayActive = Step == "screenplay";
    var subOff = !OutlineEnabled || stepsLocked;

    // "Done" checks so you can tell at a glance which optional passes you've already run on the
    // current screenplay. Look/Enrich/Fit length come from recorded markers; Screenplay = approved.
    var subs = Host.Status?.BookSubsteps;
    var importDone = OutlineEnabled;
    var lookDone = subs?.LookDone == true;
    var enrichDone = subs?.EnrichDone == true;
    var trimDone = subs?.FitLengthDone == true;
    var trimMins = subs?.FitLengthTargetMinutes;
    var screenplayDone = Host.Status?.Screenplay is { Signed: true };
}
@* Shot plan belongs to the top-level "Film" step, not the Book drill-down — no Book sub-nav there. *@
@if (Step is not "shots")
{
<nav class="ptm-substrip" aria-label="Book sub-steps">
    <span class="ptm-substrip__lead">@L["Home.Book"]</span>
    <a class="ptm-substep @(importActive ? "is-active" : "") @(stepsLocked ? "is-disabled" : "")"
       href="@(stepsLocked ? "javascript:void(0)" : "adaptation/import")"
       @onclick:preventDefault="stepsLocked"
       title="Import a book, PDF, or screenplay"
       data-testid="adapt-step-import">@L["Adaptation.Import"] @if (importDone) { <span class="ptm-substep__done" title="Done" aria-label="done">✓</span> }</a>
    <a class="ptm-substep @(lookActive ? "is-active" : "") @(subOff ? "is-disabled" : "")"
       href="@(subOff ? "javascript:void(0)" : "adaptation/look")"
       @onclick:preventDefault="subOff"
       title="@(subOff ? "Import a source first" : lookDone ? "Choose the visual style (done — run again to change)" : "Choose the visual style")"
       data-testid="adapt-step-look">@L["Adaptation.Look"] @if (lookDone) { <span class="ptm-substep__done" title="Done" aria-label="done">✓</span> }</a>
    <a class="ptm-substep @(embellishActive ? "is-active" : "") @(subOff ? "is-disabled" : "")"
       href="@(subOff ? "javascript:void(0)" : "adaptation/embellish")"
       @onclick:preventDefault="subOff"
       title="@(subOff ? "Import a source first" : enrichDone ? "Enrich the scene description (done — run again to add more)" : "Enrich the scene description")"
       data-testid="adapt-step-embellish">@L["Adaptation.Enrich"] @if (enrichDone) { <span class="ptm-substep__done" title="Done" aria-label="done">✓</span> }</a>
    <a class="ptm-substep @(trimActive ? "is-active" : "") @(subOff ? "is-disabled" : "")"
       href="@(subOff ? "javascript:void(0)" : "adaptation/trim")"
       @onclick:preventDefault="subOff"
       title="@(subOff ? "Import a source first" : trimDone && trimMins is > 0 ? $"Fit the film to your length and budget (done — fit toward ~{Math.Round(trimMins.Value)} min)" : "Fit the film to your length and budget")"
       data-testid="adapt-step-trim">@L["Adaptation.FitLength"] @if (trimDone) { <span class="ptm-substep__done" title="Done" aria-label="done">✓@(trimMins is > 0 ? $" ~{Math.Round(trimMins.Value)}m" : "")</span> }</a>
    <a class="ptm-substep @(screenplayActive ? "is-active" : "") @(subOff ? "is-disabled" : "")"
       href="@(subOff ? "javascript:void(0)" : "adaptation/screenplay")"
       @onclick:preventDefault="subOff"
       title="@(subOff ? "Import a source first" : screenplayDone ? "Edit and approve the final screenplay (approved)" : "Edit and approve the final screenplay")"
       data-testid="adapt-step-screenplay">@L["Adaptation.Screenplay"] @if (screenplayDone) { <span class="ptm-substep__done" title="Approved" aria-label="approved">✓</span> }</a>
</nav>
}
else
{
    @* Shot plan is part of the top-level "Film" step — show the studio strip, like Cast does. *@
    <StudioProcessStrip Active="film" FullStudio="true" />
}

@if (!string.IsNullOrEmpty(Host.Error))
{
    <div class="alert alert-danger">@Host.Error</div>
}
@* Hide completion/status noise while Import or a job is still running, and don't restate the
   outcome when the job panel below is already showing this exact message (one fact, one place). *@
@if (!string.IsNullOrEmpty(Host.Message) && !Host.SuppressGuidanceBanners && !MessageDuplicatesJobPanel)
{
    <div class="alert alert-info">@Host.Message</div>
}

@* In-page busy (e.g. screenplay approve) — not a background job, but can take many seconds.
   Skip on Import: that page already has its own progress card. *@
@if (Host.Busy && !Host.JobRunning && Step is not "import" and not "book")
{
    <JobProgressCard Visible="true"
                     Indeterminate="true"
                     Message="@(string.IsNullOrWhiteSpace(Host.BusyMessage) ? "Working…" : Host.BusyMessage)"
                     TestId="busy-progress" />
}

@* Job panel: progress + Cancel only while running. Admin can expand Details. *@
@if (ShowJobPanel)
{
    var (jobIdx, jobTot, waiting, displayIdx) = AdaptationPageBase.ComputeJobProgress(
        Host.Job!, Host.ProgressIndex, Host.ProgressTotal, Host.JobRunning);
    var runPct = Host.JobRunning
        ? AdaptationPageBase.ComputeProgressPercent(
            displayIdx, jobTot, waiting, Host.JobRunning, Host.Job!.StartedAt)
        : (int?)null;
    var jobMsg = Host.JobRunning
        ? AdaptationPageBase.OperatorJobRunningMessage(Host.Job!)
        : AdaptationPageBase.OperatorJobDoneMessage(Host.Job!);
    <JobProgressCard Visible="true"
                     Status="@Host.Job!.Status"
                     Message="@jobMsg"
                     Index="displayIdx"
                     Total="jobTot"
                     Percent="runPct"
                     ShowCancel="Host.JobRunning"
                     OnCancel="Host.CancelAsync"
                     Kind="@Host.Job.Kind"
                     ShowLog="@(Session.IsAdmin && !Host.JobRunning)"
                     LogLines="Host.Job.Log"
                     LogMaxLines="40"
                     TestId="job-panel"
                     StatusTestId="job-status"
                     CancelTestId="job-cancel" />
}

@if (Host.Status is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    @* Skip “Next” when it only restates the step you’re already on *@
    @if (ShowNextBanner)
    {
        <div class="alert @AdaptationPageBase.NextStepAlertClass(Host.Status.NextStep) py-2">
            <strong>Next:</strong> @AdaptationPageBase.NextStepLabel(Host.Status.NextStep)
            @if (!Host.Status.XaiConfigured && Host.Status.NextStep is "draft_screenplay" or "run_stage1" or "run_stage2" or "replan_stage2")
            {
                <span class="ms-2">· <a href="configuration">Connect service</a></span>
            }
        </div>
    }

    @ChildContent
}

@code {
    [Parameter, EditorRequired] public AdaptationPageBase Host { get; set; } = null!;
    [Parameter, EditorRequired] public string Step { get; set; } = "book";
    [Parameter] public RenderFragment? ChildContent { get; set; }


    private bool OutlineEnabled => AdaptationPageBase.OutlineEnabled(Host.Status);

    private bool ShotsEnabled => AdaptationPageBase.ShotsEnabled(Host.Status);

    /// <summary>There was a prior sign-off, but the draft has since changed (vs. never approved at all).</summary>
    private bool NeedsReapprove =>
        Host.Status?.Screenplay is { } s
        && !s.ReadyForShots
        && !string.IsNullOrWhiteSpace(s.SignedHash);

    private bool ShowJobPanel => AdaptationPageBase.ShowJobPanel(Session.IsAdmin, Host.Job, Step);

    /// <summary>
    /// True when the generic message banner would just restate what the finished job panel already
    /// shows (on job completion the host sets Message = OperatorJobDoneMessage). Suppress the banner
    /// in that case so the same outcome isn't printed twice. Non-admins get no job panel, so their
    /// banner still shows.
    /// </summary>
    private bool MessageDuplicatesJobPanel =>
        ShowJobPanel && !Host.JobRunning && Host.Job is not null
        && string.Equals(Host.Message, AdaptationPageBase.OperatorJobDoneMessage(Host.Job), StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        try { await Session.EnsureHydratedAsync(); } catch { /* optional */ }
    }

    private bool ShowNextBanner =>
        AdaptationPageBase.ShowNextStepBanner(Host.Status, Host.SuppressGuidanceBanners, Step ?? "");

}
