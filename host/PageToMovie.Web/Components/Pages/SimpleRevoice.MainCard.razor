@* Page-local to SimpleRevoice — main re-voice card (excludes page chrome + alerts) *@

<div class="card border-primary border-opacity-50 mb-3" data-testid="simple-revoice-card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="fw-semibold">Automatic re-voice</span>
        @if (!string.IsNullOrWhiteSpace(Host._projectId))
        {
            <span class="badge text-bg-secondary">@Host._projectId</span>
        }
    </div>
    <div class="card-body">
        @if (string.IsNullOrWhiteSpace(Host._projectId))
        {
            <p class="mb-2">No active project. Start from story & voice first.</p>
            <a class="btn btn-primary" href="simple-voice">← Back to story & voice</a>
        }
        else if (!Host._hasClone)
        {
            <p class="mb-2">No cloned voice on the narrator yet.</p>
            <a class="btn btn-primary" href="simple-voice">← Record your voice</a>
        }
        else
        {
            <p class="small text-muted mb-3">
                Only clips whose speaker is the narrator get TTS + audio replace.
                Everyone else keeps the original soundtrack. Nothing goes through the video model.
                @if (Host._narratorClipCount > 0)
                {
                    <span class="d-block mt-1">
                        <strong>@Host._narratorClipCount</strong> narrator clip(s) to re-voice
                        · <strong>@Host._keepClipCount</strong> left as-is
                    </span>
                }
            </p>

            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <button type="button"
                        class="btn btn-primary btn-lg"
                        data-testid="simple-revoice-start"
                        disabled="@(Host._busy || Host._narratorClipCount == 0)"
                        @onclick="Host.RunAsync">
                    @if (Host._busy)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Working…</span>
                    }
                    else if (Host._done)
                    {
                        <span>Run again</span>
                    }
                    else
                    {
                        <span>Replace narrator audio →</span>
                    }
                </button>
                <a class="btn btn-outline-secondary" href="simple-voice">← Voice sample</a>
                @if (Host._done)
                {
                    <a class="btn btn-outline-primary" href="scenes?simple=1">Open scenes</a>
                    <a class="btn btn-outline-primary" href="review">Preview / stitch</a>
                }
            </div>

            @if (Host._clips.Count == 0 && !Host._loading)
            {
                <div class="alert alert-warning mb-0">
                    No clips found yet. Finish the library film (shot plan + video) in full studio first,
                    or open a project that already has picture clips.
                </div>
            }
            else
            {
                <SimpleRevoice_ProgressPanel />
            }

            @if (!string.IsNullOrEmpty(Host._previewUrl))
            {
                <div class="mt-3">
                    <div class="fw-semibold mb-1">Last clip preview</div>
                    <video class="w-100 rounded border" controls src="@Host._previewUrl" @key="Host._previewUrl"></video>
                </div>
            }
        }
    </div>
</div>

@code {
    [CascadingParameter] public SimpleRevoice Host { get; set; } = default!;
}
