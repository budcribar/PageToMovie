@* Page-local to Review — AI movie report card *@
@inject IAppLocalizer L

@if (Report is not null)
{
<div class="card mb-3 border-info text-white shadow-sm" style="background-color: #0f172a !important; border-color: #3b82f6 !important;" data-testid="review-movie-report-card">
            @* Collapsing keeps the header — score, verdict, and the way back in — so the report is
               never lost, just out of the way of the scene table below it. *@
            @* One line at 1024 wide, where the sidebar leaves the card only ~700px: the title
               shortens, the score keeps its verdict, and the model badge waits for a wider screen.
               Wrapping here cost 70-odd vertical pixels for a bar that is meant to be out of the way. *@
            <div class="card-header border-secondary d-flex justify-content-between align-items-center flex-nowrap gap-2 py-2" style="background-color: #1e293b !important;">
                <div class="d-flex align-items-center gap-2 flex-nowrap overflow-hidden">
                    <span class="fs-5 flex-shrink-0">🤖</span>
                    <span class="fw-bold fs-6 text-truncate">
                        <span class="d-none d-xl-inline">Full Movie Executive AI Review</span>
                        <span class="d-xl-none">Executive AI Review</span>
                    </span>
                    <span class="badge fs-6 flex-shrink-0 @ScoreBadgeClass(Report.OverallScore)">
                        <span class="d-none d-xl-inline">Overall Score: </span>@Report.OverallScore / 10 — @Report.Verdict
                    </span>
                    <span class="badge bg-dark border border-secondary text-white-50 d-none d-xxl-inline-block flex-shrink-0">
                        Model: @Report.ProviderUsed.ToUpperInvariant()
                    </span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0 text-nowrap"
                        data-testid="review-movie-report-toggle"
                        aria-expanded="@((!Collapsed).ToString().ToLowerInvariant())"
                        aria-controls="review-movie-report-body"
                        @onclick="() => OnToggleCollapsed.InvokeAsync()">
                    @(Collapsed ? "▸" : "▾") @(Collapsed ? L["Common.Show"] : L["Common.Hide"])
                </button>
            </div>
            @if (!Collapsed)
            {
            <div class="card-body py-3 review-report-body" id="review-movie-report-body" data-testid="review-movie-report-body">
                <!-- Executive Summary & Category Score Breakdown Matrix -->
                <div class="p-3 mb-3 rounded border border-secondary" style="background-color: #1e293b;">
                    <div class="fw-semibold text-info mb-2 d-flex justify-content-between align-items-center">
                        <span>Executive Overview &amp; Category Scores</span>
                    </div>
                    <div class="markdown-body mb-3 text-light">@MarkdownHelper.Render(!string.IsNullOrWhiteSpace(Report.ExecutiveSummary) ? Report.ExecutiveSummary : Report.SummaryNotes)</div>
                    
                    @if (Report.CategoryScores is { Count: > 0 })
                    {
                        <div class="row g-2">
                            @foreach (var cat in Report.CategoryScores)
                            {
                                <div class="col-6 col-md-3">
                                    <div class="p-2 rounded bg-dark border border-secondary d-flex justify-content-between align-items-center">
                                        <span class="small text-truncate me-1 text-white-50" title="@cat.Key">@cat.Key</span>
                                        <span class="badge @ScoreBadgeClass(cat.Value)">@cat.Value/10</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Rollup Sequence Group Accordions -->
                @if (Report.GroupFeedback?.Count > 0)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                        <span class="small fw-semibold text-muted">Sequence Groups Breakdown (@Report.GroupFeedback.Count groups)</span>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => OnExpandAll.InvokeAsync()">Expand All</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => OnCollapseAll.InvokeAsync()">Collapse All</button>
                        </div>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var group in Report.GroupFeedback)
                        {
                            var groupRange = group.SceneRange;
                            var expanded = IsSceneGroupExpanded(groupRange);
                            <div class="rounded border border-secondary overflow-hidden" style="background-color: #1e293b;">
                                <div class="p-2.5 d-flex justify-content-between align-items-center cursor-pointer user-select-none" 
                                     style="background-color: rgba(255,255,255,0.03);"
                                     @onclick="() => OnToggleGroup.InvokeAsync(groupRange)">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted small">@(expanded ? "▼" : "▶")</span>
                                        <span class="fw-semibold text-info">@groupRange</span>
                                        @if (!string.IsNullOrWhiteSpace(group.ContinuityNotes))
                                        {
                                            <span class="small text-muted text-truncate d-none d-md-inline ms-2" style="max-width: 400px;">
                                                @MarkdownHelper.StripHtml(group.ContinuityNotes)
                                            </span>
                                        }
                                    </div>
                                    <span class="badge @ScoreBadgeClass(group.Score)">
                                        Score: @group.Score/10
                                    </span>
                                </div>
                                @if (expanded)
                                {
                                    <div class="p-3 border-top border-secondary border-opacity-50">
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <div class="small text-white-50"><strong>Continuity &amp; Transitions:</strong></div>
                                                <div class="markdown-body small text-light mb-2">@MarkdownHelper.RenderOrDash(group.ContinuityNotes)</div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="small text-white-50"><strong>Character Consistency &amp; Wardrobe:</strong></div>
                                                <div class="markdown-body small text-light mb-2">@MarkdownHelper.RenderOrDash(group.VisualConsistencyNotes)</div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(group.LightingNotes))
                                            {
                                                <div class="col-md-6">
                                                    <div class="small text-white-50"><strong>Lighting &amp; Color Grade:</strong></div>
                                                    <div class="markdown-body small text-light mb-2">@MarkdownHelper.Render(group.LightingNotes)</div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(group.AudioNotes))
                                            {
                                                <div class="col-md-6">
                                                    <div class="small text-white-50"><strong>Audio &amp; Dialogue Alignment:</strong></div>
                                                    <div class="markdown-body small text-light mb-2">@MarkdownHelper.Render(group.AudioNotes)</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            }
        </div>
}
