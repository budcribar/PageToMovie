@* Page-local to Admin — test outbound email diagnostic modal *@
@if (Visible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true"
         style="background:rgba(0,0,0,0.5);" @onclick="CloseAsync">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title">✉️ Send Test Outbound Email</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="small text-muted mb-3">
                        Send a test email to verify your active mail sender configuration (Resend API key, SMTP server, or log fallback).
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Recipient Email Address</label>
                        <input type="email"
                               class="form-control form-control-sm"
                               placeholder="you@example.com"
                               @bind="_address"
                               @bind:event="oninput" />
                    </div>
                    @if (!string.IsNullOrEmpty(_status))
                    {
                        <InlineAlert Variant="success" CssClass="py-2 small mb-3" Message="@_status" role="status" />
                    }
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <InlineAlert Variant="danger" CssClass="py-2 small mb-3" Message="@_error" role="alert" />
                    }

                    @if (_result is { } res)
                    {
                        <div class="card bg-dark border-secondary text-light small mb-0">
                            <div class="card-header py-1 fw-semibold d-flex justify-content-between align-items-center">
                                <span>🔍 Mail Sender Diagnostic Report</span>
                                <span class="badge @(res.Ok ? "bg-success" : "bg-danger")">@(res.Ok ? "PASSED" : "FAILED")</span>
                            </div>
                            <div class="card-body p-2">
                                <div class="mb-1">Active Provider: <code class="text-info">@(res.SenderType ?? "Unknown")</code></div>
                                <div class="mb-1">Resend Key Resolved: <strong>@(res.ResendKeyResolved ? "Yes ✓" : "No ✕")</strong></div>
                                @if (res.CheckedEnvs is { Count: > 0 } envs)
                                {
                                    <div class="mt-2 fw-semibold">Detected Environment Variables:</div>
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        @foreach (var env in envs)
                                        {
                                            <span class="badge @(env.Value ? "text-bg-success" : "text-bg-secondary")">
                                                @env.Key: @(env.Value ? "SET" : "NOT SET")
                                            </span>
                                        }
                                    </div>
                                }
                                @if (res.SenderType == "LoggingEmailSender")
                                {
                                    <InlineAlert Variant="warning" CssClass="py-1 px-2 small mt-2 mb-0">
                                        ⚠️ <strong>Server is in Log-Only Mode:</strong> No real email was transmitted to an inbox. Outbound email links are logged to server stdout. Set the <code>Resend_Key</code> environment variable on Railway to enable live email delivery.
                                    </InlineAlert>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer py-2">
                    <BusyButton Label="Close" Busy="_busy" CssClass="btn btn-sm btn-secondary" OnClick="CloseAsync" />
                    <BusyButton Label="Send Test Email" BusyLabel="Sending Email…" Busy="_busy"
                                CssClass="btn btn-sm btn-warning" OnClick="SendAsync" />
                </div>
            </div>
        </div>
    </div>
}
