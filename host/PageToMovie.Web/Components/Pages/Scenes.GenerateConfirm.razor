@* Page-local to Scenes — batch generate confirmation *@
@inject IAppLocalizer L
@using PageToMovie.Core.Models

@if (Visible)
{
    <DarkModalShell Visible="true" OnClose="OnClose" data-testid="generate-confirm-modal">
        <Title>@L["Scenes.GenerateConfirmTitle"]</Title>
        <ChildContent>
            <fieldset class="mb-3" data-testid="generate-confirm-scope">
                <legend class="form-label small text-muted mb-2">@L["Scenes.GenerateScopeLegend"]</legend>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="genScope" id="genScopeMissing"
                           data-testid="generate-confirm-scope-missing"
                           value="missing"
                           checked="@(!ForceAllTakes)"
                           disabled="@(Busy || MissingClipCount == 0)"
                           @onclick="() => SetScopeAsync(false)" />
                    <label class="form-check-label" for="genScopeMissing">@L["Scenes.GenerateScopeMissing"]</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="genScope" id="genScopeAll"
                           data-testid="generate-confirm-scope-all"
                           value="all"
                           checked="@ForceAllTakes"
                           disabled="@Busy"
                           @onclick="() => SetScopeAsync(true)" />
                    <label class="form-check-label" for="genScopeAll">@L["Scenes.GenerateScopeAllTakes"]</label>
                </div>
            </fieldset>

            @if (AllClipCount == 0)
            {
                <div class="alert alert-info py-2 small mb-3">@L["Scenes.GenerateNothingToDo"]</div>
            }
            else
            {
                @if (MissingClipCount == 0)
                {
                    <div class="alert alert-info py-2 small mb-3">@L["Scenes.GenerateAlreadyDoneHint"]</div>
                }
                <p class="mb-3">
                    @(ForceAllTakes
                        ? L.Format("Scenes.GenerateConfirmSummaryAll", EstimatedClips, SelectedCount)
                        : L.Format("Scenes.GenerateConfirmSummary", EstimatedClips, SelectedCount))
                </p>
            }

            <div class="mb-3">
                <label class="form-label small text-muted" for="genResConfirm">@L["Common.Resolution"]</label>
                @if (ResolutionLocked)
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary">@(ResolutionLock ?? Resolution)</span>
                        <span class="small text-muted">@L["Scenes.ResolutionLockedHelp"]</span>
                    </div>
                }
                else
                {
                    <select id="genResConfirm"
                            data-testid="generate-confirm-resolution"
                            class="form-select form-select-sm bg-dark text-white border-secondary"
                            style="width:auto"
                            value="@Resolution"
                            @onchange="OnResolutionChange"
                            disabled="@Busy">
                        <option value="480p">480p</option>
                        <option value="720p">720p</option>
                        <option value="1080p">1080p</option>
                    </select>
                }
            </div>

            @if (ShowModelPicker && VideoModels.Count > 0)
            {
                <div class="mb-3">
                    <label class="form-label small text-muted" for="genModelConfirm">
                        Video model <span class="badge bg-secondary align-middle">admin</span>
                    </label>
                    <select id="genModelConfirm"
                            data-testid="generate-confirm-model"
                            class="form-select form-select-sm bg-dark text-white border-secondary"
                            style="width:auto"
                            disabled="@Busy"
                            value="@SelectedVideoModel"
                            @onchange="OnModelChange">
                        <option value="">@L["Scenes.ProjectDefault"]</option>
                        @foreach (var m in VideoModels)
                        {
                            <option value="@m.Id">@m.DisplayName</option>
                        }
                    </select>
                    <div class="form-text text-muted">@L["Scenes.ModelBatchOverrideHelp"]</div>
                </div>
            }

            <div class="d-flex align-items-baseline gap-2">
                <span class="small text-muted">@L["Scenes.EstimatedCost"]</span>
                @if (!CostReady)
                {
                    <span class="small text-muted">@L["Scenes.Calculating"]</span>
                }
                else
                {
                    <span class="fs-5 fw-bold" data-testid="generate-confirm-cost">~$@(EstimatedCostUsd.ToString("0.00"))</span>
                }
            </div>
            @if (AllCredits)
            {
                <div class="small text-muted mt-1">@L["Scenes.EndCreditsNoCostHelp"]</div>
            }
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    disabled="@Busy" @onclick="OnClose">@L["Common.Cancel"]</button>
            <button type="button" class="btn btn-sm btn-success fw-bold"
                    data-testid="generate-confirm-go"
                    disabled="@GenerateDisabled"
                    @onclick="OnConfirm">
                @L.Format("Scenes.GenerateScenesButton", SelectedCount)
            </button>
        </Footer>
    </DarkModalShell>
}
