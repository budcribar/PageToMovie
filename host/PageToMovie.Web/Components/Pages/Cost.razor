@page "/cost"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject NavigationManager Nav
@inject IAppLocalizer L
@using PageToMovie.Core.Models
@using System.Globalization
@using static PageToMovie.Web.Components.CostFormatting

<PageTitle>@L["Nav.Estimate"]</PageTitle>

<div class="cost-page" data-testid="cost-page">

@if (ActiveProject.HasProject)
{
    <StudioProcessStrip Active="estimate" FullStudio="true" />
}

<InlineAlert Message="@_error" />

@if (ActiveProject.HasProject && !ActiveProject.CanEstimate)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 mb-2">
        <div class="small">
            <strong>@L["CostPage.FullQuoteNeedsScreenplay"]</strong>
            @ActiveProject.EstimateBlockedReason
        </div>
        <a class="btn btn-sm btn-warning fw-semibold" href="adaptation">@L["CostPage.GoToBook"]</a>
    </div>
}

@if (_report is null)
{
    <EmptyState Message="@L["Common.Loading"]" CssClass="text-muted" />
}
else
{
    var s = _report.Summary;

    <div class="card cost-hub mb-2" data-testid="decision-forecast-card">
        <div class="card-body py-2 px-3">
            @* Two money numbers only: estimate + spent *@
            <div class="row g-2 text-center cost-hub-metrics">
                <div class="col-4">
                    <div class="text-muted cost-hub-label">@L["CostPage.Duration"]</div>
                    <div class="cost-hero-num cost-hub-value" data-testid="cost-duration">@DurationLabel</div>
                </div>
                <div class="col-4">
                    <div class="text-muted cost-hub-label" title="Forecast for a full first-pass at current settings">@L["CostPage.Estimate"]</div>
                    <div class="cost-hero-num cost-hub-value" data-testid="cost-estimate">@CostLabel</div>
                    <div class="cost-hub-meta">
                        @_report.DraftResolution
                        <span class="visually-hidden" data-testid="cost-basis">@EstimateBasisLabel</span>
                        @if (EstimateIsScaledForTarget)
                        {
                            <span data-testid="cost-scaled"> · to target</span>
                        }
                    </div>
                </div>
                <div class="col-4">
                    <div class="text-muted cost-hub-label" title="Already billed on this project">@L["CostPage.Spent"]</div>
                    <div class="cost-hero-num cost-hub-value" data-testid="cost-spent">@Usd(s.ActualUsd)</div>
                </div>
            </div>

            @if (ActiveProject.Status?.Index is { HasIndex: true } ix)
            {
                <div class="text-muted small text-center mt-2" data-testid="cost-index-counts">
                    @ix.SceneCards scenes · @ix.Locations locations · @ix.SpeakingCast speaking
                    @if (ActiveProject.Status?.Cut is { HasCut: true, KeepAll: false } cut && cut.TotalSequences > 0)
                    {
                        <span> · @cut.KeptSequences of @cut.TotalSequences sequences</span>
                    }
                </div>
                @if (Session.IsAdmin && ix.Warnings.Count > 0)
                {
                    <div class="text-warning small text-center" data-testid="cost-index-warnings">
                        @string.Join(" · ", ix.Warnings)
                    </div>
                }
            }

            @if (!string.IsNullOrWhiteSpace(_shapeMessage))
            {
                <div class="alert alert-success py-1 px-2 small mt-2 mb-0 d-flex flex-wrap align-items-center gap-2" data-testid="decision-shape-done">
                    <span>@_shapeMessage</span>
                    @if (!string.IsNullOrWhiteSpace(_prePruneCheckpointHash))
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                data-testid="cost-revert-prune"
                                title="@PrePruneUndoTitle"
                                disabled="@_busy"
                                @onclick="RevertPruneAsync">
                            Undo prune
                        </button>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_shapeError))
            {
                <div class="alert alert-danger py-1 px-2 small mt-2 mb-0" data-testid="shaping-error">@_shapeError</div>
            }
            @if (!string.IsNullOrWhiteSpace(_collabNote))
            {
                <div class="alert alert-warning py-1 px-2 small mt-2 mb-0" data-testid="decision-collab-note">@_collabNote</div>
            }

            @* Settings row: target length on left (under duration), resolution on right *@
            <div class="row g-3 align-items-center mt-2 cost-hub-controls">
                <div class="col-md-6 d-flex justify-content-center">
                    <div class="d-flex flex-wrap align-items-center justify-content-center gap-2" data-testid="cost-length-row">
                        @if (!string.IsNullOrWhiteSpace(_projectId))
                        {
                            <FilmLengthCard Embedded="true" ProjectId="@_projectId" Disabled="@_busy" OnChanged="OnFilmLengthChangedAsync" />
                            @if (NeedsFitForTarget)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning"
                                        data-testid="cost-fit-target"
                                        disabled="@_busy"
                                        title="Shorten the screenplay to hit target length. A checkpoint is saved first so you can undo."
                                        @onclick="RunFitTrimAsync">
                                    @L["CostPage.PruneScript"]
                                </button>
                            }
                        }
                    </div>
                </div>
                <div class="col-md-6 d-flex justify-content-center">
                    <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
                        <label class="form-label cost-hub-label mb-0 me-1">@L["CostPage.VideoResolution"]</label>
                        <div class="btn-group" role="group" aria-label="Video resolution">
                            @foreach (var res in new[] { "480p", "720p", "1080p" })
                            {
                                <button type="button"
                                        class="btn btn-sm @(_draftRes == res ? "btn-primary" : "btn-outline-secondary")"
                                        data-testid="@($"cost-res-{res}")"
                                        disabled="@_busy"
                                        @onclick="() => SetDraftResolutionAsync(res)">
                                    @res
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (_phase == DecisionPhase.ConfirmGenerate)
            {
                <div class="cost-hub-decision border-top border-secondary border-opacity-25 mt-2 pt-2"
                     data-testid="decision-confirm-generate">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="p-2 px-3 border border-secondary border-opacity-25 rounded bg-dark bg-opacity-25 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-success">Automatic</span>
                                        <span class="fw-semibold small">@L["CostPage.FullFilmGeneration"]</span>
                                    </div>
                                    <p class="small text-muted mb-2">
                                        Automatically prepares cast & locations, builds the shot plan, and produces the entire film (~@DurationLabel · @CostLabel).
                                    </p>
                                </div>
                                <button type="button"
                                        class="btn btn-sm btn-success fw-semibold w-100"
                                        data-testid="decision-confirm-go"
                                        disabled="@(_busy || !ActiveProject.CanEstimate || PlanBusy || GeneratingBusy || !IsOwner)"
                                        @onclick="ConfirmGenerateAsync">
                                    @L["CostPage.StartAutomaticGeneration"]
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-2 px-3 border border-secondary border-opacity-25 rounded bg-dark bg-opacity-25 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-primary">Manual</span>
                                        <span class="fw-semibold small">@L["CostPage.StepByStepCraft"]</span>
                                    </div>
                                    <p class="small text-muted mb-2">
                                        Review cast, locations, and scenes, build the shot plan, and generate scene-by-scene (e.g. test Scene 1 first).
                                    </p>
                                </div>
                                <a class="btn btn-sm btn-outline-primary fw-semibold w-100"
                                   href="adaptation/screenplay"
                                   data-testid="decision-manual-step">
                                    @L["CostPage.ContinueStepByStep"]
                                </a>
                            </div>
                        </div>
                    </div>
                    @if (PlanBusy)
                    {
                        <div class="alert alert-warning py-1 px-2 small mt-1 mb-0" data-testid="decision-plan-busy">
                            <code>@_scriptLeaseHolder</code> is editing the plan — full generate blocked.
                        </div>
                    }
                    @if (GeneratingBusy)
                    {
                        <div class="alert alert-info py-1 px-2 small mt-1 mb-0" data-testid="decision-generating-busy-confirm">
                            A job is already running — open Film to watch it.
                        </div>
                    }
                    <div class="mt-1 text-end">
                        <button type="button" class="btn btn-sm btn-link text-muted text-decoration-none py-0" data-testid="decision-confirm-back" @onclick="BackToCard">
                            Cancel
                        </button>
                    </div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_projectId) && ActiveProject.HasProject && ActiveProject.CanEstimate && !IsViewerOnly)
            {
                <div class="cost-hub-decision border-top border-secondary border-opacity-25 mt-2 pt-2" data-testid="decision-card">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="p-2 px-3 border border-secondary border-opacity-25 rounded bg-dark bg-opacity-25 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-success">Automatic</span>
                                        <span class="fw-semibold small">@L["CostPage.FullFilmGeneration"]</span>
                                    </div>
                                    <p class="small text-muted mb-2">
                                        Automatically prepares cast & locations, builds the shot plan, and produces the entire film (~@DurationLabel · @CostLabel).
                                    </p>
                                </div>
                                <button type="button"
                                        class="btn btn-sm btn-success fw-semibold w-100"
                                        data-testid="decision-confirm-go"
                                        disabled="@(_busy || !ActiveProject.CanEstimate || PlanBusy || GeneratingBusy || !IsOwner)"
                                        @onclick="ConfirmGenerateAsync">
                                    @L["CostPage.StartAutomaticGeneration"]
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-2 px-3 border border-secondary border-opacity-25 rounded bg-dark bg-opacity-25 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-primary">Manual</span>
                                        <span class="fw-semibold small">@L["CostPage.StepByStepCraft"]</span>
                                    </div>
                                    <p class="small text-muted mb-2">
                                        Review cast, locations, and scenes, build the shot plan, and generate scene-by-scene (e.g. test Scene 1 first).
                                    </p>
                                </div>
                                <a class="btn btn-sm btn-outline-primary fw-semibold w-100"
                                   href="adaptation/screenplay"
                                   data-testid="decision-manual-step">
                                    @L["CostPage.ContinueStepByStep"]
                                </a>
                            </div>
                        </div>
                    </div>
                    @if (GeneratingBusy)
                    {
                        <div class="small text-info mt-1" data-testid="decision-generating-busy">
                            Job running — open Film to watch.
                        </div>
                    }
                </div>
            }
            else if (IsViewerOnly)
            {
                <p class="small text-muted mt-2 mb-0" data-testid="decision-viewer-readonly">
                    Viewer access — forecast is read-only.
                </p>
            }
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-end gap-2 cost-hub-footer">
        <a class="small text-muted" href="cost/breakdown" data-testid="cost-breakdown-link">
            @L["CostPage.ProjectCostBreakdown"]
        </a>
        <span class="text-muted small">·</span>
        <a class="small text-muted" href="account/costs" data-testid="cost-account-link">
            @L["CostPage.SeeAllProjectsBilling"]
        </a>
    </div>
}

</div>
