@page "/cost"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject NavigationManager Nav
@inject IAppLocalizer L
@using PageToMovie.Core.Models
@using System.Globalization
@using static PageToMovie.Web.Components.CostFormatting

<PageTitle>@L["Nav.Estimate"]</PageTitle>

<StudioPageHeader Kicker="Studio · Estimate" Title="@L["Nav.Estimate"]">
    @L["CostPage.Subtitle"]
</StudioPageHeader>

@if (ActiveProject.HasProject)
{
    <StudioProcessStrip Active="estimate" FullStudio="true" />
}

<InlineAlert Message="@_error" />

@* Soft gate — still show what you've spent when the screenplay is not ready yet. *@
@if (ActiveProject.HasProject && !ActiveProject.CanEstimate)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <strong>@L["CostPage.FullQuoteNeedsScreenplay"]</strong>
            @ActiveProject.EstimateBlockedReason
        </div>
        <a class="btn btn-sm btn-warning fw-semibold" href="adaptation">Go to Book →</a>
    </div>
}

    @if (_report is null)
    {
        <EmptyState Message="@L["Common.Loading"]" CssClass="text-muted" />
    }
    else
    {
        var s = _report.Summary;
        // Before a shot plan exists the film isn't sized yet, so the top-line responds to the length +
        // resolution you pick (minutes-based projection). Once the shot plan exists, use the real
        // clip-based estimate (which changes when you trim to fewer scenes).
        var hasShotPlan = string.Equals(_report.EstimateBasis, "shot_plan", StringComparison.OrdinalIgnoreCase);
        var targetMin = (_filmRuntime?.TargetMinutes ?? 0) > 0
            ? _filmRuntime!.TargetMinutes
            : Math.Max(1, _filmRuntime?.NaturalMinutes ?? 1);
        var estimate = hasShotPlan ? s.FullFilmAllDraftUsd : ProjectedEstimateUsd(targetMin);

        @* —— One card: estimate/spent/remaining · resolution · film length —— *@
        <div class="card mb-4">
            <div class="card-body">
                @* Headline numbers on top *@
                <div class="row g-3 text-center">
                    <div class="col-4">
                        <div class="text-muted small text-uppercase mb-1">@L["Nav.Estimate"]</div>
                        <div class="fs-3 fw-semibold cost-hero-num" data-testid="cost-estimate">@Usd(estimate)</div>
                        <div class="small text-muted">
                            @if (hasShotPlan)
                            {
                                <span>@_report.DraftResolution · from shot plan</span>
                            }
                            else
                            {
                                <span>~@targetMin min · @_report.DraftResolution · projected</span>
                            }
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="text-muted small text-uppercase mb-1">@L["CostPage.Spent"]</div>
                        <div class="fs-3 fw-semibold cost-hero-num" data-testid="cost-spent">@Usd(s.ActualUsd)</div>
                        <div class="small text-muted">@L["CostPage.SoFar"]</div>
                    </div>
                    <div class="col-4">
                        <div class="text-muted small text-uppercase mb-1">@L["CostPage.Remaining"]</div>
                        <div class="fs-3 fw-semibold cost-hero-num" data-testid="cost-remaining">@Usd(Math.Max(0, estimate - s.ActualUsd))</div>
                        <div class="small text-muted">est − spent</div>
                    </div>
                </div>

                <hr class="my-3" />

                @* Two balanced columns that stay centered on resize *@
                <div class="row g-3 align-items-start">
                    <div class="col-md-6">
                        <label class="form-label small mb-1">@L["CostPage.VideoResolution"]</label>
                        <div class="btn-group d-flex" role="group" aria-label="Video resolution">
                            @foreach (var res in new[] { "480p", "720p", "1080p" })
                            {
                                <button type="button"
                                        class="btn btn-sm @(_draftRes == res ? "btn-primary" : "btn-outline-secondary")"
                                        data-testid="@($"cost-res-{res}")"
                                        disabled="@_busy"
                                        @onclick="() => SetDraftResolutionAsync(res)">
                                    @res
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        @if (!string.IsNullOrWhiteSpace(_projectId))
                        {
                            <FilmLengthCard Embedded="true" ProjectId="@_projectId" Disabled="@_busy" OnChanged="LoadAsync" />
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Primary action: confirm estimate and advance to the next incomplete stage (not always Film). *@
        @if (!string.IsNullOrWhiteSpace(_projectId) && ActiveProject.HasProject && ActiveProject.CanEstimate)
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4 p-3 rounded border border-primary border-opacity-25 bg-primary bg-opacity-10">
                <div class="small">
                    <strong>@(ActiveProject.CanScenes ? L["CostPage.ReadyToGenerate"] : "Estimate confirmed — next step")</strong>
                    @if (ActiveProject.CanScenes)
                    {
                        <span> @L["CostPage.ContinueToFilm"]</span>
                    }
                    else
                    {
                        <span> @AgreeNextStageHint</span>
                    }
                </div>
                <button type="button"
                        class="btn btn-primary fw-semibold px-4"
                        data-testid="cost-agree-continue"
                        disabled="@_busy"
                        @onclick="AgreeAndContinueAsync">
                    @L["CostPage.AgreeAndContinue"]
                </button>
            </div>
        }

        @* Full breakdown and account-wide spend each live on their own page. *@
        <div class="d-flex flex-wrap justify-content-end gap-2 mb-3">
            <a class="btn btn-sm btn-outline-secondary" href="cost/breakdown" data-testid="cost-breakdown-link">
                @L["CostPage.ProjectCostBreakdown"]
            </a>
            <a class="btn btn-sm btn-outline-secondary" href="account/costs" data-testid="cost-account-link">
                @L["CostPage.SeeAllProjectsBilling"]
            </a>
        </div>
    }
