@page "/cost"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject NavigationManager Nav
@inject IAppLocalizer L
@using PageToMovie.Core.Models
@using System.Globalization
@using static PageToMovie.Web.Components.CostFormatting

<PageTitle>@L["Nav.Estimate"]</PageTitle>

<div class="cost-page" data-testid="cost-page">

@if (ActiveProject.HasProject)
{
    <StudioProcessStrip Active="estimate" FullStudio="true" />
}

<InlineAlert Message="@_error" />

@if (ActiveProject.HasProject && !ActiveProject.CanEstimate)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 mb-2">
        <div class="small">
            <strong>@L["CostPage.FullQuoteNeedsScreenplay"]</strong>
            @ActiveProject.EstimateBlockedReason
        </div>
        <a class="btn btn-sm btn-warning fw-semibold" href="adaptation">Go to Book →</a>
    </div>
}

@if (_report is null)
{
    <EmptyState Message="@L["Common.Loading"]" CssClass="text-muted" />
}
else
{
    var s = _report.Summary;
    var estimate = DisplayEstimateUsd;

    <div class="card cost-hub mb-2" data-testid="decision-forecast-card">
        <div class="card-body py-2 px-3">
            @* Metrics: Duration · Movie cost · Spent · To finish (only when gen underway) *@
            <div class="row g-2 text-center cost-hub-metrics">
                <div class="@(ShowToFinish ? "col-6 col-md-3" : "col-4")">
                    <div class="text-muted cost-hub-label">Duration</div>
                    <div class="cost-hero-num cost-hub-value" data-testid="cost-duration">@DurationLabel</div>
                </div>
                <div class="@(ShowToFinish ? "col-6 col-md-3" : "col-4")">
                    <div class="text-muted cost-hub-label" title="Forecast for a full first-pass at current settings">Movie cost</div>
                    <div class="cost-hero-num cost-hub-value" data-testid="cost-estimate">@CostLabel</div>
                    <div class="cost-hub-meta">
                        @_report.DraftResolution · <span data-testid="cost-basis">@EstimateBasisLabel</span>
                        @if (EstimateIsScaledForTarget)
                        {
                            <span data-testid="cost-scaled"> · scaled to target</span>
                        }
                    </div>
                </div>
                <div class="@(ShowToFinish ? "col-6 col-md-3" : "col-4")">
                    <div class="text-muted cost-hub-label" title="Already billed on this project">Spent</div>
                    <div class="cost-hero-num cost-hub-value" data-testid="cost-spent">@Usd(s.ActualUsd)</div>
                </div>
                @if (ShowToFinish)
                {
                    <div class="col-6 col-md-3">
                        <div class="text-muted cost-hub-label" title="Cost of clips still missing (not the full-movie forecast)">To finish</div>
                        <div class="cost-hero-num cost-hub-value" data-testid="cost-remaining">@Usd(DisplayRemainingUsd)</div>
                        @if (!string.IsNullOrWhiteSpace(_report.RemainingLabel))
                        {
                            <div class="cost-hub-meta" data-testid="cost-remaining-label">@_report.RemainingLabel</div>
                        }
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_report.TakesLearning?.HistoryLabel))
            {
                <div class="cost-hub-meta text-center mt-1" data-testid="cost-takes-history">@_report.TakesLearning.HistoryLabel</div>
            }

            @if (!string.IsNullOrWhiteSpace(_shapeMessage))
            {
                <div class="alert alert-success py-1 px-2 small mt-2 mb-0" data-testid="decision-shape-done">@_shapeMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(_shapeError))
            {
                <div class="alert alert-danger py-1 px-2 small mt-2 mb-0" data-testid="shaping-error">@_shapeError</div>
            }
            @if (!string.IsNullOrWhiteSpace(_collabNote))
            {
                <div class="alert alert-warning py-1 px-2 small mt-2 mb-0" data-testid="decision-collab-note">@_collabNote</div>
            }

            @* Plan levers on one row — no Edit-focus maze *@
            <div class="row g-2 align-items-end mt-2 cost-hub-controls">
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label cost-hub-label mb-1">@L["CostPage.VideoResolution"]</label>
                    <div class="btn-group d-flex" role="group" aria-label="Video resolution">
                        @foreach (var res in new[] { "480p", "720p", "1080p" })
                        {
                            <button type="button"
                                    class="btn btn-sm @(_draftRes == res ? "btn-primary" : "btn-outline-secondary")"
                                    data-testid="@($"cost-res-{res}")"
                                    disabled="@_busy"
                                    @onclick="() => SetDraftResolutionAsync(res)">
                                @res
                            </button>
                        }
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label cost-hub-label mb-1">Production</label>
                    <div class="btn-group d-flex" role="group" aria-label="Production mode" data-testid="cost-production-mode">
                        <button type="button"
                                class="btn btn-sm @(ProductionModes.IsDraft(_productionMode) ? "btn-warning" : "btn-outline-secondary")"
                                data-testid="cost-mode-draft"
                                disabled="@_busy"
                                title="Faster first watch — cast plates optional"
                                @onclick='() => SetProductionModeAsync(ProductionModes.Draft)'>
                            Draft
                        </button>
                        <button type="button"
                                class="btn btn-sm @(ProductionModes.IsFull(_productionMode) ? "btn-primary" : "btn-outline-secondary")"
                                data-testid="cost-mode-full"
                                disabled="@_busy"
                                title="Identity-locked plates required before video spend"
                                @onclick='() => SetProductionModeAsync(ProductionModes.Full)'>
                            Full
                        </button>
                    </div>
                    <div class="visually-hidden" data-testid="cost-mode-hint">
                        @(ProductionModes.IsDraft(_productionMode) ? "Draft" : "Full")
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    @if (!string.IsNullOrWhiteSpace(_projectId))
                    {
                        <FilmLengthCard Embedded="true" ProjectId="@_projectId" Disabled="@_busy" OnChanged="OnFilmLengthChangedAsync" />
                        @if (NeedsFitForTarget)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-warning mt-1"
                                    data-testid="cost-fit-target"
                                    disabled="@_busy"
                                    title="Rewrite screenplay + refresh plan density for the new length"
                                    @onclick="RunFitTrimAsync">
                                Fit screenplay to target
                            </button>
                        }
                    }
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label class="form-label cost-hub-label mb-1">Max speaking cast</label>
                    <div class="input-group input-group-sm">
                        <input type="number" class="form-control" min="1" max="40" placeholder="default"
                               @bind="_castCapInput" disabled="@_busy" data-testid="shaping-cast-cap" />
                        <button type="button" class="btn btn-outline-primary" disabled="@_busy"
                                @onclick="SaveCastCapAsync" data-testid="shaping-cast-cap-save">
                            Save
                        </button>
                    </div>
                </div>
            </div>

            @* Craft links — not a separate step *@
            @if (ActiveProject.CanCharacters || ActiveProject.CanEstimate)
            {
                <div class="d-flex flex-wrap gap-2 mt-2 small" data-testid="shaping-craft">
                    <span class="text-muted align-self-center">Craft:</span>
                    <a class="btn btn-outline-secondary btn-sm py-0" href="characters" data-testid="shaping-to-cast">Cast & voice</a>
                    <a class="btn btn-outline-secondary btn-sm py-0" href="locations" data-testid="shaping-to-locs">Locations</a>
                    <a class="btn btn-outline-secondary btn-sm py-0" href="adaptation/screenplay" data-testid="shaping-to-script">Script</a>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_projectId) && ActiveProject.HasProject && ActiveProject.CanEstimate && !IsViewerOnly)
            {
                <div class="cost-hub-decision border-top border-secondary border-opacity-25 mt-2 pt-2" data-testid="decision-card">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        @if (IsOwner)
                        {
                            <button type="button"
                                    class="btn btn-primary fw-semibold"
                                    data-testid="decision-generate"
                                    disabled="@(_busy || GeneratingBusy || PlanBusy)"
                                    @onclick="ConfirmGenerateAsync">
                                @(ActiveProject.CanScenes ? "Generate missing clips" : "Generate movie")
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-outline-primary fw-semibold"
                                    data-testid="decision-generate-scenes"
                                    disabled="@_busy"
                                    @onclick="ChooseGenerate">
                                Open Film for scenes →
                            </button>
                        }
                        @if (GeneratingBusy)
                        {
                            <span class="small text-info" data-testid="decision-generating-busy">
                                Job running (<code>@_blockingJobKind</code>) — watch on Film.
                            </span>
                        }
                        else if (PlanBusy && IsOwner)
                        {
                            <span class="small text-warning" data-testid="decision-plan-busy-hint">
                                <code>@_scriptLeaseHolder</code> holds the plan lease.
                            </span>
                        }
                    </div>
                </div>
            }
            else if (IsViewerOnly)
            {
                <p class="small text-muted mt-2 mb-0" data-testid="decision-viewer-readonly">
                    Viewer access — forecast is read-only.
                </p>
            }
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-end gap-2 cost-hub-footer">
        <a class="small text-muted" href="cost/breakdown" data-testid="cost-breakdown-link">
            @L["CostPage.ProjectCostBreakdown"]
        </a>
        <span class="text-muted small">·</span>
        <a class="small text-muted" href="account/costs" data-testid="cost-account-link">
            @L["CostPage.SeeAllProjectsBilling"]
        </a>
    </div>
}

</div>
