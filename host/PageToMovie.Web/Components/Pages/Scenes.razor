@page "/scenes"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject JobHubClient Hub
@inject ActiveProjectState ActiveProject
@inject StudioCapabilityState Caps
@inject AdminSessionService Session
@inject ClientVideoStitchService Stitch
@inject ClientMediaFolderService MediaFolder
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IAppLocalizer L
@using PageToMovie.Core.Models
@using PageToMovie.Web.Services

<PageTitle>@(IsSimpleFilm ? L["ProcessStrip.Movie"] : L["Nav.Film"])</PageTitle>

<StudioPageHeader Kicker="@(IsSimpleFilm ? "Easiest start · Movie" : "Studio · Step 5 · Film")"
                   Title="@(IsSimpleFilm ? "Make your movie" : L["Nav.Film"])">
    @if (IsSimpleFilm)
    {
        <text>Generate every scene with your narrator voice. Stock pictures stay as-is.</text>
    }
    else
    {
        <text>@L["ScenesPage.Subtitle"]</text>
    }
</StudioPageHeader>

<StudioProcessStrip Active="film" SimpleMode="@IsSimpleFilm" FullStudio="@(!IsSimpleFilm)" />

@if (IsSimpleFilm)
{
    <div class="alert alert-primary border-primary border-opacity-50 py-2 small mb-3" data-testid="simple-film-banner">
        <strong>Simple path.</strong>
        Your voice is ready — use <strong>Generate missing</strong> (or the batch control below) to film all scenes.
        <a href="simple-voice" class="alert-link">Back to story & voice</a>
    </div>
}

@if (_gateChecked && !ActiveProject.CanScenes)
{
    <ReadinessGateBanner Visible="true"
                         Reason="@ActiveProject.ScenesBlockedReason"
                         FallbackReason="Finish the shot plan first."
                         ActionHref="adaptation/shots"
                         ActionLabel="Open shot plan →" />
}
else
{

@* Feature 8: clip finished but not saved to a local media folder *@
@if (!string.IsNullOrEmpty(MediaFolder.LocalSaveWarning))
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 mb-3"
         data-testid="scenes-local-save-warning"
         role="status">
        <span>@MediaFolder.LocalSaveWarning</span>
        <div class="d-flex align-items-center gap-2 flex-shrink-0">
            @if (!MediaFolder.IsConnected)
            {
                <button type="button"
                        class="btn btn-sm btn-warning text-nowrap"
                        disabled="@_busy"
                        @onclick="ConnectMediaFolderFromWarningAsync">
                    Connect folder
                </button>
            }
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    @onclick="DismissLocalSaveWarning">
                Dismiss
            </button>
        </div>
    </div>
}

@* Proactive nudge before the reactive warning above ever needs to fire. *@
@if (!MediaFolder.IsConnected && string.IsNullOrEmpty(MediaFolder.LocalSaveWarning))
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 mb-3"
         data-testid="scenes-connect-folder-banner">
        @if (MediaFolder.NeedsReconnect)
        {
            <span>📁 Re-grant access to <strong>@MediaFolder.PendingReconnectFolderName</strong> so clips save on this computer.</span>
        }
        else
        {
            <span>📁 <strong>Connect a folder</strong> so clips save on this computer.</span>
        }
        <button type="button"
                class="btn btn-sm btn-warning text-nowrap"
                disabled="@_busy"
                @onclick="ConnectMediaFolderFromWarningAsync">
            @(MediaFolder.NeedsReconnect ? "Reconnect folder" : "Connect folder")
        </button>
    </div>
}

@if (_castChecked && !CastReady)
{
    <InlineAlert Variant="warning" CssClass="py-2" data-testid="scenes-cast-gate">
        Cast incomplete
        @if (_castReadyCount is int cr && _castTotal is int ct)
        {
            <span>(@cr/@ct)</span>
        }
        — finish voice + locks on
        <a class="alert-link" href="characters">Characters →</a>
    </InlineAlert>
}


@* ---- Scene version history (P3) ---- *@
@* Own flag — distinct from _showSceneHistory (the unrelated git-commit history modal further
   below), so toggling one panel never shows/hides the other. *@
@if (_selectedScene is int snHist)
{
    <div class="mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary"
                @onclick="() => _showInlineSceneHistory = !_showInlineSceneHistory">
            @(_showInlineSceneHistory ? "Hide history" : "Scene history")
        </button>
    </div>
    @if (_showInlineSceneHistory)
    {
        <SceneVersionHistory ProjectId="@_projectId"
                             SceneKey="@($"scene:{snHist}")"
                             OnClose="HideSceneHistory"
                             OnRestored="OnSceneHistoryRestored" />
    }
}

@if (_selectedScene is int)
{
    <div class="mb-3">
        <button class="btn btn-outline-primary" disabled="@_busy" @onclick="BackToListAsync">← All scenes</button>
    </div>
}

@if (_showFilters)
{
    <div class="card mb-3 p-3 border-secondary bg-dark" data-testid="scenes-select-panel">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="small text-muted">🔍 Filters</span>
            <button class="btn btn-sm btn-outline-secondary py-0 px-2" type="button"
                    data-testid="scenes-filters-collapse"
                    title="Hide filters"
                    @onclick="() => _showFilters = false">
                ✕ Hide
            </button>
        </div>
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted">Character</label>
                <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_pickCharacter" @bind:after="SelectByCharacter" disabled="@_busy">
                    <option value="">All characters…</option>
                    @foreach (var c in CharacterOptions)
                    {
                        <option value="@c">@ShortChar(c)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Location</label>
                <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="_pickLocation" @bind:after="SelectByLocation" disabled="@_busy">
                    <option value="">All locations…</option>
                    @foreach (var loc in LocationOptions)
                    {
                        <option value="@loc">@ShortLoc(loc)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted">Setting text</label>
                <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="_pickSetting" @bind:event="oninput" disabled="@_busy" placeholder="Filter by text e.g. pajamas" />
            </div>
            <div class="col-md-2">
                @if (HasActiveFilters)
                {
                    <button class="btn btn-sm btn-outline-danger w-100" type="button" @onclick="ClearFilters">
                        Clear filters
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (_showScenePlayer && _playingScene is int playSn && !IsSceneGenBusy(playSn) && !_clientStitching)
{
    <div class="card mb-3 border-primary">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span>
                Scene <code class="small">S@(playSn.ToString("D2"))</code>
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="HideScenePlayer">Hide</button>
        </div>
        <div class="card-body py-2">
            @if (MediaFolder.IsSyncing && string.IsNullOrEmpty(_clientSceneUrl))
            {
                <MediaDownloadProgress Label="Downloading video clips to local folder…"
                                       CurrentFile="@MediaFolder.SyncCurrentFile" Current="@MediaFolder.SyncCurrent"
                                       Total="@MediaFolder.SyncTotal" Percent="@MediaFolder.SyncPercent"
                                       FooterText="Playback will start automatically as soon as downloads complete."
                                       data-testid="scenes-downloading-player" />
            }
            else
            {
                <video controls playsinline autoplay
                       style="width:100%;max-height:70vh;background:#000;border-radius:0.35rem;"
                       src="@ScenePlayerSrc(playSn)"
                       @key="_sceneVideoKey"
                       onloadeddata="this.play().catch(function(){})">
                    Your browser does not support HTML5 video.
                </video>
                <div class="mt-2 d-flex flex-wrap gap-3 align-items-center">
                    <a href="/dialogue-timing?scene=@playSn" class="small" data-testid="scene-dialogue-timing">Review dialogue timing →</a>
                    @if (string.IsNullOrEmpty(_clientSceneUrl))
                    {
                        <a href="@Engine.CompositeVideoUrl(_projectId, playSn)" target="_blank" rel="noopener" class="small text-muted">Open in new tab</a>
                    }
                </div>
                @if (Session.IsAdmin && _detail is { } _dd && _dd.SceneNumber == playSn && _dd.DuplicateClipNumbers.Count > 0)
                {
                    <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small" data-testid="scene-dup-clips">
                        ⚠ Malformed shot plan: clip @(string.Join(", ", _dd.DuplicateClipNumbers)) appears more than once in this scene, which doubles it. Deduped for playback — regenerate the shot plan to fix the data.
                    </div>
                }
            }
        </div>
    </div>
}
else if (_showScenePlayer && _playingScene is int busySn && (IsSceneGenBusy(busySn) || _clientStitching))
{
    <div class="card mb-3 border-secondary">
        <div class="card-body py-2 small text-muted">
            @if (_clientStitching)
            {
                <span>Combining clips in browser… @_clientStitchStatus</span>
            }
            else
            {
                <span>Scene hidden while generating <code>S@(busySn.ToString("D2"))</code>.</span>
            }
            <button type="button" class="btn btn-link btn-sm p-0 align-baseline ms-1" @onclick="HideScenePlayer">Dismiss</button>
        </div>
    </div>
}

@if (_showPreviewPlayer && !string.IsNullOrEmpty(_clientPreviewUrl) && !_clientStitching)
{
    <div class="card mb-3 border-primary" data-testid="scenes-preview-player">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span>
                Preview — @_previewScenes.Count scene@(_previewScenes.Count == 1 ? "" : "s"):
                <code class="small">@string.Join(", ", _previewScenes.Select(s => $"S{s:D2}"))</code>
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="HidePreviewPlayerAsync">Hide</button>
        </div>
        <div class="card-body py-2">
            <video controls playsinline autoplay
                   style="width:100%;max-height:70vh;background:#000;border-radius:0.35rem;"
                   src="@_clientPreviewUrl"
                   @key="_previewVideoKey"
                   onloadeddata="this.play().catch(function(){})">
                Your browser does not support HTML5 video.
            </video>
        </div>
    </div>
}
else if (_showPreviewPlayer && _clientStitching)
{
    <div class="card mb-3 border-secondary" data-testid="scenes-preview-player">
        <div class="card-body py-2 small text-muted">
            Combining selected scenes in browser… @_clientStitchStatus
        </div>
    </div>
}

@if (_verifyingClip)
{
    var vPct = _verifyTotal > 0 ? Math.Min(100, Math.Max(5, (int)Math.Round((double)_verifyCurrent / _verifyTotal * 100.0))) : 0;
    <JobProgressCard Status="running"
                     Message="@_verifyStatusLabel"
                     Index="_verifyCurrent"
                     Total="_verifyTotal"
                     Percent="vPct"
                     TestId="scenes-verify-progress"
                     CssClass="border-info shadow-sm" />
}

@if (_selectedScene is null)
{
    @* ---- Scene list ---- *@
    @if (_scenes is null)
    {
        <EmptyState Message="Loading scenes…" CssClass="text-muted" />
    }
    else if (_scenes.Count == 0)
    {
        <EmptyState Message="No scenes in the shot plan yet."
                    ActionHref="adaptation/shots"
                    ActionLabel="Open shot plan →"
                    CssClass="text-muted" />
    }
    else
    {
        @* Authoritative scene/clip counts for tests, queryable in one place without counting rows. *@
        <div data-testid="scenes-status"
             data-scene-count="@_scenes.Count"
             data-clip-count="@_scenes.Sum(s => s.ClipCount)"
             data-clips-on-disk="@_scenes.Sum(s => s.ClipsOnDisk)"
             data-scenes-complete="@_scenes.Count(s => s.ClipsComplete)"
             class="visually-hidden" aria-hidden="true"></div>
        @* Batch generation is started from THIS all-scenes view, so its progress/message/result must
           show here too — the detail view below has its own copy for single-scene work. Without this,
           confirming Generate from the list started the job but showed nothing (dead-click symptom). *@
        <InlineAlert Message="@_error" CssClass="mb-3" />
        @if (!JobRunning)
        {
            <InlineAlert Message="@_message" Variant="info" CssClass="mb-3" />
        }
        @if (ShowLiveGenProgress && _job is not null)
        {
            <JobProgressCard Status="@_job.Status"
                             Message="@LiveGenStatusLabel(_job)"
                             Index="_job.Index"
                             Total="_job.Total"
                             Percent="LiveGenProgressPercent(_job)"
                             ShowCancel="true"
                             CancelDisabled="_busy"
                             OnCancel="CancelAsync"
                             Kind="@_job.Kind"
                             TestId="scenes-gen-progress"
                             CancelTestId="scenes-gen-cancel" />
        }
        else if (ShowOperatorGenPartial && _job is not null)
        {
            @GenPartialAlert
        }
        else if (ShowOperatorGenError && _job is not null)
        {
            @GenErrorAlert
        }

        <div class="card mb-3 p-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <CapabilityLockedControl Enabled="Caps.VideoReady"
                                             BlockedReason="@Caps.VideoBlockedReason"
                                             SettingsHref="@Caps.VideoSettingsHref"
                                             TestId="scenes-generate-batch-cap">
                    <button type="button"
                            data-testid="scenes-generate-batch"
                            class="btn batch-go @(_selected.Count > 0 && !JobRunning && CastReady ? "batch-go--ready" : "")"
                            disabled="@(_busy || _selected.Count == 0 || JobRunning || !CastReady || SelectedLockedByOther)"
                            title="@(!CastReady ? CastBlockedTitle : SelectedLockedByOther ? "Selection includes scenes locked by another user" : null)"
                            @onclick="OpenGenerateConfirmAsync">
                        @if (JobRunning)
                        {
                            <span class="batch-go__spin" aria-hidden="true"></span>
                            <span>Generating…</span>
                        }
                        else
                        {
                            <span class="batch-go__play" aria-hidden="true">▶</span>
                            <span>
                                Generate @(_selected.Count > 0 ? $"{_selected.Count} scene{(_selected.Count == 1 ? "" : "s")}" : "Batch")
                                @if (_selected.Count > 0)
                                {
                                    <span class="batch-go__meta">· ~@EstimateSelectedClips() clips</span>
                                }
                            </span>
                        }
                    </button>
                    </CapabilityLockedControl>

                    @if (_scenes is not null && VisibleScenes.Any(s => !s.ClipsComplete || s.ClipsOnDisk < s.ClipCount))
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary ms-2"
                                disabled="@_busy"
                                title="Select scenes that still need clips"
                                @onclick="SelectMissingScenes">
                            @L["ScenesPage.SelectMissing"]
                        </button>
                    }


                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button"
                            data-testid="scenes-play-selected"
                            class="btn btn-outline-primary btn-sm"
                            disabled="@(_busy || _clientStitching || !CanPlaySelected)"
                            title="@(CanPlaySelected
                                ? "Stitch selected scenes in the browser (composites or clips)"
                                : _selected.Count == 0
                                    ? "Select one or more scenes first"
                                    : "Selected scenes have no clips or composites to play yet")"
                            @onclick="PlaySelectedAsync">
                        ▶ @L["ScenesPage.PlaySelected"]@(_selected.Count > 0 ? $" ({_selected.Count})" : "")
                    </button>
                    <CapabilityLockedControl Enabled="Caps.VideoReviewReady"
                                             BlockedReason="@Caps.VideoReviewBlockedReason"
                                             SettingsHref="@Caps.VideoReviewSettingsHref"
                                             TestId="scenes-verify-dialogue-cap">
                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            disabled="@(_busy || JobRunning || _verifyingClip || !SelectedScenesHaveClipsToVerify)"
                            title="@(SelectedScenesHaveClipsToVerify
                                ? "Check the spoken words in each finished clip against the screenplay"
                                : _selected.Count == 0
                                    ? "Select one or more scenes with finished clips first"
                                    : "Selected scenes have no finished clips to check yet")"
                            @onclick="VerifySelectedScenesDialogueAsync">
                        🔍 @L["ScenesPage.VerifySceneDialogue"]@(_selected.Count > 0 ? $" ({_selected.Count})" : "")
                    </button>
                    </CapabilityLockedControl>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            disabled="@(_busy || JobRunning)"
                            title="@(_selected.Count > 0
                                ? $"Regenerate only the {_selected.Count} checked scene(s) from the screenplay — other scenes are left untouched"
                                : "Check scenes first to regenerate just those — with nothing checked, this rebuilds every scene from the screenplay")"
                            @onclick="RebuildShotPlanAsync">
                        🔄 @L["ScenesPage.RebuildShotPlan"]
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            data-testid="scenes-add-scene"
                            disabled="@(_busy || JobRunning)"
                            title="Add a new empty scene to the shot plan"
                            @onclick="() => AddSceneAsync(false)">
                        ➕ @L["ScenesPage.AddScene"]
                    </button>
                    @* Credits are auto-inserted into the shot plan; this only re-adds one if it was deleted. *@
                    @if (!HasCreditsScene)
                    {
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                data-testid="scenes-add-credits"
                                disabled="@(_busy || JobRunning)"
                                title="Re-add the end-credits scene (normally added automatically)"
                                @onclick="() => AddSceneAsync(true)">
                            🎬 @L["ScenesPage.AddCredits"]
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-secondary" data-testid="scenes-select-toggle"
                            disabled="@_busy" @onclick="() => _showFilters = !_showFilters">
                        🔍 @L["ScenesPage.Filters"] @(HasActiveFilters ? " (Active)" : "")
                    </button>
                </div>
            </div>

            @* Jump back to the screenplay-shaping phases that otherwise only live under Book. Both edit the
               screenplay, which re-opens it (un-approve + re-gate cast), so each confirms before navigating. *@
            @if (!IsSimpleFilm)
            {
                <div class="mt-2 pt-2 border-top border-secondary d-flex align-items-center gap-2 small flex-wrap">
                    <span class="text-muted">@L["ScenesPage.Screenplay"]</span>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary py-0 px-2"
                            data-testid="scenes-view-screenplay"
                            disabled="@_busy"
                            title="Read the current screenplay (view only — does not re-open it)"
                            @onclick="ViewScreenplay">
                        📄 @L["ScenesPage.View"]
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-outline-info py-0 px-2"
                            data-testid="scenes-goto-fit-length"
                            disabled="@(_busy || JobRunning)"
                            title="Change the movie's target length (extend or shorten)"
                            @onclick="AdjustFitLengthAsync">
                        ⏱ @L["ScenesPage.FitLength"]
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-outline-info py-0 px-2"
                            data-testid="scenes-goto-embellish"
                            disabled="@(_busy || JobRunning)"
                            title="Embellish the scene descriptions"
                            @onclick="AdjustEmbellishAsync">
                        ✨ @L["ScenesPage.Embellish"]
                    </button>
                    <span class="text-muted">· editing re-opens the screenplay (you'll re-approve it &amp; re-check cast)</span>
                </div>
            }

        </div>

        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle">
                <thead>
                    <tr>
                        <th style="width:2.5rem;">
                            <input class="form-check-input" type="checkbox"
                                   data-testid="scenes-select-all"
                                   title="Select all shown scenes"
                                   checked="@AllShownScenesSelected"
                                   disabled="@(_busy || VisibleScenes.Count == 0)"
                                   @onchange="e => ToggleSelectAllShown((bool)(e.Value ?? false))" />
                        </th>
                        <th style="width:7rem; cursor:pointer; user-select:none;" @onclick='() => ToggleSort("number")' title="Click to sort by Scene Number">
                            # @(_sortBy == "number" ? (_sortAscending ? "▲" : "▼") : "⇅")
                        </th>
                        <th>@L["ScenesPage.Setting"]</th>
                        <th>@L["ScenesPage.CastLocation"]</th>
                        <th style="width:6rem;">@L["ReviewPage.Clips"]</th>
                        <th style="width:7.5rem; cursor:pointer; user-select:none;" @onclick='() => ToggleSort("duration")' title="Click to sort by Duration">
                            @L["ReviewPage.Dur"] @(_sortBy == "duration" ? (_sortAscending ? "▲" : "▼") : "⇅")
                        </th>
                        <th style="width:9rem;" title="Score background music for this scene">@L["ScenesPage.Music"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in SortedVisibleScenes)
                    {
                        var sn = s.SceneNumber;
                        var isSel = _selected.Contains(sn);
                        <tr class="@(isSel ? "table-active" : "")" style="cursor:pointer;" @key="sn"
                            data-testid="scene-row" data-scene-number="@sn">
                            <td @onclick:stopPropagation="true">
                                <input class="form-check-input" type="checkbox"
                                       checked="@isSel"
                                       disabled="@_busy"
                                       @onchange="e => ToggleSelect(sn, (bool)(e.Value ?? false))" />
                            </td>
                            <td class="text-nowrap" @onclick="() => OpenSceneAsync(sn)">
                                <span class="badge @(s.ClipsComplete ? "bg-success text-white" : "bg-warning text-dark") px-2 py-1 rounded-pill" style="font-weight:600;">
                                    S@(sn.ToString("D2"))
                                </span>
                                <button type="button"
                                        class="btn btn-sm btn-link text-danger p-0 ms-2 text-decoration-none"
                                        title="Delete scene S@(sn.ToString("D2")) from plan"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => RequestDeleteScene(sn)">
                                    🗑️
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-link text-info p-0 ms-1 text-decoration-none"
                                        title="Open editor for scene S@(sn.ToString("D2"))"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OpenSceneAsync(sn)">
                                    ✏️
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-link text-secondary p-0 ms-1 text-decoration-none"
                                        title="View changes & history for scene S@(sn.ToString("D2"))"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OpenSceneHistoryAsync(sn)">
                                    📜
                                </button>
                                @if (s.LockedByOther)
                                {
                                    <span class="badge bg-warning text-dark ms-1" title="Locked by @s.LockOwnerUserId">🔒 @s.LockOwnerUserId</span>
                                }
                            </td>
                            <td @onclick="() => OpenSceneAsync(sn)">
                                @(s.Setting is { Length: > 0 } set ? Trunc(set, 56) : "—")
                                @if (s.CompositeExists)
                                {
                                    <span class="badge bg-light text-dark border ms-1">mux</span>
                                }
                            </td>
                            <td @onclick="() => OpenSceneAsync(sn)" class="small">
                                @if (s.CharactersOnScreen.Count > 0)
                                {
                                    <span class="text-muted">@string.Join(", ", s.CharactersOnScreen.Select(ShortChar).Take(4))</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                                @if (!string.IsNullOrEmpty(s.PrimaryLocationId) || s.LocationIds.Count > 0)
                                {
                                    <div class="text-muted">
                                        <code>@ShortLoc(s.PrimaryLocationId ?? s.LocationIds.FirstOrDefault() ?? "")</code>
                                    </div>
                                }
                            </td>
                            <td @onclick="() => OpenSceneAsync(sn)" class="text-nowrap">
                                @{ var (pg, pgCls, pgTitle) = SceneProgressGlyph(s); }
                                <span class="@pgCls me-1" title="@pgTitle" aria-label="@pgTitle">@pg</span>
                                <span class="@(s.ClipsComplete ? "text-success" : s.ClipsOnDisk > 0 ? "text-warning" : "text-muted")">
                                    @s.ClipsOnDisk/@s.ClipCount
                                </span>
                            </td>
                            <td @onclick="() => OpenSceneAsync(sn)" class="small">
                                @if (s.ActualDurationSeconds is double act)
                                {
                                    <span title="Measured from composite or clips">@FormatClock(act)</span>
                                    @if (s.PlannedDurationSeconds is double plan && Math.Abs(plan - act) > 1.5)
                                    {
                                        <div class="text-muted" style="font-size:0.75rem;" title="Planned length">plan @FormatClock(plan)</div>
                                    }
                                }
                                else if (s.PlannedDurationSeconds is double planOnly)
                                {
                                    <span class="text-muted" title="Plan only — no media measured">~@FormatClock(planOnly)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td @onclick:stopPropagation="true" class="text-nowrap">
                                <button type="button"
                                        class="btn btn-sm btn-warning text-black fw-bold py-0 px-2"
                                        data-testid="scene-row-score-music"
                                        disabled="@(_busy || JobRunning || _scoringMusic || !Caps.MusicReady || s.LockedByOther)"
                                        title="@(Caps.MusicReady ? "Score background music for this scene" : Caps.MusicBlockedReason)"
                                        @onclick="() => OpenScoreMenu(sn)">
                                    🎵 Score
                                </button>
                                @if (s.HasBackgroundMusic)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-link text-info p-0 ms-1 text-decoration-none"
                                            title="View & compare past audio takes for this scene"
                                            @onclick="() => OpenMusicCompareAsync(sn)">
                                        🎧
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else if (_detail is null)
{
    <p class="text-muted">Loading scene…</p>
}
else
{
    <InlineAlert Message="@_error" CssClass="mb-3" />
    @if (!JobRunning)
    {
        <InlineAlert Message="@_message" Variant="info" CssClass="mb-3" />
    }

    @* Live gen: one compact surface — status + bar + Cancel only (no badges, no Grok dump, no log). *@
    @if (ShowLiveGenProgress && _job is not null)
    {
        <JobProgressCard Status="@_job.Status"
                         Message="@LiveGenStatusLabel(_job)"
                         Index="_job.Index"
                         Total="_job.Total"
                         Percent="LiveGenProgressPercent(_job)"
                         ShowCancel="true"
                         CancelDisabled="_busy"
                         OnCancel="CancelAsync"
                         Kind="@_job.Kind"
                         TestId="scenes-gen-progress"
                         CancelTestId="scenes-gen-cancel" />
    }
    else if (ShowOperatorGenPartial && _job is not null)
    {
        @GenPartialAlert
    }
    else if (ShowOperatorGenError && _job is not null)
    {
        @GenErrorAlert
    }
    else if (Session.IsAdmin && _job is not null &&
             (_job.Status is "done" or "partial" or "error" or "cancelled"))
    {
        @* Admin: finished-job summary only — no live log dump (that belonged under generating). *@
        <div class="card mb-3 border-@(_job.Status == "error" ? "danger" : _job.Status == "partial" ? "warning" : "secondary")">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="small">@(_job.Message ?? _job.Status)</span>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="ReloadListAsync">Refresh list</button>
                </div>
                @if (_job.Log.Count > 0)
                {
                    <button type="button"
                            class="btn btn-sm btn-link text-muted p-0 mt-1 text-decoration-none"
                            @onclick="() => _showAdminJobLog = !_showAdminJobLog">
                        @(_showAdminJobLog ? "Hide details" : "Details (admin)")
                    </button>
                    @if (_showAdminJobLog)
                    {
                        <pre class="small mb-0 mt-1" style="max-height: 120px; overflow: auto;">@string.Join("\n", _job.Log.TakeLast(20))</pre>
                    }
                }
            </div>
        </div>
    }

    @* ---- Scene detail ---- *@
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
                <strong>Scene @(_detail.SceneNumber.ToString("D2"))</strong>
                — @(_detail.Setting is { Length: > 0 } st ? st : "—")
            </span>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button type="button"
                        class="btn btn-sm btn-outline-info"
                        title="View history & changes for this scene"
                        @onclick="() => OpenSceneHistoryAsync(_detail.SceneNumber)">
                    📜 History
                </button>
                <div class="d-flex align-items-center gap-1">
                    <label class="small text-muted mb-0" for="genResDetail">Res</label>
                    <select id="genResDetail"
                            class="form-select form-select-sm"
                            style="width:auto"
                            @bind="_genResolution"
                            @bind:after="RefreshCostEstimateAsync"
                            disabled="@(_busy || ResolutionLocked)"
                            title="@(ResolutionLocked ? $"Locked at {_resolutionLock} — this project already has clips at that resolution." : null)">
                        <option value="480p">480p</option>
                        <option value="720p">720p</option>
                        <option value="1080p">1080p</option>
                    </select>
                    @if (ResolutionLocked)
                    {
                        <span class="small text-muted" title="Locked to on-disk resolution">🔒</span>
                    }
                </div>
                <button class="btn btn-sm btn-success"
                        disabled="@(_busy || JobRunning || (_detail.ClipsOnDisk == 0 && !_detail.CompositeExists))"
                        title="Play scene (browser stitch from clips)"
                        @onclick="() => PlaySceneCompositeAsync(_detail.SceneNumber)">
                    ▶ Play scene
                </button>
                <button class="btn btn-sm btn-outline-secondary"
                        data-testid="clip-add-open"
                        disabled="@(_busy || JobRunning)"
                        title="Add a new clip to this scene (define fields, then generate its video)"
                        @onclick="OpenAddClipDialog">
                    + Add clip
                </button>
                @if (_detail.ClipsOnDisk > 0)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            disabled="@(_busy || JobRunning || _verifyingClip)"
                            title="@(_selectedClips.Count > 0 ? $"Run dialogue & speaker verification on {_selectedClips.Count} selected clip(s)" : "Run dialogue & speaker verification on selected clips in the first column")"
                            @onclick="VerifySelectedScenesDialogueAsync">
                        @(_selectedClips.Count > 0 ? $"🔍 Verify ({_selectedClips.Count}) Selected Clips" : "🔍 Verify Clip Dialogue")
                    </button>
                }
                @* Background music is scored from the All-scenes overview (one control per scene row),
                   since music is a per-scene concern and this view is about the scene's clips. *@
                @if (_detail.HasBackgroundMusic)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-info"
                            disabled="@(_busy || JobRunning)"
                            title="View past audio takes & compare against the current one"
                            @onclick="() => OpenMusicCompareAsync(_detail.SceneNumber)">
                        🎧 Audio Takes
                    </button>
                }
                @if (_detail.CompositeExists || _detail.ClipsOnDisk > 0)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-info"
                            data-testid="scene-open-external-editor"
                            disabled="@(_busy || JobRunning)"
                            title="Open scene video in @_preferredVideoEditor"
                            @onclick="() => OpenInExternalEditorAsync(_detail.SceneNumber, _selectedClip)">
                        🎬 Open in @_preferredVideoEditor
                    </button>
                }
                @if (DetailLockedByOther)
                {
                    <span class="badge bg-warning text-dark">🔒 @_detailLockOwner</span>
                }
            </div>
        </div>
        <div class="card-body">
            <p class="small text-muted mb-2">
                @_detail.ClipsOnDisk/@_detail.ClipCount clips on disk
                @if (_detail.ActualDurationSeconds is double actD)
                {
                    <span>· <strong class="text-body">@FormatClock(actD)</strong> actual</span>
                    @if (_detail.PlannedDurationSeconds is double planD)
                    {
                        <span>· plan @FormatClock(planD)</span>
                    }
                }
                else if (_detail.PlannedDurationSeconds is double planOnly)
                {
                    <span>· plan ~@FormatClock(planOnly)</span>
                }
                @if (_detail.CharactersOnScreen.Count > 0)
                {
                    <span>· cast: @string.Join(", ", _detail.CharactersOnScreen.Select(ShortChar))</span>
                }
                @if (!string.IsNullOrEmpty(_detail.PrimaryLocationId))
                {
                    <span>· loc: <code>@ShortLoc(_detail.PrimaryLocationId)</code></span>
                }
                @{
                    var verifiedCount = _detail.Clips.Count(c => c.DialogueVerification is { } v && (string.Equals(v.Status, "verified", StringComparison.OrdinalIgnoreCase) || string.Equals(v.Status, "no_speech", StringComparison.OrdinalIgnoreCase)));
                    var totalWithDialogue = _detail.Clips.Count(c => !string.IsNullOrWhiteSpace(c.Dialogue));
                }
                @if (totalWithDialogue > 0 && verifiedCount > 0)
                {
                    <span>· <span class="text-success fw-semibold" title="Clips with dialogue verified via native video/audio QA">✓ @verifiedCount/@totalWithDialogue dialogue verified</span></span>
                }
            </p>

            @* Full scene composite — hide while clip selected, remux/gen busy, or full player open *@
            @if (IsSceneGenBusy(_detail.SceneNumber))
            {
                <p class="small text-muted mb-2">
                    Scene composite hidden while combining…
                </p>
            }
            else if (_showScenePlayer && _playingScene == _detail.SceneNumber)
            {
                <p class="small text-muted mb-2">
                    Playing full scene above.
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="HideScenePlayer">Show inline preview</button>
                </p>
            }
            else if (_detail.CompositeExists && _selectedClip is null)
            {
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h6 class="text-muted mb-0">Scene composite <span class="small fw-normal">(all clips · full scene)</span></h6>
                        <button class="btn btn-sm btn-link" type="button"
                                @onclick="() => PlaySceneCompositeAsync(_detail.SceneNumber)">
                            Play full scene
                        </button>
                    </div>
                    <video controls playsinline
                           style="max-width:100%; max-height:280px; background:#111; border-radius:0.35rem;"
                           src="@(_sceneCompositeVideoUrl ?? _sceneCompositeServerUrl)"
                           @key="_inlineCompositeKey"
                           poster=""></video>
                    <p class="small text-muted mb-0 mt-1">
                        Scene composite on disk (~@(_detail.ActualDurationSeconds is double ad ? FormatClock(ad) : "?")).
                        Select a clip row below to play one clip only.
                    </p>
                </div>
            }
            else if (_detail.CompositeExists && _selectedClip is int)
            {
                <p class="small text-muted mb-2">
                    Viewing single clip — full scene composite hidden.
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => SelectClip(null)">Show scene composite</button>
                </p>
            }

            @{
                var hasMissingClips = _detail.Clips.Any(c => !c.OnDisk);
            }
            @if (hasMissingClips || _selectedClips.Count > 0)
            {
                <div class="d-flex align-items-center flex-wrap gap-2 mb-2" data-testid="clip-select-bar">
                    @if (hasMissingClips)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                data-testid="clip-select-missing"
                                disabled="@_busy"
                                title="Check clips not yet on disk"
                                @onclick="SelectMissingClips">
                            Select missing
                        </button>
                    }
                    @if (_detail.Clips.Any(c => c.DialogueVerification is { Status: "mismatch" } or { Status: "speaker_swap" }))
                    {
                        <button type="button"
                                class="btn btn-sm btn-warning text-black fw-semibold"
                                data-testid="clip-select-mismatched"
                                disabled="@_busy"
                                title="Check all clips in this scene with dialogue mismatches or speaker swaps"
                                @onclick="SelectMismatchedClips">
                            Select mismatched (@_detail.Clips.Count(c => c.DialogueVerification is { Status: "mismatch" } or { Status: "speaker_swap" }))
                        </button>
                    }
                    @if (_selectedClips.Count > 0)
                    {
                        <span class="small">
                            <strong>@_selectedClips.Count</strong> selected
                            @if (EstimateSelectedClipsCostUsd() is { } scc)
                            {
                                <span class="text-muted">· ~$@(scc.ToString("0.00"))</span>
                            }
                        </span>
                        <button type="button" class="btn btn-sm btn-warning"
                                data-testid="clip-batch-regen"
                                disabled="@(_busy || JobRunning || !CastReady || DetailLockedByOther)"
                                title="@(!CastReady
                                    ? CastBlockedTitle
                                    : DetailLockedByOther
                                    ? $"Locked by {_detailLockOwner}"
                                    : "Generate (or re-generate) every selected clip")"
                                @onclick="RegenSelectedClipsAsync">
                            Generate selected
                        </button>
                    }
                </div>
            }

            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width:2rem;">
                                <input class="form-check-input" type="checkbox"
                                       data-testid="clip-select-all"
                                       title="Select all clips"
                                       checked="@AllClipsSelected"
                                       disabled="@(_busy || _detail is not { Clips.Count: > 0 })"
                                       @onchange="e => ToggleSelectAllClips((bool)(e.Value ?? false))" />
                            </th>
                            <th style="width:7rem;">Clip</th>
                            <th style="width:6rem; cursor:pointer; user-select:none;"
                                @onclick="ToggleClipDurationSort"
                                title="Click to sort by duration">
                                Dur @(_clipSortByDuration ? (_clipSortAscending ? "▲" : "▼") : "⇅")
                            </th>
                            <th>Dialogue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in SortedDetailClips)
                        {
                            var active = _selectedClip == c.ClipNumber;
                            var cn = c.ClipNumber;
                            var isChecked = _selectedClips.Contains(cn);
                            <tr class="@(active ? "table-primary" : isChecked ? "table-warning" : "")" style="cursor:pointer;"
                                @onclick="() => SelectClip(cn)">
                                <td @onclick:stopPropagation="true">
                                    <input class="form-check-input" type="checkbox"
                                           data-testid="@($"clip-select-{cn}")"
                                           checked="@isChecked"
                                           disabled="@_busy"
                                           @onchange="e => ToggleClipSelect(cn, (bool)(e.Value ?? false))" />
                                </td>
                                <td class="text-nowrap" @onclick:stopPropagation="true">
                                    @{
                                        var clipBusy = IsClipGenBusy(cn);
                                    }
                                    @if (clipBusy)
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1 rounded-pill font-monospace me-1" style="font-size:0.8rem;"
                                              title="Generating — file is about to change">⏳ C@(cn.ToString("D2"))</span>
                                    }
                                    else if (c.OnDisk)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-success rounded-pill px-2 py-0 font-monospace fw-semibold align-baseline me-1 shadow-sm"
                                                style="font-size:0.78rem; border-width:1px;"
                                                title="Click to play clip C@(cn.ToString("D2")) video"
                                                @onclick="() => SelectClip(cn)">
                                            ▶ Play C@(cn.ToString("D2"))
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-light px-2 py-1 rounded-pill font-monospace me-1" style="font-size:0.8rem;"
                                              title="Not on disk yet">C@(cn.ToString("D2"))</span>
                                    }
                                    @if (c.DialogueVerification is { } ver)
                                    {
                                        var isNoSpeechFail = string.Equals(ver.Status, "no_speech", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(ver.ExpectedDialogue);
                                        var (badgeClass, badgeText) = ver.Status?.ToLowerInvariant() switch
                                        {
                                            "verified" => ("bg-success-subtle text-success border border-success-subtle", $"✓ Verified ({ver.DialogueAccuracyScore:P0})"),
                                            "speaker_swap" => ("bg-danger-subtle text-danger border border-danger-subtle", "⚠ Speaker Swap"),
                                            "mismatch" => ("bg-warning-subtle text-warning border border-warning-subtle", $"⚠ Mismatch ({ver.DialogueAccuracyScore:P0})"),
                                            "no_speech" when isNoSpeechFail => ("bg-danger-subtle text-danger border border-danger-subtle", "⚠ No speech (0%)"),
                                            "no_speech" => ("bg-secondary-subtle text-secondary border border-secondary-subtle", "✓ No speech"),
                                            _ => ("bg-secondary-subtle text-secondary border border-secondary-subtle", ver.Status ?? "unverified"),
                                        };
                                        <button type="button" class="btn btn-sm p-0 border-0 align-baseline"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => OpenVerificationModal(_detail.SceneNumber, cn, ver)">
                                            <span class="badge @badgeClass ms-1 d-inline-block text-center" style="min-width: 140px; cursor:pointer; padding: 0.35em 0.6em; font-size: 0.75rem;" title="Click to view verification report details">
                                                @badgeText 📋
                                            </span>
                                        </button>
                                    }
                                    <button type="button"
                                            class="btn btn-sm btn-outline-info py-0 px-1 ms-2 text-decoration-none small"
                                            disabled="@(_busy || JobRunning)"
                                            title="View past takes & version comparison grid for this clip"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OpenClipCompareAsync(_detail.SceneNumber, cn)">
                                        🎬 Takes
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-link text-danger p-0 ms-2 text-decoration-none"
                                            data-testid="@($"clip-delete-{cn}")"
                                            disabled="@(_busy || JobRunning)"
                                            title="Delete this clip (video + shot plan entry)"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => RequestDeleteClip(_detail.SceneNumber, cn)">
                                        🗑️
                                    </button>
                                </td>
                                <td class="small">
                                    @if (c.ActualDurationSeconds is double ca)
                                    {
                                        <span>@FormatClock(ca)</span>
                                        @if (c.DurationSeconds > 0 && Math.Abs(c.DurationSeconds - ca) > 1.5)
                                        {
                                            <span class="text-muted"> · plan @c.DurationSeconds s</span>
                                        }
                                    }
                                    else if (c.DurationSeconds > 0)
                                    {
                                        <span class="text-muted">~@c.DurationSeconds s</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small clip-dialogue-cell"
                                    title="@(string.IsNullOrWhiteSpace(c.Dialogue) ? "Click to add dialogue" : c.Dialogue + " (click to edit)")"
                                    style="cursor:pointer;"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => OpenClipEditor(c)">
                                    @if (string.IsNullOrWhiteSpace(c.Dialogue))
                                    {
                                        <span class="clip-dialogue-link clip-dialogue-link--empty">—</span>
                                    }
                                    else
                                    {
                                        <span class="clip-dialogue-link">@Trunc(c.Dialogue, 90)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (_clip is not null)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>
                    Clip <code>S@(_detail.SceneNumber.ToString("D2"))C@(_clip.ClipNumber.ToString("D2"))</code>
                    @if (!string.IsNullOrEmpty(_clip.Timestamp))
                    {
                        <span class="text-muted ms-2">@_clip.Timestamp</span>
                    }
                </span>
                <div class="d-flex gap-1">
                    @{
                        var clipNeedsPrev = PreviousClipMissing(_clip.ClipNumber);
                    }
                    <button class="btn btn-sm btn-outline-warning"
                            disabled="@(_busy || JobRunning || !CastReady || clipNeedsPrev)"
                            title="@(!CastReady
                                ? CastBlockedTitle
                                : clipNeedsPrev
                                ? $"Generate C{(_clip.ClipNumber - 1):D2} first — continues from previous video"
                                : "Force re-generate this clip (overwrites if present)")"
                            @onclick="() => RegenClipAsync(_detail.SceneNumber, _clip.ClipNumber)">
                        Regen clip
                    </button>
                    <button class="btn btn-sm btn-outline-primary"
                            data-testid="clip-video-edit-open"
                            disabled="@(_busy || JobRunning || !_clip.OnDisk || ClipExceedsEditDurationCap(_clip))"
                            title="@(!_clip.OnDisk
                                ? "Generate this clip first"
                                : ClipExceedsEditDurationCap(_clip)
                                ? $"Clip is {(_clip.ActualDurationSeconds ?? _clip.DurationSeconds):0.#}s — Grok can only edit clips up to {MaxVideoEditInputSeconds:0.#}s"
                                : "Edit this clip with an AI text prompt (new take, spends provider credit)")"
                            @onclick="OpenVideoEditPrompt">
                        ✂️ AI Edit
                    </button>
                    <button class="btn btn-sm btn-outline-info"
                            disabled="@(_busy || JobRunning)"
                            title="View past takes & version comparison grid for this clip"
                            @onclick="() => OpenClipCompareAsync(_detail.SceneNumber, _clip.ClipNumber)">
                        🎬 Takes (@(_clipVersions?.Count ?? 1))
                    </button>
                    <button class="btn btn-sm btn-outline-secondary"
                            disabled="@(_busy || JobRunning)"
                            title="Edit clip fields (dialogue, prompt, characters, lighting…)"
                            @onclick="() => OpenClipEditor(_clip)">
                        Edit clip
                    </button>
                    <button class="btn btn-sm btn-outline-danger"
                            disabled="@(_busy || JobRunning)"
                            title="Delete this clip (video + shot plan entry)"
                            @onclick="() => RequestDeleteClip(_detail.SceneNumber, _clip.ClipNumber)">
                        Delete clip
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => SelectClip(null)">Close</button>
                </div>
            </div>
            <div class="card-body row">
                <div class="col-md-5 mb-3">
                    @if (_clip.OnDisk)
                    {
                        <div class="small text-success mb-1">
                            Single clip only
                            @if (_clip.ActualDurationSeconds is double cad)
                            {
                                <span>· @FormatClock(cad)</span>
                            }
                            · not the full scene
                        </div>
                        @if (_clipVideoLoading)
                        {
                            <MediaDownloadProgress Label="Checking for a newer local copy…" ShowProgress="false" />
                        }
                        else
                        {
                            <video controls playsinline autoplay
                                   style="width:100%; max-height:320px; background:#111; border-radius:0.35rem;"
                                   src="@(_clipVideoUrl ?? _clipServerVideoUrl)"
                                   @key="@($"clip-{_detail.SceneNumber}-{_clip.ClipNumber}-{_clipVideoKey}")"
                                   onloadeddata="this.play().catch(function(){})"></video>
                        }
                        <div class="small text-muted mt-1">
                            @_clip.FileName · @FormatSize(_clip.SizeBytes)
                            · <a href="@Engine.ClipVideoUrl(_projectId, _detail.SceneNumber, _clip.ClipNumber)" target="_blank" rel="noopener">open clip URL</a>
                        </div>
                    }
                    else
                    {
                        <div class="border rounded p-4 text-center text-muted">
                            No video on disk
                            @if (PreviousClipMissing(_clip.ClipNumber))
                            {
                                <div class="small text-warning mt-2">
                                    Generate C@((_clip.ClipNumber - 1).ToString("D2")) first — this clip continues from the previous video.
                                </div>
                            }
                            <div class="mt-2">
                                <button class="btn btn-sm btn-warning"
                                        disabled="@(_busy || JobRunning || !CastReady || PreviousClipMissing(_clip.ClipNumber))"
                                        title="@(!CastReady
                                            ? CastBlockedTitle
                                            : PreviousClipMissing(_clip.ClipNumber)
                                            ? $"Need C{(_clip.ClipNumber - 1):D2} on disk"
                                            : null)"
                                        @onclick="() => RegenClipAsync(_detail.SceneNumber, _clip.ClipNumber)">
                                    Generate this clip
                                </button>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-7">
                    <h6>Visual prompt</h6>
                    <pre class="small bg-light border rounded p-2" style="max-height:200px; overflow:auto; white-space:pre-wrap;">@(_clip.VisualPrompt is { Length: > 0 } vp ? vp : "—")</pre>

                    <button class="btn btn-sm btn-outline-secondary mb-2"
                            @onclick="() => OpenClipCompareAsync(_detail.SceneNumber, _clip.ClipNumber)">
                        🎬 Takes (@(_clipVersions?.Count ?? 1))
                    </button>
                    }
                    <h6 class="mt-2">Negative</h6>
                    @if (!string.IsNullOrWhiteSpace(_clip.NegativePrompt))
                    {
                        <pre class="small bg-light border rounded p-2" style="max-height:80px; overflow:auto; white-space:pre-wrap;">@_clip.NegativePrompt</pre>
                        <div class="form-text small">Plus global bans at gen (text/watermarks/limbs/name tags…).</div>
                    }
                    else
                    {
                        <p class="small text-muted mb-0">
                            No clip-specific extras. Global bans still apply at video gen
                            (no legible text, watermarks, logos, extra limbs, name tags…).
                        </p>
                    }
                    <h6>Audio</h6>
                    <p class="small mb-1">
                        <strong>@(string.IsNullOrEmpty(_clip.Speaker) ? "—" : ShortChar(_clip.Speaker))</strong>
                        @if (!string.IsNullOrEmpty(_clip.Delivery))
                        {
                            <span class="text-muted">· @ShortDelivery(_clip.Delivery)</span>
                        }
                    </p>
                    @if (_clip.Dialogue is { Length: > 0 } fullDlg)
                    {
                        <pre class="small bg-light border rounded p-2 mb-2" style="cursor:pointer;
                             max-height:160px; overflow:auto; white-space:pre-wrap; word-break:break-word;"
                             @onclick="() => OpenClipEditor(_clip)" title="Click to edit">@fullDlg</pre>
                    }
                    else
                    {
                        <p class="small text-muted" style="cursor:pointer;" @onclick="() => OpenClipEditor(_clip)" title="Click to add dialogue">— (click to add)</p>
                    }
                    @if (_clip.DialogueVerification is { } ver)
                    {
                        @if (string.Equals(ver.Status, "verified", StringComparison.OrdinalIgnoreCase))
                        {
                            <button type="button" class="btn btn-sm p-0 border-0 text-start align-baseline"
                                    @onclick="() => OpenVerificationModal(_detail.SceneNumber, _clip.ClipNumber, ver)">
                                <div class="badge bg-success-subtle text-success border border-success-subtle rounded-pill mb-2 px-2 py-1 small" style="cursor:pointer;" title="Click to view complete verification report">
                                    ✓ Dialogue &amp; Speaker Verified (@($"{ver.DialogueAccuracyScore:P0}")) 📋
                                </div>
                            </button>
                        }
                        else if (string.Equals(ver.Status, "speaker_swap", StringComparison.OrdinalIgnoreCase))
                        {
                            <button type="button" class="btn btn-sm p-0 border-0 text-start align-baseline"
                                    @onclick="() => OpenVerificationModal(_detail.SceneNumber, _clip.ClipNumber, ver)">
                                <div class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill mb-2 px-2 py-1 small" style="cursor:pointer;" title="Click to view complete verification report">
                                    ⚠ Speaker Swap (Expected @ver.ExpectedSpeaker, Detected @(ver.DetectedSpeaker ?? "Other")) 📋
                                </div>
                            </button>
                        }
                        else if (string.Equals(ver.Status, "mismatch", StringComparison.OrdinalIgnoreCase))
                        {
                            <button type="button" class="btn btn-sm p-0 border-0 text-start align-baseline"
                                    @onclick="() => OpenVerificationModal(_detail.SceneNumber, _clip.ClipNumber, ver)">
                                <div class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill mb-2 px-2 py-1 small" style="cursor:pointer;" title="Click to view complete verification report">
                                    ⚠ Dialogue Mismatch (@($"{ver.DialogueAccuracyScore:P0}")) 📋
                                </div>
                            </button>
                        }

                        @if (!string.IsNullOrWhiteSpace(ver.TranscribedDialogue) || !string.IsNullOrWhiteSpace(ver.DetectedSpeaker))
                        {
                            <div class="p-2 mb-2 rounded bg-body-tertiary border border-secondary-subtle x-small text-start">
                                <div class="mb-1">
                                    <span class="fw-bold me-1">Speaker:</span>
                                    <span>Expected <em>@(ver.ExpectedSpeaker ?? "None")</em></span>
                                    @if (!string.IsNullOrWhiteSpace(ver.DetectedSpeaker))
                                    {
                                        <span class="ms-1">· Heard <em>@ver.DetectedSpeaker</em></span>
                                    }
                                </div>
                                @RenderDiffHtml(ver.ExpectedDialogue, ver.TranscribedDialogue)
                            </div>
                        }

                        @if (_musicTrashVersions is { Count: > 0 })
                        {
                            <hr class="border-secondary my-4" />
                            <button type="button" class="btn btn-sm btn-outline-secondary text-white mb-2"
                                    @onclick="() => _showMusicTrash = !_showMusicTrash">
                                Deleted takes (@_musicTrashVersions.Count) @(_showMusicTrash ? "▲ Hide" : "▼ Show")
                            </button>
                            @if (_showMusicTrash)
                            {
                                @foreach (var take in _musicTrashVersions)
                                {
                                    <div class="card bg-dark border-secondary p-2 mb-2 opacity-75">
                                        <div class="d-flex justify-content-between align-items-center gap-2">
                                            <span class="small text-muted">@take.CreatedAtUtc.ToLocalTime().ToString("g")</span>
                                            <button type="button" class="btn btn-sm btn-outline-info"
                                                    disabled="@_promotingMusicVersion"
                                                    @onclick="() => RestoreMusicVersionAsync(_compareMusicSceneNumber, take.TakeId)">
                                                Restore take
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        }
                    }
                    @if (_clip.OnDisk)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill mb-2 px-2 py-0 ms-1 small"
                                disabled="@_verifyingClip"
                                @onclick="() => VerifyClipDialogueManualAsync(_clip)"
                                title="Run automated dialogue verification on this existing clip">
                            @(_verifyingClip && _verifyingClipNumber == _clip.ClipNumber ? "Verifying..." : "Verify Dialogue")
                        </button>
                    }
                    @if (_clip.CharactersOnScreen.Count > 0)
                    {
                        <p class="small text-muted mb-1">on screen: @string.Join(", ", _clip.CharactersOnScreen.Select(ShortChar))</p>
                    }
                    <p class="small text-muted mb-0">
                        subject: @(_clip.PrimarySubject is { Length: > 0 } ps ? ps : "—")
                        · continuation: @_clip.Continuation
                        · @_clip.DurationSeconds s
                    </p>
                </div>
            </div>
            <div class="card-footer small text-muted">
                Use <strong>Play scene</strong> to preview video or <a href="review">Review</a> to rate takes.
            </div>
        </div>
    }
}
} @* end CanScenes gate *@

@if (_deleteSceneTarget is int deleteSn)
{
    <ConfirmModal Visible="true" Title="@($"Delete Scene S{deleteSn:D2}?")"
                  ConfirmLabel="Delete Scene" Busy="_busy"
                  OnConfirm="ConfirmDeleteSceneAsync" OnCancel="() => { _deleteSceneTarget = null; }">
        Are you sure you want to delete <strong>Scene @deleteSn.ToString("D2")</strong> from the shot plan?
        <div class="text-muted small mt-2">
            Note: You can easily restore missing scenes anytime by clicking <strong>Regenerate Selected Scenes</strong> with nothing checked (rebuilds every scene from the screenplay).
        </div>
    </ConfirmModal>
}

@if (_deleteClipTarget is { } delTarget)
{
    <ConfirmModal Visible="true" Title="Delete clip?" ConfirmLabel="Delete clip"
                  ConfirmTestId="clip-delete-confirm" Busy="_busy" BodyClass="" BackdropOpacity=".45"
                  OnConfirm="ConfirmDeleteClipAsync" OnCancel="CancelDeleteClip">
        <p class="mb-0">
            Delete <code>S@(delTarget.Scene.ToString("D2"))C@(delTarget.Clip.ToString("D2"))</code>?
            This removes the video file and its shot-plan entry — cannot be undone.
            Play scene / Play WIP afterward to drop it from the assembled cut.
        </p>
    </ConfirmModal>
}

@if (_clipEditor is { } ed)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true"
         style="background:rgba(0,0,0,.45);" @onclick="CloseClipEditor">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title" data-testid="clip-editor-title">
                        @(_clipEditorIsNew ? "Add clip" : "Edit clip") <code>S@(ed.Scene.ToString("D2"))C@(ed.Clip.ToString("D2"))</code>
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseClipEditor"></button>
                </div>
                <div class="modal-body">
                    <InlineAlert Message="@_error" CssClass="p-2 small mb-3" />
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small mb-0">Clip number</label>
                            <input type="number" class="form-control form-control-sm" min="1"
                                   data-testid="clip-editor-number"
                                   @bind="ed.Clip" disabled="@(!_clipEditorIsNew)" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small mb-0">Duration (s)</label>
                            <input type="number" class="form-control form-control-sm"
                                   min="0" max="12"
                                   @bind="ed.DurationSeconds" />
                            <div class="form-text small">0 = unset · 3–12s if set</div>
                        </div>
                        <div class="col-4">
                            <label class="form-label small mb-0">Primary subject</label>
                            <select class="form-select form-select-sm" @bind="ed.PrimarySubject">
                                <option value="">— none —</option>
                                @foreach (var ck in CharacterOptions)
                                {
                                    <option value="@ck">@ShortChar(ck)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <h6 class="mb-1">Characters</h6>
                    <div class="d-flex flex-wrap gap-2 mb-3 p-2 border rounded">
                        @if (CharacterOptions.Count == 0)
                        {
                            <span class="small text-muted">No characters yet — add them on the Characters page.</span>
                        }
                        @foreach (var ck in CharacterOptions)
                        {
                            var isOn = _clipEditorCast.Contains(ck);
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="checkbox" id="@($"cast-{ck}")"
                                       checked="@isOn"
                                       @onchange="e => ToggleClipEditorCast(ck, (bool)(e.Value ?? false))" />
                                <label class="form-check-label small" for="@($"cast-{ck}")">@ShortChar(ck)</label>
                            </div>
                        }
                    </div>

                    <h6 class="mb-1">Visual</h6>
                    <label class="form-label small mb-0">Prompt <span class="text-danger">*</span></label>
                    <textarea class="form-control form-control-sm mb-3" rows="4" required
                              placeholder="Required — action / framing for this take"
                              @bind="ed.VisualPrompt"></textarea>

                    <h6 class="mb-1">Dialogue</h6>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small mb-0">Speaker</label>
                            <select class="form-select form-select-sm" @bind="ed.Speaker">
                                <option value="">— none —</option>
                                @foreach (var ck in CharacterOptions)
                                {
                                    <option value="@ck">@ShortChar(ck)</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Delivery</label>
                            <select class="form-select form-select-sm" @bind="ed.Delivery">
                                <option value="">— none —</option>
                                <option value="spoken_on_camera">Spoken (on camera)</option>
                                <option value="voiceover_internal">Voiceover (internal)</option>
                                <option value="off_camera">Off camera</option>
                            </select>
                        </div>
                    </div>
                    <textarea class="form-control form-control-sm mb-1" rows="2"
                              data-testid="clip-editor-dialogue"
                              placeholder="Dialogue / voiceover text (requires speaker + delivery)…"
                              @bind="ed.Dialogue"></textarea>
                    <div class="form-text small mb-2">
                        Silent clips: leave speaker none and dialogue empty. Spoken/VO lines need both a speaker and a delivery other than none.
                    </div>
                    <label class="form-label small mb-0 mt-1">Pronunciation hint</label>
                    <input type="text" class="form-control form-control-sm mb-1"
                           data-testid="clip-editor-pronunciation-hint"
                           placeholder="Optional — e.g. Pronounce 'tear' as verb /tɛər/ ('tare' / rip apart)"
                           @bind="ed.PronunciationHint" />
                    <div class="form-text small mb-3">
                        Phonetic guidance for homographs or unusual names (e.g. tear, lead, wind, bow).
                    </div>

                    <!-- Collapsible Advanced Options -->
                    <div class="mb-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 text-start d-flex justify-content-between align-items-center"
                                @onclick="() => _showEditClipAdvanced = !_showEditClipAdvanced">
                            <span>⚙️ Advanced options (Negative prompt, Lighting &amp; Color, Film stock)</span>
                            <span>@(_showEditClipAdvanced ? "▲ Hide" : "▼ Expand")</span>
                        </button>

                        @if (_showEditClipAdvanced)
                        {
                            <div class="p-3 border border-top-0 rounded-bottom bg-dark bg-opacity-75 border-secondary border-opacity-50 text-white">
                                <label class="form-label small mb-1 fw-medium text-light">Negative prompt (clip extras)</label>
                                <textarea class="form-control form-control-sm mb-1 bg-dark text-white border-secondary" rows="2" @bind="ed.NegativePrompt"
                                          placeholder="Optional — story-specific bans only"></textarea>
                                <div class="form-text small mb-3 text-muted">
                                    Empty is normal. Shared global bans (no watermarks, logos, extra limbs, name tags) are automatically applied at video gen.
                                </div>

                                <h6 class="mb-2 fw-semibold text-light">Lighting &amp; Color</h6>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small mb-1 text-light">Color palette</label>
                                        <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="ed.ColorPalette"
                                               placeholder="e.g. Warm golden hour, Neon noir" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small mb-1 text-light">Film stock / Lens</label>
                                        <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="ed.FilmStock"
                                               placeholder="e.g. 35mm anamorphic, Kodak Vision3" />
                                    </div>
                                </div>
                                <div class="form-text small mt-2 mb-0 text-muted">
                                    Empty is fine. Shot plan bakes grading into the visual prompt; fill these only to pin palette or stock for this clip.
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <span class="small text-muted me-auto">
                        @(_clipEditorIsNew
                            ? "Creates the shot-plan entry only — generate its video afterward."
                            : "Regen the clip afterward to re-render video/audio with these fields.")
                    </span>
                    <button type="button" class="btn btn-sm btn-secondary" disabled="@_busy" @onclick="CloseClipEditor">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" data-testid="clip-editor-save"
                            disabled="@_busy" @onclick="SaveClipEditorAsync">
                        @(_clipEditorIsNew ? "Add clip" : "Save clip")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Scene History & Revert Modal *@
@if (_showSceneHistory)
{
    <DarkModalShell Visible="true" OnClose="CloseSceneHistory" HeaderClass="" TitleClass="" DialogClass="modal-lg modal-dialog-scrollable">
        <Title>Scene S@(_historySceneNumber.ToString("D2")) History &amp; Changes</Title>
        <ChildContent>
                    <InlineAlert Message="@_sceneRevertMessage" Variant="info" CssClass="py-2 mb-3" />

                    @if (_loadingHistory)
                    {
                        <p class="text-muted">Loading scene changes…</p>
                    }
                    else if (_sceneHistory is null || _sceneHistory.Count == 0)
                    {
                        <p class="text-muted">No change history recorded for this scene yet.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in _sceneHistory)
                            {
                                <div class="list-group-item bg-dark text-white border-secondary py-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <strong>@item.Message</strong>
                                            <div class="small text-muted">
                                                <code>@item.ShortHash</code> · by @item.Author · @item.CommittedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                            </div>
                                        </div>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-warning"
                                                disabled="@_revertingScene"
                                                @onclick="() => RevertSceneToVersionAsync(_historySceneNumber, item.CommitHash)">
                                            Revert to version
                                        </button>
                                    </div>
                                    @if (item.Changes.Count > 0)
                                    {
                                        <ul class="small text-secondary mb-0 ps-3">
                                            @foreach (var change in item.Changes)
                                            {
                                                <li>@change</li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }
                        </div>
                    }
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseSceneHistory">Close</button>
        </Footer>
    </DarkModalShell>
}

@* Clip Version Take Comparison Grid & Trash Bin Modal *@
@if (_showClipCompare)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.6);" role="dialog">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="modal-title m-0">Takes &amp; Versions — Scene S@(_compareSceneNumber.ToString("D2")) Clip C@(_compareClipNumber.ToString("D2"))</h5>
                    <div class="d-flex align-items-center gap-2">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn @(_compareGridView ? "btn-secondary active" : "btn-outline-secondary")" @onclick="() => _compareGridView = true">
                                Grid View
                            </button>
                            <button type="button" class="btn @(!_compareGridView ? "btn-secondary active" : "btn-outline-secondary")" @onclick="() => _compareGridView = false">
                                Split View
                            </button>
                        </div>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseClipCompare"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <InlineAlert Message="@_clipCompareMessage" Variant="info" CssClass="py-2 mb-3" />

                    @if (_loadingClipVersions)
                    {
                        <p class="text-muted">Loading clip take history…</p>
                    }
                    else if (_clipVersions is null || _clipVersions.Count == 0)
                    {
                        <p class="text-muted">No takes recorded yet for this clip.</p>
                    }
                    else if (_compareGridView)
                    {
                        @* Multi-Card Take Comparison Grid *@
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                            @foreach (var v in _clipVersions)
                            {
                                var isCurrent = v.IsCurrent;
                                var videoUrl = CompareVideoUrl(v);

                                <div class="col">
                                    <div class="card bg-dark border-secondary h-100 p-2 @(isCurrent ? "border-success shadow-sm" : "")">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge @(isCurrent ? "bg-success" : "bg-primary")">
                                                @(isCurrent ? "★ Active Take" : $"Take {v.Take}")
                                            </span>
                                            <span class="small text-muted">@v.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                        </div>

                                        <video controls playsinline style="width:100%;max-height:220px;background:#000;border-radius:0.35rem;" src="@videoUrl">
                                            Your browser does not support HTML5 video.
                                        </video>

                                        <div class="mt-2 small text-secondary flex-grow-1">
                                            @if (!string.IsNullOrWhiteSpace(v.VisualPrompt))
                                            {
                                                <div class="text-truncate" title="@v.VisualPrompt"><strong>Prompt:</strong> @v.VisualPrompt</div>
                                            }
                                            <div><strong>Model / Res:</strong> @(!string.IsNullOrEmpty(v.Model) ? v.Model : "Default") (@(!string.IsNullOrEmpty(v.Resolution) ? v.Resolution : "480p")) · @(v.DurationSeconds > 0 ? v.DurationSeconds.ToString("F1") + "s" : "")</div>
                                            @if (v.ClientOnly)
                                            {
                                                <div class="text-info">📱 Stored on your device</div>
                                            }
                                        </div>

                                        <div class="d-flex gap-2 mt-3">
                                            @if (isCurrent)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success w-100" disabled>
                                                    ✓ Active Take
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-warning text-dark fw-semibold flex-grow-1"
                                                        disabled="@(_promotingVersion || v.ClientOnly)"
                                                        title="@(v.ClientOnly ? "This take is stored on your device only — reconnect your folder to sync it back before selecting it" : null)"
                                                        @onclick="() => PromoteClipVersionAsync(_compareSceneNumber, _compareClipNumber, v.VersionId)">
                                                    ★ Select &amp; Keep
                                                </button>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        disabled="@(_promotingVersion || v.ClientOnly)"
                                                        title="@(v.ClientOnly ? "This take is stored on your device only — reconnect your folder to sync it back before deleting it" : "Delete this take")"
                                                        @onclick="() => SoftDeleteClipVersionAsync(_compareSceneNumber, _compareClipNumber, v.VersionId)">
                                                    🗑️
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @* Split View: Current vs Selected *@
                        var activeVersion = _clipVersions.FirstOrDefault(v => v.IsCurrent) ?? _clipVersions.First();
                        var comparedVersion = _selectedCompareVersion ?? _clipVersions.FirstOrDefault(v => !v.IsCurrent) ?? activeVersion;

                        <div class="row g-3">
                            <div class="col-md-6 border-end border-secondary">
                                <div class="card bg-dark border-secondary h-100 p-2">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-success">★ Active Take</span>
                                        <span class="small text-muted">Take @activeVersion.Take · @activeVersion.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                    </div>
                                    <video controls playsinline style="width:100%;max-height:40vh;background:#000;border-radius:0.35rem;" src="@CompareVideoUrl(activeVersion)">
                                        Your browser does not support HTML5 video.
                                    </video>
                                    <div class="mt-2 small text-secondary">
                                        <div><strong>Prompt:</strong> @(activeVersion.VisualPrompt.Length > 0 ? activeVersion.VisualPrompt : "—")</div>
                                        <div><strong>Model / Res:</strong> @activeVersion.Model (@activeVersion.Resolution) · @activeVersion.DurationSeconds.ToString("F1")s</div>
                                        @if (activeVersion.ClientOnly)
                                        {
                                            <div class="text-info">📱 Stored on your device</div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card bg-dark border-secondary h-100 p-2">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-info text-dark">Selected Take</span>
                                        @if (_clipVersions.Count(v => !v.IsCurrent) > 0)
                                        {
                                            <select class="form-select form-select-sm w-auto" @bind="_selectedCompareVersionId">
                                                @foreach (var v in _clipVersions.Where(v => !v.IsCurrent))
                                                {
                                                    <option value="@v.VersionId">Take @v.Take (@v.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt"))</option>
                                                }
                                            </select>
                                        }
                                    </div>
                                    <video controls playsinline style="width:100%;max-height:40vh;background:#000;border-radius:0.35rem;" src="@CompareVideoUrl(comparedVersion)">
                                        Your browser does not support HTML5 video.
                                    </video>
                                    <div class="mt-2 small text-secondary">
                                        <div><strong>Prompt:</strong> @(comparedVersion.VisualPrompt.Length > 0 ? comparedVersion.VisualPrompt : "—")</div>
                                        <div><strong>Model / Res:</strong> @comparedVersion.Model (@comparedVersion.Resolution) · @comparedVersion.DurationSeconds.ToString("F1")s</div>
                                        @if (comparedVersion.ClientOnly)
                                        {
                                            <div class="text-info">📱 Stored on your device</div>
                                        }
                                    </div>
                                    <button type="button"
                                            class="btn btn-sm btn-warning text-dark fw-semibold w-100 mt-2"
                                            disabled="@(_promotingVersion || comparedVersion.IsCurrent || comparedVersion.ClientOnly)"
                                            title="@(comparedVersion.ClientOnly ? "This take is stored on your device only — reconnect your folder to sync it back before selecting it" : null)"
                                            @onclick="() => PromoteClipVersionAsync(_compareSceneNumber, _compareClipNumber, comparedVersion.VersionId)">
                                        ★ Select &amp; Keep (Take @comparedVersion.Take)
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    @* Collapsible Trash Bin Section *@
                    @if (_trashVersions is { Count: > 0 })
                    {
                        <hr class="border-secondary my-4" />
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary text-white" @onclick="() => _showTrashBin = !_showTrashBin">
                                🗑️ Trash Bin (@_trashVersions.Count) @(_showTrashBin ? "▲ Hide" : "▼ Show")
                            </button>
                            @if (_showTrashBin)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => _showEmptyTrashConfirm = true">
                                    Empty Trash
                                </button>
                            }
                        </div>

                        @if (_showEmptyTrashConfirm)
                        {
                            <div class="alert alert-warning py-2 mb-3 d-flex justify-content-between align-items-center">
                                <span>Permanently delete @_trashVersions.Count take(s)? Note: Once purged, these video files cannot be recovered.</span>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => EmptyClipTrashAsync(_compareSceneNumber, _compareClipNumber)">Confirm Purge</button>
                                    <button type="button" class="btn btn-sm btn-secondary" @onclick="() => _showEmptyTrashConfirm = false">Cancel</button>
                                </div>
                            </div>
                        }

                        @if (_showTrashBin)
                        {
                            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 mt-1">
                                @foreach (var tv in _trashVersions)
                                {
                                    <div class="col">
                                        <div class="card bg-dark border-secondary p-2 opacity-75">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="badge bg-secondary">Deleted Take</span>
                                                <span class="small text-muted">@tv.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                            </div>
                                            <div class="small text-secondary mb-2">@tv.Mp4FileName</div>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-info w-100"
                                                    disabled="@_promotingVersion"
                                                    @onclick="() => RestoreClipVersionAsync(_compareSceneNumber, _compareClipNumber, tv.VersionId)">
                                                ↩️ Restore Take
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" @onclick="CloseClipCompare">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@* Generate confirm — opens from the batch "Generate" button so resolution + cost are decided at
   the moment of spend instead of parked in the toolbar. *@
@if (_showGenerateConfirm)
{
    <DarkModalShell Visible="true" OnClose="CloseGenerateConfirm">
        <Title>▶ Generate video</Title>
        <ChildContent>
                    <p class="mb-3">
                        Making <strong>~@EstimateSelectedClips()</strong> clip@(EstimateSelectedClips() == 1 ? "" : "s")
                        across <strong>@_selected.Count</strong> scene@(_selected.Count == 1 ? "" : "s").
                    </p>

                    <div class="mb-3">
                        <label class="form-label small text-muted" for="genResConfirm">Resolution</label>
                        @if (ResolutionLocked)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-secondary">@(_resolutionLock ?? _genResolution)</span>
                                <span class="small text-muted">🔒 Locked — clips already exist for this movie</span>
                            </div>
                        }
                        else
                        {
                            <select id="genResConfirm"
                                    data-testid="generate-confirm-resolution"
                                    class="form-select form-select-sm bg-dark text-white border-secondary"
                                    style="width:auto"
                                    @bind="_genResolution"
                                    @bind:after="RefreshCostEstimateAsync"
                                    disabled="@_busy">
                                <option value="480p">480p</option>
                                <option value="720p">720p</option>
                                <option value="1080p">1080p</option>
                            </select>
                        }
                    </div>

                    @if (Session.IsAdmin && _videoModels.Count > 0 && _selected.Any(sn => !IsCreditsSceneNum(sn)))
                    {
                        <div class="mb-3">
                            <label class="form-label small text-muted" for="genModelConfirm">
                                Video model <span class="badge bg-secondary align-middle">admin</span>
                            </label>
                            <select id="genModelConfirm"
                                    data-testid="generate-confirm-model"
                                    class="form-select form-select-sm bg-dark text-white border-secondary"
                                    style="width:auto"
                                    disabled="@_busy"
                                    value="@_selectedVideoModel"
                                    @onchange="@(e => _selectedVideoModel = e.Value?.ToString() ?? "")">
                                <option value="">Project default</option>
                                @foreach (var m in _videoModels)
                                {
                                    <option value="@m.Id">@m.DisplayName</option>
                                }
                            </select>
                            <div class="form-text text-muted">One-off for this batch — compare generators without changing project settings.</div>
                        </div>
                    }

                    <div class="d-flex align-items-baseline gap-2">
                        <span class="small text-muted">Estimated cost</span>
                        @if (_costReport is null)
                        {
                            <span class="small text-muted">calculating…</span>
                        }
                        else
                        {
                            <span class="fs-5 fw-bold" data-testid="generate-confirm-cost">~$@(EstimateSelectedCostUsd().ToString("0.00"))</span>
                        }
                    </div>
                    @if (_selected.All(IsCreditsSceneNum))
                    {
                        <div class="small text-muted mt-1">End credits render instantly in your browser — no video model, no cost.</div>
                    }
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    disabled="@_busy" @onclick="CloseGenerateConfirm">Cancel</button>
            <button type="button" class="btn btn-sm btn-success fw-bold"
                    data-testid="generate-confirm-go"
                    disabled="@(_busy || _selected.Count == 0 || JobRunning || !CastReady || SelectedLockedByOther)"
                    @onclick="ConfirmGenerateAsync">
                ▶ Generate @_selected.Count scene@(_selected.Count == 1 ? "" : "s")
            </button>
        </Footer>
    </DarkModalShell>
}

@* AI clip edit — point-of-use prompt for a text-based edit of the currently open clip (xAI
   /v1/videos/edits). Runs as a background job (same live-progress mechanism as Regen clip), not a
   blocking request — edit processing time isn't guaranteed short just because the clip is short. *@
@if (_showVideoEditPrompt && _clip is not null)
{
    <DarkModalShell Visible="true" OnClose="CloseVideoEditPrompt">
        <Title>✂️ AI edit clip</Title>
        <ChildContent>
            <p class="small text-muted">
                Describe the change — e.g. "change her jacket to red" or "make him wave instead of nod".
                Saved as a new take; the current version stays in 🎬 Takes.
            </p>
            <textarea class="form-control bg-dark text-white border-secondary"
                      data-testid="clip-video-edit-prompt"
                      rows="3"
                      placeholder="Edit instruction…"
                      disabled="@_busy"
                      @bind="_videoEditPromptText" @bind:event="oninput"></textarea>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    disabled="@_busy" @onclick="CloseVideoEditPrompt">Cancel</button>
            <button type="button" class="btn btn-sm btn-primary fw-bold"
                    data-testid="clip-video-edit-go"
                    disabled="@(_busy || JobRunning || string.IsNullOrWhiteSpace(_videoEditPromptText))"
                    @onclick="SubmitVideoEditAsync">
                ✂️ Edit clip
            </button>
        </Footer>
    </DarkModalShell>
}

@* Score-music chooser — opens from a scene's "Score" button so the music style + Sing choice
   live at the point of use instead of parked in the toolbar. *@
@if (_scoreMenuScene is int scoreSn)
{
    <DarkModalShell Visible="true" OnClose="CloseScoreMenu">
        <Title>🎵 Score music — Scene S@(scoreSn.ToString("D2"))</Title>
        <ChildContent>
                    <label class="form-label small text-muted" for="scoreMusicStyle">Music style</label>
                    <select id="scoreMusicStyle"
                            class="form-select form-select-sm bg-dark text-white border-secondary mb-3"
                            data-testid="score-menu-model"
                            disabled="@(_busy || _scoringMusic)"
                            value="@_selectedAudioModel"
                            @onchange="@(e => _selectedAudioModel = e.Value?.ToString() ?? _selectedAudioModel)">
                        @foreach (var m in _audioModels)
                        {
                            <option value="@m.Id">@m.DisplayName</option>
                        }
                    </select>
                    @if (SelectedAudioModelCanSing)
                    {
                        <ToggleSwitch Value="_wantVocal" ValueChanged="@(v => _wantVocal = v)" Id="scoreMenuSing"
                                      Disabled="@(_busy || _scoringMusic)" LabelClass="form-check-label small"
                                      data-testid="score-menu-sing">
                            <Label>Sing lyrics for this scene</Label>
                        </ToggleSwitch>
                    }
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    disabled="@_scoringMusic" @onclick="CloseScoreMenu">Cancel</button>
            <button type="button" class="btn btn-sm btn-warning text-black fw-bold"
                    data-testid="score-menu-generate"
                    disabled="@(_busy || JobRunning || _scoringMusic)"
                    @onclick="() => ScoreFromMenuAsync(scoreSn)">
                @(_wantVocal && SelectedAudioModelCanSing ? "🎤" : "🎵") Generate music
            </button>
        </Footer>
    </DarkModalShell>
}

@* Audio Takes Modal — compares scene background-audio generation runs (model, vocal/instrumental,
   prompt/lyrics), listen-based rather than the clip modal's dual video player since comparing audio
   just means playing one take, then another. *@
@if (_showMusicCompare)
{
    <DarkModalShell Visible="true" OnClose="CloseMusicCompare" DialogClass="modal-lg modal-dialog-scrollable">
        <Title>Audio Takes — Scene S@(_compareMusicSceneNumber.ToString("D2"))</Title>
        <ChildContent>
                    <InlineAlert Message="@_musicCompareMessage" Variant="info" CssClass="py-2 mb-3" />

                    @if (_loadingMusicVersions)
                    {
                        <p class="text-muted">Loading audio take history…</p>
                    }
                    else if (_musicVersions is null || _musicVersions.Count == 0)
                    {
                        <p class="text-muted">No audio takes recorded yet for this scene.</p>
                    }
                    else
                    {
                        @foreach (var v in _musicVersions.OrderByDescending(x => x.IsCurrent).ThenByDescending(x => x.CreatedAtUtc))
                        {
                            <div class="card bg-secondary bg-opacity-10 border-secondary mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                        <div>
                                            @if (v.IsCurrent)
                                            {
                                                <span class="badge bg-success me-1">Current</span>
                                            }
                                            @if (v.IsVocal)
                                            {
                                                <span class="badge bg-info text-dark me-1">🎤 Singing</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary me-1">🎵 Instrumental</span>
                                            }
                                            <span class="text-muted small">@(string.IsNullOrEmpty(v.Model) ? "unknown model" : v.Model) · @v.CreatedAtUtc.ToLocalTime().ToString("g")</span>
                                        </div>
                                        <div class="d-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    disabled="@(_promotingMusicVersion || v.IsCurrent)"
                                                    @onclick="() => PromoteMusicVersionAsync(_compareMusicSceneNumber, v.TakeId)">
                                                Make Active
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    disabled="@(_promotingMusicVersion || v.IsCurrent)"
                                                    @onclick="() => SoftDeleteMusicVersionAsync(_compareMusicSceneNumber, v.TakeId)">
                                                Delete
                                            </button>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(v.Prompt))
                                    {
                                        <div class="small text-muted mb-1"><strong>Style:</strong> @v.Prompt</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(v.Lyrics))
                                    {
                                        <div class="small text-muted mb-2"><strong>Lyrics:</strong> @v.Lyrics</div>
                                    }
                                    <div class="d-flex flex-column gap-1">
                                        @if (_musicCompareUrls.TryGetValue(v.TakeId, out var urls) && urls.Count > 0)
                                        {
                                            @for (var i = 0; i < urls.Count; i++)
                                            {
                                                var segLabel = urls.Count > 1 ? $"Segment {i + 1}" : "Audio";
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="small text-muted" style="min-width:5.5rem">@segLabel</span>
                                                    <audio controls preload="none" src="@urls[i]" style="height:32px;flex:1"></audio>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="small text-muted">Not available locally — reconnect your media folder to sync it back.</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseMusicCompare">Close</button>
        </Footer>
    </DarkModalShell>
}

@* Clip Dialogue Verification Report Modal *@
@if (_showVerificationModal && _verifModalResult is { } verReport)
{
    <DarkModalShell Visible="true" OnClose="CloseVerificationModal" HeaderClass="" TitleClass="" DialogClass="modal-lg modal-dialog-scrollable">
        <Title>📋 Verification Report — Scene S@(_verifModalSceneNumber.ToString("D2")) Clip C@(_verifModalClipNumber.ToString("D2"))</Title>
        <ChildContent>
                    @* Header Status Badge *@
                    <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded border border-secondary bg-black bg-opacity-40">
                        <div>
                            <div class="text-secondary small">Verification Status</div>
                            @if (string.Equals(verReport.Status, "verified", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success fs-6 px-3 py-1">✓ Verified Match (@($"{verReport.DialogueAccuracyScore:P0}"))</span>
                            }
                            else if (string.Equals(verReport.Status, "speaker_swap", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger fs-6 px-3 py-1">⚠ Speaker Swap Detected</span>
                            }
                            else if (string.Equals(verReport.Status, "mismatch", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-warning text-dark fs-6 px-3 py-1">⚠ Spoken Dialogue Mismatch (@($"{verReport.DialogueAccuracyScore:P0}"))</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6 px-3 py-1">@verReport.Status</span>
                            }
                        </div>
                        <div class="text-end small text-secondary">
                            <div>Verified: @verReport.VerifiedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</div>
                            <div>Engine: Multimodal Video &amp; Audio QA</div>
                        </div>
                    </div>

                    @* Clip Duration & Pacing Telemetry *@
                    @if (verReport.EstimatedDurationSeconds > 0 || verReport.ActualDurationSeconds > 0)
                    {
                        <div class="card bg-dark border-secondary mb-3">
                            <div class="card-header bg-secondary bg-opacity-20 border-secondary fw-semibold text-light d-flex justify-content-between align-items-center">
                                <span>⏱️ Clip Duration &amp; Pacing Analysis</span>
                                @if (verReport.SpeechTruncated)
                                {
                                    <span class="badge bg-danger text-white">⚠ Speech Truncated</span>
                                }
                            </div>
                            <div class="card-body">
                                <div class="row g-3 mb-2">
                                    <div class="col-4">
                                        <div class="small text-secondary">Planned Total Duration</div>
                                        <div class="fw-bold fs-6 text-light">@($"{verReport.EstimatedDurationSeconds:F1}s")</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="small text-secondary">Actual Measured MP4</div>
                                        <div class="fw-bold fs-6 text-light">@($"{verReport.ActualDurationSeconds:F1}s")</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="small text-secondary">Pacing Variance</div>
                                        @{
                                            var diff = verReport.ActualDurationSeconds - verReport.EstimatedDurationSeconds;
                                            var diffText = diff >= 0 ? $"+{diff:F1}s" : $"{diff:F1}s";
                                            var diffClass = Math.Abs(diff) <= 1.0 ? "text-success" : "text-warning";
                                        }
                                        <div class="fw-bold fs-6 @diffClass">@diffText</div>
                                    </div>
                                </div>
                                @if (verReport.SpeechDurationSeconds > 0 || verReport.ActionDurationSeconds > 0)
                                {
                                    <div class="row g-3 pt-2 border-top border-secondary-subtle">
                                        <div class="col-6">
                                            <div class="small text-secondary">🗣️ Dialogue Speech Length</div>
                                            <div class="fw-semibold text-info">@($"{verReport.SpeechDurationSeconds:F1}s")</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="small text-secondary">🎬 Action &amp; Camera Movement</div>
                                            <div class="fw-semibold text-light">@($"{verReport.ActionDurationSeconds:F1}s")</div>
                                        </div>
                                    </div>
                                }
                                @if (verReport.SpeechTruncated)
                                {
                                    <div class="alert alert-danger py-2 mt-3 mb-0 small d-flex align-items-center gap-2">
                                        <span>⚠ <strong>Speech Truncation Warning:</strong> Transcribed speech was cut off mid-line because the video rendered shorter than required for the dialogue.</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Speaker Match Breakdown *@
                    <div class="card bg-dark border-secondary mb-3">
                        <div class="card-header bg-secondary bg-opacity-20 border-secondary fw-semibold text-light">
                            🗣️ Character &amp; Speaker Verification
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="small text-secondary">Expected Speaker (Script)</div>
                                    <div class="fw-bold fs-6 text-light">@(string.IsNullOrWhiteSpace(verReport.ExpectedSpeaker) ? "None" : verReport.ExpectedSpeaker)</div>
                                </div>
                                <div class="col-6">
                                    <div class="small text-secondary">Heard / Observed Speaker</div>
                                    <div class="fw-bold fs-6 @(verReport.SpeakerMatch ? "text-success" : "text-danger")">
                                        @(string.IsNullOrWhiteSpace(verReport.DetectedSpeaker) ? "Unknown" : verReport.DetectedSpeaker)
                                        @(verReport.SpeakerMatch ? " ✓" : " ⚠ (Swap)")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Spoken Dialogue Breakdown *@
                    <div class="card bg-dark border-secondary mb-3">
                        <div class="card-header bg-secondary bg-opacity-20 border-secondary fw-semibold d-flex justify-content-between align-items-center text-light">
                            <span>🎙️ Spoken Dialogue &amp; Audio Track Transcription</span>
                            <span class="badge bg-info text-dark">Accuracy: @($"{verReport.DialogueAccuracyScore:P0}")</span>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <div class="small text-secondary mb-1">Expected Script Dialogue</div>
                                <div class="p-2 rounded bg-black border border-secondary text-light font-monospace small">
                                    @(string.IsNullOrWhiteSpace(verReport.ExpectedDialogue) ? "(No dialogue planned)" : verReport.ExpectedDialogue)
                                </div>
                            </div>
                            <div class="mb-3">
                                <div class="small text-secondary mb-1">Transcribed Audio Dialogue (Heard on MP4 Track)</div>
                                <div class="p-2 rounded bg-black border border-secondary text-light font-monospace small">
                                    @(string.IsNullOrWhiteSpace(verReport.TranscribedDialogue) ? "(No speech detected in audio)" : verReport.TranscribedDialogue)
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(verReport.ExpectedDialogue) && !string.IsNullOrWhiteSpace(verReport.TranscribedDialogue))
                            {
                                <div class="mb-1">
                                    <div class="small text-secondary mb-1">Visual Script Diff</div>
                                    @RenderDiffHtml(verReport.ExpectedDialogue, verReport.TranscribedDialogue)
                                </div>
                            }
                        </div>
                    </div>

                    @* AI Inspector Notes *@
                    @if (!string.IsNullOrWhiteSpace(verReport.SummaryNote))
                    {
                        <div class="card bg-dark border-secondary">
                            <div class="card-header bg-secondary bg-opacity-20 border-secondary fw-semibold text-light">
                                📝 QA Inspector Summary Notes
                            </div>
                            <div class="card-body">
                                <div class="small text-light" style="white-space:pre-wrap;">@verReport.SummaryNote</div>
                            </div>
                        </div>
                    }
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary" @onclick="CloseVerificationModal">Close Report</button>
        </Footer>
    </DarkModalShell>
}

@code {
    // Operator-facing gen outcome alerts, shared by the top and bottom render sites. Stay here
    // (not in Scenes.razor.cs) because they embed markup - RenderFragment lambdas with inline
    // <div>/<span> content only compile via the Razor compiler, not as plain C#.
    private RenderFragment GenPartialAlert => __builder =>
    {
        <div class="alert alert-warning py-2 d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <span class="small">Some clips finished; others failed. Refresh and retry the missing ones.</span>
            <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="ReloadListAsync">Refresh</button>
        </div>
    };

    private RenderFragment GenErrorAlert => __builder =>
    {
        <div class="alert alert-danger py-2 d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <span class="small">@(!string.IsNullOrWhiteSpace(_job?.Message) ? $"Generation failed: {_job.Message}" : "Generation failed. Try again.")</span>
            <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="ReloadListAsync">Refresh</button>
        </div>
    };
}
