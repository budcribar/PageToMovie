@page "/scenes"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject JobHubClient Hub
@inject ActiveProjectState ActiveProject
@inject StudioCapabilityState Caps
@inject AdminSessionService Session
@inject ClientVideoStitchService Stitch
@inject ClientMediaFolderService MediaFolder
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IAppLocalizer L
@inject ClientVoiceSubstitutionService VoiceSub
@using PageToMovie.Core.Models
@using PageToMovie.Web.Services

<PageTitle>@(IsSimpleFilm ? L["ProcessStrip.Movie"] : L["Nav.Film"])</PageTitle>

<StudioPageHeader Kicker="@(IsSimpleFilm ? "Easiest start · Movie" : "Studio · Step 5 · Film")"
                   Title="@(IsSimpleFilm ? "Make your movie" : L["Nav.Film"])">
    @if (IsSimpleFilm)
    {
        <text>Generate every scene with your narrator voice. Stock pictures stay as-is.</text>
    }
    else
    {
        <text>@L["ScenesPage.Subtitle"]</text>
    }
</StudioPageHeader>

<StudioProcessStrip Active="film" SimpleMode="@IsSimpleFilm" FullStudio="@(!IsSimpleFilm)" />

@* D6: movie readiness strip *@
@if (List._scenes is { Count: > 0 })
{
    var r = List.MovieReadiness;
    <div class="card mb-3 border-0 bg-body-secondary bg-opacity-50" data-testid="movie-readiness-strip">
        <div class="card-body py-2 px-3">
            <div class="d-flex flex-wrap align-items-center gap-3 small">
                <strong class="text-uppercase text-muted" style="letter-spacing:.04em;">Movie</strong>
                <span data-testid="readiness-scenes"><strong>@r.Scenes</strong> scenes</span>
                <span class="text-muted">·</span>
                <span data-testid="readiness-clips"><strong>@r.ClipsOnDisk</strong> / @r.ClipsPlanned clips on disk</span>
                @if (r.ClipsMissing > 0)
                {
                    <span class="text-muted">·</span>
                    <span class="text-warning" data-testid="readiness-missing"><strong>@r.ClipsMissing</strong> missing</span>
                }
                else if (r.ClipsPlanned > 0)
                {
                    <span class="text-muted">·</span>
                    <span class="text-success" data-testid="readiness-complete">all clips on disk</span>
                }
                <span class="text-muted">·</span>
                <span data-testid="readiness-scene-complete"><strong>@r.ScenesComplete</strong> scenes complete</span>
                @if (r.ScenesPartial > 0)
                {
                    <span class="text-muted">·</span>
                    <span class="text-warning" data-testid="readiness-partial" title="Some clips generated; plan not full">
                        <strong>@r.ScenesPartial</strong> partial
                    </span>
                }
                @if (r.StaleClips > 0)
                {
                    <span class="text-muted">·</span>
                    <span class="text-danger" data-testid="readiness-stale" title="Plan or dialogue QA newer than on-disk video">
                        <strong>@r.StaleClips</strong> stale
                    </span>
                }
                <span class="ms-auto d-flex flex-wrap gap-1">
                    @if (r.ClipsMissing > 0 && ActiveProject.CanScenes)
                    {
                        <button type="button" class="btn btn-sm btn-primary"
                                data-testid="readiness-fill-holes"
                                disabled="@(_busy || Gen.JobRunning)"
                                title="Generate only missing clips across the movie"
                                @onclick="Gen.StartFillHolesMovieAsync">
                            Fill holes
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-testid="readiness-select-missing"
                                disabled="@_busy"
                                @onclick="() => List.SelectMissingScenes()">
                            Select missing
                        </button>
                    }
                    @if (r.StaleScenes > 0 && ActiveProject.CanScenes)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-testid="readiness-regen-stale"
                                disabled="@(_busy || Gen.JobRunning)"
                                title="Force re-generate scenes with stale clips"
                                @onclick="Gen.StartRegenStaleSelectedAsync">
                            Regen stale
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-testid="readiness-select-stale"
                                disabled="@_busy"
                                @onclick="() => List.SelectStaleScenes()">
                            Select stale
                        </button>
                    }
                </span>
            </div>
        </div>
    </div>

    @* Remaining spend — only while generating (avoid duplicating the Estimate page). *@
    @if (Gen.JobRunning && List._costReport is { } cr)
    {
        <div class="card mb-3 border-0 border-start border-4 border-primary" data-testid="film-remaining-strip">
            <div class="card-body py-2 px-3">
                <div class="d-flex flex-wrap align-items-center gap-3 small">
                    <strong class="text-uppercase text-muted" style="letter-spacing:.04em;">While generating</strong>
                    <span data-testid="film-remaining-spent">
                        Spent <strong>@CostFormatting.Usd(cr.Summary.ActualUsd)</strong>
                    </span>
                    <span class="text-muted">·</span>
                    <span data-testid="film-remaining-usd">
                        Left <strong>@CostFormatting.Usd(cr.Summary.RemainingFirstPassUsd)</strong>
                    </span>
                    @if (cr.Summary.ClipsMissing > 0)
                    {
                        <span class="text-muted">·</span>
                        <span class="text-warning" data-testid="film-remaining-clips">
                            <strong>@cr.Summary.ClipsMissing</strong> clips left
                        </span>
                    }
                    <a class="btn btn-sm btn-link ms-md-auto" href="cost" data-testid="film-remaining-to-cost">Estimate →</a>
                </div>
            </div>
        </div>
    }
}

@if (IsSimpleFilm)
{
    <div class="alert alert-primary border-primary border-opacity-50 py-2 small mb-3" data-testid="simple-film-banner">
        <strong>Simple path.</strong>
        Review splice windows, then put your voice on the existing pictures.
        <a href="dialogue-timing" class="alert-link" data-testid="simple-film-dialogue-timing">Dialogue timing →</a>
        <span class="text-muted"> · </span>
        <button type="button" class="btn btn-sm btn-primary ms-1"
                data-testid="scenes-generate-missing"
                disabled="@(_busy || Gen.JobRunning)"
                @onclick="Gen.StartSimpleMovieAsync">Generate missing</button>
        <span class="text-muted"> · </span>
        <a href="simple-voice" class="alert-link">Back to story & voice</a>
    </div>
}

@if (_gateChecked && !ActiveProject.CanScenes && !List.HasSceneOrClipMedia && !IsSimpleFilm)
{
    <ReadinessGateBanner Visible="true"
                         Reason="@ActiveProject.ScenesBlockedReason"
                         FallbackReason="Finish the shot plan first."
                         ActionHref="adaptation/shots"
                         ActionLabel="Open shot plan →" />
}
else
{

@* Feature 8: clip finished but not saved to a local media folder *@
@if (!string.IsNullOrEmpty(MediaFolder.LocalSaveWarning))
{
    <InlineAlert Variant="warning"
                 CssClass="d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 mb-3"
                 data-testid="scenes-local-save-warning"
                 role="status">
        <span>@MediaFolder.LocalSaveWarning</span>
        <div class="d-flex align-items-center gap-2 flex-shrink-0">
            @if (!MediaFolder.IsConnected)
            {
                <BusyButton Label="Connect folder" Busy="_busy" CssClass="btn btn-sm btn-warning text-nowrap"
                            OnClick="ConnectMediaFolderFromWarningAsync" />
            }
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    @onclick="DismissLocalSaveWarning">
                Dismiss
            </button>
        </div>
    </InlineAlert>
}

@* Proactive nudge before the reactive warning above ever needs to fire. *@
@if (!MediaFolder.IsConnected && string.IsNullOrEmpty(MediaFolder.LocalSaveWarning))
{
    <InlineAlert Variant="warning"
                 CssClass="d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 mb-3"
                 data-testid="scenes-connect-folder-banner">
        @if (MediaFolder.NeedsReconnect)
        {
            <span>📁 Re-grant access to <strong>@MediaFolder.PendingReconnectFolderName</strong> so clips save on this computer.</span>
        }
        else
        {
            <span>📁 <strong>Connect a folder</strong> so clips save on this computer.</span>
        }
        <BusyButton Label="@(MediaFolder.NeedsReconnect ? "Reconnect folder" : "Connect folder")"
                    Busy="_busy" CssClass="btn btn-sm btn-warning text-nowrap"
                    OnClick="ConnectMediaFolderFromWarningAsync" />
    </InlineAlert>
}

@if (List._castChecked && !List.CastReady)
{
    <InlineAlert Variant="warning" CssClass="py-2" data-testid="scenes-cast-gate">
        Cast incomplete
        @if (List._castReadyCount is int cr && List._castTotal is int ct)
        {
            <span>(@cr/@ct)</span>
        }
        —
        @if (ProductionModes.IsDraft(List._costReport?.ProductionMode))
        {
            <span>finish voice on speaking cast (draft: plates optional)</span>
        }
        else
        {
            <span>finish voice + locks on</span>
        }
        <a class="alert-link" href="characters">Characters →</a>
        @if (!ProductionModes.IsDraft(List._costReport?.ProductionMode))
        {
            <span class="text-muted"> · or switch to <a class="alert-link" href="cost">Draft mode</a> for a first watch without plates</span>
        }
    </InlineAlert>
}


@* ---- Scene version history (P3) ---- *@
@* Own flag — distinct from History._showSceneHistory (the unrelated git-commit history modal further
   below), so toggling one panel never shows/hides the other. *@
@if (List._selectedScene is int snHist)
{
    <div class="mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary"
                @onclick="() => History._showInlineSceneHistory = !History._showInlineSceneHistory">
            @(History._showInlineSceneHistory ? "Hide history" : "Scene history")
        </button>
    </div>
    @if (History._showInlineSceneHistory)
    {
        <SceneVersionHistory ProjectId="@_projectId"
                             SceneKey="@($"scene:{snHist}")"
                             OnClose="History.HideSceneHistory"
                             OnRestored="History.OnSceneHistoryRestored" />
    }
}

@if (List._selectedScene is int)
{
    <div class="mb-3">
        <button class="btn btn-outline-primary" disabled="@_busy" @onclick="List.BackToListAsync">← All scenes</button>
    </div>
}

@if (List._showFilters)
{
    <div class="card mb-3 p-3 border-secondary bg-dark" data-testid="scenes-select-panel">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="small text-muted">🔍 Filters</span>
            <button class="btn btn-sm btn-outline-secondary py-0 px-2" type="button"
                    data-testid="scenes-filters-collapse"
                    title="Hide filters"
                    @onclick="() => List._showFilters = false">
                ✕ Hide
            </button>
        </div>
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted">Character</label>
                <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="List._pickCharacter" @bind:after="List.SelectByCharacter" disabled="@_busy">
                    <option value="">All characters…</option>
                    @foreach (var c in GetCharacterOptions())
                    {
                        <option value="@c">@ShortChar(c)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Location</label>
                <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="List._pickLocation" @bind:after="List.SelectByLocation" disabled="@_busy">
                    <option value="">All locations…</option>
                    @foreach (var loc in GetLocationOptions())
                    {
                        <option value="@loc">@ShortLoc(loc)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted">Setting text</label>
                <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="List._pickSetting" @bind:event="oninput" disabled="@_busy" placeholder="Filter by text e.g. pajamas" />
            </div>
            <div class="col-md-2">
                @if (List.HasActiveFilters)
                {
                    <button class="btn btn-sm btn-outline-danger w-100" type="button" @onclick="List.ClearFilters">
                        Clear filters
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (Playback._showScenePlayer && Playback._playingScene is int playSn && !Gen.IsSceneGenBusy(playSn) && !Playback._clientStitching)
{
    <div class="card mb-3 border-primary">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span>
                Scene <code class="small">S@(playSn.ToString("D2"))</code>
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Playback.HideScenePlayer">Hide</button>
        </div>
        <div class="card-body py-2">
            @if (MediaFolder.IsSyncing && string.IsNullOrEmpty(Playback._clientSceneUrl))
            {
                <MediaDownloadProgress Label="Downloading video clips to local folder…"
                                       CurrentFile="@MediaFolder.SyncCurrentFile" Current="@MediaFolder.SyncCurrent"
                                       Total="@MediaFolder.SyncTotal" Percent="@MediaFolder.SyncPercent"
                                       FooterText="Playback will start automatically as soon as downloads complete."
                                       data-testid="scenes-downloading-player" />
            }
            else
            {
                <video controls playsinline autoplay
                       style="width:100%;max-height:70vh;background:#000;border-radius:0.35rem;"
                       src="@Playback.ScenePlayerSrc(playSn)"
                       @key="Playback._sceneVideoKey"
                       onloadeddata="this.play().catch(function(){})">
                    Your browser does not support HTML5 video.
                </video>
                <div class="mt-2 d-flex flex-wrap gap-3 align-items-center">
                    <a href="/dialogue-timing?scene=@playSn" class="small" data-testid="scene-dialogue-timing">Review dialogue timing →</a>
                    @if (string.IsNullOrEmpty(Playback._clientSceneUrl))
                    {
                        <a href="@Engine.CompositeVideoUrl(_projectId, playSn)" target="_blank" rel="noopener" class="small text-muted">Open in new tab</a>
                    }
                </div>
                @if (Session.IsAdmin && List._detail is { } _dd && _dd.SceneNumber == playSn && _dd.DuplicateClipNumbers.Count > 0)
                {
                    <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small" data-testid="scene-dup-clips">
                        ⚠ Malformed shot plan: clip @(string.Join(", ", _dd.DuplicateClipNumbers)) appears more than once in this scene, which doubles it. Deduped for playback — regenerate the shot plan to fix the data.
                    </div>
                }
            }
        </div>
    </div>
}
else if (Playback._showScenePlayer && Playback._playingScene is int busySn && (Gen.IsSceneGenBusy(busySn) || Playback._clientStitching))
{
    <div class="card mb-3 border-secondary">
        <div class="card-body py-2 small text-muted">
            @if (Playback._clientStitching)
            {
                <span>Combining clips in browser… @Playback._clientStitchStatus</span>
            }
            else
            {
                <span>Scene hidden while generating <code>S@(busySn.ToString("D2"))</code>.</span>
            }
            <button type="button" class="btn btn-link btn-sm p-0 align-baseline ms-1" @onclick="Playback.HideScenePlayer">Dismiss</button>
        </div>
    </div>
}

@if (Playback._showPreviewPlayer && !string.IsNullOrEmpty(Playback._clientPreviewUrl) && !Playback._clientStitching)
{
    <div class="card mb-3 border-primary" data-testid="scenes-preview-player">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span>
                Preview — @Playback._previewScenes.Count scene@(Playback._previewScenes.Count == 1 ? "" : "s"):
                <code class="small">@string.Join(", ", Playback._previewScenes.Select(s => $"S{s:D2}"))</code>
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Playback.HidePreviewPlayerAsync">Hide</button>
        </div>
        <div class="card-body py-2">
            <video controls playsinline autoplay
                   style="width:100%;max-height:70vh;background:#000;border-radius:0.35rem;"
                   src="@Playback._clientPreviewUrl"
                   @key="Playback._previewVideoKey"
                   onloadeddata="this.play().catch(function(){})">
                Your browser does not support HTML5 video.
            </video>
        </div>
    </div>
}
else if (Playback._showPreviewPlayer && Playback._clientStitching)
{
    <div class="card mb-3 border-secondary" data-testid="scenes-preview-player">
        <div class="card-body py-2 small text-muted">
            Combining selected scenes in browser… @Playback._clientStitchStatus
        </div>
    </div>
}

@if (Dialogue._verifyingClip)
{
    var vPct = Dialogue._verifyTotal > 0 ? Math.Min(100, Math.Max(5, (int)Math.Round((double)Dialogue._verifyCurrent / Dialogue._verifyTotal * 100.0))) : 0;
    <JobProgressCard Status="running"
                     Message="@Dialogue._verifyStatusLabel"
                     Index="Dialogue._verifyCurrent"
                     Total="Dialogue._verifyTotal"
                     Percent="vPct"
                     TestId="scenes-verify-progress"
                     CssClass="border-info shadow-sm" />
}

@if (List._selectedScene is null)
{
    <CascadingValue Value="this" IsFixed="true">
    <CascadingValue Value="List" IsFixed="true">
    <CascadingValue Value="Gen" IsFixed="true">
    <CascadingValue Value="Playback" IsFixed="true">
    <CascadingValue Value="ClipSel" IsFixed="true">
    <CascadingValue Value="ClipForm" IsFixed="true">
    <CascadingValue Value="ClipVer" IsFixed="true">
    <CascadingValue Value="ClipRegen" IsFixed="true">
    <CascadingValue Value="Music" IsFixed="true">
    <CascadingValue Value="Dialogue" IsFixed="true">
    <CascadingValue Value="History" IsFixed="true">

        <ScenesSceneList />
    
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
</CascadingValue>
}
else if (List._detail is null)
{
    <EmptyState Message="Loading scene…" CssClass="text-muted" />
}
else
{
    <CascadingValue Value="this" IsFixed="true">
    <CascadingValue Value="List" IsFixed="true">
    <CascadingValue Value="Gen" IsFixed="true">
    <CascadingValue Value="Playback" IsFixed="true">
    <CascadingValue Value="ClipSel" IsFixed="true">
    <CascadingValue Value="ClipForm" IsFixed="true">
    <CascadingValue Value="ClipVer" IsFixed="true">
    <CascadingValue Value="ClipRegen" IsFixed="true">
    <CascadingValue Value="Music" IsFixed="true">
    <CascadingValue Value="Dialogue" IsFixed="true">
    <CascadingValue Value="History" IsFixed="true">

        <ScenesSceneDetail />
    
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
</CascadingValue>
}
} @* end CanScenes gate *@

@if (List._deleteSceneTarget is int deleteSn)
{
    <ConfirmModal Visible="true" Title="@($"Delete Scene S{deleteSn:D2}?")"
                  ConfirmLabel="Delete Scene" Busy="_busy"
                  OnConfirm="List.ConfirmDeleteSceneAsync" OnCancel="() => { List._deleteSceneTarget = null; }">
        Are you sure you want to delete <strong>Scene @deleteSn.ToString("D2")</strong> from the shot plan?
        <div class="text-muted small mt-2">
            Note: You can easily restore missing scenes anytime by clicking <strong>Regenerate Selected Scenes</strong> with nothing checked (rebuilds every scene from the screenplay).
        </div>
    </ConfirmModal>
}

@if (ClipForm._deleteClipTarget is { } delTarget)
{
    <ConfirmModal Visible="true" Title="Delete clip?" ConfirmLabel="Delete clip"
                  ConfirmTestId="clip-delete-confirm" Busy="_busy" BodyClass="" BackdropOpacity=".45"
                  OnConfirm="ClipForm.ConfirmDeleteClipAsync" OnCancel="ClipForm.CancelDeleteClip">
        <p class="mb-0">
            Delete <code>S@(delTarget.Scene.ToString("D2"))C@(delTarget.Clip.ToString("D2"))</code>?
            This removes the video file and its shot-plan entry — cannot be undone.
            Play scene / Play WIP afterward to drop it from the assembled cut.
        </p>
    </ConfirmModal>
}

@if (ClipForm._clipEditor is not null)
{
    <Scenes_ClipFieldEditor Editor="ClipForm._clipEditor"
                            IsNew="ClipForm._clipEditorIsNew"
                            Busy="_busy"
                            Error="@_error"
                            CharacterOptions="GetCharacterOptions()"
                            CastKeys="ClipForm._clipEditorCast"
                            OnClose="ClipForm.CloseClipEditor"
                            OnSave="ClipForm.SaveClipEditorAsync"
                            CastToggled="ClipForm.OnClipEditorCastToggled" />
}

@if (History._showSceneHistory)
{
    <Scenes_SceneHistory Visible="true"
                         SceneNumber="History._historySceneNumber"
                         Message="@History._sceneRevertMessage"
                         Loading="History._loadingHistory"
                         Reverting="History._revertingScene"
                         History="History._sceneHistory"
                         OnClose="History.CloseSceneHistory"
                         OnRevert="@(hash => History.RevertSceneToVersionAsync(History._historySceneNumber, hash))" />
}

@if (ClipVer._showClipCompare)
{
    <Scenes_ClipCompare Visible="true"
                        SceneNumber="ClipVer._compareSceneNumber"
                        ClipNumber="ClipVer._compareClipNumber"
                        Message="@ClipVer._clipCompareMessage"
                        Loading="ClipVer._loadingClipVersions"
                        Promoting="ClipVer._promotingVersion"
                        Versions="ClipVer._clipVersions"
                        TrashVersions="ClipVer._trashVersions"
                        VideoUrls="Playback._compareVideoUrls"
                        OnClose="ClipVer.CloseClipCompare"
                        Promote="@(id => ClipVer.PromoteClipVersionAsync(ClipVer._compareSceneNumber, ClipVer._compareClipNumber, id))"
                        Delete="@(id => ClipVer.SoftDeleteClipVersionAsync(ClipVer._compareSceneNumber, ClipVer._compareClipNumber, id))"
                        Restore="@(id => ClipVer.RestoreClipVersionAsync(ClipVer._compareSceneNumber, ClipVer._compareClipNumber, id))"
                        EmptyTrash="@(() => ClipVer.EmptyClipTrashAsync(ClipVer._compareSceneNumber, ClipVer._compareClipNumber))" />
}

@if (Gen._showGenerateConfirm)
{
    <Scenes_GenerateConfirm Visible="true"
                            EstimatedClips="ClipSel.EstimateSelectedClips()"
                            SelectedCount="List._selected.Count"
                            ResolutionLocked="List.ResolutionLocked"
                            ResolutionLock="@List._resolutionLock"
                            Resolution="@Gen._genResolution"
                            ResolutionChanged="@(v => Gen._genResolution = v)"
                            OnResolutionCommitted="List.RefreshCostEstimateAsync"
                            ShowModelPicker="@(Session.IsAdmin && Gen._videoModels.Count > 0 && List._selected.Any(sn => !Gen.IsCreditsSceneNum(sn)))"
                            VideoModels="Gen._videoModels"
                            SelectedVideoModel="@Gen._selectedVideoModel"
                            SelectedVideoModelChanged="@(v => Gen._selectedVideoModel = v)"
                            CostReady="@(List._costReport is not null)"
                            EstimatedCostUsd="List.EstimateSelectedCostUsd()"
                            AllCredits="@(List._selected.All(Gen.IsCreditsSceneNum))"
                            Busy="_busy"
                            GenerateDisabled="@(_busy || List._selected.Count == 0 || Gen.JobRunning || !List.CastReady || List.SelectedLockedByOther)"
                            OnClose="Gen.CloseGenerateConfirm"
                            OnConfirm="Gen.ConfirmGenerateAsync" />
}

@* AI clip edit — point-of-use prompt for a text-based edit of the currently open clip (xAI
   /v1/videos/edits). Runs as a background job (same live-progress mechanism as Regen clip), not a
   blocking request — edit processing time isn't guaranteed short just because the clip is short. *@
@if (ClipRegen._showVideoEditPrompt && ClipForm._clip is not null)
{
    <Scenes_VideoEditPrompt Visible="true"
                            Prompt="@ClipRegen._videoEditPromptText"
                            PromptChanged="@(v => ClipRegen._videoEditPromptText = v)"
                            Busy="_busy"
                            JobRunning="Gen.JobRunning"
                            OnClose="ClipRegen.CloseVideoEditPrompt"
                            OnSubmit="ClipRegen.SubmitVideoEditAsync" />
}

@* Score-music chooser — opens from a scene's "Score" button so the music style + Sing choice
   live at the point of use instead of parked in the toolbar. *@
@if (Music._scoreMenuScene is int scoreSn)
{
    <Scenes_ScoreMusicMenu Visible="true"
                           SceneNumber="scoreSn"
                           Models="Music._audioModels"
                           SelectedModelId="@Music._selectedAudioModel"
                           SelectedModelIdChanged="@(v => Music._selectedAudioModel = v)"
                           WantVocal="Music._wantVocal"
                           WantVocalChanged="@(v => Music._wantVocal = v)"
                           CanSing="Music.SelectedAudioModelCanSing"
                           Disabled="@(_busy || Music._scoringMusic)"
                           Scoring="Music._scoringMusic"
                           GenerateDisabled="@(_busy || Gen.JobRunning || Music._scoringMusic)"
                           OnClose="Music.CloseScoreMenu"
                           OnGenerate="@(() => Music.ScoreFromMenuAsync(scoreSn))" />
}

@if (Music._showMusicCompare)
{
    <Scenes_MusicCompare Visible="true"
                         SceneNumber="Music._compareMusicSceneNumber"
                         Message="@Music._musicCompareMessage"
                         Loading="Music._loadingMusicVersions"
                         Busy="Music._promotingMusicVersion"
                         Versions="Music._musicVersions"
                         Urls="_musicCompareUrls"
                         OnClose="Music.CloseMusicCompare"
                         OnPromote="@(id => Music.PromoteMusicVersionAsync(Music._compareMusicSceneNumber, id))"
                         OnDelete="@(id => Music.SoftDeleteMusicVersionAsync(Music._compareMusicSceneNumber, id))" />
}

@if (Dialogue._showVerificationModal && Dialogue._verifModalResult is not null)
{
    <Scenes_VerificationReport Visible="true"
                               SceneNumber="Dialogue._verifModalSceneNumber"
                               ClipNumber="Dialogue._verifModalClipNumber"
                               Report="Dialogue._verifModalResult"
                               OnClose="CloseVerificationModal" />
}
