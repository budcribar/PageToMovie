@* Page-local to Scenes — all-scenes list *@
@inject StudioCapabilityState Caps
@inject AdminSessionService Session
@inject IAppLocalizer L
@inject ClientMediaFolderService MediaFolder
@using Microsoft.AspNetCore.Components
@using PageToMovie.Core.Models


    @* ---- Scene list ---- *@
    @if (ListState!._scenes is null)
    {
        <EmptyState Message="Loading scenes…" CssClass="text-muted" />
    }
    else if (ListState!._scenes.Count == 0)
    {
        <EmptyState Message="No scenes in the shot plan yet."
                    ActionHref="adaptation/shots"
                    ActionLabel="Open shot plan →"
                    CssClass="text-muted" />
    }
    else
    {
        @* Authoritative scene/clip counts for tests, queryable in one place without counting rows. *@
        <div data-testid="scenes-status"
             data-scene-count="@ListState!._scenes.Count"
             data-clip-count="@ListState!._scenes.Sum(s => s.ClipCount)"
             data-clips-on-disk="@ListState!._scenes.Sum(s => s.ClipsOnDisk)"
             data-scenes-complete="@ListState!._scenes.Count(s => s.ClipsComplete)"
             class="visually-hidden" aria-hidden="true"></div>
        @* Batch generation is started from THIS all-scenes view, so its progress/message/result must
           show here too — the detail view below has its own copy for single-scene work. Without this,
           confirming Generate from the list started the job but showed nothing (dead-click symptom). *@
        <InlineAlert Message="@Host._error" CssClass="mb-3" />
        @if (!Gen!.JobRunning)
        {
            <InlineAlert Message="@Host._message" Variant="info" CssClass="mb-3" />
        }
        @if (Gen!.ShowLiveGenProgress && Gen!._job is not null)
        {
            <JobProgressCard Status="@Gen!._job.Status"
                             Message="@Scenes.ScenesGeneration.LiveGenStatusLabel(Gen!._job)"
                             Index="Gen!._job.Index"
                             Total="Gen!._job.Total"
                             Percent="Gen!.LiveGenProgressPercent(Gen!._job)"
                             ShowCancel="true"
                             CancelDisabled="false"
                             OnCancel="Gen!.CancelAsync"
                             Kind="@Gen!._job.Kind"
                             TestId="scenes-gen-progress"
                             CancelTestId="scenes-gen-cancel" />
        }
        else if (Gen!.ShowOperatorGenPartial && Gen!._job is not null)
        {
            <Scenes_GenPartialAlert />
        }
        else if (Gen!.ShowOperatorGenError && Gen!._job is not null)
        {
            <Scenes_GenErrorAlert />
        }

        <div class="card mb-3 p-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <CapabilityLockedControl Enabled="Caps.VideoReady"
                                             BlockedReason="@Caps.VideoBlockedReason"
                                             SettingsHref="@Caps.VideoSettingsHref"
                                             TestId="scenes-generate-batch-cap">
                    <button type="button"
                            data-testid="scenes-generate-batch"
                            class="btn batch-go @(ListState!._selected.Count > 0 && !Gen!.JobRunning && ListState!.CastReady ? "batch-go--ready" : "")"
                            disabled="@(Host._busy || ListState!._selected.Count == 0 || Gen!.JobRunning || !ListState!.CastReady || ListState!.SelectedLockedByOther)"
                            title="@(!ListState!.CastReady ? ListState!.CastBlockedTitle : ListState!.SelectedLockedByOther ? "Selection includes scenes locked by another user" : null)"
                            @onclick="Gen!.OpenGenerateConfirmAsync">
                        @if (Gen!.JobRunning)
                        {
                            <span class="batch-go__spin" aria-hidden="true"></span>
                            <span>Generating…</span>
                        }
                        else
                        {
                            <span class="batch-go__play" aria-hidden="true">▶</span>
                            <span>
                                Generate @(ListState!._selected.Count > 0 ? $"{ListState!._selected.Count} scene{(ListState!._selected.Count == 1 ? "" : "s")}" : "Batch")
                                @if (ListState!._selected.Count > 0)
                                {
                                    <span class="batch-go__meta">· ~@ClipSel!.EstimateSelectedClips() clips</span>
                                }
                            </span>
                        }
                    </button>
                    </CapabilityLockedControl>

                    @if (ListState!._scenes is not null && ListState!.GetVisibleScenes().Any(s => !s.ClipsComplete || s.ClipsOnDisk < s.ClipCount))
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary ms-2"
                                disabled="@Host._busy"
                                title="Select scenes that still need clips"
                                @onclick="ListState!.SelectMissingScenes">
                            @L["ScenesPage.SelectMissing"]
                        </button>
                    }


                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button"
                            data-testid="scenes-play-selected"
                            class="btn btn-outline-primary btn-sm"
                            disabled="@(Host._busy || Playback!._clientStitching || !Playback!.CanPlaySelected)"
                            title="@(Playback!.CanPlaySelected
                                ? "Stitch selected scenes in the browser (composites or clips)"
                                : ListState!._selected.Count == 0
                                    ? "Select one or more scenes first"
                                    : "Selected scenes have no clips or composites to play yet")"
                            @onclick="Playback!.PlaySelectedAsync">
                        ▶ @L["ScenesPage.PlaySelected"]@(ListState!._selected.Count > 0 ? $" ({ListState!._selected.Count})" : "")
                    </button>
                    <CapabilityLockedControl Enabled="Caps.VideoReviewReady"
                                             BlockedReason="@Caps.VideoReviewBlockedReason"
                                             SettingsHref="@Caps.VideoReviewSettingsHref"
                                             TestId="scenes-verify-dialogue-cap">
                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            disabled="@(Host._busy || Gen!.JobRunning || Dialogue!._verifyingClip || !Dialogue!.SelectedScenesHaveClipsToVerify)"
                            title="@(Dialogue!.SelectedScenesHaveClipsToVerify
                                ? "Check the spoken words in each finished clip against the screenplay"
                                : ListState!._selected.Count == 0
                                    ? "Select one or more scenes with finished clips first"
                                    : "Selected scenes have no finished clips to check yet")"
                            @onclick="Dialogue!.VerifySelectedScenesDialogueAsync">
                        🔍 @L["ScenesPage.VerifySceneDialogue"]@(ListState!._selected.Count > 0 ? $" ({ListState!._selected.Count})" : "")
                    </button>
                    </CapabilityLockedControl>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            disabled="@(Host._busy || Gen!.JobRunning)"
                            title="@(ListState!._selected.Count > 0
                                ? $"Regenerate only the {ListState!._selected.Count} checked scene(s) from the screenplay — other scenes are left untouched"
                                : "Check scenes first to regenerate just those — with nothing checked, this rebuilds every scene from the screenplay")"
                            @onclick="ListState!.RebuildShotPlanAsync">
                        🔄 @L["ScenesPage.RebuildShotPlan"]
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            data-testid="scenes-add-scene"
                            disabled="@(Host._busy || Gen!.JobRunning)"
                            title="Add a new empty scene to the shot plan"
                            @onclick="() => ListState!.AddSceneAsync(false)">
                        ➕ @L["ScenesPage.AddScene"]
                    </button>
                    @* Credits are auto-inserted into the shot plan; this only re-adds one if it was deleted. *@
                    @if (!Gen!.HasCreditsScene)
                    {
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                data-testid="scenes-add-credits"
                                disabled="@(Host._busy || Gen!.JobRunning)"
                                title="Re-add the end-credits scene (normally added automatically)"
                                @onclick="() => ListState!.AddSceneAsync(true)">
                            🎬 @L["ScenesPage.AddCredits"]
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-secondary" data-testid="scenes-select-toggle"
                            disabled="@Host._busy" @onclick="() => ListState!._showFilters = !ListState!._showFilters">
                        🔍 @L["ScenesPage.Filters"] @(ListState!.HasActiveFilters ? " (Active)" : "")
                    </button>
                </div>
            </div>

            @* Jump back to the screenplay-shaping phases that otherwise only live under Book. Both edit the
               screenplay, which re-opens it (un-approve + re-gate cast), so each confirms before navigating. *@
            @if (!Host.IsSimpleFilm)
            {
                <div class="mt-2 pt-2 border-top border-secondary d-flex align-items-center gap-2 small flex-wrap">
                    <span class="text-muted">@L["ScenesPage.Screenplay"]</span>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary py-0 px-2"
                            data-testid="scenes-view-screenplay"
                            disabled="@Host._busy"
                            title="Read the current screenplay (view only — does not re-open it)"
                            @onclick="Host.ViewScreenplay">
                        📄 @L["ScenesPage.View"]
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-outline-info py-0 px-2"
                            data-testid="scenes-goto-fit-length"
                            disabled="@(Host._busy || Gen!.JobRunning)"
                            title="Change the movie's target length (extend or shorten)"
                            @onclick="Host.AdjustFitLengthAsync">
                        ⏱ @L["ScenesPage.FitLength"]
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-outline-info py-0 px-2"
                            data-testid="scenes-goto-embellish"
                            disabled="@(Host._busy || Gen!.JobRunning)"
                            title="Embellish the scene descriptions"
                            @onclick="Host.AdjustEmbellishAsync">
                        ✨ @L["ScenesPage.Embellish"]
                    </button>
                    <span class="text-muted">· editing re-opens the screenplay (you'll re-approve it &amp; re-check cast)</span>
                </div>
            }

        </div>

        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle">
                <thead>
                    <tr>
                        <th style="width:2.5rem;">
                            <input class="form-check-input" type="checkbox"
                                   data-testid="scenes-select-all"
                                   title="Select all shown scenes"
                                   checked="@ListState!.AreAllVisibleSelected()"
                                   disabled="@(Host._busy || ListState!.GetVisibleScenes().Count == 0)"
                                   @onchange="e => ListState!.ToggleSelectAllShown((bool)(e.Value ?? false))" />
                        </th>
                        <th style="width:7rem; cursor:pointer; user-select:none;" @onclick='() => ListState!.ToggleSort("number")' title="Click to sort by Scene Number">
                            # @(ListState!._sortBy == "number" ? (ListState!._sortAscending ? "▲" : "▼") : "⇅")
                        </th>
                        <th>@L["ScenesPage.Setting"]</th>
                        <th>@L["ScenesPage.CastLocation"]</th>
                        <th style="width:6rem;">@L["ReviewPage.Clips"]</th>
                        <th style="width:7.5rem; cursor:pointer; user-select:none;" @onclick='() => ListState!.ToggleSort("duration")' title="Click to sort by Duration">
                            @L["ReviewPage.Dur"] @(ListState!._sortBy == "duration" ? (ListState!._sortAscending ? "▲" : "▼") : "⇅")
                        </th>
                        <th style="width:9rem;" title="Score background music for this scene">@L["ScenesPage.Music"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in ListState!.SortedVisibleScenes)
                    {
                        var sn = s.SceneNumber;
                        var isSel = ListState!._selected.Contains(sn);
                        <tr class="@(isSel ? "table-active" : "")" style="cursor:pointer;" @key="sn"
                            data-testid="scene-row" data-scene-number="@sn">
                            <td @onclick:stopPropagation="true">
                                <input class="form-check-input" type="checkbox"
                                       checked="@isSel"
                                       disabled="@Host._busy"
                                       @onchange="e => ListState!.ToggleSelect(sn, (bool)(e.Value ?? false))" />
                            </td>
                            <td class="text-nowrap" @onclick="() => ListState!.OpenSceneAsync(sn)">
                                <span class="badge @(s.ClipsComplete ? "bg-success text-white" : "bg-warning text-dark") px-2 py-1 rounded-pill" style="font-weight:600;">
                                    S@(sn.ToString("D2"))
                                </span>
                                <button type="button"
                                        class="btn btn-sm btn-link text-danger p-0 ms-2 text-decoration-none"
                                        title="Delete scene S@(sn.ToString("D2")) from plan"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => ListState!.RequestDeleteScene(sn)">
                                    🗑️
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-link text-info p-0 ms-1 text-decoration-none"
                                        title="Open editor for scene S@(sn.ToString("D2"))"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => ListState!.OpenSceneAsync(sn)">
                                    ✏️
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-link text-secondary p-0 ms-1 text-decoration-none"
                                        title="View changes & history for scene S@(sn.ToString("D2"))"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => History!.OpenSceneHistoryAsync(sn)">
                                    📜
                                </button>
                                @if (s.LockedByOther)
                                {
                                    <span class="badge bg-warning text-dark ms-1" title="Locked by @s.LockOwnerUserId">🔒 @s.LockOwnerUserId</span>
                                }
                            </td>
                            <td @onclick="() => ListState!.OpenSceneAsync(sn)">
                                @(s.Setting is { Length: > 0 } set ? Scenes.Trunc(set, 56) : "—")
                                @if (s.CompositeExists)
                                {
                                    <span class="badge bg-light text-dark border ms-1">mux</span>
                                }
                            </td>
                            <td @onclick="() => ListState!.OpenSceneAsync(sn)" class="small">
                                @if (s.CharactersOnScreen.Count > 0)
                                {
                                    <span class="text-muted">@string.Join(", ", s.CharactersOnScreen.Select(Scenes.ShortChar).Take(4))</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                                @if (!string.IsNullOrEmpty(s.PrimaryLocationId) || s.LocationIds.Count > 0)
                                {
                                    <div class="text-muted">
                                        <code>@Scenes.ShortLoc(s.PrimaryLocationId ?? s.LocationIds.FirstOrDefault() ?? "")</code>
                                    </div>
                                }
                            </td>
                            <td @onclick="() => ListState!.OpenSceneAsync(sn)" class="text-nowrap">
                                @{ var (pg, pgCls, pgTitle) = ListState!.SceneProgressGlyph(s); }
                                <span class="@pgCls me-1" title="@pgTitle" aria-label="@pgTitle">@pg</span>
                                <span class="@(s.ClipsComplete ? "text-success" : s.ClipsOnDisk > 0 ? "text-warning" : "text-muted")">
                                    @s.ClipsOnDisk/@s.ClipCount
                                </span>
                            </td>
                            <td @onclick="() => ListState!.OpenSceneAsync(sn)" class="small">
                                @if (s.ActualDurationSeconds is double act)
                                {
                                    <span title="Measured from composite or clips">@Scenes.FormatClock(act)</span>
                                    @if (s.PlannedDurationSeconds is double plan && Math.Abs(plan - act) > 1.5)
                                    {
                                        <div class="text-muted" style="font-size:0.75rem;" title="Planned length">plan @Scenes.FormatClock(plan)</div>
                                    }
                                }
                                else if (s.PlannedDurationSeconds is double planOnly)
                                {
                                    <span class="text-muted" title="Plan only — no media measured">~@Scenes.FormatClock(planOnly)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td @onclick:stopPropagation="true" class="text-nowrap">
                                <button type="button"
                                        class="btn btn-sm btn-warning text-black fw-bold py-0 px-2"
                                        data-testid="scene-row-score-music"
                                        disabled="@(Host._busy || Gen!.JobRunning || Music!._scoringMusic || !Caps.MusicReady || s.LockedByOther)"
                                        title="@(Caps.MusicReady ? "Score background music for this scene" : Caps.MusicBlockedReason)"
                                        @onclick="() => Music!.OpenScoreMenu(sn)">
                                    🎵 Score
                                </button>
                                @if (s.HasBackgroundMusic)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-link text-info p-0 ms-1 text-decoration-none"
                                            title="View & compare past audio takes for this scene"
                                            @onclick="() => Music!.OpenMusicCompareAsync(sn)">
                                        🎧
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
