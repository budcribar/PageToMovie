@page "/adaptation/shots"
@inherits AdaptationPageBase
@inject IAppLocalizer L

<PageTitle>@L["Adaptation.ShotPlan"]</PageTitle>

<AdaptationShell Host="this" Step="shots">
    @if (Status is not null)
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>@L["Adaptation.ShotPlan"]</span>
                @if (!Jobs.JobRunning && Status.Stage2.Stage2Ready && !Status.Stage2.Stage2Stale)
                {
                    <span class="small text-muted">
                        <strong>@Status.Stage2.Stage2Scenes</strong> @L["Scenes.Scenes"] ·
                        <strong>@Status.Stage2.Stage2Clips</strong> @L["Scenes.Clips"]
                    </span>
                }
                else if (!Jobs.JobRunning && Status.Stage2.Stage2Stale)
                {
                    <span class="badge bg-warning text-dark">@L["Adaptation.NeedsUpdate"]</span>
                }
            </div>
            <div class="card-body">
                @if (FromDecisionCard || AutoGen)
                {
                    <InlineAlert Variant="info" CssClass="py-2 small mb-3" data-testid="shots-from-decision">
                        @if (AutoGen)
                        {
                            <span data-testid="shots-autogen">
                                @L["Adaptation.AutoGenNotice"]
                            </span>
                        }
                        else
                        {
                            <span>
                                @L["Adaptation.ManualGenNotice"]
                            </span>
                        }
                        <a class="alert-link ms-1" href="cost">@L["ScreenplayPage.BackToEstimate"]</a>
                    </InlineAlert>
                }
                @* Status alerts only when idle — during a job the progress card is the single surface *@
                @if (!Jobs.JobRunning)
                {
                    @if (!Status.Stage1.Present || Status.Stage1.SceneCount <= 0)
                    {
                        <InlineAlert Variant="secondary" CssClass="py-2 small mb-3">
                            <a href="adaptation/screenplay">@L["Adaptation.ApproveScreenplayFirst"]</a>
                        </InlineAlert>
                    }
                    else if (Status.Stage2.Stage2Stale)
                    {
                        <InlineAlert Variant="warning" CssClass="py-2 small mb-3">
                            @L["Adaptation.ScreenplayChangedUpdateShots"]
                        </InlineAlert>
                    }
                    else if (!Status.Stage2.Stage2Ready)
                    {
                        <InlineAlert Variant="warning" CssClass="py-2 small mb-3">
                            @L.Format("Adaptation.ScreenplayScenesNoShots", Status.Stage2.Stage1Scenes)
                        </InlineAlert>
                    }
                }

                @* While building: only Cancel (in job panel) is interactive — hide other actions. *@
                @if (!Jobs.JobRunning)
                {
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <a class="btn btn-outline-secondary"
                           data-testid="shots-to-screenplay"
                           href="adaptation/screenplay"
                           title="Edit scene beats, dialogue lines, and visual actions in the screenplay editor">
                            @L["Adaptation.EditScreenplayBeats"]
                        </a>
                        <button class="btn btn-primary"
                                data-testid="shots-build"
                                disabled="@(Busy || !Status.Stage2.Stage1Exists)"
                                @onclick="Pipeline.RunShotsAsync">
                            @ShotPlanButtonLabel(Status.Stage2)
                        </button>
                        @if (Status.Stage2.Stage2Ready && !Status.Stage2.Stage2Stale)
                        {
                            <a class="btn btn-outline-primary" data-testid="shots-to-scenes" href="scenes"
                               title="Create video clips from this shot plan">@L["Adaptation.OpenScenesLink"]</a>
                        }
                        <div data-testid="shots-status"
                             data-ready="@(Status.Stage2.Stage2Ready && !Status.Stage2.Stage2Stale ? "true" : "false")"
                             data-scenes="@Status.Stage2.Stage2Scenes"
                             data-clips="@Status.Stage2.Stage2Clips"
                             class="visually-hidden"
                             aria-hidden="true"></div>
                    </div>
                }
                else
                {
                    <div data-testid="shots-status"
                         data-ready="false"
                         data-building="true"
                         data-scenes="@Status.Stage2.Stage2Scenes"
                         data-clips="@Status.Stage2.Stage2Clips"
                         class="visually-hidden"
                         aria-hidden="true"></div>
                }
            </div>
        </div>
    }
</AdaptationShell>
