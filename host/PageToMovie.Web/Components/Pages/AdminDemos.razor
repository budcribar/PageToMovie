@page "/admin/demos"
@inject EngineApiClient Api
@inject AdminSessionService Session
@inject NavigationManager Nav

<PageTitle>Demo gallery admin — PageToMovie</PageTitle>

<div class="container-fluid py-3">
    <AdminPageHeader Title="Demo gallery">
        <Subtitle>
            The private <strong>Page to Movie</strong> YouTube channel is the source of truth.
            Creators publish only through the app UI (server OAuth). Connect the channel once, then
            <strong>Sync channel → gallery</strong> (or open /demo for a throttled auto-sync).
        </Subtitle>
        <Actions>
            <a class="btn btn-sm btn-outline-primary" href="/demo">Public gallery</a>
            <BusyButton Label="Refresh" Busy="_busy" CssClass="btn btn-sm btn-outline-secondary" OnClick="ReloadAllAsync" />
        </Actions>
    </AdminPageHeader>

    @if (!Session.IsAdmin)
    {
        <InlineAlert Variant="warning">Admin session required. <a href="/admin/login">Sign in</a></InlineAlert>
    }
    else
    {
        <InlineAlert Message="@_error" />
        <InlineAlert Message="@_message" Variant="info" CssClass="py-2" />

        @* --- YouTube channel --- *@
        <div class="card mb-3 border-secondary">
            <div class="card-body py-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <div class="fw-semibold">YouTube channel</div>
                        <div class="small text-muted">
                            @if (_yt is null)
                            {
                                <span>Checking status…</span>
                            }
                            else if (!_yt.Configured)
                            {
                                <span class="text-warning">
                                    OAuth not configured. Set <code>PageToMovie__YouTube__ClientId</code>,
                                    <code>ClientSecret</code>, and <code>RedirectUri</code> on the API, then restart.
                                </span>
                            }
                            else if (_yt.Connected)
                            {
                                <span class="text-success">Connected — gallery can list this channel’s uploads (sync or open /demo).</span>
                            }
                            else
                            {
                                <span>Configured, but not connected yet. Connect once as admin.</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        @if (_yt is { Configured: true, Connected: true })
                        {
                            <button type="button" class="btn btn-primary btn-sm fw-semibold"
                                    disabled="@_busy" @onclick="SyncChannelAsync"
                                    title="List every upload on the connected channel and put them on the public gallery">
                                Sync channel → gallery
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    disabled="@_busy" @onclick="DisconnectYouTubeAsync">
                                Disconnect
                            </button>
                        }
                        else if (_yt is { Configured: true, Connected: false })
                        {
                            <button type="button" class="btn btn-warning btn-sm fw-semibold"
                                    disabled="@_busy" @onclick="ConnectYouTubeAsync">
                                Connect YouTube
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* --- Register existing YouTube video --- *@
        <div class="card mb-3 border-secondary">
            <div class="card-body py-3">
                <div class="fw-semibold mb-1">Add existing YouTube film to the gallery</div>
                <p class="small text-muted mb-3">
                    For demos already on YouTube — paste the watch URL or video id. No finished project required.
                </p>
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-5">
                        <label class="form-label small mb-1" for="admin-yt-url">YouTube URL or id</label>
                        <input id="admin-yt-url" class="form-control form-control-sm"
                               placeholder="https://www.youtube.com/watch?v=… or 11-char id"
                               @bind="_ytUrl" @bind:event="oninput" disabled="@_busy" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label small mb-1" for="admin-yt-title">Title</label>
                        <input id="admin-yt-title" class="form-control form-control-sm"
                               placeholder="Film title" @bind="_ytTitle" @bind:event="oninput" disabled="@_busy" />
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label small mb-1" for="admin-yt-desc">Description</label>
                        <input id="admin-yt-desc" class="form-control form-control-sm"
                               placeholder="Optional" @bind="_ytDesc" @bind:event="oninput" disabled="@_busy" />
                    </div>
                    <div class="col-12 col-md-2">
                        <button type="button" class="btn btn-primary btn-sm w-100"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_ytUrl) || string.IsNullOrWhiteSpace(_ytTitle))"
                                @onclick="RegisterFromYouTubeAsync">
                            Add to gallery
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
            <span class="small text-muted">Filter:</span>
            @foreach (var f in _filters)
            {
                <button type="button"
                        class="btn btn-sm @(_statusFilter == f.Key ? "btn-primary" : "btn-outline-secondary")"
                        disabled="@_busy"
                        @onclick="() => SetFilterAsync(f.Key)">
                    @f.Label
                </button>
            }
        </div>

        @if (_loading)
        {
            <p class="text-muted">Loading demos…</p>
        }
        else if (_demos.Count == 0)
        {
            <InlineAlert Variant="secondary"
                         Message="No demos in this filter. Link a YouTube video above — the public gallery only lists entries with a YouTube id." />
        }
        else
        {
            <div class="row g-3">
                <Virtualize TItem="DemoListItem" Items="_demos" Context="d">
                    <div class="col-12 col-xl-6" @key="@($"{d.Id}:{d.Status}:{d.YoutubeId}")">
                        <div class="card h-100 border-secondary">
                            <div class="card-header py-2 d-flex flex-wrap justify-content-between gap-2">
                                <div>
                                    <strong>@d.Title</strong>
                                    <span class="badge ms-1 @StatusBadgeClass(d.Status)">@(d.Status ?? "?")</span>
                                    @if (!string.IsNullOrWhiteSpace(d.YoutubeId))
                                    {
                                        <span class="badge text-bg-danger ms-1">YouTube</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary ms-1">no YT id</span>
                                    }
                                    @if (d.ReportCount > 0)
                                    {
                                        <span class="badge text-bg-warning ms-1">@d.ReportCount reports</span>
                                    }
                                </div>
                                <span class="small text-muted">@d.CreatedAt.ToLocalTime().ToString("g")</span>
                            </div>
                            <div class="card-body py-2">
                                <p class="small mb-2">
                                    <span class="text-muted">by</span> @(d.CreatedBy ?? "—")
                                    @if (!string.IsNullOrWhiteSpace(d.ProjectId))
                                    {
                                        <span class="text-muted"> · project</span> <code>@d.ProjectId</code>
                                    }
                                </p>
                                @if (!string.IsNullOrWhiteSpace(d.Description))
                                {
                                    <p class="small">@d.Description</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(d.YoutubeId))
                                {
                                    var embed = $"https://www.youtube.com/embed/{d.YoutubeId}?rel=0";
                                    var watch = !string.IsNullOrWhiteSpace(d.YoutubeUrl)
                                        ? d.YoutubeUrl
                                        : $"https://www.youtube.com/watch?v={d.YoutubeId}";
                                    <div class="ratio ratio-16x9 mb-2 rounded overflow-hidden bg-black">
                                        <iframe src="@embed" title="@d.Title" loading="lazy"
                                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                                allowfullscreen></iframe>
                                    </div>
                                    <a class="small" href="@watch" target="_blank" rel="noopener">Open on YouTube ↗</a>
                                }
                                else
                                {
                                    <p class="small text-muted mb-2">No YouTube id — not visible on the public wall.</p>
                                }
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    @if (!string.IsNullOrWhiteSpace(d.YoutubeId)
                                         && !string.Equals(d.Status, "public", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="button" class="btn btn-sm btn-success" disabled="@_busy"
                                                @onclick="@(() => ReviewAsync(d.Id, "public"))">
                                            Mark public
                                        </button>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                            @onclick="@(() => ReviewAsync(d.Id, "removed"))">
                                        Remove from gallery
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy"
                                            @onclick="@(() => HardDeleteAsync(d.Id))">
                                        Delete entry
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </Virtualize>
            </div>
        }
    }
</div>
