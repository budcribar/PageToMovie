@page "/simple-revoice"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject ClientMediaFolderService MediaFolder

<PageTitle>Put your voice on the film · PageToMovie</PageTitle>

<div class="mb-3">
    <span class="ptm-adapt-kicker">Easiest start · step 3</span>
    <h1 class="ptm-adapt-title mb-1">Your voice on the film</h1>
    <p class="ptm-adapt-lede mb-0">
        We keep the pictures and only re-speak the <strong>narrator</strong> with your cloned voice.
        Other speakers (like Mom) and silent clips stay as they are.
    </p>
</div>

@if (!Session.IsLoggedIn)
{
    <InlineAlert Variant="warning">
        <span>Sign in to re-voice a project.</span>
        <a class="btn btn-sm btn-primary ms-2" href="login?returnUrl=/simple-revoice">Sign in</a>
    </InlineAlert>
}
else
{
    <StudioProcessStrip Active="film" SimpleMode="true" />

    <InlineAlert Message="@_error" data-testid="simple-revoice-error" />
    <InlineAlert Message="@_message" Variant="success" CssClass="py-2" data-testid="simple-revoice-message" />

    <CascadingValue Value="this" IsFixed="true">
        <SimpleRevoiceMainCard />
    </CascadingValue>
}
