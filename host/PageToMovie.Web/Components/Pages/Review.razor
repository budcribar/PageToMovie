@page "/review"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject JobHubClient Hub
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ClientVideoStitchService Stitch
@inject ClientMediaFolderService MediaFolder
@inject ClientVoiceSubstitutionService VoiceSub
@inject StudioCapabilityState Caps
@inject IAppLocalizer L
@using PageToMovie.Core.Models

<PageTitle>@L["Nav.Review"] · final cut</PageTitle>

<StudioPageHeader Kicker="Studio · Edit afterward" Title="@L["Nav.Review"]">
    @L["ReviewPage.Subtitle"]
</StudioPageHeader>

<StudioProcessStrip Active="review" FullStudio="true" />

@if (_gateChecked && !ActiveProject.CanReview)
{
    <ReadinessGateBanner Visible="true"
                         Reason="@ActiveProject.ReviewBlockedReason"
                         FallbackReason="Finish the shot plan first."
                         ActionHref="adaptation/shots"
                         ActionLabel="Open shot plan →" />
}
else
{
<div class="d-flex align-items-center justify-content-end flex-wrap gap-2 mb-3">
    @if (_scenes.Count > 0)
    {
        var approvedCount = _scenes.Count(s => s.IsApproved);
        var pct = Math.Round((approvedCount * 100.0) / Math.Max(1, _scenes.Count));
        <div class="d-flex align-items-center gap-2 bg-dark border border-secondary px-3 py-1.5 rounded-pill text-white small shadow-sm"
             data-testid="review-checklist" data-approved-count="@approvedCount" data-scene-count="@_scenes.Count">
            <span><strong>Checklist:</strong> @approvedCount of @_scenes.Count scenes approved (@pct%)</span>
            <div class="progress ms-1" style="width: 80px; height: 6px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: @pct%"></div>
            </div>
        </div>
    }
</div>

<InlineAlert Message="@_error" />
@if (!_isReviewing)
{
    <InlineAlert Message="@_message" Variant="info" />
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 p-2.5 rounded border border-secondary" style="background-color: #0f172a;">
    <div class="btn-group" role="group" aria-label="Review page views">
        <button type="button" 
                class="btn @(_activeTab == "review" ? "btn-primary fw-bold" : "btn-outline-secondary text-white-50") px-3"
                data-testid="review-tab-review"
                @onclick='() => ToggleTabAsync("review")'>
            🤖 @L["ReviewPage.ReviewAndApprove"]
        </button>
        <button type="button" 
                class="btn @(_activeTab == "play" ? "btn-success fw-bold" : "btn-outline-secondary text-white-50") px-3"
                data-testid="review-tab-play"
                disabled="@(_busy || JobRunning || !HasGeneratedClips)"
                @onclick='() => ToggleTabAsync("play")'
                title="@(HasGeneratedClips ? WipPlayTitle : "Generate clips first")">
            ▶ @L["ReviewPage.Play"]
        </button>
        <button type="button" 
                class="btn @(_activeTab == "share" ? "btn-info text-white fw-bold" : "btn-outline-secondary text-white-50") px-3"
                data-testid="review-tab-share"
                disabled="@(_busy || JobRunning || !HasGeneratedClips)"
                @onclick='() => ToggleTabAsync("share")'
                title="@(HasGeneratedClips ? null : "Generate clips first")">
            📤 @L["ReviewPage.ShareAndExport"]
        </button>
        <button type="button"
                class="btn btn-outline-info text-info px-3"
                data-testid="review-open-editor"
                disabled="@(_busy || JobRunning || !HasGeneratedClips)"
                @onclick="OpenInExternalEditorAsync"
                title="@(HasGeneratedClips ? $"Open full cut video in {_preferredVideoEditor}" : "Generate clips first")">
            🎬 @L.Format("ReviewPage.OpenInEditor", _preferredVideoEditor)
        </button>
        <button type="button"
                class="btn btn-outline-primary px-3"
                data-testid="review-dub-my-voice"
                disabled="@(_busy || JobRunning || !HasGeneratedClips || _dubbing)"
                @onclick="DubInMyVoiceAsync"
                title="@(HasGeneratedClips ? "Replace the narrator with your recorded voice, then download" : "Generate clips first")">
            🎙️ @(_dubbing ? "Making your version…" : L["ReviewPage.MakeInMyVoice"])
        </button>
        @if (_dubbing && !string.IsNullOrWhiteSpace(_dubStatus))
        {
            <span class="small text-info align-self-center" data-testid="review-dub-status">@_dubStatus</span>
        }
    </div>

    <div class="d-flex align-items-center gap-2">
        @if (_activeTab == "review")
        {
            <CapabilityLockedControl Enabled="Caps.VideoReviewReady"
                                     BlockedReason="@Caps.VideoReviewBlockedReason"
                                     SettingsHref="@Caps.VideoReviewSettingsHref"
                                     TestId="review-auto-all-cap">
                <button class="btn btn-sm btn-outline-info fw-semibold" data-testid="review-auto-all"
                        disabled="@(_busy || JobRunning || _isReviewing || !HasGeneratedClips)"
                        title="@(HasGeneratedClips ? "Run AI visual quality and continuity review on the full movie" : "Generate clips first")"
                        @onclick="StartFullMovieReviewAsync">
                    @if (_isReviewing)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Reviewing (@_reviewProgressPct%)…</span>
                    }
                    else
                    {
                        <span>⚡ Run AI Continuity Review</span>
                    }
                </button>
            </CapabilityLockedControl>
        }
        @if (JobRunning)
        {
            <BusyButton Label="Cancel job" Busy="_busy" CssClass="btn btn-sm btn-outline-danger" OnClick="CancelAsync" />
        }
    </div>
</div>

@if (_activeTab == "review")
{
    @if (_isReviewing)
    {
        <div class="card p-4 mb-3 bg-dark text-white border-info shadow" data-testid="review-ai-progress">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="spinner-border text-info" role="status" style="width: 2rem; height: 2rem;"></div>
                    <div>
                        <h5 class="fw-bold text-white mb-0">🤖 Executive AI Movie Review in Progress</h5>
                        <div class="small text-light mt-1">@_reviewProgressStatus</div>
                    </div>
                </div>
                <span class="badge fs-6 text-bg-info px-3 py-2">@_reviewProgressPct%</span>
            </div>
            <div class="progress mb-2" style="height: 18px; background: rgba(255,255,255,0.15); border-radius: 8px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-info"
                     role="progressbar"
                     style="width: @(_reviewProgressPct)%; font-weight: 700; font-size: 0.85rem;"
                     aria-valuenow="@_reviewProgressPct"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    @_reviewProgressPct%
                </div>
            </div>
            <div class="alert alert-info py-2 px-3 mb-0 small text-start">
                ℹ️ <strong>Review in progress:</strong> Vision AI is evaluating video keyframes across 6 categories (Continuity, Character, Lighting, Pacing, Dialogue, Music). Please keep this page open.
            </div>
        </div>
    }

    @if (_movieReport is not null)
    {
                <Review_MovieReport Report="_movieReport"
                            OnDismiss="@( () => _movieReport = null)"
                            OnExpandAll="@(() => ToggleAllSceneGroups(true))"
                            OnCollapseAll="@(() => ToggleAllSceneGroups(false))"
                            OnToggleGroup="ToggleSceneGroupExpand"
                            IsGroupExpanded="IsSceneGroupExpanded" />

    }
    else
    {
        <div class="card mb-3 border-info text-white shadow-sm" style="background-color: #0f172a !important; border-color: #3b82f6 !important;">
            <div class="card-body p-4 text-center">
                <div class="fs-1 mb-2">🤖</div>
                <h5 class="fw-bold mb-2">@L["ReviewPage.AiVisualContinuityTitle"]</h5>
                <p class="text-white-50 mb-3 mx-auto" style="max-width: 600px;">
                    @L["ReviewPage.AiVisualContinuityDesc"]
                </p>
                <CapabilityLockedControl Enabled="Caps.VideoReviewReady"
                                         BlockedReason="@Caps.VideoReviewBlockedReason"
                                         SettingsHref="@Caps.VideoReviewSettingsHref"
                                         TestId="review-empty-cta-cap">
                    <button class="btn btn-info text-white fw-bold px-4"
                            disabled="@(_busy || JobRunning)"
                            @onclick="StartFullMovieReviewAsync">
                        ⚡ @L["ReviewPage.RunAiContinuityReview"]
                    </button>
                </CapabilityLockedControl>
            </div>
        </div>
    }
}
else if (_activeTab == "play")
{

@if (_youTubeUpload is not null)
{
    <p class="small text-muted mb-3" data-testid="review-youtube-last-upload">
        Last YouTube upload: <strong>@_youTubeUpload.Title</strong> (@_youTubeUpload.PrivacyStatus, @_youTubeUpload.UploadedAt.ToLocalTime().ToString("g")) —
        <a href="@_youTubeUpload.Url" target="_blank" rel="noopener">@_youTubeUpload.Url</a>
        @if (Session.IsAdmin)
        {
            <a href="#" class="ms-2" @onclick="DisconnectYouTubeAsync" @onclick:preventDefault="true">(disconnect channel)</a>
        }
    </p>
}



@if (_showWipPlayer && _clientStitching)
{
    <div class="card mb-3 border-secondary">
        <div class="card-body py-2 small text-muted">
            Combining full cut in browser… @_clientStitchStatus
        </div>
    </div>
}
else if (_showWipPlayer && (!string.IsNullOrEmpty(_clientWipUrl) || _wipExists))
{
    <div class="card mb-3 border-success">
        <div class="card-header d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
            <span>
                @if (!string.IsNullOrEmpty(_clientWipUrl))
                {
                    <span>WIP preview <span class="badge bg-info text-dark ms-1">client stitch</span></span>
                }
                else
                {
                    <span>WIP movie <code class="small">@(_wipPath ?? "assets/movie_wip.mp4")</code></span>
                    @if (_wipStale)
                    {
                        <span class="badge bg-warning text-dark ms-1">stale</span>
                    }
                    else
                    {
                        <span class="badge bg-success ms-1">current</span>
                    }
                }
            </span>
            @if (string.IsNullOrEmpty(_clientWipUrl) && !string.IsNullOrEmpty(_wipUpdatedAt))
            {
                <span class="small text-muted">updated @_wipUpdatedAt · @FormatBytes(_wipBytes)</span>
            }
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="HideWipPlayerAsync">Hide</button>
        </div>
        <div class="card-body py-2">
            @{ var wipNeedsRebuild = _wipStale && string.IsNullOrEmpty(_clientWipUrl); }
            @if (wipNeedsRebuild && MediaFolder.IsSyncing)
            {
                <MediaDownloadProgress Label="Downloading media to rebuild the movie…"
                                       CurrentFile="@MediaFolder.SyncCurrentFile" Current="@MediaFolder.SyncCurrent"
                                       Total="@MediaFolder.SyncTotal" Percent="@MediaFolder.SyncPercent" />
            }
            else if (wipNeedsRebuild && !MediaFolder.IsConnected)
            {
                <div class="py-3 text-center text-muted">
                    <p class="mb-2">@_wipReason — connect your local media folder to rebuild this movie from your synced clips.</p>
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ConnectFolderForWipAsync">Connect folder</button>
                </div>
            }
            else
            {
                @if (wipNeedsRebuild && !string.IsNullOrEmpty(_wipReason))
                {
                    <p class="small text-warning mb-2">@_wipReason — showing the last built copy, not current.</p>
                }
                <video controls playsinline autoplay="@(!wipNeedsRebuild)"
                       style="width:100%;max-height:70vh;background:#000;border-radius:0.35rem;"
                       src="@(string.IsNullOrEmpty(_clientWipUrl) ? WipServerSrc() : _clientWipUrl)"
                       @key="_wipVideoKey"
                       onloadeddata="this.play().catch(function(){})">
                    Your browser does not support HTML5 video.
                </video>
                @if (string.IsNullOrEmpty(_clientWipUrl))
                {
                    <div class="mt-2">
                        <a href="@Engine.WipMovieUrl(_projectId)" target="_blank" rel="noopener" class="small text-muted">Open in new tab</a>
                    </div>
                }
            }
        </div>
    </div>
}

@if (_showScenePlayer && _playingScene is int playSn && !_clientStitching)
{
    <div class="card mb-3 border-primary">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span>
                Scene
                <code class="small">S@(playSn.ToString("D2"))</code>
                @if (!string.IsNullOrEmpty(_clientSceneUrl))
                {
                    <span class="badge bg-info text-dark ms-1">client stitch</span>
                }
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="HideScenePlayerAsync">Hide</button>
        </div>
        <div class="card-body py-2">
            <video controls playsinline autoplay
                   style="width:100%;max-height:70vh;background:#000;border-radius:0.35rem;"
                   src="@(string.IsNullOrEmpty(_clientSceneUrl) ? SceneServerSrc(playSn) : _clientSceneUrl)"
                   @key="_sceneVideoKey"
                   onloadeddata="this.play().catch(function(){})">
                Your browser does not support HTML5 video.
            </video>
            <p class="small text-muted mb-0 mt-2">
                @if (string.IsNullOrEmpty(_clientSceneUrl))
                {
                    <a href="@Engine.CompositeVideoUrl(_projectId, playSn)" target="_blank" rel="noopener">Open in new tab</a>
                }
                else
                {
                    <span>Stitched in browser from clips (not written to disk).</span>
                }
            </p>
        </div>
    </div>
}
else if (_showScenePlayer && _clientStitching)
{
    <div class="card mb-3 border-secondary">
        <div class="card-body py-2 small text-muted">
            Combining scene in browser… @_clientStitchStatus
        </div>
    </div>
}

@if (_showClipPlayer && _playingClipScene is int clipSn && _playingClipNum is int clipCn)
{
    <div class="card mb-3 border-info">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span>
                Clip
                <code class="small">S@(clipSn.ToString("D2"))C@(clipCn.ToString("D2"))</code>
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="HideClipPlayer">Hide</button>
        </div>
        <div class="card-body py-2">
            <video controls playsinline autoplay
                   style="width:100%;max-height:50vh;background:#000;border-radius:0.35rem;"
                   src="@ClipServerSrc(clipSn, clipCn)"
                   @key="_clipVideoKey"
                   onloadeddata="this.play().catch(function(){})">
                Your browser does not support HTML5 video.
            </video>
            <p class="small text-muted mb-0 mt-2">
                <a href="@Engine.ClipVideoUrl(_projectId, clipSn, clipCn)" target="_blank" rel="noopener">Open in new tab</a>
                · after regen, <strong>Play scene</strong> stitches the updated cut in the browser
            </p>
        </div>
    </div>
}
}

@if (_job is not null &&
     (_job.Status is "running" or "done" or "error" or "cancelled") &&
     (_job.Kind is "remux" or "scene" or "batch" or "book_prepare" or "book_import" or "stage1" or "stage2"))
{
    var reviewJobMsg = string.Join(" ", new[]
    {
        _job.Message,
        _job.Scene is int jsn ? $"S{jsn:D2}" : null,
        _job.Clip is int jcn ? $"C{jcn}" : null,
        _job.Total > 0 && string.Equals(_job.Status, "running", StringComparison.OrdinalIgnoreCase)
            && KeyFormatting.EstimateTimeRemaining(_job.StartedAt, _job.Index, _job.Total) is { } eta
            ? eta : null
    }.Where(s => !string.IsNullOrWhiteSpace(s))!);
    <JobProgressCard Status="@_job.Status"
                     Message="@(string.IsNullOrWhiteSpace(reviewJobMsg) ? _job.Status : reviewJobMsg)"
                     Index="_job.Index"
                     Total="_job.Total"
                     Kind="@_job.Kind"
                     ShowLog="_job.Log.Count > 0"
                     LogLines="_job.Log"
                     LogMaxLines="30"
                     TestId="review-job" />
}


<div class="row g-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>@L["ReviewPage.ScenesAndClips"]</span>
                <span class="small text-muted fw-normal">@L["ReviewPage.PlayStitchesHint"]</span>
            </div>
            <div class="card-body p-0">
                @if (_scenes.Count == 0)
                {
                    <EmptyState Message="No scenes — finish Adaptation first." CssClass="text-muted p-3 mb-0" />
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th style="cursor:pointer; user-select:none;" @onclick='() => ToggleSceneSort("number")' title="Sort by scene number">
                                        @L["ReviewPage.Scene"] @(_sceneSortBy == "number" ? (_sceneSortAsc ? "▲" : "▼") : "⇅")
                                    </th>
                                    <th>@L["ReviewPage.Clips"]</th>
                                    <th style="cursor:pointer; user-select:none;" @onclick='() => ToggleSceneSort("duration")' title="Sort by duration">
                                        @L["ReviewPage.Dur"] @(_sceneSortBy == "duration" ? (_sceneSortAsc ? "▲" : "▼") : "⇅")
                                    </th>
                                    <th>@L["ReviewPage.Composite"]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in SortedReviewScenes)
                                {
                                    var sn = s.SceneNumber;
                                    var clipsDone = s.ClipsComplete || (s.ClipCount > 0 && s.ClipsOnDisk >= s.ClipCount);
                                    <tr class="@(_selectedScene == sn ? "table-active" : "")" data-testid="review-scene-row" data-scene-number="@sn" data-approved="@s.IsApproved.ToString().ToLowerInvariant()">
                                        <td class="text-nowrap">
                                            <span class="badge @(clipsDone ? "bg-success text-white" : "bg-warning text-dark") px-2 py-1 rounded-pill"
                                                  style="font-weight:600;cursor:pointer;"
                                                  title="@(clipsDone ? "All clips on disk" : "Missing clips")"
                                                  @onclick="() => SelectSceneAsync(sn)">
                                                S@(sn.ToString("D2"))
                                            </span>
                                            <div class="small text-muted mt-1">@(string.IsNullOrEmpty(s.Setting) ? "—" : s.Setting)</div>
                                        </td>
                                        <td class="small">@s.ClipsOnDisk/@s.ClipCount</td>
                                        <td class="small">
                                            @if (s.ActualDurationSeconds is double ad)
                                            {
                                                <span>@FormatClock(ad)</span>
                                            }
                                            else if (s.PlannedDurationSeconds is double pd)
                                            {
                                                <span class="text-muted">~@FormatClock(pd)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (s.CompositeExists || s.ClipsOnDisk > 0)
                                            {
                                                <span class="badge bg-success">@s.ClipsOnDisk/@s.ClipCount clips</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">—</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex flex-wrap gap-1 justify-content-end">
                                                <button class="btn btn-sm btn-success"
                                                        data-testid="@($"review-play-scene-{sn}")"
                                                        disabled="@(_busy || JobRunning || (s.ClipsOnDisk == 0 && !s.CompositeExists))"
                                                        title="Play scene (browser stitch from clips)"
                                                        @onclick="() => PlaySceneAsync(sn)">
                                                    ▶ Play
                                                </button>
                                                @if (s.IsApproved)
                                                {
                                                    <button class="btn btn-sm btn-success"
                                                            data-testid="@($"review-approve-{sn}")"
                                                            disabled="@(_busy || JobRunning)"
                                                            title="Scene is approved. Click to toggle."
                                                            @onclick="() => ApproveAsync(sn)">
                                                        ✓ Approved
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-success"
                                                            data-testid="@($"review-approve-{sn}")"
                                                            disabled="@(_busy || JobRunning)"
                                                            title="Mark scene approved"
                                                            @onclick="() => ApproveAsync(sn)">
                                                        ☐ Approve
                                                    </button>
                                                }
                                                <button class="btn btn-sm btn-link"
                                                        data-testid="@($"review-clips-{sn}")"
                                                        @onclick="() => SelectSceneAsync(sn)">
                                                    Clips
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @if (_selectedScene is int sel)
        {
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span>S@(sel.ToString("D2")) clip review</span>
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-success"
                                disabled="@(_busy || JobRunning || (ClipCountOnDisk(sel) == 0 && !SceneHasComposite(sel)))"
                                title="Play scene (browser stitch from clips)"
                                @onclick="() => PlaySceneAsync(sel)">
                            ▶ Play scene
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label small">Note (required to Pass after auto-review fail)</label>
                        <input class="form-control form-control-sm" @bind="_note" disabled="@_busy"
                               placeholder="Override reason if auto-review failed…" />
                    </div>
                    <div class="d-flex flex-column gap-3">
                        @for (var c = 1; c <= ClipCountFor(sel); c++)
                        {
                            var cn = c;
                            var key = $"S{sel:D2}C{cn:D2}";
                            var st = _reviews.TryGetValue(key, out var r) ? r : "—";
                            var onDisk = ClipOnDisk(sel, cn);
                            var autoBusy = IsAutoReviewRunning(sel, cn);
                            var draft = GetLocalDraft(sel, cn);
                            var editing = _editKey == key;
                            <div class="border rounded p-2 small">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge @(onDisk ? "bg-success text-white" : "bg-warning text-dark") px-2 py-1 rounded-pill"
                                          style="font-weight:600;"
                                          title="@(onDisk ? "On disk" : "Not on disk yet")">
                                        C@(cn.ToString("D2"))
                                    </span>
                                    <span class="badge bg-light text-dark">@st</span>
                                    @if (draft is not null && !editing)
                                    {
                                        <span class="badge bg-info text-dark">AI: @draft.Suggestion</span>
                                    }
                                </div>
                                <div class="btn-group btn-group-sm mt-1 flex-wrap">
                                    <button class="btn btn-outline-dark" disabled="@(_busy || !onDisk)"
                                            title="Play this clip"
                                            @onclick="() => PlayClip(sel, cn)">▶</button>
                                    <button class="btn btn-outline-primary"
                                            data-testid="@($"review-auto-{sel}-{cn}")"
                                            data-scene="@sel"
                                            data-clip="@cn"
                                            disabled="@(_busy || !onDisk || JobRunning || autoBusy || !Caps.VideoReviewReady)"
                                            title="@(Caps.VideoReviewReady ? "AI review: this clip + end of previous (does not change files)" : Caps.VideoReviewBlockedReason)"
                                            @onclick="() => StartAutoReviewAsync(sel, cn)">
                                        @(autoBusy ? "Reviewing…" : draft is not null && !editing ? "Review again" : "Review")
                                    </button>
                                    @if (draft is not null && !editing && !autoBusy)
                                    {
                                        <button class="btn btn-primary"
                                                data-testid="@($"review-apply-open-{sel}-{cn}")"
                                                disabled="@_busy"
                                                title="Show suggested edits to accept or change"
                                                @onclick="() => OpenApplyPanel(sel, cn)">
                                            Apply suggestions
                                        </button>
                                    }
                                    @if (editing)
                                    {
                                        <button class="btn btn-warning"
                                                data-testid="@($"review-apply-regen-{sel}-{cn}")"
                                                disabled="@(_busy || JobRunning || !HasIncludedEdits())"
                                                title="Save accepted edits and re-generate this clip"
                                                @onclick="() => ApplyAndRegenAsync(sel, cn)">
                                            Apply + regen
                                        </button>
                                        <button class="btn btn-outline-secondary" disabled="@_busy"
                                                @onclick="CloseApplyPanel">Cancel</button>
                                    }
                                    <button class="btn btn-outline-success" data-testid="@($"review-pass-{sel}-{cn}")" disabled="@_busy"
                                            @onclick="() => ReviewAsync(sel, cn, passStatus)">Pass</button>
                                    <button class="btn btn-outline-danger" data-testid="@($"review-fail-{sel}-{cn}")" disabled="@_busy"
                                            @onclick="() => ReviewAsync(sel, cn, failStatus)">Fail</button>
                                </div>
                                @if (autoBusy && _job is not null)
                                {
                                    var pct = _job.Status == "queued" || _job.Total <= 0
                                        ? 8
                                        : (int)Math.Round(100.0 * Math.Clamp(_job.Index, 0, _job.Total) / Math.Max(1, _job.Total));
                                    if (_job.Status == "running" && _job.Index <= 0) pct = 0;
                                    <div class="mt-2">
                                        <div class="d-flex justify-content-between text-muted">
                                            <span>@(_job.Message ?? "Reviewing…")</span>
                                            @if (_job.Total == 100 && _job.Status == "running")
                                            {
                                                <span>@_job.Index%</span>
                                            }
                                        </div>
                                        <div class="progress mt-1" style="height: 0.45rem;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                                 style="width: @(pct)%"></div>
                                        </div>
                                    </div>
                                }
                                @if (draft is not null && !editing && !autoBusy)
                                {
                                    <div class="form-text mt-1">
                                        @draft.Note
                                        @if (draft.IncludedPreviousTail)
                                        {
                                            <span class="text-muted"> · continuity: @draft.Continuity</span>
                                        }
                                        @if (draft.Suggestions.Count > 0)
                                        {
                                            <span> · @draft.Suggestions.Count suggestion(s)</span>
                                        }
                                    </div>
                                }
                                @if (editing && _editRows is not null)
                                {
                                    <div class="mt-2 border-top pt-2">
                                        @if (!string.IsNullOrEmpty(draft?.Note))
                                        {
                                            <div class="mb-2 text-muted">@draft!.Note</div>
                                        }
                                        @if (_editRows.Count == 0)
                                        {
                                            <p class="text-muted mb-1">No field changes suggested. You can Pass or Apply + regen as-is.</p>
                                        }
                                        @foreach (var row in _editRows)
                                        {
                                            <div class="border rounded p-2 mb-2 bg-light">
                                                <div class="form-check mb-1">
                                                    <input class="form-check-input" type="checkbox"
                                                           id="@row.Id" @bind="row.Include" disabled="@_busy" />
                                                    <label class="form-check-label" for="@row.Id">
                                                        <strong>@row.Label</strong>
                                                        <span class="text-muted">(@row.Layer@(string.IsNullOrEmpty(row.CharKey) ? "" : " · " + row.CharKey))</span>
                                                    </label>
                                                </div>
                                                @if (!string.IsNullOrEmpty(row.Rationale))
                                                {
                                                    <div class="text-muted mb-1">@row.Rationale</div>
                                                }
                                                @if (!string.IsNullOrEmpty(row.CurrentValue))
                                                {
                                                    <div class="mb-1">
                                                        <span class="text-muted">Current:</span>
                                                        <div class="small" style="max-height:4rem;overflow:auto;white-space:pre-wrap;">@row.CurrentValue</div>
                                                    </div>
                                                }
                                                <label class="form-label small mb-0">Suggested (editable)</label>
                                                <textarea class="form-control form-control-sm" rows="3"
                                                          @bind="row.Value" disabled="@(_busy || !row.Include)"></textarea>
                                            </div>
                                        }
                                        <p class="form-text mb-0">
                                            Check what to keep, edit text if needed, then <strong>Apply + regen</strong> saves and re-generates this clip.
                                        </p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <p class="small text-muted mb-0 mt-3">
                        <strong>Review</strong> drafts AI feedback (includes previous clip end when C2+).
                        <strong>Apply suggestions</strong> shows edits; <strong>Apply + regen</strong> writes them and re-gens.
                        <strong>Play scene</strong> / <strong>Play WIP</strong> stitch in the browser when needed (no server ffmpeg for preview).
                    </p>
                </div>
            </div>
        }
    </div>
</div>

<div class="card mt-3 border-secondary-subtle">
    <div class="card-header py-2 bg-transparent">
        <button type="button"
                class="btn btn-link text-decoration-none text-body p-0 d-flex align-items-center gap-2 w-100 text-start"
                @onclick="() => _showActivity = !_showActivity"
                aria-expanded="@_showActivity">
            <span class="small text-muted" style="width:1rem;display:inline-block;">@(_showActivity ? "▾" : "▸")</span>
            <span>Activity / history</span>
            <span class="badge bg-light text-dark border ms-1">@_entries.Count</span>
            <span class="small text-muted ms-auto fw-normal">audit trail of pass / fail / approve</span>
        </button>
    </div>
    @if (_showActivity)
    {
        <div class="card-body p-0 border-top">
            @if (_entries.Count == 0)
            {
                <p class="text-muted p-3 mb-0">No entries yet.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var e in _entries.Take(40))
                    {
                        <li class="list-group-item small">
                            <div class="d-flex justify-content-between">
                                <span class="badge bg-secondary">@e.Type</span>
                                <span class="text-muted">@e.Ts</span>
                            </div>
                            <div>
                                @if (e.Scene is int sn)
                                {
                                    <code>S@(sn.ToString("D2"))</code>
                                    @if (e.Clip is int cn)
                                    {
                                        <code class="ms-1">C@(cn.ToString("D2"))</code>
                                    }
                                }
                                <span class="ms-1">@e.UserNote</span>
                            </div>
                            @if (!string.IsNullOrEmpty(e.SuggestedRule))
                            {
                                <div class="text-muted">@e.SuggestedRule</div>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>
} @* end _activeTab == "review" *@
else if (_activeTab == "play")
{
    <div class="card mb-3 border-success shadow-lg text-white" style="background-color: #0f172a !important; border-color: #10b981 !important;">
        <div class="card-header border-secondary d-flex justify-content-between align-items-center py-2.5" style="background-color: #1e293b !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">🎬</span>
                <span class="fw-bold fs-6">Full Movie Player</span>
                @if (string.IsNullOrEmpty(_clientWipUrl) && !string.IsNullOrEmpty(_wipUpdatedAt))
                {
                    <span class="badge bg-dark border border-secondary text-white-50">updated @_wipUpdatedAt · @FormatBytes(_wipBytes)</span>
                }
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SetTabReview">Back to Review</button>
        </div>
        <div class="card-body p-3">
            @if (_clientStitching)
            {
                <div class="p-5 text-center text-info">
                    <div class="spinner-border text-info me-2" role="status"></div>
                    <div class="fw-semibold mt-2">Stitching full movie preview in browser…</div>
                    <div class="small text-muted mt-1">@_clientStitchStatus</div>
                </div>
            }
            else
            {
                <video controls playsinline autoplay
                       style="width:100%;max-height:75vh;background:#000;border-radius:0.5rem;"
                       src="@(string.IsNullOrEmpty(_clientWipUrl) ? WipServerSrc() : _clientWipUrl)"
                       @key="_wipVideoKey">
                    Your browser does not support HTML5 video.
                </video>
                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-secondary flex-wrap gap-2">
                    <span class="small text-muted">
                        @if (!string.IsNullOrEmpty(_clientWipUrl))
                        {
                            <span>Stitched directly in browser from scene clips</span>
                        }
                        else
                        {
                            <span>Saved movie file on server</span>
                        }
                    </span>
                    <div class="d-flex gap-2">
                        @if (string.IsNullOrEmpty(_clientWipUrl))
                        {
                            <a href="@Engine.WipMovieUrl(_projectId)" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">Open MP4 in new tab</a>
                        }
                        <button type="button" class="btn btn-sm btn-info text-white" @onclick="SetTabShare">
                            Share film →
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}
else if (_activeTab == "share")
{
    <div class="card mb-3 border-info text-white shadow-sm" style="background-color: #0f172a !important; border-color: #3b82f6 !important;" data-testid="review-share-card">
        <div class="card-header border-secondary d-flex justify-content-between align-items-center py-2.5" style="background-color: #1e293b !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">📤</span>
                <span class="fw-bold fs-6">Share &amp; Export Film</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SetTabReview">Back to Review</button>
        </div>
        <div class="card-body p-4 text-white">
<div class="alert alert-secondary border-secondary py-2 px-3 mb-3 small" data-testid="review-share-channel-note">
    Films publish to the private <strong>Page to Movie</strong> YouTube channel <em>only through this app</em>
    (no YouTube Studio for creators). The gallery plays those uploads.
</div>
@if (_youTubeStatus is not null && _youTubeStatus.Configured)
{
    @if (!_youTubeStatus.Connected)
    {
        @if (Session.IsAdmin)
        {
            <div class="alert alert-warning d-flex align-items-center justify-content-between mb-3 py-2 px-3 shadow-sm" data-testid="review-youtube-connect-alert">
                <div class="small">
                    <strong>Channel not connected:</strong> One-time admin OAuth so the app can upload to Page to Movie.
                </div>
                <button type="button" class="btn btn-sm btn-warning fw-bold text-dark ms-3 text-nowrap" @onclick="ConnectYouTubeAsync">
                    Connect Page to Movie channel
                </button>
            </div>
        }
        else
        {
            <div class="alert alert-warning py-2 px-3 mb-3 small" data-testid="review-youtube-waiting-admin">
                The Page to Movie channel isn’t connected yet. An admin must connect it once before publishes can upload.
            </div>
        }
    }
    else
    {
        <div class="alert alert-success py-2 px-3 mb-3 small d-flex align-items-center justify-content-between" data-testid="review-youtube-connected-alert">
            <span>✅ Page to Movie channel ready — publish from here to put your film on the wall.</span>
            @if (Session.IsAdmin)
            {
                <button type="button" class="btn btn-sm btn-link text-white-50 p-0 ms-2 text-decoration-none" @onclick="DisconnectYouTubeAsync">(disconnect)</button>
            }
        </div>
    }
}
@if (_isPublishing)
{
    <div class="card p-4 my-2 text-center bg-dark text-white border-primary shadow" data-testid="review-publish-progress">
        <div class="d-flex justify-content-center align-items-center gap-3 mb-3">
            <div class="spinner-border text-primary" role="status" style="width: 2.2rem; height: 2.2rem;"></div>
            <h5 class="fw-bold text-white mb-0">Publishing Film to Demo Gallery</h5>
        </div>
        <p class="text-light small mb-3">@_publishProgressStatus</p>
        <div class="progress mb-3" style="height: 20px; background: rgba(255,255,255,0.15); border-radius: 8px;">
            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                 role="progressbar"
                 style="width: @(_publishProgressPct)%; font-weight: 700; font-size: 0.85rem;"
                 aria-valuenow="@_publishProgressPct"
                 aria-valuemin="0"
                 aria-valuemax="100">
                @_publishProgressPct%
            </div>
        </div>
        <div class="alert alert-info py-2 px-3 mb-0 small text-start">
            ℹ️ <strong>Upload in progress:</strong> Please keep this page open while the cut uploads to the server. Once uploaded to 100%, YouTube processing will continue automatically in the background.
        </div>
    </div>
}
else
{
            <div class="mb-3">
                <label class="form-label small fw-semibold">Film Title</label>
                <input class="form-control bg-dark text-white border-secondary" @bind="_demoTitle" maxlength="120"
                       placeholder="e.g. The Tell-Tale Heart" />
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">About this film</label>
                <textarea class="form-control bg-dark text-white border-secondary" rows="3" @bind="_demoDescription"
                          placeholder="A short description for the gallery wall..." maxlength="800"></textarea>
            </div>
            <div class="mb-3">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="demoMadeForKids" @bind="_demoMadeForKids" />
                    <label class="form-check-label small" for="demoMadeForKids">
                        Made for kids (YouTube child-audience setting).
                    </label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="demoAiDisclosure" @bind="_demoIsAiSynthetic" />
                    <label class="form-check-label small" for="demoAiDisclosure">
                        Contains AI-generated visuals or audio.
                    </label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="demoGuidelines" @bind="_demoAcceptedGuidelines" />
                    <label class="form-check-label small" for="demoGuidelines">
                        I confirm this film is appropriate for a general audience.
                    </label>
                </div>
            </div>

@if (_showIncompleteWarning)
{
    <div class="alert alert-warning border-warning my-3 p-3 shadow-sm" data-testid="review-incomplete-warning">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="fs-4">⚠️</span>
            <div>
                <strong class="text-warning">Incomplete Movie Warning:</strong>
                <span class="ms-1">@_incompleteScenesCount scene(s) (@_missingClipsCount clip(s) total) have not been generated yet.</span>
            </div>
        </div>
        <p class="small mb-3 text-light">
            Uploading now will build a partial cut using only the available clips. You can click <strong>Proceed &amp; Upload Partial Cut</strong> to publish anyway, or cancel to finish generating clips first.
        </p>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-warning btn-sm fw-bold text-dark" @onclick="ConfirmIncompleteAndPublishAsync">
                Proceed &amp; Upload Partial Cut
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelIncompleteWarning">
                Cancel
            </button>
        </div>
    </div>
}

            <div class="d-flex justify-content-end gap-2 pt-3 border-top border-secondary">
                <button type="button" class="btn btn-outline-secondary" @onclick="SetTabReview">Cancel</button>
                <button type="button" class="btn btn-primary px-4" data-testid="review-save-confirm"
