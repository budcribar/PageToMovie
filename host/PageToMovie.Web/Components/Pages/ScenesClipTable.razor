@inherits PageToMovie.Web.Components.PageSliceComponent
@* Page-local to Scenes — clip table in scene detail. Option B: the row IS the clip surface —
   grip + checkbox + numbered expander + line + duration + ONE status chip; clicking a row expands
   it in place (player + actions), no separate inspector panel below the table. *@
@inject StudioCapabilityState Caps
@inject AdminSessionService Session
@inject IAppLocalizer L
@inject ClientMediaFolderService MediaFolder
@inject EngineApiClient Engine
@using Microsoft.AspNetCore.Components
@using PageToMovie.Core.Models

<div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr>
                <th style="width:1.2rem;"></th>
                <th style="width:2rem;">
                    <input class="form-check-input" type="checkbox"
                           data-testid="clip-select-all"
                           title="Select all clips"
                           checked="@ClipSel.AllClipsSelected"
                           disabled="@(Host._busy || ListState._detail is not { Clips.Count: > 0 })"
                           @onchange="e => ClipSel.ToggleSelectAllClips((bool)(e.Value ?? false))" />
                </th>
                <th style="width:5.5rem;">@L["ScenesPage.ClipHeader"]</th>
                <th>@L["ScenesPage.BeatScriptHeader"]</th>
                <th style="width:5rem; cursor:pointer; user-select:none;"
                    @onclick="ClipSel.ToggleClipDurationSort"
                    title="Click to sort by duration (drag-reorder needs plan order)">
                    @L["ScenesPage.DurHeader"] @ClipSel.DurationSortArrow
                </th>
                <th style="width:10rem;">@L["Common.Status"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in ClipSel.SortedDetailClips)
            {
                var active = ClipForm._selectedClip == c.ClipNumber;
                var cn = c.ClipNumber;
                var isChecked = ClipSel._selectedClips.Contains(cn);
                <tr class="@ClipRowClass(active, isChecked)" style="cursor:pointer;"
                    draggable="@(CanDragClips ? "true" : "false")"
                    @ondragstart="() => HandleClipDragStart(cn)"
                    @ondragover:preventDefault
                    @ondrop="() => HandleClipDropAsync(cn)"
                    @onclick="() => ToggleExpand(cn)">
                    <td class="text-muted text-center align-middle pe-0"
                        title="@(CanDragClips ? "Drag to reorder clips (renumbers files)" : "Reorder is off while sorted by duration or a job runs")"
                        style="cursor:@(CanDragClips ? "grab" : "default"); letter-spacing:-2px; opacity:.6;">⠿</td>
                    <td @onclick:stopPropagation="true">
                        <input class="form-check-input" type="checkbox"
                               data-testid="@($"clip-select-{cn}")"
                               checked="@isChecked"
                               disabled="@Host._busy"
                               @onchange="e => ClipSel.ToggleClipSelect(cn, (bool)(e.Value ?? false))" />
                    </td>
                    <td class="text-nowrap">
                        <button type="button"
                                class="btn btn-sm rounded-pill px-2 py-0 font-monospace fw-semibold align-baseline @(active ? "btn-primary" : "btn-outline-secondary")"
                                style="font-size:0.78rem;"
                                data-testid="@($"clip-expander-{cn}")"
                                title="@(active ? "Collapse this clip" : "Expand this clip (player + actions)")"
                                @onclick:stopPropagation="true"
                                @onclick="() => ToggleExpand(cn)">
                            C@(cn.ToString("D2")) @(active ? "▾" : "▸")
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-success py-0 px-1 ms-1"
                                data-testid="@($"clip-row-play-{cn}")"
                                disabled="@(Host._busy || Gen.JobRunning || !(Playback?.CanPlayClip(ListState._detail.SceneNumber, cn) ?? false))"
                                title="@(Playback?.ClipPlayTitle(ListState._detail.SceneNumber, cn) ?? "Play this clip")"
                                @onclick:stopPropagation="true"
                                @onclick="() => Playback!.PlaySingleClipAsync(ListState._detail.SceneNumber, cn)">
                            ▶
                        </button>
                    </td>
                    <td class="small clip-dialogue-cell" title="@ClipDialogueTitle(c)">
                        @if (!string.IsNullOrWhiteSpace(c.Speaker))
                        {
                            <strong class="text-info me-1" style="letter-spacing:0.03em;">@c.Speaker.ToUpper():</strong>
                        }
                        @if (!string.IsNullOrWhiteSpace(c.Dialogue))
                        {
                            <span>@Scenes.Trunc(c.Dialogue, 110)</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(c.VisualPrompt))
                        {
                            <span class="text-muted fst-italic">🎬 @Scenes.Trunc(c.VisualPrompt, 110)</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                        @if (c.CharactersOnScreen.Count > 0)
                        {
                            <span class="ms-1 text-muted small" style="font-size:0.72rem;">(@string.Join(", ", c.CharactersOnScreen.Select(Scenes.ShortChar)))</span>
                        }
                    </td>
                    <td class="small">
                        @if (c.ActualDurationSeconds is double ca)
                        {
                            <span>@Scenes.FormatClock(ca)</span>
                            @if (c.DurationSeconds > 0 && Math.Abs(c.DurationSeconds - ca) > 1.5)
                            {
                                <span class="text-muted"> · plan @c.DurationSeconds s</span>
                            }
                        }
                        else if (c.DurationSeconds > 0)
                        {
                            <span class="text-muted">~@c.DurationSeconds s</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td @onclick:stopPropagation="true">
                        @{ var (chipClass, chipText, chipTitle) = ClipStatusChip(c); }
                        @if (c.DialogueVerification is { } ver)
                        {
                            <button type="button" class="btn btn-sm p-0 border-0 align-baseline"
                                    data-testid="@($"clip-status-{cn}")"
                                    @onclick="() => Host.OpenVerificationModal(ListState._detail.SceneNumber, cn, ver)">
                                <span class="badge @chipClass d-inline-block text-center"
                                      style="min-width:8.5rem; cursor:pointer; padding:0.35em 0.6em; font-size:0.75rem;"
                                      title="@chipTitle (click for the verification report)">@chipText 📋</span>
                            </button>
                        }
                        else
                        {
                            <span class="badge @chipClass d-inline-block text-center"
                                  data-testid="@($"clip-status-{cn}")"
                                  style="min-width:8.5rem; padding:0.35em 0.6em; font-size:0.75rem;"
                                  title="@chipTitle">@chipText</span>
                        }
                    </td>
                </tr>
                @if (active)
                {
                    <tr class="clip-expansion">
                        <td colspan="6" class="p-0 border-0">
                            <ScenesClipInspector />
                        </td>
                    </tr>
                }
            }
            <tr>
                <td colspan="6" class="border-0">
                    <button type="button" class="btn btn-sm btn-link text-muted text-decoration-none px-1"
                            data-testid="clip-add"
                            disabled="@(Host._busy || Gen.JobRunning)"
                            title="Add a new clip to this scene's shot plan (generate its video afterward)"
                            @onclick="ClipForm.OpenAddClipDialog">
                        ＋ Add clip…
                    </button>
                </td>
            </tr>
        </tbody>
    </table>
</div>
