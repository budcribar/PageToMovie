@inherits PageToMovie.Web.Components.PageSliceComponent
@* Page-local to Scenes — scene detail *@
@inject StudioCapabilityState Caps
@inject AdminSessionService Session
@inject IAppLocalizer L
@inject ClientMediaFolderService MediaFolder
@inject EngineApiClient Engine
@using Microsoft.AspNetCore.Components
@using PageToMovie.Core.Models


    <InlineAlert Message="@Host._error" CssClass="mb-3" />
    @if (!Gen.JobRunning)
    {
        <InlineAlert Message="@Host._message" Variant="info" CssClass="mb-3" />
    }

    @* Live gen: one compact surface — status + bar + Cancel only (no badges, no Grok dump, no log). *@
    @if (Gen.ShowLiveGenProgress && Gen._job is not null)
    {
        <JobProgressCard Status="@Gen._job.Status"
                         Message="@Scenes.ScenesGeneration.LiveGenStatusLabel(Gen._job)"
                         Index="Gen._job.Index"
                         Total="Gen._job.Total"
                         Percent="Gen.LiveGenProgressPercent(Gen._job)"
                         ShowCancel="true"
                         CancelDisabled="false"
                         OnCancel="Gen.CancelAsync"
                         Kind="@Gen._job.Kind"
                         StartedAt="Gen._job.StartedAt"
                         TestId="scenes-gen-progress"
                         CancelTestId="scenes-gen-cancel" />
    }
    else if (Gen.ShowOperatorGenPartial && Gen._job is not null)
    {
        <ScenesGenPartialAlert />
    }
    else if (Gen.ShowOperatorGenError && Gen._job is not null)
    {
        <ScenesGenErrorAlert />
    }
    else if (Session.IsAdmin && Gen._job is not null &&
             (Gen._job.Status is "done" or "partial" or "error" or "cancelled"))
    {
        @* Admin: finished-job summary only — no live log dump (that belonged under generating). *@
        <div class="card mb-3 border-@FinishedJobBorder">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="small">@(Gen._job.Message ?? Gen._job.Status)</span>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@Host._busy" @onclick="ListState.ReloadListAsync">Refresh list</button>
                </div>
                @if (Gen._job.Log.Count > 0)
                {
                    <button type="button"
                            class="btn btn-sm btn-link text-muted p-0 mt-1 text-decoration-none"
                            @onclick="() => Gen._showAdminJobLog = !Gen._showAdminJobLog">
                        @(Gen._showAdminJobLog ? "Hide details" : "Details (admin)")
                    </button>
                    @if (Gen._showAdminJobLog)
                    {
                        <pre class="small mb-0 mt-1" style="max-height: 120px; overflow: auto;">@string.Join("\n", Gen._job.Log.TakeLast(20))</pre>
                    }
                }
            </div>
        </div>
    }

    @* ---- Scene detail ---- *@
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <div class="btn-group btn-group-sm" role="group" aria-label="Scene navigation">
                    <button type="button" class="btn btn-outline-secondary py-0 px-2"
                            disabled="@(!ListState.CanSelectPreviousScene || Host._busy)"
                            title="Previous Scene (Key: [)"
                            data-testid="scene-detail-prev"
                            @onclick="ListState.SelectPreviousSceneAsync">
                        ‹ Prev
                    </button>
                    <button type="button" class="btn btn-outline-secondary py-0 px-2"
                            disabled="@(!ListState.CanSelectNextScene || Host._busy)"
                            title="Next Scene (Key: ])"
                            data-testid="scene-detail-next"
                            @onclick="ListState.SelectNextSceneAsync">
                        Next ›
                    </button>
                </div>
                <span>
                    <strong>Scene @(ListState._detail.SceneNumber.ToString("D2"))</strong>
                    — @(ListState._detail.Setting is { Length: > 0 } st ? st : "—")
                </span>
                @if (ListState.CastReady)
                {
                    <span class="badge bg-success-subtle text-success border border-success border-opacity-25 ms-1" style="font-size:0.7rem;" title="Cast looks & voices locked in Step 2">🔒 Cast Locked</span>
                }
                else
                {
                    <a href="characters" class="badge bg-warning-subtle text-warning border border-warning border-opacity-50 text-decoration-none ms-1" style="font-size:0.7rem;" title="Pin character looks & voices in Step 2 before generating clips">⚠️ Cast Unlocked →</a>
                }
            </div>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button type="button"
                        class="btn btn-sm btn-outline-info"
                        title="View history & changes for this scene"
                        @onclick="() => History.OpenSceneHistoryAsync(ListState._detail.SceneNumber)">
                    📜 History
                </button>
                <button class="btn btn-sm btn-success"
                        disabled="@(Host._busy || Gen.JobRunning || (ListState._detail.ClipsOnDisk == 0 && !ListState._detail.CompositeExists))"
                        title="Play scene (browser stitch from clips)"
                        @onclick="() => Playback.PlaySceneCompositeAsync(ListState._detail.SceneNumber)">
                    ▶ Play scene
                </button>
                @if (ListState._detail.ClipsOnDisk > 0)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            disabled="@(Host._busy || Gen.JobRunning || Dialogue._verifyingClip)"
                            title="@(ClipSel._selectedClips.Count > 0 ? $"Run dialogue & speaker verification on {ClipSel._selectedClips.Count} selected clip(s)" : "Run dialogue & speaker verification on selected clips in the first column")"
                            @onclick="Dialogue.VerifySelectedScenesDialogueAsync">
                        @(ClipSel._selectedClips.Count > 0 ? $"🔍 Verify ({ClipSel._selectedClips.Count}) Selected Clips" : "🔍 Verify Clip Dialogue")
                    </button>
                }
                @if (ListState._detail.HasBackgroundMusic)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-info"
                            disabled="@(Host._busy || Gen.JobRunning)"
                            title="View past audio takes & compare against the current one"
                            @onclick="() => Music.OpenMusicCompareAsync(ListState._detail.SceneNumber)">
                        🎧 Audio Takes
                    </button>
                }
                @if (ListState._detail.CompositeExists || ListState._detail.ClipsOnDisk > 0)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-info"
                            data-testid="scene-open-external-editor"
                            disabled="@(Host._busy || Gen.JobRunning)"
                            title="Open scene video in @ClipRegen._preferredVideoEditor"
                            @onclick="() => ClipRegen.OpenInExternalEditorAsync(ListState._detail.SceneNumber, ClipForm._selectedClip)">
                        🎬 Open in @ClipRegen._preferredVideoEditor
                    </button>
                }
                @if (Host.DetailLockedByOther)
                {
                    <span class="badge bg-warning text-dark">🔒 @Host._detailLockOwner</span>
                }
            </div>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 mb-3" data-testid="scene-edit-hub">
                <a class="btn btn-sm btn-outline-secondary"
                   href="@StudioDeepLinks.Screenplay(ListState._detail.SceneNumber, returnScene: ListState._detail.SceneNumber)"
                   title="Edit dialogue and action for this scene in the full screenplay editor">✏️ Edit in Screenplay</a>
                <button type="button" class="btn btn-sm btn-outline-info"
                        data-testid="toggle-fountain-drawer"
                        @onclick="() => ListState._showFountainDrawer = !ListState._showFountainDrawer">
                    📜 @(ListState._showFountainDrawer ? "Hide Fountain Script" : "Show Fountain Script")
                </button>
            </div>

            @* Inline Fountain screenplay text drawer *@
            @if (ListState._showFountainDrawer)
            {
                <div class="card mb-3 border-info border-opacity-50 bg-dark bg-opacity-50" data-testid="scene-fountain-card">
                    <div class="card-header py-1 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span class="small fw-semibold text-info">📜 Fountain Script · Scene @ListState._detail.SceneNumber.ToString("D2")</span>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-link btn-sm p-0 text-muted small text-decoration-none"
                                    @onclick="() => ListState._showRawFountain = !ListState._showRawFountain">
                                @(ListState._showRawFountain ? "View Formatted" : "View Raw Fountain")
                            </button>
                            <button type="button" class="btn btn-link btn-sm p-0 text-muted small text-decoration-none"
                                    @onclick="() => ListState._showFountainDrawer = false">✕ Hide</button>
                        </div>
                    </div>
                    <div class="card-body py-2 px-3">
                        @if (!string.IsNullOrWhiteSpace(ListState._sceneFountainText))
                        {
                            @if (ListState._showRawFountain)
                            {
                                <pre class="p-2 mb-0 rounded bg-dark border border-secondary text-light small font-monospace" style="max-height: 240px; overflow-y: auto; white-space: pre-wrap;">@ListState._sceneFountainText</pre>
                            }
                            else
                            {
                                <div class="screenplay-view p-2 bg-dark rounded border border-secondary" style="max-height: 240px; overflow-y: auto; font-family: 'Courier New', Courier, monospace; font-size: 0.85rem; line-height: 1.4;">
                                    @foreach (var el in ListState._sceneFountainElements)
                                    {
                                        @switch (el.Type)
                                        {
                                            case PageToMovie.Fountain.FountainParser.ElementType.SceneHeading:
                                                <div class="fw-bold text-warning text-uppercase mb-2">@el.Text</div>
                                                break;
                                            case PageToMovie.Fountain.FountainParser.ElementType.Character:
                                                <div class="text-center fw-bold text-info text-uppercase mt-2 mb-0" style="letter-spacing: 0.05em;">@el.Text</div>
                                                break;
                                            case PageToMovie.Fountain.FountainParser.ElementType.Parenthetical:
                                                <div class="text-center text-muted fst-italic mb-0">@el.Text</div>
                                                break;
                                            case PageToMovie.Fountain.FountainParser.ElementType.Dialogue:
                                                <div class="mx-auto text-light mb-2" style="max-width: 32rem; text-align: center;">@el.Text</div>
                                                break;
                                            case PageToMovie.Fountain.FountainParser.ElementType.Transition:
                                                <div class="text-end fw-bold text-muted text-uppercase mb-2">@el.Text</div>
                                                break;
                                            case PageToMovie.Fountain.FountainParser.ElementType.Action:
                                            default:
                                                <div class="text-light text-opacity-75 mb-2" style="text-align: justify;">@el.Text</div>
                                                break;
                                        }
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted small py-2">
                                <em>No Fountain screenplay text parsed for Scene @ListState._detail.SceneNumber.</em>
                                <a href="@StudioDeepLinks.Screenplay(ListState._detail.SceneNumber, returnScene: ListState._detail.SceneNumber)" class="ms-1">Open Screenplay editor →</a>
                            </div>
                        }
                    </div>
                </div>
            }

            @* E4: regen scopes *@
            <div class="d-flex flex-wrap gap-1 mb-3" data-testid="regen-scopes">
                <span class="small text-muted align-self-center me-1">Regen:</span>
                <button type="button" class="btn btn-sm btn-outline-primary"
                        data-testid="regen-scope-missing"
                        disabled="@(Host._busy || Gen.JobRunning || !ListState.CastReady)"
                        title="Generate only missing clips in this scene"
                        @onclick="() => Gen.GenerateMissingInSceneAsync(ListState._detail.SceneNumber)">
                    Missing
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning"
                        data-testid="regen-scope-stale"
                        disabled="@(Host._busy || Gen.JobRunning || !ListState.CastReady || !(ListState._detail.Clips?.Any(c => c.IsStale) ?? false))"
                        title="Force re-generate stale clips in this scene"
                        @onclick="() => Gen.RegenStaleInSceneAsync(ListState._detail.SceneNumber)">
                    Stale
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger"
                        data-testid="regen-scope-scene"
                        disabled="@(Host._busy || Gen.JobRunning || !ListState.CastReady)"
                        title="Force re-generate entire scene"
                        @onclick="() => Gen.ForceRegenSceneAsync(ListState._detail.SceneNumber)">
                    Full scene
                </button>
            </div>

            @* Full scene composite — hide while clip selected, remux/gen busy, or full player open *@
            @if (Gen.IsSceneGenBusy(ListState._detail.SceneNumber))
            {
                <p class="small text-muted mb-2">
                    Scene composite hidden while combining…
                </p>
            }
            else if (Playback._showScenePlayer && Playback._playingScene == ListState._detail.SceneNumber)
            {
                <p class="small text-muted mb-2">
                    Playing full scene above.
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="Playback.HideScenePlayer">Show inline preview</button>
                </p>
            }
            else if (ListState._detail.CompositeExists && ClipForm._selectedClip is null)
            {
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h6 class="text-muted mb-0">Scene composite <span class="small fw-normal">(all clips · full scene)</span></h6>
                        <button class="btn btn-sm btn-link" type="button"
                                @onclick="() => Playback.PlaySceneCompositeAsync(ListState._detail.SceneNumber)">
                            Play full scene
                        </button>
                    </div>
                    <video controls playsinline
                           style="max-width:100%; max-height:280px; background:#111; border-radius:0.35rem;"
                           src="@(Playback._sceneCompositeVideoUrl ?? Playback._sceneCompositeServerUrl)"
                           @key="Playback._inlineCompositeKey"
                           poster=""></video>
                    <p class="small text-muted mb-0 mt-1">
                        Scene composite on disk (~@(ListState._detail.ActualDurationSeconds is double ad ? Scenes.FormatClock(ad) : "?")).
                        Select a clip row below to play one clip only.
                    </p>
                </div>
            }
            else if (ListState._detail.CompositeExists && ClipForm._selectedClip is int)
            {
                <p class="small text-muted mb-2">
                    Viewing single clip — full scene composite hidden.
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => ClipForm.SelectClip(null)">Show scene composite</button>
                </p>
            }

            @{
                var hasMissingClips = ListState._detail.Clips.Any(c => !c.OnDisk);
            }
            @if (hasMissingClips || ClipSel._selectedClips.Count > 0)
            {
                <div class="d-flex align-items-center flex-wrap gap-2 mb-2" data-testid="clip-select-bar">
                    @if (hasMissingClips)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                data-testid="clip-select-missing"
                                disabled="@Host._busy"
                                title="Check clips not yet on disk"
                                @onclick="ClipSel.SelectMissingClips">
                            Select missing
                        </button>
                    }
                    @if (ListState._detail.Clips.Any(c => c.DialogueVerification is { Status: "mismatch" } or { Status: "speaker_swap" }))
                    {
                        <button type="button"
                                class="btn btn-sm btn-warning text-black fw-semibold"
                                data-testid="clip-select-mismatched"
                                disabled="@Host._busy"
                                title="Check all clips in this scene with dialogue mismatches or speaker swaps"
                                @onclick="Dialogue.SelectMismatchedClips">
                            Select mismatched (@ListState._detail.Clips.Count(c => c.DialogueVerification is { Status: "mismatch" } or { Status: "speaker_swap" }))
                        </button>
                    }
                    @if (ClipSel._selectedClips.Count > 0)
                    {
                        <span class="small">
                            <strong>@ClipSel._selectedClips.Count</strong> selected
                            @if (ClipSel.EstimateSelectedClipsCostUsd() is { } scc)
                            {
                                <span class="text-muted">· ~$@(scc.ToString("0.00"))</span>
                            }
                        </span>
                        <button type="button" class="btn btn-sm btn-warning"
                                data-testid="clip-batch-regen"
                                disabled="@(Host._busy || Gen.JobRunning || !ListState.CastReady || Host.DetailLockedByOther)"
                                title="@RegenSelectedTitle"
                                @onclick="ClipRegen.RegenSelectedClipsAsync">
                            Generate selected
                        </button>
                    }
                </div>
            }

                        <ScenesClipTable />


        </div>
    </div>

    <ScenesClipInspector />
}
