@* Page-local to Scenes — dialogue verification report (compact: one screen, all collected data) *@
@using PageToMovie.Core.Models

@if (Visible && Report is not null)
{
    var status = (Report.Status ?? "").ToLowerInvariant();
    var (statusClass, statusText) = status switch
    {
        "verified" => ("bg-success", $"✓ Verified ({Report.DialogueAccuracyScore:P0})"),
        "speaker_swap" => ("bg-danger", "⚠ Speaker swap"),
        "visual_defect" => ("bg-danger", "⚠ Visual defect"),
        "mismatch" => ("bg-warning text-dark", $"⚠ Dialogue mismatch ({Report.DialogueAccuracyScore:P0})"),
        "no_speech" when !string.IsNullOrWhiteSpace(Report.ExpectedDialogue) => ("bg-danger", "⚠ No speech (0%)"),
        "no_speech" => ("bg-success", $"✓ Verified ({Report.DialogueAccuracyScore:P0})"),
        _ => ("bg-secondary", Report.Status ?? "unverified"),
    };
    var diff = Report.ActualDurationSeconds - Report.EstimatedDurationSeconds;
    var hasTiming = Report.EstimatedDurationSeconds > 0 || Report.ActualDurationSeconds > 0;

    <DarkModalShell Visible="true" OnClose="OnClose" HeaderClass="" TitleClass="" DialogClass="modal-lg modal-dialog-scrollable modal-dialog-centered">
        <Title>📋 Verification — S@(SceneNumber.ToString("D2")) C@(ClipNumber.ToString("D2"))</Title>
        <ChildContent>
            @* Row 1: verdict + who spoke + when *@
            <div class="d-flex flex-wrap align-items-center gap-3 mb-2" data-testid="verify-summary">
                <span class="badge @statusClass fs-6 px-3 py-1">@statusText</span>
                <span class="small text-light">
                    <span class="text-secondary">Speaker</span>
                    <strong>@(string.IsNullOrWhiteSpace(Report.ExpectedSpeaker) ? "—" : Report.ExpectedSpeaker)</strong>
                    <span class="text-secondary">→ heard</span>
                    <strong class="@(Report.SpeakerMatch ? "text-success" : "text-danger")">@(string.IsNullOrWhiteSpace(Report.DetectedSpeaker) ? "unknown" : Report.DetectedSpeaker)</strong>
                </span>
                <span class="small text-secondary ms-auto" title="Multimodal video + audio QA">@Report.VerifiedAt.ToLocalTime().ToString("MMM d, h:mm tt")</span>
            </div>

            @* Row 2: the numbers, one line each *@
            @if (hasTiming)
            {
                <div class="d-flex flex-wrap gap-3 small mb-2 p-2 rounded border border-secondary bg-black bg-opacity-40" data-testid="verify-facts">
                    <span><span class="text-secondary">Planned</span> <strong class="text-light">@($"{Report.EstimatedDurationSeconds:F1}s")</strong></span>
                    <span><span class="text-secondary">Actual</span> <strong class="text-light">@($"{Report.ActualDurationSeconds:F1}s")</strong></span>
                    <span><span class="text-secondary">Δ</span> <strong class="@(Math.Abs(diff) <= 1.0 ? "text-success" : "text-warning")">@(diff >= 0 ? $"+{diff:F1}s" : $"{diff:F1}s")</strong></span>
                    @if (Report.SpeechDurationSeconds > 0 || Report.ActionDurationSeconds > 0)
                    {
                        <span><span class="text-secondary">Speech</span> <strong class="text-info">@($"{Report.SpeechDurationSeconds:F1}s")</strong></span>
                        <span><span class="text-secondary">Action</span> <strong class="text-light">@($"{Report.ActionDurationSeconds:F1}s")</strong></span>
                    }
                    @if (Report.WordCount > 0)
                    {
                        <span><span class="text-secondary">Words</span> <strong class="text-light">@Report.WordCount</strong>@(Report.SyllableCount > 0 ? $" · {Report.SyllableCount} syl" : "")</span>
                    }
                    @if (Report.SpeechTruncated)
                    {
                        <span class="badge bg-danger">⚠ speech cut off</span>
                    }
                </div>
            }

            @* Row 3: script vs heard (diff when both exist) *@
            @if (!string.IsNullOrWhiteSpace(Report.ExpectedDialogue) || !string.IsNullOrWhiteSpace(Report.TranscribedDialogue))
            {
                <div class="mb-2 small" data-testid="verify-dialogue">
                    <div class="d-flex justify-content-between"><span class="text-secondary">Script</span><span class="badge bg-info text-dark">@($"{Report.DialogueAccuracyScore:P0}")</span></div>
                    <div class="p-2 rounded bg-black border border-secondary text-light font-monospace">@(string.IsNullOrWhiteSpace(Report.ExpectedDialogue) ? "(no dialogue planned)" : Report.ExpectedDialogue)</div>
                    <div class="text-secondary mt-1">Heard</div>
                    @if (!string.IsNullOrWhiteSpace(Report.ExpectedDialogue) && !string.IsNullOrWhiteSpace(Report.TranscribedDialogue))
                    {
                        <div class="p-2 rounded bg-black border border-secondary font-monospace">@DialogueDiffHtml.Render(Report.ExpectedDialogue, Report.TranscribedDialogue)</div>
                    }
                    else
                    {
                        <div class="p-2 rounded bg-black border border-secondary text-light font-monospace">@(string.IsNullOrWhiteSpace(Report.TranscribedDialogue) ? "(no speech detected)" : Report.TranscribedDialogue)</div>
                    }
                </div>
            }

            @* Row 4: what the verifier found, by tier — the reasons behind the score *@
            @if (Report.Issues is { Count: > 0 })
            {
                <div class="mb-2 small" data-testid="verify-issues">
                    <div class="text-secondary">Issues (@Report.Issues.Count)</div>
                    @foreach (var tier in IssueTiers)
                    {
                        var items = Report.Issues.Where(i => tier.Match(i.Kind)).ToList();
                        if (items.Count == 0) continue;
                        <div class="d-flex flex-wrap align-items-start gap-2 mt-1">
                            <span class="badge @tier.BadgeClass" title="@tier.Help">@tier.Label</span>
                            <ul class="mb-0 ps-3 text-light">
                                @foreach (var i in items)
                                {
                                    <li><code>@i.Kind</code>@(string.IsNullOrWhiteSpace(i.Word) ? "" : $" ‘{i.Word}’")@(string.IsNullOrWhiteSpace(i.Detail) ? "" : $" — {i.Detail}")</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
            else if (status is "verified")
            {
                <div class="small text-secondary mb-2">No issues reported — words, speaker and picture as planned.</div>
            }

            @* Row 5: the model's own note (short) *@
            @if (!string.IsNullOrWhiteSpace(Report.SummaryNote))
            {
                <div class="small text-secondary" style="white-space:pre-wrap;" data-testid="verify-note">📝 @Report.SummaryNote</div>
            }
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-secondary btn-sm" @onclick="OnClose">Close</button>
        </Footer>
    </DarkModalShell>
}
