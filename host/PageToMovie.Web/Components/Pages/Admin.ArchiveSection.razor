@inject ClientMediaFolderService MediaFolder
@using Microsoft.AspNetCore.Components

<Admin_CollapsibleCard Title="📦 Project Export, Import & Music Synthesis"
                               Expanded="Host._showProjectArchiving"
                               ExpandedChanged="@(v =>
 Host._showProjectArchiving = v)">
<div class="row g-3">
                        <div class="col-md-6">
                            <div class="fw-semibold small mb-2">Export (download zip)</div>
                            <p class="small text-muted mb-2">
                                Stage 1: server project folder. Stage 2: merge MP4/MP3/etc. from your
                                connected media folder under this project id. Connect the media folder first for a complete archive.
                            </p>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <select class="form-select form-select-sm" style="max-width: 16rem;"
                                        @bind="Host._exportProjectId"
                                        disabled="@(Host._archiveBusy || Host._projectOptions.Count == 0)">
                                    @if (Host._projectOptions.Count == 0)
                                    {
                                        <option value="">No projects</option>
                                    }
                                    else
                                    {
                                        @foreach (var p in Host._projectOptions)
                                        {
                                            <option value="@p">@p</option>
                                        }
                                    }
                                </select>
                                <button type="button" class="btn btn-sm btn-primary"
                                        disabled="@(Host._archiveBusy || string.IsNullOrWhiteSpace(Host._exportProjectId))"
                                        @onclick="Host.ExportProjectAsync">
                                    @(Host._archiveBusy && Host._archiveAction == "export" ? "Exporting…" : "Download full project + media")
                                </button>
                            </div>
                            <p class="form-text mb-0 mt-1">
                                Includes <code>source/</code>, <code>assets/</code>, scenes, cast, book page PNGs, clips.
                            </p>
                        </div>
                        <div class="col-md-6">
                            <div class="fw-semibold small mb-2">Import (upload zip)</div>
                            <p class="small text-muted mb-2">
                                Stage 1: project files to the server. Stage 2: MP4/MP3/etc. into your
                                connected media folder (same layout as export). Connect the media folder first for a full restore.
                            </p>
                            <InputFile OnChange="Host.OnImportFileSelected" accept=".zip,application/zip"
                                       class="form-control form-control-sm mb-2"
                                       disabled="@Host._archiveBusy" />
                            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                                <input class="form-control form-control-sm" style="max-width: 11rem;"
                                       placeholder="Optional new id"
                                       @bind="Host._importPreferredId"
                                       disabled="@Host._archiveBusy" />
                                <select class="form-select form-select-sm" style="max-width: 13rem;"
                                        @bind="Host._importTargetUserId"
                                        disabled="@Host._archiveBusy"
                                        title="Select a target user to own the imported project area">
                                    <option value="">Target owner: (unassigned / admin)</option>
                                    @foreach (var u in Host._userList)
                                    {
                                        <option value="@u">User: @u</option>
                                    }
                                </select>
                                <div class="form-check mb-0">
                                    <InputCheckbox class="form-check-input" id="importOverwrite" @bind-Value="Host._importOverwrite" />
                                    <label class="form-check-label small" for="importOverwrite">Overwrite</label>
                                </div>
                                <button type="button" class="btn btn-sm btn-success"
                                        disabled="@(Host._archiveBusy || Host._importFile is null)"
                                        @onclick="Host.ImportProjectAsync">
                                    @(Host._archiveBusy && Host._archiveAction == "import" ? "Importing…" : "Import project")
                                </button>
                            </div>
                            <p class="form-text mb-0 mt-1">
                                Max ~512&nbsp;MB. Zip should contain <code>project.json</code> (optionally under a top folder).
                            </p>
                        </div>
                        <div class="col-md-12 mt-3 pt-3 border-top">
                            <div class="fw-semibold small mb-2">🎵 Augment &amp; Synthesize Project Music Scores</div>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <select class="form-select form-select-sm" style="max-width: 16rem;"
                                        @bind="Host._augmentProjectId"
                                        disabled="@(Host._archiveBusy || Host._projectOptions.Count == 0)">
                                    @if (Host._projectOptions.Count == 0)
                                    {
                                        <option value="">No projects</option>
                                    }
                                    else
                                    {
                                        @foreach (var p in Host._projectOptions)
                                        {
                                            <option value="@p">@p</option>
                                        }
                                    }
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        disabled="@(Host._archiveBusy || string.IsNullOrWhiteSpace(Host._augmentProjectId))"
                                        @onclick="Host.AugmentMusicAsync">
                                    @(Host._archiveBusy && Host._archiveAction == "augment" ? "Composing Scores…" : "1. Compose Score Prompts")
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-success ms-1"
                                        disabled="@(Host._archiveBusy || string.IsNullOrWhiteSpace(Host._augmentProjectId))"
                                        @onclick="Host.SynthesizeAudioAsync">
                                    @(Host._archiveBusy && Host._archiveAction == "synthesize" ? $"Synthesizing Audio ({Host._synthesizeCurrent}/{Host._synthesizeTotal})…" : "🎼 Synthesize Scene Audio Tracks (Skip Existing)")
                                </button>
                            </div>
                            @if (Host._archiveBusy && Host._archiveAction == "synthesize" && Host._synthesizeTotal > 0)
                            {
                                var pct = Math.Min(100, Math.Max(5, (int)Math.Round((double)Host._synthesizeCurrent / Host._synthesizeTotal * 100.0)));
                                <div class="progress mt-2 mb-1" style="height: 20px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                                         role="progressbar"
                                         style="width: @pct%"
                                         aria-valuenow="@pct"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        @Host._synthesizeCurrent / @Host._synthesizeTotal scenes (@pct%)
                                    </div>
                                </div>
                            }
                            <p class="form-text mb-0 mt-2">
                                1. <strong>Compose Score Prompts</strong> non-destructively enriches <code>blueprint.clips.grok.json</code> with AI background music score prompts across all scenes.<br/>
                                2. <strong>Synthesize Scene Audio Tracks</strong> checks each scene and queues AI stereo background music generation for any scene missing audio.
                            </p>
                            @if (Host._archiveBusy && Host._archiveAction == "synthesize")
                            {
                                <p class="form-text mb-0 mt-1">
                                    Local media folder:
                                    @if (MediaFolder.IsConnected)
                                    {
                                        <span class="text-success">connected (@MediaFolder.FolderName)</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">not connected — generated audio cannot be saved</span>
                                    }
                                    @if (!string.IsNullOrEmpty(MediaFolder.LastStatus))
                                    {
                                        <text> · </text><code>@MediaFolder.LastStatus</code>
                                    }
                                </p>
                            }
                        </div>
                    </div>
                    <InlineAlert Message="@Host._archiveMsg" Variant="info" CssClass="py-2 small mt-3 mb-0" />
                    <InlineAlert Message="@Host._archiveError" CssClass="py-2 small mt-3 mb-0" />
        
</Admin_CollapsibleCard>
