@* Page-local to Home — named project checkpoints list/save (embedded in Manage) *@
@using Microsoft.AspNetCore.Components

<div class="rounded p-2 bg-dark bg-opacity-25 border border-secondary border-opacity-25"
     data-testid="home-checkpoints-panel">
    <div class="small text-muted mb-2">
        Snapshot before a risky change (e.g. music). Roll back anytime — your clips are kept.
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <input class="form-control form-control-sm bg-white text-dark border-secondary"
               style="max-width: 20rem;"
               data-testid="home-checkpoint-name"
               value="@Host.Checkpoints._checkpointName"
               @oninput="@(e => Host.Checkpoints._checkpointName = e.Value?.ToString() ?? "")"
               disabled="@Host.Checkpoints._checkpointBusy"
               maxlength="80"
               placeholder="Name (e.g. Before music)" />
        <button class="btn btn-success btn-sm"
                data-testid="home-checkpoint-save"
                disabled="@(Host.Checkpoints._checkpointBusy || string.IsNullOrWhiteSpace(Host.Checkpoints._checkpointName))"
                @onclick="Host.Checkpoints.CreateCheckpointAsync">
            @(Host.Checkpoints._checkpointBusy ? "Saving…" : "Save checkpoint")
        </button>
    </div>
    @if (Host.Checkpoints._checkpoints.Count == 0)
    {
        <div class="small text-muted">No checkpoints yet.</div>
    }
    else
    {
        <ul class="list-unstyled mb-0 home-checkpoint-list" data-testid="home-checkpoint-list">
            @foreach (var cp in Host.Checkpoints._checkpoints)
            {
                <li class="d-flex flex-wrap align-items-center justify-content-between gap-2 py-1 border-top border-secondary border-opacity-25">
                    <span class="min-w-0">
                        <span class="fw-semibold text-truncate">@(string.IsNullOrWhiteSpace(cp.Message) ? cp.CommitHash[..Math.Min(8, cp.CommitHash.Length)] : cp.Message)</span>
                        <span class="small text-muted ms-1">· @cp.CommittedAt.ToLocalTime().ToString("MMM d, HH:mm")</span>
                    </span>
                    <button class="btn btn-outline-warning btn-sm flex-shrink-0"
                            data-testid="@($"home-checkpoint-revert-{cp.CommitHash[..Math.Min(8, cp.CommitHash.Length)]}")"
                            disabled="@Host.Checkpoints._checkpointBusy"
                            @onclick="() => Host.Checkpoints.RevertCheckpointAsync(cp)">
                        Roll back
                    </button>
                </li>
            }
        </ul>
    }
</div>
