@page "/"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject JobHubClient Hub
@inject NavigationManager Nav
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject IJSRuntime Js
@inject ClientMediaFolderService MediaFolder
@inject IAppLocalizer L
@using PageToMovie.Core.Models
@using PageToMovie.Core.Util

<PageTitle>PageToMovie</PageTitle>

<InlineAlert Message="@_error" />
<InlineAlert Message="@_message" Variant="info" />

@if (_healthOk == false)
{
    <InlineAlert Variant="warning" Message="Server not reachable. Start PageToMovie.Api, then reload this page." />
}


<Home_Landing IsLoggedIn="Session.IsLoggedIn" />

@if (!Session.IsLoggedIn)
{
    @* Same three cards as signed-in easy home; CTAs send guests to sign-in. *@
    <PromoCard TestId="home-simple-voice-card" Eyebrow="@L["Home.EasiestStart"]" Title="@L["Home.ReadLibraryBook"]">
        <Body>
            @L["Home.PickStoryRecordSample"]
        </Body>
        <Cta>
            <a href="login?returnUrl=/simple-voice" class="btn btn-primary btn-sm flex-shrink-0" data-testid="home-open-simple-voice">
                @L["Home.SignInToTry"]
            </a>
        </Cta>
    </PromoCard>
    <PromoCard TestId="home-full-studio-card" Eyebrow="@L["Home.Advanced"]" Title="@L["Home.FullStudio"]">
        <Body>
            @L["Home.CastEstimateFilmReview"]
        </Body>
        <Cta>
            <a href="login?returnUrl=/" class="btn btn-primary btn-sm flex-shrink-0" data-testid="home-open-full-studio-guest">
                @L["Home.SignInForStudio"]
            </a>
        </Cta>
    </PromoCard>
}
else if (_projects is null)
{
    <div class="card mb-3 home-studio-card">
        <div class="card-body py-3 text-muted small">@L["Common.Loading"]</div>
    </div>
}
else
{
    var activeMeta = _projects.Projects.FirstOrDefault(p =>
        string.Equals(p.Id, _projects.Active?.Id, StringComparison.OrdinalIgnoreCase));
    var hasActive = ActiveProject.HasProject || !string.IsNullOrWhiteSpace(_projects.Active?.Id);

    @if (ShowEasyHome)
    {
        @* Default home: easiest start only — advanced project picker is behind Full studio. *@
        <PromoCard TestId="home-simple-voice-card" Eyebrow="@L["Home.EasiestStart"]" Title="@L["Home.ReadLibraryBook"]">
            <Body>
                @L["Home.PickStoryRecordSampleStock"]
            </Body>
            <Cta>
                <a href="simple-voice" class="btn btn-primary btn-sm flex-shrink-0" data-testid="home-open-simple-voice">
                    @L["Home.TryWithYourVoice"]
                </a>
            </Cta>
        </PromoCard>

        <PromoCard TestId="home-full-studio-card" Eyebrow="@L["Home.Advanced"]" Title="@L["Home.FullStudio"]">
            <Body>
                @L["Home.FullStudioDescription"]
            </Body>
            <Cta>
                <button type="button"
                        class="btn btn-primary btn-sm flex-shrink-0"
                        data-testid="home-open-full-studio"
                        @onclick="EnterFullStudio">
                    @L["Home.OpenFullStudio"]
                </button>
            </Cta>
        </PromoCard>
    }
    else
    {
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <button type="button"
                    class="btn btn-link btn-sm px-0"
                    data-testid="home-back-easy-start"
                    @onclick="ExitFullStudio">
                @L["Home.BackToEasyStart"]
            </button>
            <span class="small text-muted">@L["Home.FullStudio"]</span>
        </div>

        <div class="card mb-3 home-studio-card" data-testid="home-studio-card">
            <div class="card-body py-3">
                @if (hasActive)
                {
                    @* Single studio bar: Project · name · visibility · New · Manage · [Setup if keys missing] *@
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2 home-active-toolbar">
                        <span class="home-project-label text-muted small text-uppercase flex-shrink-0">Project</span>
                        <select class="form-select form-select-sm home-project-select flex-grow-1"
                                style="min-width: 10rem; max-width: 22rem;"
                                data-testid="home-project-picker"
                                value="@(_projects.Active?.Id ?? ActiveProject.ProjectId)"
                                disabled="@_busy"
                                title="Project"
                                aria-label="Project"
                                @onchange="OnPickerChangedAsync">
                            @foreach (var p in _projects.Projects)
                            {
                                <option @key="p.Id" value="@p.Id">@(p.Label ?? p.Title ?? p.Id)</option>
                            }
                        </select>
                        @if (activeMeta is not null)
                        {
                            <span class="badge @VisibilityBadgeClass(activeMeta.VisibilityMode) small fw-normal flex-shrink-0"
                                  title="Visibility">
                                @VisibilityBadgeText(activeMeta.VisibilityMode)
                            </span>
                        }
                        <button type="button"
                                class="btn btn-outline-primary btn-sm flex-shrink-0"
                                data-testid="home-new-project"
                                disabled="@_busy"
                                @onclick="OpenNewProjectAsync"
                                title="New project">
                            + New
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm flex-shrink-0"
                                data-testid="home-import-project"
                                disabled="@(_busy || _importing)"
                                @onclick="ToggleImport"
                                title="Import a project zip">
                            Import
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm flex-shrink-0"
                                data-testid="home-manage-projects"
                                aria-expanded="@(_manageExpanded ? "true" : "false")"
                                @onclick="() => _manageExpanded = !_manageExpanded">
                            Manage @(_manageExpanded ? "▴" : "▾")
                        </button>
                        @if (NeedsApiSetup)
                        {
                            <a href="configuration"
                               class="btn btn-warning btn-sm flex-shrink-0"
                               data-testid="home-setup-config"
                               title="Connect your AI API keys">
                                Setup keys
                            </a>
                        }
                    </div>

                    <div class="home-project-cost d-flex flex-wrap align-items-center gap-2 gap-md-3 mb-2"
                         data-testid="home-project-cost">
                        @if (_costLoading && _costEstimateUsd is null && _costActualUsd is null)
                        {
                            <span class="small text-muted">Loading cost…</span>
                        }
                        else if (_costNeedsModels)
                        {
                            <span class="small text-muted" data-testid="home-cost-needs-setup">
                                Estimate available after <a href="/configuration">setup</a>.
                            </span>
                        }
                        else
                        {
                            <span class="small">
                                <span class="text-muted">Estimate</span>
                                <strong class="ms-1" data-testid="home-cost-estimate">@FormatUsd(_costEstimateUsd)</strong>
                                @if (!string.IsNullOrWhiteSpace(_costResolution))
                                {
                                    <span class="text-muted ms-1">(@_costResolution</span>
                                    @if (_costVideoRate is > 0)
                                    {
                                        <span class="text-muted"> · @FormatUsd(_costVideoRate)/s</span>
                                    }
                                    <span class="text-muted">)</span>
                                }
                            </span>
                            <span class="text-muted small d-none d-sm-inline">·</span>
                            <span class="small">
                                <span class="text-muted">Spent</span>
                                <strong class="ms-1" data-testid="home-cost-spent">@FormatUsd(_costActualUsd)</strong>
                            </span>
                            <a href="/cost" class="small ms-sm-1" data-testid="home-cost-details">Details</a>
                        }
                    </div>

                    @* Package history: auto-commits on save; never auto-reverts. *@
                    <div class="d-flex flex-wrap align-items-center gap-2 gap-md-3 mb-2 small"
                         data-testid="home-package-history">
                        @if (_packageStatusLoading && _packageStatus is null)
                        {
                            <span class="text-muted">Checking package history…</span>
                        }
                        else if (_packageStatus is { GitAvailable: true })
                        {
                            <span>
                                <span class="text-muted">Last saved</span>
                                @if (!string.IsNullOrWhiteSpace(_packageStatus.LastCommitHash))
                                {
                                    <strong class="ms-1 font-monospace" data-testid="home-last-saved-hash">@ShortHash(_packageStatus.LastCommitHash)</strong>
                                }
                                else
                                {
                                    <span class="ms-1 text-muted">—</span>
                                }
                                @if (_packageStatus.LastCommitAtUtc is DateTime when)
                                {
                                    <span class="text-muted ms-1" title="@when.ToString("u")">@FormatRelativeUtc(when)</span>
                                }
                            </span>
                            @if (_packageStatus.HasUncommittedChanges)
                            {
                                <span class="badge text-bg-warning text-dark fw-normal" data-testid="home-package-dirty">
                                    Unsaved package changes
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(PackageHistoryUrl))
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                                        data-testid="home-package-history-link"
                                        disabled="@_busy"
                                        @onclick="() => OpenHistoryAsync(PackageHistoryUrl!)">
                                    History
                                </button>
                            }
                            @if (CanSavePackageRevision)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                                        data-testid="home-package-save-revision"
                                        disabled="@_busy"
                                        title="Commit text package and push to backup when configured"
                                        @onclick="() => SaveRevisionAsync(ActivePackageProjectId)">
                                    Save revision
                                </button>
                            }
                        }
                        else if (_packageStatus is not null && !string.IsNullOrWhiteSpace(_packageStatus.SkipReason))
                        {
                            <span class="text-muted" title="@_packageStatus.SkipReason">Package history off on this host</span>
                        }
                    </div>

                    @if (_manageExpanded && hasActive)
                    {
                        <div class="home-manage-panel mb-3 p-2 rounded border border-secondary border-opacity-25">
                            @{
                                var id = _projects.Active?.Id ?? ActiveProject.ProjectId ?? "";
                                var p = activeMeta ?? _projects.Projects.FirstOrDefault(x =>
                                    string.Equals(x.Id, id, StringComparison.OrdinalIgnoreCase));
                                var canManage = CanManageProject(p);
                            }
                            @if (p is not null)
                            {
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    @if (!string.IsNullOrWhiteSpace(p.ParentProjectId) && canManage)
                                    {
                                        <a class="btn btn-sm btn-outline-warning"
                                           href="projects/@id/review-contribution?originProjectId=@p.ParentProjectId">
                                            Diff
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                                @onclick="() => SyncOriginAsync(id, p.ParentProjectId!)">
                                            Sync origin
                                        </button>
                                    }
                                    @if (canManage)
                                    {
                                        <select class="form-select form-select-sm w-auto"
                                                value="@p.VisibilityMode"
                                                disabled="@_busy"
                                                @onchange="(e) => ChangeVisibilityAsync(id, e.Value?.ToString())">
                                            <option value="Private">Private</option>
                                            <option value="Public">Public (Read-Only)</option>
                                            <option value="Open">Public (Forkable)</option>
                                        </select>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                                @onclick="BeginRenameAsync">
                                            Rename
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                disabled="@(_busy || _backingUp)"
                                                data-testid="home-backup-project"
                                                title="Download a full backup zip (project files + all media)"
                                                @onclick="BackupProjectAsync">
                                            @(_backingUp ? "Backing up…" : "Back up")
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                disabled="@_busy"
                                                data-testid="home-checkpoints"
                                                title="Save named checkpoints of this project and roll back to one (your clips are kept)"
                                                @onclick="ToggleCheckpointsAsync">
                                            Checkpoints
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                                @onclick="() => OpenCollaboratorsModal(id)">
                                            Collaborate
                                        </button>
                                        @if (_historyUrls.TryGetValue(id, out var historyUrl) && !string.IsNullOrWhiteSpace(historyUrl))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                                    @onclick="() => OpenHistoryAsync(historyUrl)">
                                                GitHub
                                            </button>
                                        }
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-auto" disabled="@_busy"
                                            @onclick="() => BeginDeleteAsync(id, p.Label ?? p.Title ?? id)">
                                        Delete
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="small text-muted mb-0">No project details to manage.</p>
                            }
                        </div>
                    }

                    @if (_showRename && hasActive)
                    {
                        <div class="border border-secondary border-opacity-50 rounded p-3 mt-2 bg-dark bg-opacity-75 text-white shadow-sm">
                            <div class="fw-semibold small text-light mb-2">Rename project</div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <input class="form-control form-control-sm flex-grow-1 bg-white text-dark border-secondary fw-medium"
                                       style="min-width: 10rem; color: #111111 !important; background-color: #ffffff !important;"
                                       data-testid="home-rename-project-name"
                                       value="@_renameName"
                                       @oninput="OnRenameNameInput"
                                       disabled="@_busy"
                                       maxlength="80"
                                       placeholder="New display name"
                                       aria-label="Rename project" />
                                <button class="btn btn-success btn-sm"
                                        data-testid="home-rename-project-save"
                                        disabled="@(_busy || string.IsNullOrWhiteSpace(_renameName))"
                                        @onclick="ConfirmRenameAsync">
                                    Save name
                                </button>
                                <button class="btn btn-outline-secondary btn-sm text-light border-secondary"
                                        disabled="@_busy"
                                        @onclick="CancelRename">
                                    Cancel
                                </button>
                            </div>
                            <div class="form-text text-muted mt-1">Changes the display name only — project id stays the same.</div>
                        </div>
                    }

                    @if (_showCheckpoints && hasActive)
                    {
                        <div class="border border-secondary border-opacity-50 rounded p-3 mt-2 bg-dark bg-opacity-75 text-white shadow-sm"
                             data-testid="home-checkpoints-panel">
                            <div class="fw-semibold small text-light mb-2">Checkpoints</div>
                            <div class="small text-light mb-2">
                                Save a named snapshot before a risky change (e.g. adding music). Roll back anytime —
                                your clips are kept.
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                                <input class="form-control form-control-sm bg-white text-dark border-secondary"
                                       style="max-width: 20rem;"
                                       data-testid="home-checkpoint-name"
                                       value="@_checkpointName"
                                       @oninput="@(e => _checkpointName = e.Value?.ToString() ?? "")"
                                       disabled="@_checkpointBusy"
                                       maxlength="80"
                                       placeholder="Checkpoint name (e.g. Before music)" />
                                <button class="btn btn-success btn-sm"
                                        data-testid="home-checkpoint-save"
                                        disabled="@(_checkpointBusy || string.IsNullOrWhiteSpace(_checkpointName))"
                                        @onclick="CreateCheckpointAsync">
                                    @(_checkpointBusy ? "Saving…" : "Save checkpoint")
                                </button>
                            </div>
                            @if (_checkpoints.Count == 0)
                            {
                                <div class="small text-light">No checkpoints yet.</div>
                            }
                            else
                            {
                                <ul class="list-unstyled mb-0" data-testid="home-checkpoint-list">
                                    @foreach (var cp in _checkpoints)
                                    {
                                        <li class="d-flex flex-wrap align-items-center justify-content-between gap-2 py-1 border-top border-secondary border-opacity-25">
                                            <span class="min-w-0">
                                                <span class="fw-semibold text-truncate">@(string.IsNullOrWhiteSpace(cp.Message) ? cp.CommitHash[..Math.Min(8, cp.CommitHash.Length)] : cp.Message)</span>
                                                <span class="small text-light-emphasis ms-1">· @cp.CommittedAt.ToLocalTime().ToString("MMM d, HH:mm")</span>
                                            </span>
                                            <button class="btn btn-outline-warning btn-sm flex-shrink-0"
                                                    data-testid="@($"home-checkpoint-revert-{cp.CommitHash[..Math.Min(8, cp.CommitHash.Length)]}")"
                                                    disabled="@_checkpointBusy"
                                                    @onclick="() => RevertCheckpointAsync(cp)">
                                                Roll back
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }

                    @if (_deleteId is not null)
                    {
                        <div class="border border-danger border-opacity-50 rounded p-3 mt-2 bg-dark bg-opacity-75 text-white shadow-sm">
                            <p class="small mb-2 text-white">
                                Delete <strong>@_deleteLabel</strong>? This removes the project folder and all its files.
                            </p>
                            <div class="d-flex gap-2">
                                <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="ConfirmDeleteAsync">Delete project</button>
                                <button class="btn btn-outline-secondary btn-sm" disabled="@_busy" @onclick="CancelDelete">Cancel</button>
                            </div>
                        </div>
                    }

                    <StudioProcessStrip Active="@HomeActiveStep" FullStudio="true" />
                }
                else
                {
                    @* Empty studio: brand + pick/create only. *@
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2 min-w-0">
                            <img src="/favicon.png" alt="" width="36" height="36" class="rounded-2 shadow-sm flex-shrink-0" />
                            <div class="min-w-0">
                                <div class="small text-muted">Full studio</div>
                                <h1 class="home-top__title mb-0">Choose a film</h1>
                                <div class="home-top__sub">Import a book, cast, estimate, film</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-outline-secondary btn-sm"
                                    data-testid="home-import-project"
                                    disabled="@(_busy || _importing)"
                                    @onclick="ToggleImport">
                                Import
                            </button>
                            <button class="btn btn-primary btn-sm"
                                    data-testid="home-new-project"
                                    disabled="@_busy"
                                    @onclick="OpenNewProjectAsync">
                                + New project
                            </button>
                        </div>
                    </div>

                    @if (ActiveProject.Status is { XaiConfigured: false })
                    {
                        <StudioProcessStrip Active="setup" FullStudio="true" />
                    }

                    @if (_projects.Projects.Count == 0 && !_showNew)
                    {
                        <p class="small text-muted mb-0">No projects yet — create one to start Book → Cast → Film.</p>
                    }
                    else if (_projects.Projects.Count > 0)
                    {
                        <div class="list-group project-list">
                            @foreach (var p in _projects.Projects)
                            {
                                var id = p.Id ?? "";
                                <button type="button"
                                        class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-2"
                                        data-testid="@($"home-project-{id}")"
                                        disabled="@_busy"
                                        @onclick="() => OpenProjectAsync(id)">
                                    <span class="text-truncate fw-semibold">@(p.Label ?? p.Title ?? id)</span>
                                    <span class="badge @VisibilityBadgeClass(p.VisibilityMode) small fw-normal flex-shrink-0">
                                        @VisibilityBadgeText(p.VisibilityMode)
                                    </span>
                                </button>
                            }
                        </div>
                    }
                }

                @if (_showNew)
                {
                    <div class="border border-secondary border-opacity-50 rounded p-3 mt-3 bg-dark bg-opacity-75 text-white shadow-sm">
                        <div class="fw-semibold small text-light mb-2">Create New Project</div>
                        @if (ActiveProject.Status is not null && !ActiveProject.Status.XaiConfigured)
                        {
                            <div class="alert alert-warning py-1 px-2 small mb-2">
                                No AI provider connected yet — finish <strong>Setup</strong> (step 0) first.
                                <a href="configuration" class="alert-link">Open Setup →</a>
                            </div>
                        }
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <input @ref="_nameInputRef"
                                   class="form-control form-control-sm flex-grow-1 bg-white text-dark border-secondary fw-medium"
                                   style="min-width: 10rem; color: #111111 !important; background-color: #ffffff !important; caret-color: #000000 !important;"
                                   data-testid="home-new-project-name"
                                   value="@_newName"
                                   @oninput="OnNewNameInput"
                                   @onkeydown="OnNewNameKeyDown"
                                   disabled="@_busy"
                                   placeholder="Enter project name..."
                                   maxlength="80"
                                   autofocus
                                   aria-label="New project name" />
                            <button class="btn btn-success btn-sm flex-shrink-0 px-3"
                                    data-testid="home-create-project"
                                    disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))"
                                    @onclick="CreateProjectAsync">
                                Create
                            </button>
                            <button class="btn btn-outline-secondary btn-sm flex-shrink-0 px-3 text-light border-secondary"
                                    disabled="@_busy"
                                    @onclick="ToggleNewProjectAsync">
                                Cancel
                            </button>
                        </div>
                    </div>
                }

                @if (_showImport)
                {
                    @ImportPanel
                }
            </div>
        </div>
    }
}

@* Demo films always visible under either mode *@
<div class="card home-showcase-card mb-3" data-testid="home-demo-films-card">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
            <div class="min-w-0">
                <div class="ptm-adapt-kicker mb-1">@L["Home.PageToMovieChannel"]</div>
                <div class="fw-semibold fs-5 mb-0">@L["Home.DemoFilms"]</div>
                <div class="small text-muted text-truncate" title="@_demoShowcaseHint">@_demoShowcaseHint</div>
            </div>
            <a href="/demo" class="btn btn-sm btn-primary flex-shrink-0" data-testid="home-open-demo-gallery">
                @L["Home.OpenGallery"]
            </a>
        </div>
        @if (_publicDemos.Count > 0)
        {
            <div class="home-showcase-thumbs" aria-label="Recent demo films">
                @foreach (var d in _publicDemos.Take(4))
                {
                    var yt = YouTubeVideoId.Extract(d.YoutubeId) ?? YouTubeVideoId.Extract(d.YoutubeUrl);
                    var href = yt is not null
                        ? YouTubeVideoId.WatchUrl(yt)
                        : (!string.IsNullOrWhiteSpace(d.YoutubeUrl) && Uri.TryCreate(d.YoutubeUrl.Trim(), UriKind.Absolute, out _)
                            ? d.YoutubeUrl!.Trim()
                            : "/demo");
                    var thumb = yt is not null
                        ? YouTubeVideoId.ThumbnailUrl(yt, "mqdefault")
                        : null;
                    <a class="home-showcase-thumb"
                       href="@href"
                       target="@(yt is not null || href.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? "_blank" : null)"
                       rel="@(yt is not null || href.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? "noopener noreferrer" : null)"
                       title="@d.Title">
                        @if (thumb is not null)
                        {
                            <img src="@thumb" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span class="home-showcase-thumb__ph" aria-hidden="true">▶</span>
                        }
                        <span class="home-showcase-thumb__label">@d.Title</span>
                    </a>
                }
            </div>
        }
    </div>
</div>


<ProjectCollaboratorsModal IsOpen="_showCollaboratorsModal" ProjectId="_collaboratorsProjectId" OnClose="CloseCollaboratorsModal" />

@code {
    // ImportPanel stays here (not in Home.razor.cs) - it uses @<div> inline markup
    // literal syntax, which only compiles via the Razor compiler, not as plain C#.
    /// <summary>Shared import panel — rendered both in the empty-studio state and when a project is
    /// open, so Import is always available on the project card.</summary>
    private RenderFragment ImportPanel => @<div class="border border-secondary border-opacity-50 rounded p-3 mt-3 bg-dark bg-opacity-75 text-white shadow-sm">
        <div class="fw-semibold small text-light mb-2">Import a project</div>
        <div class="small text-light mb-2">
            Import a Page to Movie project <code>.zip</code> export into your own workspace.
        </div>
        <div class="mb-2">
            <InputFile OnChange="OnImportFileSelected" accept=".zip"
                       class="form-control form-control-sm bg-white text-dark"
                       style="max-width: 22rem;"
                       disabled="@(_busy || _importing)" />
        </div>
        @if (_importFile is not null)
        {
            <div class="small text-light mb-1">Import as:</div>
            <div class="mb-2">
                <input class="form-control form-control-sm bg-white text-dark border-secondary"
                       style="max-width: 22rem;"
                       data-testid="home-import-name"
                       value="@_importName"
                       @oninput="@(e => _importName = e.Value?.ToString() ?? "")"
                       disabled="@_importing"
                       maxlength="80"
                       placeholder="Project name"
                       aria-label="Import as name" />
            </div>
        }
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (_importFile is not null)
            {
                <button class="btn btn-success btn-sm"
                        data-testid="home-import-confirm"
                        disabled="@(_importing || string.IsNullOrWhiteSpace(_importName))"
                        @onclick="HandleImportAsync">
                    @(_importing ? "Importing…" : "Import")
                </button>
            }
            <button class="btn btn-outline-secondary btn-sm text-light border-secondary"
                    disabled="@_importing"
                    @onclick="ToggleImport">
                Cancel
            </button>
        </div>
    </div>;
}
