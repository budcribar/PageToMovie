@page "/"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject JobHubClient Hub
@inject NavigationManager Nav
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject IJSRuntime Js
@inject ClientMediaFolderService MediaFolder
@inject ServerHealthState Health
@inject IAppLocalizer L
@using PageToMovie.Core.Models
@using PageToMovie.Core.Util

<PageTitle>PageToMovie</PageTitle>

<InlineAlert Message="@_error" data-testid="home-error" />
<InlineAlert Message="@_message" Variant="info" data-testid="home-message" />


<Home_Landing IsLoggedIn="Session.IsLoggedIn" ShowEasyStart="_easyStartAvailable" />

@if (!Session.IsLoggedIn)
{
    @* Same cards as signed-in easy home; CTAs send guests to sign-in. *@
    @if (_easyStartAvailable)
    {
    <PromoCard TestId="home-simple-voice-card" Eyebrow="@L["Home.EasiestStart"]" Title="@L["Home.ReadLibraryBook"]">
        <Body>
            @L["Home.PickStoryRecordSample"]
        </Body>
        <Cta>
            <a href="login?returnUrl=/simple-voice" class="btn btn-primary btn-sm flex-shrink-0" data-testid="home-open-simple-voice">
                @L["Home.SignInToTry"]
            </a>
        </Cta>
    </PromoCard>
    }
    <PromoCard TestId="home-full-studio-card" Eyebrow="@L["Home.Advanced"]" Title="@L["Home.FullStudio"]">
        <Body>
            @L["Home.CastEstimateFilmReview"]
        </Body>
        <Cta>
            <a href="login?returnUrl=/" class="btn btn-primary btn-sm flex-shrink-0" data-testid="home-open-full-studio-guest">
                @L["Home.SignInForStudio"]
            </a>
        </Cta>
    </PromoCard>
}
else if (Projects._projects is null)
{
    <div class="card mb-3 home-studio-card">
        <div class="card-body py-3 text-muted small">@L["Common.Loading"]</div>
    </div>
}
else
{
    @if (Projects.ShowEasyHome)
    {
        @* Default home: easiest start only when a timing-complete library book exists. *@
        @if (_easyStartAvailable)
        {
        <PromoCard TestId="home-simple-voice-card" Eyebrow="@L["Home.EasiestStart"]" Title="@L["Home.ReadLibraryBook"]">
            <Body>
                @L["Home.PickStoryRecordSampleStock"]
            </Body>
            <Cta>
                <a href="simple-voice" class="btn btn-primary btn-sm flex-shrink-0" data-testid="home-open-simple-voice">
                    @L["Home.TryWithYourVoice"]
                </a>
            </Cta>
        </PromoCard>
        }

        <PromoCard TestId="home-full-studio-card" Eyebrow="@L["Home.Advanced"]" Title="@L["Home.FullStudio"]">
            <Body>
                @L["Home.FullStudioDescription"]
            </Body>
            <Cta>
                <button type="button"
                        class="btn btn-primary btn-sm flex-shrink-0"
                        data-testid="home-open-full-studio"
                        @onclick="Projects.EnterFullStudio">
                    @L["Home.OpenFullStudio"]
                </button>
            </Cta>
        </PromoCard>
    }
    else
    {
        @if (_easyStartAvailable)
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <button type="button"
                        class="btn btn-link btn-sm px-0"
                        data-testid="home-back-easy-start"
                        @onclick="Projects.ExitFullStudio">
                    @L["Home.BackToEasyStart"]
                </button>
            </div>
        }

        <CascadingValue Value="this" IsFixed="true">
            <CascadingValue Value="Projects" IsFixed="true">
            <CascadingValue Value="Jobs" IsFixed="true">
            <CascadingValue Value="Import" IsFixed="true">
            <CascadingValue Value="Checkpoints" IsFixed="true">
            <CascadingValue Value="Costs" IsFixed="true">
                <HomeStudioCard />
            </CascadingValue>
            </CascadingValue>
            </CascadingValue>
            </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    }
}

@* Standalone demo films card only when not in full studio mode *@
@if (!Session.IsLoggedIn || Projects.ShowEasyHome)
{
    <CascadingValue Value="this" IsFixed="true">
        <CascadingValue Value="Costs" IsFixed="true">
            <HomeDemoFilmsCard />
        </CascadingValue>
    </CascadingValue>
}


<ProjectCollaboratorsModal IsOpen="Projects._showCollaboratorsModal" ProjectId="Projects._collaboratorsProjectId" OnClose="Projects.CloseCollaboratorsModal" />

@if (Projects._deleteId is not null)
{
    @* Centered overlay — same family as new-project / collaborators. Do not inline this in the
       Manage panel (that sat below the fold after checkpoints). *@
    <div class="modal-backdrop fade show" style="z-index: 1050;" @onclick="Projects.CancelDelete"></div>
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="home-delete-project-title"
         style="z-index: 1055;"
         data-testid="home-delete-project-modal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-white border-secondary shadow">
                <div class="modal-header border-secondary py-2">
                    <h5 class="modal-title fs-6 mb-0" id="home-delete-project-title">@L["Home.DeleteProjectTitle"]</h5>
                    <button type="button"
                            class="btn-close btn-close-white"
                            disabled="@_busy"
                            aria-label="Cancel"
                            @onclick="Projects.CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        Delete <strong data-testid="home-delete-project-label">@Projects._deleteLabel</strong>
                        @if (!string.Equals(Projects._deleteLabel, Projects._deleteId, StringComparison.Ordinal))
                        {
                            <span class="text-white-50"> (<span class="font-monospace" data-testid="home-delete-project-id">@Projects._deleteId</span>)</span>
                        }
                        ? This removes the project and all its files.
                    </p>
                </div>
                <div class="modal-footer border-secondary py-2">
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            data-testid="home-delete-project-cancel"
                            disabled="@_busy"
                            @onclick="Projects.CancelDelete">
                        Cancel
                    </button>
                    <button type="button"
                            class="btn btn-danger btn-sm"
                            data-testid="home-delete-project-confirm"
                            disabled="@_busy"
                            @onclick="Projects.ConfirmDeleteAsync">
                        @L["Home.DeleteProject"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}
