@page "/login"
@page "/signup"
@inject EngineApiClient Api
@inject AdminSessionService Session
@inject NavigationManager Nav
@inject IAppLocalizer L
@using Microsoft.AspNetCore.WebUtilities
@using PageToMovie.Core.Options

<PageTitle>@PageTitleText — PageToMovie</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo d-flex align-items-center justify-content-center gap-3 mb-3">
                <img src="/favicon.png" alt="PageToMovie" width="64" height="64" class="rounded-3 shadow" />
                <span class="logo-text fs-2 fw-bold mb-0">PageToMovie</span>
            </div>
            <p class="auth-subtitle">
                @if (_resetTokenMode)
                {
                    <text>@L["Auth.ChooseNewPassword"]</text>
                }
                else if (_forgotMode)
                {
                    <text>@L["Auth.EnterUsernameOrEmail"]</text>
                }
                else if (_isSignup)
                {
                    <text>@L["Auth.CreateAccountSubtitle"]</text>
                }
                else
                {
                    <text>@L["Auth.SignInSubtitle"]</text>
                }

            </p>
        </div>

        @if (!_checkedSession || (_busy && string.IsNullOrEmpty(_error) && string.IsNullOrEmpty(_info)))
        {
            <CenteredSpinner WrapperClass="auth-status text-center py-4" SpinnerClass="spinner-border text-primary mb-3">
                <Caption>@_status</Caption>
            </CenteredSpinner>
        }
        else if (_resetTokenMode)
        {
            <form class="auth-form" @onsubmit="SubmitResetWithTokenAsync">
                <div class="mb-3">
                    <label class="form-label" for="reset-password-input">@L["Auth.NewPassword"]</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true">🔒</span>
                        <input id="reset-password-input"
                               type="@(_showPassword ? "text" : "password")"
                               class="form-control"
                               @bind="_password"
                               @bind:event="oninput"
                               placeholder="@L["Auth.NewPassword"]"
                               autocomplete="new-password"
                               required />
                        <PasswordToggleButton Shown="_showPassword" OnToggle="ToggleShowPassword" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="reset-confirm-input">@L["Auth.ConfirmNewPassword"]</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true">✓</span>
                        <input id="reset-confirm-input"
                               type="@(_showPassword ? "text" : "password")"
                               class="form-control"
                               @bind="_confirmPassword"
                               @bind:event="oninput"
                               placeholder="@L["Auth.ConfirmPassword"]"
                               autocomplete="new-password"
                               required />
                    </div>
                </div>

                <InlineAlert Message="@_error" CssClass="py-2" role="alert" />
                <InlineAlert Message="@_info" Variant="success" CssClass="py-2" role="alert" />

                <button type="submit" class="btn btn-gradient w-100 py-2 mt-2" disabled="@_busy">
                    @(_busy ? L["Common.Updating"] : L["Auth.SetNewPassword"])
                </button>
                <button type="button" class="btn btn-link w-100 mt-2 text-decoration-none" @onclick="ExitResetTokenMode">
                    @L["Auth.BackToSignIn"]
                </button>
            </form>
        }
        else if (_forgotMode)
        {
            <form class="auth-form" @onsubmit="SubmitForgotAsync">
                <div class="mb-3">
                    <label class="form-label" for="forgot-username">@L["Auth.UsernameOrEmail"]</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true">👤</span>
                        <input id="forgot-username"
                               class="form-control"
                               @bind="_username"
                               @bind:event="oninput"
                               placeholder="@L["Auth.UsernameOrEmailPlaceholder"]"
                               autocomplete="username"
                               required />
                    </div>
                </div>

                <InlineAlert Message="@_error" CssClass="py-2" role="alert" />
                <InlineAlert Message="@_info" Variant="success" CssClass="py-2" role="alert" />

                <button type="submit" class="btn btn-gradient w-100 py-2 mt-2" disabled="@_busy">
                    @(_busy ? L["Common.Submitting"] : L["Auth.SendResetLink"])
                </button>
                <button type="button" class="btn btn-link w-100 mt-2 text-decoration-none" @onclick="ExitForgotMode">
                    @L["Auth.BackToSignIn"]
                </button>
            </form>
        }
        else
        {
            <form class="auth-form" @onsubmit="SubmitAsync">
                <div class="mb-3">
                    <label class="form-label" for="username-input">@L["Auth.Username"]</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true">👤</span>
                        <input id="username-input" class="form-control" @bind="_username" @bind:event="oninput" placeholder="@L["Auth.EnterUsernamePlaceholder"]" autocomplete="username" required />
                    </div>
                </div>

                @if (_isSignup)
                {
                    <div class="mb-3">
                        <label class="form-label" for="email-input">@L["Auth.Email"]</label>
                        <div class="input-group">
                            <span class="input-group-text" aria-hidden="true">✉</span>
                            <input id="email-input"
                                   type="email"
                                   class="form-control"
                                   @bind="_email"
                                   @bind:event="oninput"
                                   placeholder="you@example.com"
                                   autocomplete="email"
                                   required />
                        </div>
                        <div class="form-text text-muted">
                            @L["Auth.ConfirmationLinkEmailNotice"]
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label" for="password-input">@L["Auth.Password"]</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true">🔒</span>
                        <input id="password-input"
                               type="@(_showPassword ? "text" : "password")"
                               class="form-control"
                               @bind="_password"
                               @bind:event="oninput"
                               placeholder="@L["Auth.EnterPasswordPlaceholder"]"
                               autocomplete="@(_isSignup ? "new-password" : "current-password")"
                               required />
                        <PasswordToggleButton Shown="_showPassword" OnToggle="ToggleShowPassword" />
                    </div>
                </div>

                @if (_isSignup)
                {
                    <div class="mb-3">
                        <label class="form-label" for="confirm-password-input">@L["Auth.ConfirmPassword"]</label>
                        <div class="input-group">
                            <span class="input-group-text" aria-hidden="true">✓</span>
                            <input id="confirm-password-input"
                                   type="@(_showPassword ? "text" : "password")"
                                   class="form-control"
                                   @bind="_confirmPassword"
                                   @bind:event="oninput"
                                   placeholder="@L["Auth.ConfirmPassword"]"
                                   autocomplete="new-password"
                                   required />
                            <PasswordToggleButton Shown="_showPassword" OnToggle="ToggleShowPassword" />
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger d-flex align-items-start py-2" role="alert">
                        <div>
                            <div>@_error</div>
                            @if (_needsResend)
                            {
                                <button type="button"
                                        class="btn btn-link btn-sm p-0 mt-1"
                                        disabled="@_busy"
                                        @onclick="ResendConfirmationAsync">
                                    @L["Auth.ResendConfirmationEmail"]
                                </button>
                            }
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_info))
                {
                    <div class="alert alert-success py-2" role="alert">
                        <div>@_info</div>
                        @if (_needsResend)
                        {
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 mt-1"
                                    disabled="@_busy"
                                    @onclick="ResendConfirmationAsync">
                                @L["Auth.ResendConfirmationEmail"]
                            </button>
                        }
                    </div>
                }

                <button type="submit" class="btn btn-gradient w-100 py-2 mt-2" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>@(_isSignup ? L["Auth.CreatingAccount"] : L["Auth.SigningIn"])</span>
                    }
                    else
                    {
                        <span>@(_isSignup ? L["Auth.CreateAccount"] : L["Auth.SignIn"])</span>
                    }
                </button>

                @if (!_isSignup)
                {
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="EnterForgotMode">
                            @L["Auth.ForgotPassword"]
                        </button>
                    </div>
                }
            </form>
        }

        <div class="auth-footer text-center mt-4">
            @if (_resetTokenMode || _forgotMode)
            {
                <span class="text-muted small">@L["Auth.RememberedIt"] </span>
                <button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="BackToSignIn">
                    @L["Auth.SignIn"]
                </button>
            }
            else if (!_isSignup)
            {
                <span class="text-muted">@L["Auth.DontHaveAccount"] </span>
                <button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => SetMode(true)">
                    @L["Auth.SignUpNow"]
                </button>
            }
            else
            {
                <span class="text-muted">@L["Auth.AlreadyHaveAccount"] </span>
                <button type="button" class="btn btn-link p-0 text-decoration-none" @onclick="() => SetMode(false)">
                    @L["Auth.SignIn"]
                </button>
            }
            <div class="mt-3">
                <a href="/demo" class="small text-decoration-none">@L["Auth.WatchPublicDemos"]</a>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 8rem);
        padding: 1.5rem;
    }

    .auth-card {
        width: 100%;
        max-width: 26rem;
        background: rgba(22, 27, 34, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 1rem;
        padding: 2.25rem 2rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(16px);
    }

    .auth-header {
        text-align: center;
        margin-bottom: 1.75rem;
    }

    .auth-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .logo-icon {
        font-size: 2rem;
    }

    .logo-text {
        font-family: 'Outfit', sans-serif;
        font-size: 1.75rem;
        font-weight: 700;
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .auth-subtitle {
        color: #cbd5e1;
        font-size: 0.9rem;
        margin: 0;
    }

    .form-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #f1f5f9;
        margin-bottom: 0.4rem;
    }

    .input-group-text {
        background: #1e293b;
        border: 1.5px solid #475569;
        border-right: none;
        color: #e2e8f0;
        font-size: 1.1rem;
    }

    /* Beat global app.css placeholder dimming (same !important) with .auth-card scope */
    .auth-card .form-control {
        background: #1e293b;
        border: 1.5px solid #64748b;
        color: #f8fafc !important;
        font-size: 1rem;
        font-weight: 500;
        caret-color: #f8fafc;
    }

    /* One pseudo-element per rule: a grouped list with any unknown vendor pseudo
       (::-moz-placeholder / :-ms-input-placeholder) gets dropped whole by the browser,
       which is what left the placeholder dark-on-dark. Standard ::placeholder alone
       covers every current browser. */
    .auth-card .form-control::placeholder {
        /* Readable on the dark card but a clear step dimmer than typed text (#f8fafc),
           so "Enter username" still reads as a hint, not a filled-in value. */
        color: #c8d0e0 !important;
        opacity: 1 !important;
        font-style: normal;
        font-weight: 500;
        -webkit-text-fill-color: #c8d0e0 !important;
    }

    /* Chrome/Edge autofill can paint dark-on-dark; force light text inside the group */
    .auth-card .form-control:-webkit-autofill,
    .auth-card .form-control:-webkit-autofill:hover,
    .auth-card .form-control:-webkit-autofill:focus {
        -webkit-text-fill-color: #f8fafc !important;
        caret-color: #f8fafc;
        transition: background-color 99999s ease-out 0s;
        box-shadow: 0 0 0 1000px #1e293b inset !important;
    }

    .auth-card .form-control:focus {
        background: #1e293b;
        border-color: #818cf8;
        box-shadow: 0 0 0 0.25rem rgba(129, 140, 248, 0.35);
        color: #f8fafc !important;
    }

    .auth-card .input-group-text {
        background: #1e293b;
        border-color: #64748b;
        color: #e2e8f0;
    }

    .auth-card .password-toggle {
        border-color: #64748b;
        color: #f1f5f9;
        background: #334155;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        border: none;
        color: #ffffff;
        font-weight: 600;
        border-radius: 0.5rem;
        transition: opacity 0.2s ease, transform 0.1s ease;
    }

    .btn-gradient:hover:not(:disabled) {
        opacity: 0.92;
        transform: translateY(-1px);
        color: #ffffff;
    }

    .btn-gradient:disabled {
        opacity: 0.6;
    }

    .auth-footer {
        font-size: 0.875rem;
    }

    .password-toggle {
        min-width: 4.25rem;
        font-size: 0.85rem;
        font-weight: 600;
        border: 1.5px solid #475569;
        color: #f1f5f9;
        background: #1e293b;
    }

    .password-toggle:hover {
        background: rgba(99, 102, 241, 0.3);
        border-color: #818cf8;
        color: #ffffff;
    }
</style>
