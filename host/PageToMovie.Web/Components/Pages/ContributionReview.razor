@page "/projects/{id}/review-contribution"
@inject HttpClient Http
@using System.Net.Http.Json
@using System.Text.Json

<div class="container py-3">
    <h3>Contribution review</h3>
    <p class="text-muted small">Project: <code>@Id</code>
        @if (!string.IsNullOrEmpty(OriginId))
        {
            <span> · Origin: <code>@OriginId</code></span>
        }
    </p>

    <InlineAlert Message="@_error" />
    <InlineAlert Message="@_message" Variant="@(_messageOk ? "success" : "warning")" />

    @if (_hasConflicts)
    {
        <div class="card border-warning mb-3">
            <div class="card-header bg-warning-subtle">
                <strong>Merge conflicts</strong>
                @if (_autoResolvedCount > 0)
                {
                    <span class="badge text-bg-secondary ms-2">auto-resolved @_autoResolvedCount</span>
                }
            </div>
            <div class="card-body">
                <p class="small text-muted">Choose a strategy, then retry the last sync/merge direction.</p>
                @if (_remainingConflictPaths.Count > 0)
                {
                    <ul class="small">
                        @foreach (var path in _remainingConflictPaths)
                        {
                            <li><code>@path</code></li>
                        }
                    </ul>
                }
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy" @onclick="ResolvePreferOurs">Prefer Ours</button>
                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy" @onclick="ResolvePreferTheirs">Prefer Theirs</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="ResolveAuto">Auto</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="ResolveUnion">Union</button>
                </div>
            </div>
        </div>
    }

    <div class="mb-3 d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-primary" disabled="@(_busy || string.IsNullOrEmpty(OriginId))" @onclick="SyncFromOriginAsync">Sync From Origin</button>
        <button type="button" class="btn btn-primary" disabled="@(_busy || string.IsNullOrEmpty(OriginId))" @onclick="AcceptMergeAsync">Merge Into Origin</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@(_busy || string.IsNullOrEmpty(OriginId))" @onclick="SyncMediaAsync">Sync Media</button>
    </div>

    @if (_diff?.Scenes != null && _diff.Scenes.Count > 0)
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Scene</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _diff.Scenes)
                {
                    <tr>
                        <td><code>@s.SceneKey</code></td>
                        <td>@s.Status</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-success" disabled="@_busy"
                                    @onclick="() => AcceptSceneAsync(s.SceneKey)">Accept</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (_diff != null)
    {
        <p class="text-muted">No scene diffs loaded.</p>
    }
</div>
