@page "/admin/models-catalog"
@using System.Text.Json
@using System.Text.Json.Nodes
@inject EngineApiClient Api
@inject AdminSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IAppLocalizer L

<PageTitle>Models catalog manager — PageToMovie</PageTitle>

<div class="container-fluid py-3 px-4">
    <AdminPageHeader Title="Models catalog manager">
        <Subtitle>
            Add, edit, delete, and <strong>review</strong> models ·
            Save runs full self-test · Hot-applies to <code>models_catalog.json</code>
        </Subtitle>
        <Actions>
            <a href="/admin" class="btn btn-outline-secondary btn-sm">← Admin</a>
            <button class="btn btn-outline-primary btn-sm" @onclick="ToggleRawJsonEditor">
                @(_showRawJson ? "📋 Table" : "📝 Raw JSON")
            </button>
            <BusyButton Label="✓ Validate all" Busy="_busy" CssClass="btn btn-outline-success btn-sm"
                        OnClick="ValidateCatalogAsync" />
            <BusyButton Label="🔍 Scan for updates" BusyLabel="Scanning…" Busy="_scanning"
                        CssClass="btn btn-outline-info btn-sm" OnClick="ScanUpdatesAsync" />
            <BusyButton Label="💾 Save & hot-apply" BusyLabel="Saving…" Busy="_busy"
                        CssClass="btn btn-primary btn-sm" OnClick="SaveCatalogAsync" />
        </Actions>
    </AdminPageHeader>

    @if (!Session.IsAdmin)
    {
        <InlineAlert Variant="warning">Admin session required. <a href="/admin/login">Sign in</a></InlineAlert>
    }
    else if (_loading)
    {
        <p class="text-muted">Loading models catalog…</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                <pre class="mb-0 small" style="white-space: pre-wrap;">@_error</pre>
                <button type="button" class="btn-close" @onclick="() => _error = null"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                @_message
                <button type="button" class="btn-close" @onclick="() => _message = null"></button>
            </div>
        }
        @if (_validationErrors is { Count: > 0 })
        {
            <div class="alert alert-warning mb-3">
                <strong>Self-test issues (@_validationErrors.Count)</strong>
                <ul class="mb-0 small">
                    @foreach (var e in _validationErrors.Take(40))
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }

        @if (_scan is not null)
        {
            <div class="card mb-3 border-info">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span>
                        Update scan · @_scan.CheckedAtUtc
                        <span class="badge bg-success ms-1">@_scan.Summary.UnchangedFields same</span>
                        <span class="badge bg-danger ms-1">@_scan.Summary.ChangedFields changed</span>
                        <span class="badge bg-warning text-dark ms-1">@_scan.Summary.NotFoundFields not found</span>
                        <span class="badge bg-primary ms-1">@_scan.Summary.NewModels new</span>
                    </span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _scan = null">Dismiss</button>
                </div>
                <div class="card-body small">
                    <p class="text-muted mb-2">
                        <span class="badge bg-success">green</span> found &amp; same ·
                        <span class="badge bg-warning text-dark">yellow</span> not found / no probe ·
                        <span class="badge bg-danger">red</span> found &amp; different — accept to patch the table, then Save
                    </p>
                    @if (_scan.DiscoveryNotes is { Count: > 0 })
                    {
                        <ul class="text-muted mb-2">
                            @foreach (var n in _scan.DiscoveryNotes)
                            {
                                <li>@n</li>
                            }
                        </ul>
                    }
                    @if (_scan.NewModels is { Count: > 0 })
                    {
                        <h6 class="mt-2">New models (not in catalog)</h6>
                        <div class="table-responsive mb-3">
                            <table class="table table-sm table-bordered align-middle">
                                <thead><tr><th>Id</th><th>Provider</th><th>Cap</th><th>Source</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var nm in _scan.NewModels)
                                {
                                    <tr class="table-info">
                                        <td class="font-monospace">@nm.Id</td>
                                        <td>@nm.Provider</td>
                                        <td>@nm.SuggestedCapability</td>
                                        <td class="text-muted">@nm.Source</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary" @onclick="() => AcceptNewModel(nm)">Accept as LAB</button>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    @foreach (var m in _scan.Models.Where(x => x.Fields.Any(f => f.Status != "unchanged")).Take(40))
                    {
                        <div class="mb-2">
                            <strong class="font-monospace">@m.Id</strong>
                            <span class="text-muted">(@m.Capability / @m.ProviderId)</span>
                            <table class="table table-sm table-bordered mb-1">
                                <thead><tr><th>Field</th><th>Catalog</th><th>Live</th><th>Status</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var f in m.Fields)
                                {
                                    <tr class="@StatusRowClass(f.Status)">
                                        <td class="font-monospace">@f.Field</td>
                                        <td>@(f.CatalogValue ?? "—")</td>
                                        <td>@(f.LiveValue ?? "—")</td>
                                        <td>
                                            <span class="badge @StatusBadgeClass(f.Status)">@f.Status</span>
                                            @if (!string.IsNullOrWhiteSpace(f.Message))
                                            {
                                                <span class="text-muted ms-1">@f.Message</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(f.SourceUrl))
                                            {
                                                <a href="@f.SourceUrl" target="_blank" rel="noopener" class="ms-1">source</a>
                                            }
                                        </td>
                                        <td>
                                            @if (f.Status == "changed" && f.LiveValue is not null)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => AcceptFieldChange(m.Id, f)">Accept live</button>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (!_scan.Models.Any(x => x.Fields.Any(f => f.Status != "unchanged")) && _scan.NewModels.Count == 0)
                    {
                        <p class="text-success mb-0">No differences or new models reported.</p>
                    }
                </div>
            </div>
        }

        @if (_showRawJson)
        {
            <div class="card mb-3">
                <div class="card-header font-monospace small">Raw models_catalog.json</div>
                <div class="card-body p-2">
                    <textarea class="form-control font-monospace text-light bg-dark" rows="22" style="font-size: 0.85rem;" @bind="_rawJsonText"></textarea>
                </div>
            </div>
        }
        else
        {
            @* ── Search & Filter Toolbar ────────────────────────────────────── *@
            <div class="card p-3 mb-3 border shadow-sm">
                <div class="row g-2 align-items-center">
                    <div class="col-md-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-dark border-secondary text-muted">🔍</span>
                            <input class="form-control form-control-sm bg-dark text-light border-secondary"
                                   placeholder="Search model ID, name, provider…"
                                   @bind="_filterQuery"
                                   @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="_filterCapability">
                            <option value="">All Capabilities</option>
                            @foreach (var c in Capabilities)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="_filterProvider">
                            <option value="">All Providers</option>
                            @foreach (var p in AvailableProviders)
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="_filterStatus">
                            <option value="">@L["Catalog.StatusActive"]</option>
                            <option value="enabled">@L["Catalog.EnabledOnly"]</option>
                            <option value="disabled">@L["Catalog.DisabledOnly"]</option>
                            <option value="deprecated">@L["Catalog.DeprecatedOnly"]</option>
                            <option value="lab">@L["Catalog.LabModeOnly"]</option>
                            <option value="all">@L["Catalog.AllIncludingDeprecated"]</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2 justify-content-end align-items-center">
                        @if (!string.IsNullOrWhiteSpace(_filterQuery) || !string.IsNullOrWhiteSpace(_filterCapability) || !string.IsNullOrWhiteSpace(_filterProvider) || !string.IsNullOrWhiteSpace(_filterStatus))
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilters">@L["Common.ClearFilters"]</button>
                        }
                        <button class="btn btn-sm btn-success" @onclick="() => BeginAdd()">@L["Catalog.AddModel"]</button>
                        <span class="badge bg-secondary">
                            @FilteredModels.Count() of @_modelList.Count models (@_modelList.Count(m => IsEnabled(m) && !IsDeprecated(m)) active enabled, @_modelList.Count(m => IsDeprecated(m)) deprecated)
                        </span>
                    </div>
                </div>
            </div>

            @if (_editModel is not null)
            {
                <div class="card border-primary mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>@(_editIsNew ? "Add model" : $"Edit · {_editModel["id"]}")</span>
                        <button type="button" class="btn-close" @onclick="CloseEditor"></button>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Model ID</label>
                                <input class="form-control form-control-sm font-monospace" @bind="_editId" disabled="@(!_editIsNew)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Display name</label>
                                <input class="form-control form-control-sm" @bind="_editDisplayName" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small mb-0">Capability</label>
                                <select class="form-select form-select-sm" @bind="_editCapability">
                                    @foreach (var c in Capabilities)
                                    {
                                        <option value="@c">@c</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small mb-0">Provider</label>
                                <input class="form-control form-control-sm" @bind="_editProvider" />
                            </div>
                            <div class="col-md-2">
                                <ToggleSwitch @bind-Value="_editEnabled" Id="editEnabled" WrapperClass="form-check form-switch mt-4">
                                    <Label>Enabled</Label>
                                </ToggleSwitch>
                            </div>
                            <div class="col-md-2">
                                <ToggleSwitch @bind-Value="_editDeprecated" Id="editDeprecated" WrapperClass="form-check form-switch mt-4">
                                    <Label><span class="text-danger fw-bold" title="Hide from pickers and ignore during update scans">Deprecated</span></Label>
                                </ToggleSwitch>
                            </div>
                            <div class="col-md-2">
                                <ToggleSwitch @bind-Value="_editLabMode" Id="editLab" WrapperClass="form-check form-switch mt-4">
                                    <Label><span title="Incomplete OK for experiments">Lab mode</span></Label>
                                </ToggleSwitch>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Endpoint path</label>
                                <input class="form-control form-control-sm font-monospace" @bind="_editEndpointPath" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small mb-0">Max prompt length</label>
                                <input type="number" class="form-control form-control-sm" @bind="_editMaxPromptLength" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small mb-0">lastVerifiedAt</label>
                                <input class="form-control form-control-sm" @bind="_editLastVerifiedAt" placeholder="yyyy-MM-dd" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small mb-0">pricingLastReviewedAt</label>
                                <input class="form-control form-control-sm" @bind="_editPricingLastReviewedAt" placeholder="yyyy-MM-dd" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small mb-0">pricingNotes (source of cost figures)</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="_editPricingNotes"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label small mb-0">labNotes (required when Lab mode)</label>
                                <input class="form-control form-control-sm" @bind="_editLabNotes" placeholder="Why incomplete / what is being tested" />
                            </div>
                        </div>

                        @if (_editCapability is "Chat" or "Vision")
                        {
                            <hr class="my-2" />
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">maxInputTokens</label>
                                    <input type="number" class="form-control form-control-sm" @bind="_editMaxInputTokens" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">maxOutputTokens</label>
                                    <input type="number" class="form-control form-control-sm" @bind="_editMaxOutputTokens" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">input $/MTok</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" @bind="_editInputCost" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">output $/MTok</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" @bind="_editOutputCost" />
                                </div>
                            </div>
                        }
                        @if (_editCapability == "Video")
                        {
                            <hr class="my-2" />
                            <div class="row g-2">
                                <div class="col-md-2">
                                    <label class="form-label small mb-0">minClip sec</label>
                                    <input type="number" class="form-control form-control-sm" @bind="_editMinClip" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-0">maxClip sec</label>
                                    <input type="number" class="form-control form-control-sm" @bind="_editMaxClip" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-0">absMax sec</label>
                                    <input type="number" class="form-control form-control-sm" @bind="_editAbsMaxClip" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-0">maxRefs</label>
                                    <input type="number" class="form-control form-control-sm" @bind="_editMaxRefs" />
                                </div>
                                <div class="col-md-2">
                                    <ToggleSwitch @bind-Value="_editSupportsContinue" Id="editCont" WrapperClass="form-check form-switch mt-4">
                                        <Label>Continue</Label>
                                    </ToggleSwitch>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-0">extend $/sec</label>
                                    <input type="number" step="0.001" class="form-control form-control-sm" @bind="_editExtendCost" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">videoReferenceImageCost</label>
                                    <input type="number" step="0.001" class="form-control form-control-sm" @bind="_editRefImageCost" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small mb-0">videoCostPerSecond JSON</label>
                                    <input class="form-control form-control-sm font-monospace" @bind="_editVideoPerSecJson" placeholder='{"720p":0.07}' />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small mb-0">videoBaseCost JSON</label>
                                    <input class="form-control form-control-sm font-monospace" @bind="_editVideoBaseJson" placeholder='{"720p":0.4}' />
                                </div>
                            </div>
                        }
                        @if (_editCapability == "Image")
                        {
                            <hr class="my-2" />
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">maxReferenceImages</label>
                                    <input type="number" class="form-control form-control-sm" @bind="_editMaxRefs" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">imageCostPerImage</label>
                                    <input type="number" step="0.001" class="form-control form-control-sm" @bind="_editImageCost" />
                                </div>
                            </div>
                        }
                        @if (_editCapability == "Audio")
                        {
                            <hr class="my-2" />
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">maxAudioDurationSeconds</label>
                                    <input type="number" class="form-control form-control-sm" @bind="_editMaxAudio" />
                                </div>
                                <div class="col-md-3">
                                    <ToggleSwitch @bind-Value="_editSupportsVocals" Id="editVocals" WrapperClass="form-check form-switch mt-4">
                                        <Label>supportsVocals</Label>
                                    </ToggleSwitch>
                                </div>
                            </div>
                        }

                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <button class="btn btn-primary btn-sm" @onclick="ApplyEditorToList">Apply to table</button>
                            <button class="btn btn-outline-success btn-sm" @onclick="ReviewAndApplyAsync" title="Stamp review dates to today and apply">
                                ✓ Mark reviewed (today)
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="CloseEditor">Cancel</button>
                        </div>
                    </div>
                </div>
            }

            <div class="card shadow-sm border">
                <div class="table-responsive" style="max-height: 70vh;">
                    <table class="table table-hover table-striped mb-0 align-middle small">
                        <thead class="table-dark sticky-top" style="z-index: 5;">
                            <tr>
                                <th style="width: 50px;">On</th>
                                <th>Model ID</th>
                                <th>Name</th>
                                <th>Cap</th>
                                <th>Provider</th>
                                <th>Reviewed</th>
                                <th style="width: 140px;" class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredModels.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        No models match the selected filter criteria.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var m in FilteredModels)
                                {
                                    var modelId = m["id"]?.ToString() ?? "";
                                    var displayName = m["displayName"]?.ToString() ?? "";
                                    var cap = m["capability"]?.ToString() ?? "";
                                    var prov = m["provider"]?.ToString() ?? "";
                                    var verified = m["lastVerifiedAt"]?.ToString() ?? "—";
                                    var priced = m["pricingLastReviewedAt"]?.ToString() ?? "—";
                                    <tr class="@(IsDeprecated(m) ? "table-dark opacity-75" : IsEnabled(m) ? "" : "table-secondary")">
                                        <td>
                                            @if (IsDeprecated(m))
                                            {
                                                <span class="badge bg-danger" style="font-size: 0.65rem;" title="Deprecated — hidden from pickers & ignored by update scan">DEPRECATED</span>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center gap-1">
                                                    <ToggleSwitch Value="@IsEnabled(m)" ValueChanged="@(_ => ToggleModelEnabled(m))" WrapperClass="form-check form-switch mb-0" />
                                                    <span class="badge @(IsEnabled(m) ? "bg-success" : "bg-secondary")" style="font-size: 0.65rem;">
                                                        @(IsEnabled(m) ? "ON" : "OFF")
                                                    </span>
                                                </div>
                                            }
                                        </td>
                                        <td class="fw-bold font-monospace">@modelId</td>
                                        <td>
                                            @displayName
                                            @if (IsDeprecated(m))
                                            {
                                                <span class="badge bg-danger text-light ms-1" title="Deprecated model — hidden from pickers & ignored by update scan">DEPRECATED</span>
                                            }
                                            @if (m.TryGetPropertyValue("labMode", out var labNode) && labNode?.GetValue<bool>() == true)
                                            {
                                                <span class="badge bg-warning text-dark ms-1" title="@(m["labNotes"]?.ToString() ?? "lab")">LAB</span>
                                            }
                                        </td>
                                        <td><span class="badge @GetCapBadgeClass(cap)">@cap</span></td>
                                        <td class="text-muted fw-semibold">@prov</td>
                                        <td class="small text-muted">
                                            <div>row: <code>@verified</code></div>
                                            <div>$: <code>@priced</code></div>
                                        </td>
                                        <td class="text-end pe-3">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" title="Edit model settings" @onclick="() => BeginEdit(m)">✎ Edit</button>
                                                @if (IsDeprecated(m))
                                                {
                                                    <button class="btn btn-outline-info" title="Restore model to active catalog" @onclick="() => ToggleModelDeprecated(m)">Restore</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-warning" title="Deprecate model (hide & ignore in update scans)" @onclick="() => ToggleModelDeprecated(m)">Deprecate</button>
                                                }
                                                <button class="btn btn-outline-success" title="Mark reviewed today" @onclick="() => ReviewModel(m)">✓ Review</button>
                                                <button class="btn btn-outline-danger" title="Delete model" @onclick="() => RemoveModelAsync(m)">🗑</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>
