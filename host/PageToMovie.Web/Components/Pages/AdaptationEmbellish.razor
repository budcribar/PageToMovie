@page "/adaptation/embellish"
@inherits AdaptationPageBase

<PageTitle>Book · Scene enrichment</PageTitle>

<AdaptationShell Host="this" Step="embellish">
    @if (!string.IsNullOrWhiteSpace(ProjectId))
    {
        var draftExists = Status?.Screenplay.DraftExists == true;
        var enriched = Status?.BookSubsteps?.EnrichDone == true;

        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h5 mb-2">Scene enrichment</h2>

                @if (!draftExists)
                {
                    <p class="text-body-secondary mb-3">
                        Add concrete visual detail — setting, lighting, small action — so the film has enough to
                        work with, drawing on the book's own language where it's rich. Dialogue, scenes, and story
                        stay the same. Review and re-approve on the Screenplay step afterward.
                    </p>
                    <div class="alert alert-light border small mb-0">
                        Import a book first — the screenplay is written automatically, then you enrich it.
                        <a class="ms-1" href="adaptation/import">Go to Book →</a>
                    </div>
                }
                else if (!enriched)
                {
                    <p class="text-body-secondary mb-3">
                        Add concrete visual detail — setting, lighting, small action — so the film has enough to
                        work with, drawing on the book's own language where it's rich. Dialogue, scenes, and story
                        stay the same. Review and re-approve on the Screenplay step afterward.
                    </p>
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            data-testid="embellish-run"
                            disabled="@(Busy || Jobs.JobRunning)"
                            @onclick="EmbellishAsync">
                        Enrich the screenplay
                    </button>
                }
                else
                {
                    @* Already enriched — keep it compact so it's clear the work is done and you can move on. *@
                    <p class="text-body-secondary small mb-2">
                        Visual detail added — dialogue, scenes, and story are unchanged. Enrich again to add more,
                        or move on.
                    </p>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            data-testid="embellish-run"
                            disabled="@(Busy || Jobs.JobRunning)"
                            @onclick="EmbellishAsync">
                        Enrich again
                    </button>
                }
            </div>
        </div>

        @if (draftExists)
        {
            <div class="d-flex flex-wrap justify-content-end align-items-center gap-2">
                <a class="btn btn-link btn-sm text-body-secondary text-decoration-none"
                   href="adaptation/trim"
                   data-testid="embellish-trim">
                    Adjust length
                </a>
                <a class="btn btn-sm @(enriched ? "btn-primary" : "btn-outline-primary")"
                   href="adaptation/screenplay"
                   data-testid="embellish-continue">
                    Open Screenplay →
                </a>
            </div>
        }
    }
</AdaptationShell>
