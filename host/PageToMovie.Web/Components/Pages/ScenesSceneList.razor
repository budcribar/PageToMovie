@inherits PageToMovie.Web.Components.PageSliceComponent
@* Page-local to Scenes — all-scenes list *@
@inject StudioCapabilityState Caps
@inject AdminSessionService Session
@inject IAppLocalizer L
@inject ClientMediaFolderService MediaFolder
@using Microsoft.AspNetCore.Components
@using PageToMovie.Core.Models


    @* ---- Scene list ---- *@
    @{
        var list = ListState ?? Host.List;
    }
    @if (list._scenes is null)
    {
        @if (!string.IsNullOrWhiteSpace(Host._error))
        {
            <EmptyState Message="@($"Could not load scenes: {Host._error}")"
                        ActionHref="scenes"
                        ActionLabel="Retry"
                        CssClass="text-muted" />
        }
        else if (Host._busy)
        {
            <EmptyState Message="Loading scenes…" CssClass="text-muted" />
        }
        else if (VoiceSubstitutionOverlayGate.IsMissingSceneList(list._scenes))
        {
            <EmptyState Message="No scene list yet. Rebuild the shot plan from the screenplay, then return here."
                        ActionHref="adaptation/shots"
                        ActionLabel="Open shot plan →"
                        CssClass="text-muted" />
        }
    }
    else if (list._scenes.Count == 0)
    {
        @if (Host.Gen.JobRunning && Host.Gen._job is not null)
        {
            <div class="my-3">
                <JobProgressCard Status="@Host.Gen._job.Status"
                                 Message="@Scenes.ScenesGeneration.LiveGenStatusLabel(Host.Gen._job)"
                                 Index="Host.Gen._job.Index"
                                 Total="Host.Gen._job.Total"
                                 Percent="Host.Gen.LiveGenProgressPercent(Host.Gen._job)"
                                 TestId="scenes-live-progress"
                                 CssClass="border-primary shadow-sm" />
            </div>
        }
        else if (Host._busy)
        {
            <div class="card p-4 text-center my-3 bg-dark bg-opacity-25 border-secondary border-opacity-25" data-testid="scenes-empty-shotplan">
                <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
                <h5 class="fw-semibold mb-1">Building shot plan…</h5>
                <p class="text-muted small mb-0">Converting your approved screenplay into scenes and clips.</p>
            </div>
        }
        else
        {
            <div class="card p-4 text-center my-3 bg-dark bg-opacity-25 border-secondary border-opacity-25" data-testid="scenes-empty-shotplan">
                <h5 class="fw-semibold mb-1">No shot plan yet</h5>
                <p class="text-muted small mb-3">Build the shot plan to convert your approved screenplay into scenes and clips.</p>
                <div>
                    <button type="button"
                            class="btn btn-primary fw-semibold"
                            disabled="@Host._busy"
                            @onclick="list.RebuildShotPlanAsync"
                            data-testid="scenes-build-shotplan-btn">
                        Build shot plan
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        @* Authoritative scene/clip counts for tests, queryable in one place without counting rows. *@
        <div data-testid="scenes-status"
             data-scene-count="@list._scenes.Count"
             data-clip-count="@list._scenes.Sum(s => s.ClipCount)"
             data-clips-on-disk="@list._scenes.Sum(s => s.ClipsOnDisk)"
             data-scenes-complete="@list._scenes.Count(s => s.ClipsComplete)"
             class="visually-hidden" aria-hidden="true"></div>
        @* Batch generation is started from THIS all-scenes view, so its progress/message/result must
           show here too — the detail view below has its own copy for single-scene work. Without this,
           confirming Generate from the list started the job but showed nothing (dead-click symptom). *@
        <InlineAlert Message="@Host._error" Dismissible="true" OnDismiss="() => Host._error = null" CssClass="mb-3" />
        @if (!Host.Gen.JobRunning && !string.IsNullOrWhiteSpace(Host._message) && !Host._message.StartsWith("Rebuilding shot plan", StringComparison.OrdinalIgnoreCase))
        {
            <InlineAlert Message="@Host._message" Variant="info" Dismissible="true" OnDismiss="() => Host._message = null" CssClass="mb-3" />
        }
        @if (Host.Gen.ShowLiveGenProgress && Host.Gen._job is not null)
        {
            <JobProgressCard Status="@Host.Gen._job.Status"
                             Message="@Scenes.ScenesGeneration.LiveGenStatusLabel(Host.Gen._job)"
                             Index="Host.Gen._job.Index"
                             Total="Host.Gen._job.Total"
                             Percent="Host.Gen.LiveGenProgressPercent(Host.Gen._job)"
                             ShowCancel="true"
                             CancelDisabled="false"
                             OnCancel="Host.Gen.CancelAsync"
                             Kind="@Host.Gen._job.Kind"
                             StartedAt="Host.Gen._job.StartedAt"
                             TestId="scenes-gen-progress"
                             CancelTestId="scenes-gen-cancel" />
        }
        else if (Host.Gen.ShowOperatorGenPartial && Host.Gen._job is not null)
        {
            <ScenesGenPartialAlert />
        }
        else if (Host.Gen.ShowOperatorGenError && Host.Gen._job is not null)
        {
            <ScenesGenErrorAlert />
        }

        <div class="card mb-3 p-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <CapabilityLockedControl Enabled="@(Host.IsSimpleFilm || Caps.VideoReady)"
                                             BlockedReason="@StudioCapabilityState.VideoBlockedReason"
                                             SettingsHref="@StudioCapabilityState.VideoSettingsHref"
                                             TestId="scenes-generate-batch-cap">
                    <button type="button"
                            data-testid="scenes-generate-batch"
                            class="btn batch-go @((Host.IsSimpleFilm || (Host.List._selected.Count > 0 && Host.List.CastReady)) && !Host.Gen.JobRunning ? "batch-go--ready" : "")"
                            disabled="@(Host._busy || Host.Gen.JobRunning || Host.List.SelectedLockedByOther || (!Host.IsSimpleFilm && (Host.List._selected.Count == 0 || !Host.List.CastReady)))"
                            title="@(Host.IsSimpleFilm ? "Put your voice on the existing pictures" : "Generate only missing clips in selected scenes")"
                            @onclick="Host.Gen.OpenGenerateConfirmAsync">
                        @if (Host.Gen.JobRunning)
                        {
                            <span class="batch-go__spin" aria-hidden="true"></span>
                            <span>Generating…</span>
                        }
                        else
                        {
                            <span class="batch-go__play" aria-hidden="true">▶</span>
                            <span>
                                Generate @Host.List.GenerateBatchNoun
                                @if (Host.List._selected.Count > 0)
                                {
                                    <span class="batch-go__meta">· ~@ClipSel.EstimateSelectedClips() clips</span>
                                }
                            </span>
                        }
                    </button>
                    </CapabilityLockedControl>

                    <button type="button"
                            class="btn btn-outline-warning btn-sm"
                            data-testid="scenes-regenerate-selected"
                            disabled="@(Host._busy || Host.Gen.JobRunning || Host.List.SelectedLockedByOther || (!Host.IsSimpleFilm && (Host.List._selected.Count == 0 || !Host.List.CastReady)))"
                            title="Re-render all clips in selected scenes (prompts for confirmation)"
                            @onclick="Host.Gen.OpenRegenerateConfirmAsync">
                        🔄 Regenerate @Host.List.GenerateBatchNoun
                    </button>

                    @if (Host.List._scenes is not null && Host.List.GetVisibleScenes().Any(s => !s.ClipsComplete || s.ClipsOnDisk < s.ClipCount))
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                disabled="@Host._busy"
                                title="Select scenes that still need clips"
                                @onclick="Host.List.SelectMissingScenes">
                            @L["ScenesPage.SelectMissing"]
                        </button>
                    }
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button"
                            data-testid="scenes-play-selected"
                            class="btn btn-outline-primary btn-sm"
                            disabled="@(Host._busy || Playback._clientStitching || !Playback.CanPlaySelected)"
                            title="@PlaySelectedTitle"
                            @onclick="Playback.PlaySelectedAsync">
                        ▶ @L["ScenesPage.PlaySelected"]@(Host.List._selected.Count > 0 ? $" ({Host.List._selected.Count})" : "")
                    </button>
                    <CapabilityLockedControl Enabled="Caps.VideoReviewReady"
                                             BlockedReason="@StudioCapabilityState.VideoReviewBlockedReason"
                                             SettingsHref="@StudioCapabilityState.VideoReviewSettingsHref"
                                             TestId="scenes-verify-dialogue-cap">
                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            disabled="@(Host._busy || Host.Gen.JobRunning || Dialogue._verifyingClip || !Dialogue.SelectedScenesHaveClipsToVerify)"
                            title="@VerifyDialogueTitle"
                            @onclick="Dialogue.VerifySelectedScenesDialogueAsync">
                        🔍 @L["ScenesPage.VerifySceneDialogue"]@(Host.List._selected.Count > 0 ? $" ({Host.List._selected.Count})" : "")
                    </button>
                    </CapabilityLockedControl>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            disabled="@(Host._busy || Host.Gen.JobRunning)"
                            title="@(Host.List._selected.Count > 0
                                ? $"Regenerate shot plan for {Host.List._selected.Count} checked scene(s) from the screenplay"
                                : "Rebuild entire shot plan from the screenplay")"
                            @onclick="Host.List.RebuildShotPlanAsync">
                        📝 @L["ScenesPage.RebuildShotPlan"]
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            data-testid="scenes-add-scene"
                            disabled="@(Host._busy || Host.Gen.JobRunning)"
                            title="Add a new empty scene to the shot plan"
                            @onclick="() => Host.List.AddSceneAsync(false)">
                        ➕ @L["ScenesPage.AddScene"]
                    </button>
                    @* Credits are auto-inserted into the shot plan; this only re-adds one if it was deleted. *@
                    @if (!Host.Gen.HasCreditsScene)
                    {
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                data-testid="scenes-add-credits"
                                disabled="@(Host._busy || Host.Gen.JobRunning)"
                                title="Re-add the end-credits scene (normally added automatically)"
                                @onclick="() => Host.List.AddSceneAsync(true)">
                            🎬 @L["ScenesPage.AddCredits"]
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-secondary" data-testid="scenes-select-toggle"
                            disabled="@Host._busy" @onclick="() => Host.List._showFilters = !Host.List._showFilters">
                        🔍 @L["ScenesPage.Filters"] @(Host.List.HasActiveFilters ? " (Active)" : "")
                    </button>
                </div>
            </div>

            @* Jump back to the screenplay-shaping phases that otherwise only live under Book. Both edit the
               screenplay, which re-opens it (un-approve + re-gate cast), so each confirms before navigating. *@
            @if (!Host.IsSimpleFilm)
            {
                <div class="mt-2 pt-2 border-top border-secondary d-flex align-items-center gap-2 small flex-wrap">
                    <span class="text-muted">@L["ScenesPage.Screenplay"]</span>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary py-0 px-2"
                            data-testid="scenes-view-screenplay"
                            disabled="@Host._busy"
                            title="Read the current screenplay (view only — does not re-open it)"
                            @onclick="Host.ViewScreenplay">
                        📄 @L["ScenesPage.View"]
                    </button>
                </div>
            }

        </div>

        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle">
                <thead>
                    <tr>
                        <th style="width:2.5rem;">
                            <input class="form-check-input" type="checkbox"
                                   data-testid="scenes-select-all"
                                   title="Select all shown scenes"
                                   checked="@Host.List.AreAllVisibleSelected()"
                                   disabled="@(Host._busy || Host.List.GetVisibleScenes().Count == 0)"
                                   @onchange="e => Host.List.ToggleSelectAllShown((bool)(e.Value ?? false))" />
                        </th>
                        <th style="width:7rem; cursor:pointer; user-select:none;" @onclick='() => Host.List.ToggleSort("number")' title="Click to sort by Scene Number">
                            # @Host.List.SortArrow("number")
                        </th>
                        <th>@L["ScenesPage.Setting"]</th>
                        <th>@L["ScenesPage.CastLocation"]</th>
                        <th style="width:6rem;">@L["ReviewPage.Clips"]</th>
                        <th style="width:7.5rem; cursor:pointer; user-select:none;" @onclick='() => Host.List.ToggleSort("duration")' title="Click to sort by Duration">
                            @L["ReviewPage.Dur"] @Host.List.SortArrow("duration")
                        </th>
                        <th style="width:9rem;" title="Score background music for this scene">@L["ScenesPage.Music"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Host.List.SortedVisibleScenes)
                    {
                        var sn = s.SceneNumber;
                        var isSel = Host.List._selected.Contains(sn);
                        <tr class="@(isSel ? "table-active" : "")" style="cursor:pointer;" @key="sn"
                            data-testid="scene-row" data-scene-number="@sn">
                            <td @onclick:stopPropagation="true">
                                <input class="form-check-input" type="checkbox"
                                       checked="@isSel"
                                       disabled="@Host._busy"
                                       @onchange="e => Host.List.ToggleSelect(sn, (bool)(e.Value ?? false))" />
                            </td>
                            <td class="text-nowrap" @onclick="() => Host.List.OpenSceneAsync(sn)">
                                <span class="badge @(s.ClipsComplete ? "bg-success text-white" : "bg-warning text-dark") px-2 py-1 rounded-pill" style="font-weight:600;">
                                    S@(sn.ToString("D2"))
                                </span>
                                <button type="button"
                                        class="btn btn-sm btn-link text-danger p-0 ms-2 text-decoration-none"
                                        title="Delete scene S@(sn.ToString("D2")) from plan"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => Host.List.RequestDeleteScene(sn)">
                                    🗑️
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-link text-info p-0 ms-1 text-decoration-none"
                                        title="Open editor for scene S@(sn.ToString("D2"))"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => Host.List.OpenSceneAsync(sn)">
                                    ✏️
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-link text-secondary p-0 ms-1 text-decoration-none"
                                        title="View changes & history for scene S@(sn.ToString("D2"))"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => History.OpenSceneHistoryAsync(sn)">
                                    📜
                                </button>
                                @if (s.LockedByOther)
                                {
                                    <span class="badge bg-warning text-dark ms-1" title="Locked by @s.LockOwnerUserId">🔒 @s.LockOwnerUserId</span>
                                }
                            </td>
                            <td @onclick="() => Host.List.OpenSceneAsync(sn)">
                                @(s.Setting is { Length: > 0 } set ? Scenes.Trunc(set, 56) : "—")
                                @if (s.CompositeExists)
                                {
                                    <span class="badge bg-light text-dark border ms-1">mux</span>
                                }
                            </td>
                            <td @onclick="() => Host.List.OpenSceneAsync(sn)" class="small">
                                @if (s.CharactersOnScreen.Count > 0)
                                {
                                    <span class="text-muted">@string.Join(", ", s.CharactersOnScreen.Select(Scenes.ShortChar).Take(4))</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                                @if (!string.IsNullOrEmpty(s.PrimaryLocationId) || s.LocationIds.Count > 0)
                                {
                                    <div class="text-muted">
                                        <code>@Scenes.ShortLoc(s.PrimaryLocationId ?? s.LocationIds.FirstOrDefault() ?? "")</code>
                                    </div>
                                }
                            </td>
                            <td @onclick="() => Host.List.OpenSceneAsync(sn)" class="text-nowrap">
                                @{ var (pg, pgCls, pgTitle) = Scenes.ScenesListState.SceneProgressGlyph(s); }
                                <span class="@pgCls me-1" title="@pgTitle" aria-label="@pgTitle">@pg</span>
                                <span class="@Scenes.ScenesListState.ClipsCountClass(s)">
                                    @s.ClipsOnDisk/@s.ClipCount
                                </span>
                            </td>
                            <td @onclick="() => Host.List.OpenSceneAsync(sn)" class="small">
                                @if (s.ActualDurationSeconds is double act)
                                {
                                    <span title="Measured from composite or clips">@Scenes.FormatClock(act)</span>
                                    @if (s.PlannedDurationSeconds is double plan && Math.Abs(plan - act) > 1.5)
                                    {
                                        <div class="text-muted" style="font-size:0.75rem;" title="Planned length">plan @Scenes.FormatClock(plan)</div>
                                    }
                                }
                                else if (s.PlannedDurationSeconds is double planOnly)
                                {
                                    <span class="text-muted" title="Plan only — no media measured">~@Scenes.FormatClock(planOnly)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td @onclick:stopPropagation="true" class="text-nowrap">
                                <button type="button"
                                        class="btn btn-sm btn-warning text-black fw-bold py-0 px-2"
                                        data-testid="scene-row-score-music"
                                        disabled="@(Host._busy || Host.Gen.JobRunning || Music._scoringMusic || !Caps.MusicReady || s.LockedByOther)"
                                        title="@(Caps.MusicReady ? "Score background music for this scene" : StudioCapabilityState.MusicBlockedReason)"
                                        @onclick="() => Music.OpenScoreMenu(sn)">
                                    🎵 Score
                                </button>
                                @if (s.HasBackgroundMusic)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-link text-info p-0 ms-1 text-decoration-none"
                                            title="View & compare past audio takes for this scene"
                                            @onclick="() => Music.OpenMusicCompareAsync(sn)">
                                        🎧
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
