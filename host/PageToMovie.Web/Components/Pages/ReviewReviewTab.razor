@inherits PageToMovie.Web.Components.PageSliceComponent
@* Page-local to Review — review tab body: master-detail (scene list | writeup) *@
@inject StudioCapabilityState Caps
@inject IAppLocalizer L
@inject EngineApiClient Engine
@using PageToMovie.Core.Models

    @{
        var autoReview = AutoReview ?? Host.AutoReview;
        var list = List ?? Host.List;
        var playback = Playback ?? Host.Playback;
        var jobs = Jobs ?? Host.Jobs;
    }

    @if (autoReview._isReviewing)
    {
        <div class="card p-3 mb-3 bg-dark text-white border-info shadow" data-testid="review-ai-progress">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="spinner-border text-info" role="status" style="width: 2rem; height: 2rem;"></div>
                    <div>
                        <h5 class="fw-bold text-white mb-0">@L["ReviewPage.ExecutiveAiReviewInProgress"]</h5>
                        <div class="small text-light mt-1">@autoReview._reviewProgressStatus</div>
                    </div>
                </div>
                <span class="badge fs-6 text-bg-info px-3 py-2">@autoReview._reviewProgressPct%</span>
            </div>
            <div class="progress mb-2" style="height: 18px; background: rgba(255,255,255,0.15); border-radius: 8px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-info"
                     role="progressbar"
                     style="width: @(autoReview._reviewProgressPct)%; font-weight: 700; font-size: 0.85rem;"
                     aria-valuenow="@autoReview._reviewProgressPct"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    @autoReview._reviewProgressPct%
                </div>
            </div>
            <div class="alert alert-info py-2 px-3 mb-0 small text-start">
                ℹ️ <strong>Review in progress:</strong> Vision AI is evaluating video keyframes across 6 categories (Continuity, Character, Lighting, Pacing, Dialogue, Music). Please keep this page open.
            </div>
        </div>
    }

<div class="review-md" data-testid="review-master-detail">
    <div class="review-md__master" data-testid="review-master-pane">
        <Review_SceneList />
    </div>
    <div class="review-md__detail" data-testid="review-detail-pane">
        @if (playback._showScenePlayer && playback._playingScene is int playSn && !playback._clientStitching)
        {
            <div class="card mb-3 border-primary">
                <div class="card-header d-flex justify-content-between align-items-center py-2">
                    <span>
                        Scene
                        <code class="small">S@(playSn.ToString("D2"))</code>
                        @if (!string.IsNullOrEmpty(playback._clientSceneUrl))
                        {
                            <span class="badge bg-info text-dark ms-1">client stitch</span>
                        }
                    </span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="playback.HideScenePlayerAsync">@L["Common.Hide"]</button>
                </div>
                <div class="card-body py-2">
                    <video controls playsinline autoplay
                           style="width:100%;max-height:70vh;background:#000;border-radius:0.35rem;"
                           src="@(string.IsNullOrEmpty(playback._clientSceneUrl) ? playback.SceneServerSrc(playSn) : playback._clientSceneUrl)"
                           @key="playback._sceneVideoKey"
                           onloadeddata="this.play().catch(function(){})">
                        @L["ReviewPage.Html5VideoNotSupported"]
                    </video>
                    <p class="small text-muted mb-0 mt-2">
                        @if (string.IsNullOrEmpty(playback._clientSceneUrl))
                        {
                            <a href="@Engine.CompositeVideoUrl(Host._projectId, playSn)" target="_blank" rel="noopener">@L["ReviewPage.OpenInNewTab"]</a>
                        }
                        else
                        {
                            <span>Stitched in browser from clips (not written to disk).</span>
                        }
                    </p>
                </div>
            </div>
        }
        else if (playback._showScenePlayer && playback._clientStitching)
        {
            <div class="card mb-3 border-secondary">
                <div class="card-body py-2 small text-muted">
                    @L["ReviewPage.CombiningSceneBrowser"] @playback._clientStitchStatus
                </div>
            </div>
        }

        @if (list._selectedScene is int sel)
        {
            @if (autoReview._movieReport is { })
            {
                <Review_MovieReport Report="autoReview._movieReport"
                                    FilterSceneNumber="@sel"
                                    Collapsed="false"
                                    OnExpandAll="@(() => list.ToggleAllSceneGroups(true))"
                                    OnCollapseAll="@(() => list.ToggleAllSceneGroups(false))"
                                    OnToggleGroup="list.ToggleSceneGroupExpand"
                                    IsGroupExpanded="list.IsSceneGroupExpanded" />
            }
            <Review_ClipReview />
        }
        else if (autoReview._movieReport is { })
        {
            <Review_MovieReport Report="autoReview._movieReport"
                                Collapsed="autoReview._movieReportCollapsed"
                                OnToggleCollapsed="@(() => autoReview._movieReportCollapsed = !autoReview._movieReportCollapsed)"
                                OnExpandAll="@(() => list.ToggleAllSceneGroups(true))"
                                OnCollapseAll="@(() => list.ToggleAllSceneGroups(false))"
                                OnToggleGroup="list.ToggleSceneGroupExpand"
                                IsGroupExpanded="list.IsSceneGroupExpanded" />
        }
        else
        {
            <div class="card border-info text-white shadow-sm h-100" style="background-color: #0f172a !important; border-color: #3b82f6 !important;">
                <div class="card-body p-4 text-center">
                    <div class="fs-1 mb-2">🤖</div>
                    <h5 class="fw-bold mb-2">@L["ReviewPage.AiVisualContinuityTitle"]</h5>
                    <p class="text-white-50 mb-3 mx-auto" style="max-width: 600px;">
                        @L["ReviewPage.AiVisualContinuityDesc"]
                    </p>
                    <CapabilityLockedControl Enabled="Caps.VideoReviewReady"
                                             BlockedReason="@StudioCapabilityState.VideoReviewBlockedReason"
                                             SettingsHref="@StudioCapabilityState.VideoReviewSettingsHref"
                                             TestId="review-empty-cta-cap">
                        <button class="btn btn-info text-white fw-bold px-4"
                                disabled="@(Host._busy || jobs.JobRunning)"
                                @onclick="autoReview.StartFullMovieReviewAsync">
                            ⚡ @L["ReviewPage.RunAiContinuityReview"]
                        </button>
                    </CapabilityLockedControl>
                </div>
            </div>
        }
    </div>
</div>
