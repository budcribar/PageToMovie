@page "/admin/users"
@inject EngineApiClient Api
@inject AdminSessionService Session
@inject NavigationManager Nav

<PageTitle>Users &amp; Credits — PageToMovie</PageTitle>

<div class="container-fluid py-3">
    <AdminPageHeader Title="Users & credits">
        <Subtitle>Track list-rate spend · 1 credit = $0.01 USD · same basis as project cost ledger</Subtitle>
        <Actions>
            @if (Session.IsAuthenticated)
            {
                <span class="badge text-bg-secondary">@Session.UserId</span>
                <button class="btn btn-sm btn-outline-primary" @onclick="LoadAsync" disabled="@_busy">Refresh</button>
            }
        </Actions>
    </AdminPageHeader>

    @if (!_started)
    {
        <p class="text-muted">Loading admin session…</p>
    }
    else if (!Session.IsAdmin)
    {
        <InlineAlert Variant="warning">Admin session required. <a href="/admin/login">Sign in</a></InlineAlert>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <InlineAlert Message="@_error" />
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync">Retry</button>
    }
    else if (_overview is null)
    {
        <p class="text-muted">Loading…</p>
    }
    else
    {
        <InlineAlert Message="@_message" Variant="success" CssClass="py-2" />

        <div class="row g-3 mb-4">
            <StatCard Label="Users" Value="@_overview.UserCount.ToString()" />
            <StatCard Label="Credits available" Value="@_overview.TotalBalanceCredits.ToString("N0")">
                <Sub>$@_overview.TotalBalanceUsd.ToString("F2") USD</Sub>
            </StatCard>
            <StatCard Label="Credits used (lifetime)" Value="@_overview.TotalUsedCredits.ToString("N0")">
                <Sub>$@_overview.TotalUsedUsd.ToString("F2") USD</Sub>
            </StatCard>
            <StatCard Label="Credits granted (lifetime)" Value="@_overview.TotalGrantedCredits.ToString("N0")">
                <Sub>$@_overview.TotalGrantedUsd.ToString("F2") USD</Sub>
            </StatCard>
        </div>

        <div class="alert alert-secondary small py-2">
            @_overview.Notes
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Users</span>
                <span class="small text-muted">@_overview.Users.Count account(s)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th class="text-end">Balance</th>
                            <th class="text-end">Used</th>
                            <th class="text-end">Granted</th>
                            <th>Created</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_overview.Users.Count == 0)
                        {
                            <EmptyTableRow ColSpan="8" Message="No users yet." />
                        }
                        else
                        {
                            @foreach (var u in _overview.Users)
                            {
                                var isSelf = IsSelf(u);
                                <tr class="@(u.IsDisabled ? "table-secondary" : null)">
                                    <td>
                                        <div class="fw-semibold">@u.Username</div>
                                        <div class="small text-muted font-monospace">@u.UserId</div>
                                        @if (u.PasswordResetRequestedAt is not null)
                                        {
                                            <div class="small text-warning mt-1" title="@u.PasswordResetRequestedAt.Value.ToLocalTime().ToString("g")">
                                                Password help requested
                                            </div>
                                        }
                                    </td>
                                    <td><span class="badge text-bg-light">@u.Role</span></td>
                                    <td>
                                        @if (u.IsDisabled)
                                        {
                                            <span class="badge text-bg-danger">Disabled</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success">Active</span>
                                        }
                                        @if (u.PasswordResetRequestedAt is not null)
                                        {
                                            <span class="badge text-bg-warning text-dark ms-1">Reset?</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <span class="@(u.CreditsBalanceUsd < 0 ? "text-danger" : "")">
                                            @u.CreditsBalance.ToString("N0")
                                        </span>
                                        <div class="small text-muted">$@u.CreditsBalanceUsd.ToString("F2")</div>
                                    </td>
                                    <td class="text-end">
                                        @u.CreditsLifetimeUsed.ToString("N0")
                                        <div class="small text-muted">$@u.CreditsLifetimeUsedUsd.ToString("F2")</div>
                                    </td>
                                    <td class="text-end">
                                        @u.CreditsLifetimeGranted.ToString("N0")
                                        <div class="small text-muted">$@u.CreditsLifetimeGrantedUsd.ToString("F2")</div>
                                    </td>
                                    <td class="small text-muted">@u.CreatedAt.ToLocalTime().ToString("g")</td>
                                    <td class="text-end">
                                        <div class="d-flex flex-wrap gap-1 justify-content-end">
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => OpenGrant(u)"
                                                    disabled="@(_busy || u.IsDisabled)">
                                                Grant…
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => OpenResetPassword(u)"
                                                    disabled="@_busy"
                                                    title="Set a new password for this user">
                                                Password…
                                            </button>
                                            @if (u.IsDisabled)
                                            {
                                                <button class="btn btn-sm btn-outline-success"
                                                        @onclick="() => SetDisabledAsync(u, false)"
                                                        disabled="@_busy"
                                                        title="Allow this account to sign in again">
                                                    Enable
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-warning"
                                                        @onclick="() => SetDisabledAsync(u, true)"
                                                        disabled="@(_busy || isSelf)"
                                                        title="@(isSelf ? "You cannot disable yourself" : "Block login and API use")">
                                                    Disable
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => OpenDelete(u)"
                                                    disabled="@(_busy || isSelf)"
                                                    title="@(isSelf ? "You cannot delete yourself" : "Permanently delete account")">
                                                Delete…
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_grantUser is not null)
        {
            <div class="card mb-4 border-primary">
                <div class="card-header">Grant / adjust credits — @_grantUser.Username</div>
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Amount (USD)</label>
                            <InputNumber class="form-control" @bind-Value="_grantUsd" step="0.01" />
                            <div class="form-text">Positive adds, negative claws back. $1 = 100 credits.</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Or credits</label>
                            <InputNumber class="form-control" @bind-Value="_grantCredits" />
                            <div class="form-text">Fills USD from credits (× $0.01).</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Note (optional)</label>
                            <InputText class="form-control" @bind-Value="_grantNote" />
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <BusyButton Label="Apply" BusyLabel="…" Busy="_busy"
                                        CssClass="btn btn-primary flex-grow-1" OnClick="SubmitGrantAsync" />
                            <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="CloseGrant">Cancel</button>
                        </div>
                    </div>
                    <div class="mt-2 d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => QuickGrant(1)">+$1 (100)</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => QuickGrant(5)">+$5 (500)</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => QuickGrant(10)">+$10 (1000)</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => QuickGrant(25)">+$25 (2500)</button>
                    </div>
                </div>
            </div>
        }

        @if (_resetUser is not null)
        {
            <div class="card mb-4 border-warning shadow-sm">
                <div class="card-header bg-warning-subtle text-warning-emphasis d-flex align-items-center justify-content-between py-2">
                    <span class="fw-semibold">🔑 Set password — @_resetUser.Username</span>
                    <button class="btn-close" type="button" aria-label="Close" @onclick="CloseResetPassword"></button>
                </div>
                <div class="card-body">
                    @if (_resetUser.PasswordResetRequestedAt is not null)
                    {
                        <div class="alert alert-warning py-2 mb-3 small d-flex align-items-center gap-2">
                            <span>⚠️ User requested password help at @_resetUser.PasswordResetRequestedAt.Value.ToLocalTime().ToString("g").</span>
                        </div>
                    }
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label fw-medium mb-1">New password</label>
                            <div class="input-group">
                                <input type="@(_showResetNewPassword ? "text" : "password")"
                                       class="form-control"
                                       @bind="_resetNewPassword"
                                       placeholder="Enter new password"
                                       autocomplete="new-password" />
                                <button class="btn btn-outline-secondary" type="button"
                                        title="@(_showResetNewPassword ? "Hide password" : "Show password")"
                                        @onclick="() => _showResetNewPassword = !_showResetNewPassword">
                                    @(_showResetNewPassword ? "🙈 Hide" : "👁️ Show")
                                </button>
                            </div>
                            <div class="form-text mt-1">At least 4 characters. Tell the user out of band.</div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-medium mb-1">Your admin password (optional)</label>
                            <div class="input-group">
                                <input type="@(_showResetAdminPassword ? "text" : "password")"
                                       class="form-control"
                                       @bind="_resetAdminPassword"
                                       placeholder="Optional — leave blank for override"
                                       autocomplete="current-password" />
                                <button class="btn btn-outline-secondary" type="button"
                                        title="@(_showResetAdminPassword ? "Hide password" : "Show password")"
                                        @onclick="() => _showResetAdminPassword = !_showResetAdminPassword">
                                    @(_showResetAdminPassword ? "🙈 Hide" : "👁️ Show")
                                </button>
                            </div>
                            <div class="form-text mt-1">Optional. Leave blank if using operator override bypass.</div>
                        </div>
                        <div class="col-md-2 d-flex flex-column justify-content-start">
                            <label class="form-label d-none d-md-block mb-1">&nbsp;</label>
                            <div class="d-flex gap-2">
                                <BusyButton Label="Set password" BusyLabel="…" Busy="_busy"
                                            CssClass="btn btn-warning flex-grow-1 text-nowrap"
                                            OnClick="SubmitResetPasswordAsync" />
                                <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="CloseResetPassword">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (_deleteUser is not null)
        {
            <div class="card mb-4 border-danger shadow-sm">
                <div class="card-header bg-danger-subtle text-danger d-flex align-items-center justify-content-between py-2">
                    <span class="fw-semibold">⚠️ Hard-delete user — @_deleteUser.Username</span>
                    <button class="btn-close" type="button" aria-label="Close" @onclick="CloseDelete"></button>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">
                        Permanently removes the account, credit ledger, demo submissions,
                        and (by default) projects owned by this user. This cannot be undone.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-medium mb-1">Type username to confirm</label>
                            <InputText class="form-control" @bind-Value="_deleteConfirmUsername"
                                       placeholder="@_deleteUser.Username" autocomplete="off" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium mb-1">Your admin password</label>
                            <div class="input-group">
                                <input type="@(_showDeleteAdminPassword ? "text" : "password")" class="form-control" @bind="_deleteAdminPassword"
                                       placeholder="Confirm admin password" autocomplete="current-password" />
                                <button class="btn btn-outline-secondary" type="button"
                                        title="@(_showDeleteAdminPassword ? "Hide password" : "Show password")"
                                        @onclick="() => _showDeleteAdminPassword = !_showDeleteAdminPassword">
                                    @(_showDeleteAdminPassword ? "🙈 Hide" : "👁️ Show")
                                </button>
                            </div>
                            <div class="form-text mt-1">Your password (or operator override secret).</div>
                        </div>
                        <div class="col-md-4 d-flex flex-column justify-content-start">
                            <div class="form-check mb-2">
                                <InputCheckbox class="form-check-input" @bind-Value="_deleteOwnedProjects" id="delProjects" />
                                <label class="form-check-label small" for="delProjects">Delete owned projects</label>
                            </div>
                            <div class="d-flex gap-2">
                                <BusyButton Label="Delete permanently" BusyLabel="…" Busy="_busy"
                                            CssClass="btn btn-danger text-nowrap" OnClick="SubmitDeleteAsync" />
                                <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="CloseDelete">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header">Recent credit ledger</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>When (UTC)</th>
                            <th>User</th>
                            <th>Kind</th>
                            <th class="text-end">Δ USD</th>
                            <th class="text-end">Balance after</th>
                            <th>Meta</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_overview.RecentLedger.Count == 0)
                        {
                            <EmptyTableRow ColSpan="7" Message="No ledger entries yet." />
                        }
                        else
                        {
                            @foreach (var e in _overview.RecentLedger)
                            {
                                <tr>
                                    <td class="small text-muted font-monospace">@e.Ts.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="font-monospace small">@e.UserId</td>
                                    <td><span class="badge text-bg-light">@e.Kind</span></td>
                                    <td class="text-end @(e.AmountUsd < 0 ? "text-danger" : "text-success")">
                                        @(e.AmountUsd >= 0 ? "+" : "")@e.AmountUsd.ToString("F4")
                                    </td>
                                    <td class="text-end">@e.BalanceAfterUsd.ToString("F4")</td>
                                    <td class="small">
                                        @(e.MetaKind ?? "—")
                                        @if (!string.IsNullOrWhiteSpace(e.ProjectId))
                                        {
                                            <span class="text-muted"> · @e.ProjectId</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@(e.Note ?? "")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
