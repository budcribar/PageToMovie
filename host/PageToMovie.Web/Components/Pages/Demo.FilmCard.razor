@* Page-local to Demo — single public gallery film card *@
@inject AdminSessionService Session
@using PageToMovie.Core.Models
@using PageToMovie.Core.Util

<article class="demo-card w-100 @(IsHighlight ? "is-highlight" : "")"
         id="@Film.Id"
         data-testid="demo-card">
    <div class="demo-card-media">
        @if (YtWatchUrl is not null)
        {
            <a class="demo-yt-frame demo-yt-thumb-link"
               href="@YtWatchUrl"
               target="_blank"
               rel="noopener noreferrer"
               title="Watch @Film.Title on YouTube"
               data-testid="demo-watch-link">
                @if (ThumbUrl is not null)
                {
                    <img class="demo-yt-thumb"
                         src="@ThumbUrl"
                         alt=""
                         loading="lazy"
                         decoding="async" />
                }
                else
                {
                    <span class="demo-yt-thumb-fallback" aria-hidden="true"></span>
                }
                <span class="demo-yt-play" aria-hidden="true" data-testid="demo-yt-play">▶</span>
                <span class="visually-hidden">Watch on YouTube</span>
            </a>
        }
        else
        {
            <div class="demo-yt-frame demo-yt-frame--empty">
                <span class="small text-secondary">Video not available yet</span>
            </div>
        }
    </div>
    <div class="demo-card-body">
        <header class="demo-card-header">
            <h2 class="demo-card-title mb-0">@Film.Title</h2>
        </header>

        <div class="demo-card-about">
            <h3 class="demo-about-label">About this film</h3>
            <p class="demo-about-text" data-testid="demo-about">@About</p>
        </div>

        <footer class="demo-card-footer">
            <div class="demo-card-byline">
                @if (!string.IsNullOrWhiteSpace(Film.CreatedBy))
                {
                    <span>Shared by <a href="creator/@Uri.EscapeDataString(Film.CreatedBy)" class="text-decoration-none text-info fw-bold">@@@Film.CreatedBy</a></span>
                }
                else
                {
                    <span class="text-muted">Community share</span>
                }
                <span class="demo-card-date" title="@Film.CreatedAt.ToLocalTime().ToString("f")">
                    · @Film.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                </span>
            </div>
            <div class="demo-card-actions">
                <button type="button"
                        class="btn btn-sm @(Film.UpvotedByMe ? "btn-warning" : "btn-outline-secondary") demo-star-btn"
                        disabled="@(Busy || IsOwnDemo)"
                        title="@StarButtonTitle"
                        aria-pressed="@(Film.UpvotedByMe ? "true" : "false")"
                        @onclick="() => OnToggleStar.InvokeAsync(Film)">
                    <span aria-hidden="true">★</span>
                    <span class="demo-star-count">@Film.TotalStars</span>
                </button>

                @if (Film.CanFork && (Film.IsForkable || Session.IsAdmin))
                {
                    <button type="button"
                            class="btn btn-sm btn-success"
                            disabled="@Busy"
                            title="@(Session.IsLoggedIn
                                ? "Copy the full screenplay into your workspace — then pick a length or film"
                                : "Sign in to fork this project")"
                            data-testid="demo-fork"
                            @onclick="() => OnFork.InvokeAsync(Film)">
                        Fork
                    </button>
                }
                @if (Session.IsLoggedIn && !IsOwnDemo)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-warning"
                            disabled="@(Busy || IsReported)"
                            title="Report inappropriate content"
                            @onclick="() => OnReport.InvokeAsync(Film)">
                        @(IsReported ? "Reported" : "Report")
                    </button>
                }
                @if (CanRemove)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            disabled="@Busy"
                            title="@(Session.IsAdmin ? "Remove (admin)" : "Remove your film from the gallery")"
                            data-testid="demo-remove"
                            @onclick="() => OnDelete.InvokeAsync(Film.Id)">
                        Remove
                    </button>
                }
            </div>
        </footer>
    </div>
</article>
