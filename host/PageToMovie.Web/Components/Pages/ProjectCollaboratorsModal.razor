@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject EngineApiClient Engine
@inject AdminSessionService Session
@inject IAppLocalizer L

@if (IsOpen)
{
    @* Backdrop and panel are siblings — Bootstrap .modal-backdrop.show applies opacity
       to the whole element, which would make child text unreadable if nested. *@
    <div class="modal-backdrop fade show"
         style="z-index: 1050;"
         @onclick="Close"></div>
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="invite-collab-title"
         style="z-index: 1055;"
         @onclick="Close">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header py-3 border-secondary">
                    <h5 class="modal-title fw-semibold" id="invite-collab-title">@L["Collaborators.InviteCollaboratorTitle"]</h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="@L["Common.Close"]" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <InlineAlert Variant="@(isError ? "danger" : "success")" CssClass="mb-3 py-2" Message="@statusMessage" />
                    }

                    <div class="mb-3 position-relative">
                        <label class="form-label" for="invite-handle">@L["Collaborators.Handle"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark text-white border-secondary">@@</span>
                            <input id="invite-handle"
                                   type="text"
                                   class="form-control bg-dark text-white border-secondary"
                                   placeholder="@L["Collaborators.HandlePlaceholder"]"
                                   autocomplete="off"
                                   role="combobox"
                                   aria-expanded="@(_suggestions.Count > 0)"
                                   aria-controls="invite-handle-list"
                                   aria-autocomplete="list"
                                   value="@searchHandle"
                                   @oninput="OnHandleInput"
                                   @onkeydown="OnHandleKeyDown"
                                   @onfocus="OnHandleFocus" />
                        </div>
                        @if (_searching)
                        {
                            <div class="form-text text-white-50">@L["Common.Searching"]</div>
                        }
                        else if (_suggestions.Count > 0)
                        {
                            <ul id="invite-handle-list"
                                class="list-group position-absolute shadow mt-1 collab-handle-dd"
                                role="listbox"
                                style="z-index: 30; left: 0; right: 0; max-height: 14rem; overflow-y: auto;">
                                @for (var i = 0; i < _suggestions.Count; i++)
                                {
                                    var h = _suggestions[i];
                                    var bare = h.TrimStart('@');
                                    var idx = i;
                                    <li class="list-group-item list-group-item-action py-2 collab-handle-dd__item @(_highlight == idx ? "active" : "")"
                                        role="option"
                                        aria-selected="@(_highlight == idx)"
                                        style="cursor: pointer;"
                                        @onclick="() => PickHandle(bare)"
                                        @onmouseenter="() => _highlight = idx">
                                        <span class="fw-semibold">@@@bare</span>
                                    </li>
                                }
                            </ul>
                        }
                        else if (_searchAttempted && searchHandle.Trim().Length >= 1 && !_searching)
                        {
                            <div class="form-text text-white-50">@L["Collaborators.NoMatchingHandlesHelp"]</div>
                        }
                        else
                        {
                            <div class="form-text text-white-50">@L["Collaborators.TypeToFilterHandlesHelp"]</div>
                        }
                    </div>

                    <div class="mb-0">
                        <label class="form-label" for="invite-email">@L["Collaborators.Email"] <span class="text-white-50 fw-normal">@L["Collaborators.Optional"]</span></label>
                        <input id="invite-email"
                               type="email"
                               class="form-control bg-dark text-white border-secondary"
                               placeholder="@L["Collaborators.EmailPlaceholder"]"
                               autocomplete="email"
                               @bind="emailInput"
                               @bind:event="oninput" />
                        <div class="form-text text-white-50">@L["Collaborators.UseEmailOnlyNoHandle"]</div>
                    </div>
                </div>
                <div class="modal-footer py-2 border-secondary">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Close" disabled="@isSending">@L["Common.Cancel"]</button>
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@(isSending || (string.IsNullOrWhiteSpace(searchHandle) && string.IsNullOrWhiteSpace(emailInput)))"
                            @onclick="SendInvite">
                        @(isSending ? L["Collaborators.Sending"] : L["Collaborators.SendInvite"])
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .collab-handle-dd {
        background: #0f1419;
        border: 1px solid rgba(148, 163, 184, 0.35);
        border-radius: 0.5rem;
    }
    .collab-handle-dd__item {
        background: #0f1419 !important;
        color: #e2e8f0 !important;
        border-color: rgba(148, 163, 184, 0.2) !important;
    }
    .collab-handle-dd__item:hover,
    .collab-handle-dd__item.active {
        background: rgba(56, 189, 248, 0.18) !important;
        color: #fff !important;
    }
</style>
