@page "/characters"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject StudioCapabilityState Caps
@inject JobHubClient Hub
@inject AdminSessionService Session
@inject ActiveProjectState ActiveProject
@inject ClientMediaFolderService MediaFolder
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject IAppLocalizer L
@using PageToMovie.Core.Models
@using PageToMovie.Web.Services
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@L["Nav.Cast"]</PageTitle>

<StudioPageHeader Kicker="@(_simpleMode ? "Simple · your voice" : "Studio · Step 2")"
                   Title="@(_simpleMode ? L["CharactersPage.NarratorVoice"] : L["Nav.Cast"])" LedeClass="">
    @if (_simpleMode)
    {
        <text>Record one sample for the narrator. Library pictures stay as-is — we only re-voice the lines. Want faces of family? Use full studio.</text>
    }
    else
    {
        <text>@L["CharactersPage.Subtitle"]</text>
    }
</StudioPageHeader>

@if (_simpleMode)
{
    <div class="alert alert-primary border-primary border-opacity-50 py-2 small mb-3" data-testid="simple-voice-banner">
        <strong>Simple path.</strong>
        Pick the narrator (or lead), record the script below, then go to
        <a href="cost" class="alert-link">Estimate</a> or
        <a href="scenes" class="alert-link">Film</a>.
        <button type="button" class="btn btn-link btn-sm p-0 align-baseline alert-link" @onclick="ExitSimplePathAsync">Exit simple → full cast</button>
        ·
        <a href="simple-voice" class="alert-link">Library books</a>
    </div>
}

<StudioProcessStrip Active="cast" SimpleMode="@_simpleMode" FullStudio="@(!_simpleMode)" />

@if (_gateChecked && !ActiveProject.CanCharacters)
{
    <ReadinessGateBanner Visible="true"
                         Reason="@ActiveProject.CharactersBlockedReason"
                         FallbackReason="Approve the screenplay first."
                         ActionHref="adaptation/screenplay"
                         ActionLabel="Open screenplay →" />
}
else
{
@* Setup actions only when needed — hide once cast exists / book pictures are matched *@
@if (NeedsCastBuild)
{
    <div class="mb-3">
        <button type="button"
                class="btn btn-primary btn-sm"
                data-testid="characters-extract-cast"
                disabled="@(_busy || JobRunning || _extractingCast)"
                title="One step: names + looks from screenplay and book (when present)"
                @onclick="ExtractCastAsync">
            @(_extractingCast ? "Building cast…" : L["CharactersPage.BuildCast"])
        </button>
        <span class="small text-muted ms-2">Screenplay + book → names, voices, and portrait-ready looks</span>
    </div>
}
else if (Session.IsAdmin && HasCast && !JobRunning && !_extractingCast)
{
    @* Advanced re-run only for admin — operators are not offered redo of finished setup *@
    <details class="mb-2">
        <summary class="small text-muted" style="cursor:pointer">Setup again (admin)</summary>
        <div class="d-flex flex-wrap gap-2 mt-2">
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-testid="characters-extract-cast"
                    disabled="@_busy"
                    title="Rebuild names and looks from screenplay + book in one step"
                    @onclick="ExtractCastAsync">
                Rebuild cast
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    disabled="@_busy"
                    @onclick="() => StartSortCharacterPlatesAsync(useGrok: true)">
                Find characters again
            </button>
        </div>
    </details>
}

@if (_styleRejectCandidate is not null && !JobRunning)
{
    @* Style classifier flagged a mismatch — but the creator's intent wins. Two-step: pick WHY you're
       overriding (feeds the AI feedback loop: a wrong verdict is a defect to tune; a creative choice
       is the classifier working as intended), then the look locks. Dismiss keeps the verdict. *@
    <div class="alert alert-warning" data-testid="char-style-override">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
            <div>
                <strong>This look's style doesn't match the project.</strong>
                <div class="small">@_styleRejectMessage</div>
                <div class="small mt-1">To use it anyway, tell us why — it helps improve the checks:</div>
            </div>
            <button type="button" class="btn-close" aria-label="Keep the suggestion (don't use this look)"
                    data-testid="char-style-override-dismiss"
                    @onclick="DismissStyleReject"></button>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-2">
            <button type="button" class="btn btn-sm btn-warning fw-semibold"
                    data-testid="char-override-ai-wrong"
                    disabled="@_busy"
                    @onclick='() => LockCandidateAsync(_styleRejectCandidate!, overrideStyle: true, overrideReason: "ai_wrong")'>
                The check is wrong — this look does match
            </button>
            <button type="button" class="btn btn-sm btn-warning fw-semibold"
                    data-testid="char-override-preference"
                    disabled="@_busy"
                    @onclick='() => LockCandidateAsync(_styleRejectCandidate!, overrideStyle: true, overrideReason: "user_preference")'>
                My creative choice — mix styles on purpose
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-testid="char-override-other"
                    disabled="@_busy"
                    @onclick='() => LockCandidateAsync(_styleRejectCandidate!, overrideStyle: true, overrideReason: "other")'>
                Other
            </button>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(_error) && !JobRunning)
{
    <InlineAlert Message="@_error" />
}
@* One outcome surface: success flash OR next-step CTA — not both saying “ready” *@
@if (!string.IsNullOrEmpty(_message) && !_extractingCast && !JobRunning && !IsCastComplete)
{
    <InlineAlert Message="@_message" Variant="success" />
}
@if (Session.IsAdmin && _lastCastExtractKeys is { Count: > 0 } && !_extractingCast)
{
    <div class="alert alert-secondary py-2 small mb-3">
        <strong>Admin · last cast extract</strong>
        · @_lastCastExtractKeys.Count:
        <code class="user-select-all">@string.Join(", ", _lastCastExtractKeys)</code>
    </div>
}
else if (IsCastComplete && !JobRunning && !_extractingCast)
{
    <div class="alert alert-info py-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
        @if (ActiveProject.CanScenes)
        {
            <span class="small text-muted">Next</span>
            <a class="btn btn-sm btn-primary" data-testid="characters-to-scenes" href="scenes">@L["CharactersPage.OpenScenes"]</a>
        }
        else
        {
            <span class="small text-muted">Next</span>
            <a class="btn btn-sm btn-primary" data-testid="characters-to-shots" href="adaptation/shots">@L["CharactersPage.BuildShotPlan"]</a>
        }
        <div data-testid="characters-status"
             data-cast-complete="@(IsCastComplete ? "true" : "false")"
             data-has-cast="@(HasCast ? "true" : "false")"
             class="visually-hidden"
             aria-hidden="true"></div>
    </div>
}

@* In-progress: busy shimmer (not a fake % bar that looks done at 100% or stuck at 30%). *@
@if (_extractingCast)
{
    <div class="card mb-3 border-primary" data-testid="characters-building-cast">
        <div class="card-body py-3">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></div>
                <div class="small fw-semibold">
                    @(_rebuildCastHadExisting ? "Rebuilding cast…" : "Building cast…")
                </div>
            </div>
            <div class="progress progress-busy" style="height: 0.35rem;"
                 role="progressbar"
                 aria-valuetext="in progress"
                 aria-label="@(_rebuildCastHadExisting ? "Rebuilding cast" : "Building cast")">
                <div class="progress-busy__shine" aria-hidden="true"></div>
            </div>
            <div class="form-text mt-2 mb-0">
                Reading screenplay and book for names and looks.
            </div>
        </div>
    </div>
}
else if (_job is not null &&
     (_job.Kind is "character" or "character-plates" or "voice-preview") &&
     (_job.Status is "running" or "queued"))
{
    var voiceDetail = !string.IsNullOrEmpty(_job.Message)
        && string.Equals(_job.Kind, "voice-preview", StringComparison.OrdinalIgnoreCase)
            ? _job.Message
            : null;
    <JobProgressCard @key="_job.JobId"
                     Status="@_job.Status"
                     Message="@FriendlyCharacterJobStatus(_job)"
                     Index="_job.Index"
                     Total="_job.Total"
                     DetailMessage="@voiceDetail"
                     ShowCancel="true"
                     CancelDisabled="_busy"
                     OnCancel="CancelAsync"
                     Kind="@_job.Kind"
                     ShowLog="Session.IsAdmin"
                     LogLines="_job.Log"
                     TestId="characters-job" />
}

@if (_chars is null)
{
    <EmptyState Message="Loading…" CssClass="text-muted" />
}
else if (_extractingCast)
{
    @* Hide stale cast while rebuild/build runs — avoids editing the old list mid-flight. *@
}
else if (!HasCast)
{
    <InlineAlert Variant="warning" Message="No cast yet. Approve the screenplay, then build the cast."
                 data-testid="characters-empty" />
}
else if (OperatorCastCount == 0)
{
    @* Cast exists but is entirely ensemble/crowd roles — those need no individual portraits, so the
       operator roster below is empty. Acknowledge the cast instead of the misleading "No cast yet". *@
    <div class="alert alert-info" data-testid="characters-all-ensembles">
        The speaking cast here are all ensemble roles
        (@string.Join(", ", _chars!.Where(c => c.IsGroup).Select(c => c.DisplayName))) —
        no individual portraits needed. You can continue to the next step.
    </div>
}
else
{
    <div class="row">
        <div class="col-md-3">
            <div class="list-group">
                @foreach (var c in CharactersForUi)
                {
                    var active = c.Key == _selectedKey;
                    var thumb = ListThumbUrl(c);
                    var hasVoice = HasVoiceProfile(c);
                    <button type="button"
                            @key="c.Key"
                            data-testid="char-list-item"
                            data-char-key="@c.Key"
                            data-char-group="@(c.IsGroup ? "true" : "false")"
                            data-char-voice-only="@(c.VoiceOnly ? "true" : "false")"
                            class="list-group-item list-group-item-action char-list-item @(active ? "active" : "")"
                            disabled="@CastListLocked"
                            title="@(CastListLocked ? "Wait until the current action finishes" : null)"
                            @onclick="() => SelectAsync(c.Key)">
                        @if (c.VoiceOnly)
                        {
                            <span class="char-list-thumb @(hasVoice ? "char-list-thumb--voice" : "char-list-thumb--voice-missing")"
                                  title="@(hasVoice ? "Voice" : "No voice profile")"
                                  aria-hidden="true">
                                <span class="char-list-thumb__icon">♪</span>
                            </span>
                        }
                        else if (c.IsGroup && thumb is null)
                        {
                            <span class="char-list-thumb char-list-thumb--group"
                                  title="Group / chorus (no single face required)"
                                  aria-hidden="true">
                                <span class="char-list-thumb__icon">👥</span>
                            </span>
                        }
                        else if (thumb is { Length: > 0 })
                        {
                            @* Stable @key so a cache-bust (_imgBust) from saving ANOTHER character updates
                               this src in place instead of remounting the <img> (which blanked it and, with
                               lazy loading, often didn't re-fetch — the §3 "look drops on switch" bug). *@
                            <img @key="c.Key" src="@thumb" alt="" class="char-list-thumb" />
                        }
                        else
                        {
                            <span class="char-list-thumb char-list-thumb--empty" title="No picture" aria-hidden="true">
                                <span class="char-list-thumb__icon">?</span>
                            </span>
                        }
                        <span class="char-list-name text-truncate">@c.DisplayName</span>
                        @if (c.Locked)
                        {
                            <span class="char-list-lock ms-auto text-muted" title="Locked" aria-label="Locked">🔒</span>
                        }
                        @if (c.IsGroup)
                        {
                            <span class="badge text-bg-info ms-1" title="Group / chorus cast">group</span>
                        }
                        @if (!c.VoiceOnly && !hasVoice)
                        {
                            <span class="char-list-voice-miss" title="No voice profile" aria-label="No voice profile">♪</span>
                        }
                    </button>
                }
            </div>
        </div>
        <div class="col-md-9">
            @if (_selected is null)
            {
                <p class="text-muted">
                    @(_simpleMode
                        ? "Pick the narrator (or lead) on the left, then record your sample."
                        : "Click a character on the left to set a preferred look and choose how to generate.")
                </p>
            }
            else if (_simpleMode)
            {
                @* Simple path: voice first — no picture routing required to reach Record. *@
                <div class="card mb-3 border-primary border-opacity-50" data-testid="simple-voice-card">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span class="fw-semibold">@_selected.DisplayName · voice sample</span>
                        <span class="badge text-bg-primary">Simple · your voice</span>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted mb-3">
                            Record (or pick) one sample for this character. Library pictures stay as-is — we re-speak lines in your voice when you film.
                        </p>
                        @RenderVoiceEditor()
                    </div>
                </div>
                <p class="small text-muted mb-0">
                    Want to change looks later?
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="ExitSimplePathAsync">Switch to full cast</button>
                </p>
            }
            else if (_selected.VoiceOnly)
            {
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><code>@_selected.Key</code> — @_selected.DisplayName</span>
                        <span class="badge bg-secondary">voice-only (no image)</span>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted mb-3">
                            <strong>Voice style</strong> — used when this character speaks (for example narrator voice-over).
                        </p>
                        @RenderVoiceEditor()
                    </div>
                </div>
            }
            else if (_selected.IsGroup)
            {
                // Groups are filtered from the list; clear stale selection.
                _selectedKey = null;
                _selected = null;
            }
            else
            {
                @* Name + actions — no middle thumbnail (sidebar already shows look). *@
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <div class="fw-semibold">@_selected.DisplayName</div>
                    <div class="ms-auto d-flex flex-wrap gap-1">
                        @if (_mode != Mode.PickSource)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="BackToSource">← Edit</button>
                        }
                    </div>
                </div>

                <div class="card mb-2 @(_mode == Mode.PickSource ? "border-primary" : "")">
                    <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center gap-2">
                        <button type="button"
                                class="char-panel-toggle border-0 bg-transparent text-start p-0 flex-grow-1 d-flex justify-content-between align-items-center gap-2"
                                @onclick="() => _panelPictureOpen = !_panelPictureOpen">
                            <span><strong>Look & voice</strong></span>
                            <span class="small text-muted">@(_panelPictureOpen ? "▲" : "▼")</span>
                        </button>
                        @if (_selected.Locked)
                        {
                            <button type="button" class="btn btn-sm btn-outline-warning" disabled="@_busy"
                                    title="Unlock this character look so it can be changed"
                                    @onclick="UnlockAsync"
                                    @onclick:stopPropagation="true">Unlock</button>
                        }
                    </div>
                    @if (_panelPictureOpen)
                    {
                        <div class="card-body py-2">
                            @if (_mode == Mode.WaitingGenerate)
                            {
                                <div class="alert alert-info mb-0 py-2">
                                    Generating three looks for @_selected.DisplayName…
                                    @if (JobRunning)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger ms-2 py-0"
                                                disabled="@_busy" @onclick="CancelAsync">Cancel</button>
                                    }
                                </div>
                            }
                            else if (_mode == Mode.Compare && _allCandidates.Count > 0)
                            {
                                <div class="char-pick">
                                    <div class="small fw-semibold mb-1">Pick the best look</div>
                                    <p class="small text-muted mb-3 mb-md-2">
                                        Click a picture to zoom and compare detail. Use <strong>Use this look</strong> only when you’ve chosen.
                                    </p>
                                    <div class="char-pick__grid" data-testid="char-pick-grid">
                                        @foreach (var c in _allCandidates)
                                        {
                                            <CharacterPickCard Label="@c.Label"
                                                               ImageUrl="@c.Url"
                                                               Selected="@(_chosenCandidateKey == CandidateKey(c))"
                                                               ShowZoomBadge="true"
                                                               FrameDisabled="@(_busy || JobRunning)"
                                                               FrameTitle="@($"Click to save this look for {_selected?.DisplayName}")"
                                                               FrameAriaLabel="@($"Use look {c.Label}")"
                                                               OnFrameClick="@(() => LockCandidateAsync(c))"
                                                               UseLabel="Use this look"
                                                               UseTitle="Save as preferred look for film"
                                                               UseDisabled="@(_busy || JobRunning)"
                                                               OnUse="@(() => LockCandidateAsync(c))"
                                                               UseTestId="char-use-look">
                                                <ExtraActions>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary"
                                                            disabled="@(_busy || JobRunning)"
                                                            title="Zoom — inspect detail"
                                                            @onclick="@(() => OpenLookZoom(c))">
                                                        Zoom
                                                    </button>
                                                </ExtraActions>
                                            </CharacterPickCard>
                                        }
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary mt-2"
                                            disabled="@(_busy || JobRunning)"
                                            @onclick="BackToSource">
                                        ← Change route
                                    </button>
                                </div>

                                @* Full-screen zoom lightbox for detail compare *@
                                @if (_zoomCandidate is not null)
                                {
                                    <div class="char-zoom"
                                         role="dialog"
                                         aria-modal="true"
                                         aria-label="Zoomed character look"
                                         data-testid="char-look-zoom"
                                         @onclick="CloseLookZoom">
                                        <div class="char-zoom__panel" @onclick:stopPropagation="true">
                                            <div class="char-zoom__toolbar">
                                                <span class="char-zoom__title">@_zoomCandidate.Label</span>
                                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                                    <button type="button" class="btn btn-sm btn-outline-light"
                                                            disabled="@(_allCandidates.Count < 2)"
                                                            @onclick="ZoomPrev"
                                                            title="Previous look">←</button>
                                                    <button type="button" class="btn btn-sm btn-outline-light"
                                                            disabled="@(_allCandidates.Count < 2)"
                                                            @onclick="ZoomNext"
                                                            title="Next look">→</button>
                                                    <button type="button" class="btn btn-sm btn-outline-light"
                                                            @onclick="ToggleLookZoomScale"
                                                            title="Toggle 1× / 2×">
                                                        @(_zoomScale > 1.01 ? "1× fit" : "2× zoom")
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-primary"
                                                            disabled="@(_busy || JobRunning)"
                                                            @onclick="@(() => LockFromZoomAsync())">
                                                        Use this look
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                                            @onclick="CloseLookZoom">Close</button>
                                                </div>
                                            </div>
                                            <div class="char-zoom__stage @(_zoomScale > 1.01 ? "is-zoomed" : null)"
                                                 @onclick="ToggleLookZoomScale">
                                                <img src="@_zoomCandidate.Url"
                                                     alt="@_zoomCandidate.Label"
                                                     class="char-zoom__img"
                                                     style="transform: scale(@_zoomScale.ToString(System.Globalization.CultureInfo.InvariantCulture));"
                                                     draggable="false" />
                                            </div>
                                            <p class="char-zoom__hint small text-muted mb-0">
                                                Click image to toggle 2× · arrows switch looks · Esc closes
                                            </p>
                                        </div>
                                    </div>
                                }
                            }
                            else if (_mode == Mode.PickSource)
                            {
                                @* Already have a preferred look *@
                                @if (_selected.HasPreferred && _pictureRoute == PictureRoute.Choose)
                                {
                                    <div class="d-flex flex-wrap align-items-start gap-3 mb-2">
                                        @if (PreferredImageUrl is { Length: > 0 } pu)
                                        {
                                            <img src="@pu" alt="Preferred" class="rounded border char-preferred-preview" />
                                        }
                                        <div class="flex-grow-1">
                                            <div class="small fw-semibold mb-1">Preferred look saved</div>
                                            <p class="small text-muted mb-2">This picture is used for film. Change it anytime.</p>
                                            <div class="d-flex flex-wrap gap-2">
                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        disabled="@(_busy || JobRunning)"
                                                        @onclick="() => ChoosePictureRoute(PictureRoute.Generate)">
                                                    Generate new looks
                                                </button>
                                                <label class="btn btn-sm btn-outline-primary mb-0 @(_busy || JobRunning ? "disabled" : "")">
                                                    Replace with upload
                                                    <InputFile OnChange="OnUploadRefAsync"
                                                               accept=".png,.jpg,.jpeg,.webp,.gif"
                                                               class="d-none"
                                                               disabled="@(_busy || JobRunning)" />
                                                </label>
                                                @if (CanUseBookPictures)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                                            disabled="@(_busy || JobRunning)"
                                                            @onclick="() => ChoosePictureRoute(PictureRoute.Book)">
                                                        From book pictures
                                                    </button>
                                                }
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        disabled="@(_busy || JobRunning)"
                                                        @onclick="@(() => RequestDeleteImage("preferred", 0))">
                                                    Remove
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (_pictureRoute == PictureRoute.Choose)
                                {
                                    <p class="small text-muted mb-2">How do you want the look for <strong>@_selected.DisplayName</strong>?</p>
                                    <div class="d-flex flex-column gap-2">
                                        <button type="button"
                                                class="btn btn-outline-primary text-start"
                                                disabled="@(_busy || JobRunning)"
                                                @onclick="() => ChoosePictureRoute(PictureRoute.Generate)"
                                                data-testid="char-route-generate">
                                            <strong>Generate from description</strong>
                                            <div class="small opacity-75">Edit look text → create 3 options → pick one</div>
                                        </button>
                                        <label class="btn btn-outline-primary text-start mb-0 @(_busy || JobRunning ? "disabled" : "")"
                                               data-testid="char-route-upload">
                                            <strong>Upload a photo</strong>
                                            <div class="small opacity-75">Your picture becomes the preferred look — no description needed</div>
                                            <InputFile OnChange="OnUploadRefAsync"
                                                       accept=".png,.jpg,.jpeg,.webp,.gif"
                                                       class="d-none"
                                                       disabled="@(_busy || JobRunning)" />
                                        </label>
                                        @if (CanUseBookPictures)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-primary text-start"
                                                    disabled="@(_busy || JobRunning)"
                                                    @onclick="() => ChoosePictureRoute(PictureRoute.Book)"
                                                    data-testid="char-route-book">
                                                <strong>Guide from book pictures</strong>
                                                <div class="small opacity-75">Pick illustrations from the PDF, then generate looks from them</div>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (_pictureRoute == PictureRoute.Generate)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small fw-semibold">Generate from description</span>
                                        <button type="button" class="btn btn-link btn-sm text-muted p-0"
                                                @onclick="() => ChoosePictureRoute(PictureRoute.Choose)">← Routes</button>
                                    </div>
                                    <CharacterLookPanel Description="@_editDescription"
                                                       DescriptionChanged="OnLookDescriptionChanged"
                                                       VisualLock="@_editVisualLock"
                                                       VisualLockChanged="OnLookVisualLockChanged"
                                                       Busy="@(_busy || JobRunning)"
                                                       Hint="@(_lookSaveHint ?? "Text saves automatically")"
                                                       TestId="char-look-panel">
                                        <Actions>
                                            <CapabilityLockedControl Enabled="Caps.ImageReady"
                                                                     BlockedReason="@Caps.ImageBlockedReason"
                                                                     SettingsHref="@Caps.ImageSettingsHref"
                                                                     TestId="char-generate-looks-cap">
                                                <button type="button" class="btn btn-primary btn-sm"
                                                        disabled="@(_busy || JobRunning || string.IsNullOrWhiteSpace(_editDescription))"
                                                        @onclick="StartRegenerateAsync"
                                                        data-testid="char-generate-looks">
                                                    Generate 3 looks
                                                </button>
                                            </CapabilityLockedControl>
                                            @if (_savingLook)
                                            {
                                                <span class="small text-muted">Saving…</span>
                                            }
                                        </Actions>
                                    </CharacterLookPanel>
                                }
                                else if (_pictureRoute == PictureRoute.Book)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small fw-semibold">Guide from book pictures</span>
                                        <button type="button" class="btn btn-link btn-sm text-muted p-0"
                                                @onclick="() => { _showBookCandidateGallery = false; ChoosePictureRoute(PictureRoute.Choose); }">← Routes</button>
                                    </div>
                                    <p class="small text-muted mb-2">
                                        Select up to 3 illustrations that look like this character, then generate portraits guided by those pages.
                                    </p>
                                    @if (!_showBookCandidateGallery && !_selected.BookRefs.Any(b => b.Exists))
                                    {
                                        <button type="button" class="btn btn-primary btn-sm"
                                                disabled="@(_busy || JobRunning)"
                                                @onclick="ToggleBookCandidateGalleryAsync">
                                            Browse book pictures…
                                        </button>
                                    }
                                    @if (_selected.BookRefs.Any(b => b.Exists))
                                    {
                                        <div class="d-flex flex-wrap gap-2 mb-2">
                                            @foreach (var b in _selected.BookRefs.Where(x => x.Exists))
                                            {
                                                var bi = b.Index ?? 0;
                                                var src = !string.IsNullOrEmpty(b.Url)
                                                    ? CacheBust(b.Url!)
                                                    : CacheBust(Engine.CharacterBookRefUrl(_projectId, _selected.Key, bi));
                                                <div class="char-seed-tile-wrap">
                                                    <div class="char-seed-tile char-seed-tile--on">
                                                        <img src="@src" alt="Book" />
                                                        <span class="char-seed-tile__label">Book</span>
                                                    </div>
                                                    <button type="button" class="char-seed-hide" title="Remove"
                                                            disabled="@(_busy || JobRunning)"
                                                            @onclick="@(() => RequestDeleteImage("bookref", bi))">×</button>
                                                </div>
                                            }
                                        </div>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    disabled="@(_busy || JobRunning)"
                                                    @onclick="ToggleBookCandidateGalleryAsync">
                                                Change book picks
                                            </button>
                                            <button type="button" class="btn btn-primary btn-sm"
                                                    disabled="@(_busy || JobRunning)"
                                                    @onclick="StartBookGuidedGenerateAsync">
                                                Generate 3 looks from book
                                            </button>
                                        </div>
                                    }

                                    @if (_showBookCandidateGallery)
                                    {
                                        <div class="border border-secondary border-opacity-50 rounded p-3 mt-3 bg-dark bg-opacity-75 text-white shadow-sm">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <strong class="small text-light">Book pictures for @_selected.DisplayName</strong>
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        @onclick="() => _showBookCandidateGallery = false">✕</button>
                                            </div>
                                            @if (_loadingBookCandidates)
                                            {
                                                <div class="small text-muted py-2">Scanning book illustrations…</div>
                                            }
                                            else if (_rankedBookCandidates is null || _rankedBookCandidates.Count == 0)
                                            {
                                                <div class="small text-muted py-2">No book illustration candidates found for this project.</div>
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-wrap gap-2 py-2" style="max-height: 320px; overflow-y: auto;">
                                                    @foreach (var cand in _rankedBookCandidates)
                                                    {
                                                        var isSel = _selectedBookCandidatePaths.Contains(cand.PathRel, StringComparer.OrdinalIgnoreCase);
                                                        <div class="border rounded p-1 text-center bg-dark"
                                                             style="width: 110px; cursor: pointer; border-color: @(isSel ? "#6366f1" : "#374151"); background: @(isSel ? "rgba(99, 102, 241, 0.25)" : "#151922");"
                                                             @onclick="() => ToggleBookCandidateSelection(cand.PathRel)">
                                                            <div class="position-relative mb-1" style="height: 100px; background: #000; overflow: hidden; border-radius: 4px;">
                                                                <img src="@cand.Url" alt="@cand.Name" style="width: 100%; height: 100%; object-fit: contain;" />
                                                                @if (isSel)
                                                                {
                                                                    <span class="badge bg-primary position-absolute top-0 end-0 m-1">✓</span>
                                                                }
                                                            </div>
                                                            <div class="small text-truncate text-light fw-semibold" style="font-size: 0.72rem;">@(cand.Page > 0 ? $"Page {cand.Page}" : cand.Name)</div>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary border-opacity-50">
                                                    <span class="small text-muted">@_selectedBookCandidatePaths.Count of 3 selected</span>
                                                    <button type="button" class="btn btn-sm btn-success"
                                                            disabled="@(_busy || _savingBookRefs || _selectedBookCandidatePaths.Count == 0)"
                                                            @onclick="ApplySelectedBookCandidatesAsync">
                                                        @(_savingBookRefs ? "Saving…" : "Use selected")
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else if (_pictureRoute == PictureRoute.Upload)
                                {
                                    @* Upload is one-shot via InputFile on route cards; this branch is a fallback *@
                                    <label class="btn btn-primary btn-sm mb-0">
                                        Choose photo…
                                        <InputFile OnChange="OnUploadRefAsync"
                                                   accept=".png,.jpg,.jpeg,.webp,.gif"
                                                   class="d-none"
                                                   disabled="@(_busy || JobRunning)" />
                                    </label>
                                    <button type="button" class="btn btn-link btn-sm" @onclick="() => ChoosePictureRoute(PictureRoute.Choose)">← Routes</button>
                                }
                            }

                            @if (ShowVoiceFields(_selected))
                            {
                                <hr class="my-3" />
                                <div class="char-voice-inline" data-testid="char-voice-section">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                        <div>
                                            <strong class="small">Voice</strong>
                                            <span class="badge text-bg-secondary ms-1" style="font-size:0.65rem">optional</span>
                                        </div>
                                        @if (HasVoiceProfile(_selected))
                                        {
                                            <span class="badge text-bg-success" style="font-size:0.65rem">Profile set</span>
                                        }
                                        else if (_selected.HasVoiceCloneSample)
                                        {
                                            <span class="badge text-bg-info text-dark" style="font-size:0.65rem">Clone sample</span>
                                        }
                                    </div>
                                    <p class="small text-muted mb-2">
                                        Describe the voice style, or record a clone sample below.
                                    </p>
                                    @RenderVoiceEditor()
                                </div>
                            }
                            else
                            {
                                <hr class="my-3" />
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2" data-testid="char-voice-hidden-hint">
                                    <p class="small text-muted mb-0">
                                        No voice profile — optional (e.g. animal / non-speaking).
                                    </p>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => _forceShowVoice = true">
                                        Add voice…
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (_deleteConfirm is not null)
                {
                    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2 py-2">
                        <span class="small">Delete this picture?</span>
                        <button type="button" class="btn btn-sm btn-danger" disabled="@_busy" @onclick="ConfirmDeleteImageAsync">Delete</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="CancelDeleteImage">Cancel</button>
                    </div>
                }
            }
        </div>
    </div>
}
} @* end CanCharacters gate *@

@code {
    // RenderVoiceEditor stays here (not in Characters.razor.cs) - it uses inline
    // markup via a RenderFragment lambda, which only compiles via the Razor compiler.
    private RenderFragment RenderVoiceEditor() => __builder =>
    {
        @* Simple path (home → library book → your voice): only the clone card.
           Full cast keeps label/profile + film voice preview for prompt style. *@
        @if (!_simpleMode)
        {
            <CharacterVoicePanel VoiceLabel="@_editVoiceLabel"
                                 VoiceLabelChanged="OnVoiceLabelChanged"
                                 VoiceProfile="@_editVoiceProfile"
                                 VoiceProfileChanged="OnVoiceProfileChanged"
                                 Busy="@(_busy || _voicePreviewBusy || VoiceJobRunning)"
                                 Hint="@(_voiceSaveHint ?? "Profile saves automatically")"
                                 Error="@_voicePreviewError"
                                 TestId="char-voice-panel">
                <Actions>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            disabled="@(_busy || _voicePreviewBusy || VoiceJobRunning)"
                            title="Play cached sample, or generate a short film clip if missing"
                            @onclick="() => PlayVoicePreviewAsync(force: false)">
                        ▶ Play
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            disabled="@(_busy || _voicePreviewBusy || VoiceJobRunning)"
                            title="Always regenerate after editing the profile"
                            @onclick="() => PlayVoicePreviewAsync(force: true)">
                        Regenerate
                    </button>
                </Actions>
            </CharacterVoicePanel>
            @if (VoiceJobRunning && _job is not null)
            {
                <JobProgressCard Status="@_job.Status"
                                 Message="@(_job.Message ?? "Generating voice…")"
                                 Index="_job.Index"
                                 Total="_job.Total"
                                 Kind="@_job.Kind"
                                 TestId="char-voice-job"
                                 CssClass="mt-2 mb-0" />
            }
            @if (!string.IsNullOrEmpty(_voicePreviewHint))
            {
                <div class="form-text mt-1">@_voicePreviewHint</div>
            }
            @if (_voicePreviewStale && !VoiceJobRunning)
            {
                <div class="form-text text-warning mt-1">Profile changed — Regenerate to hear the new voice.</div>
            }
            @if (!string.IsNullOrEmpty(_voicePreviewUrl) && !VoiceJobRunning)
            {
                <video class="mt-2 w-100 rounded border" style="max-height: 240px; background: #000;"
                       controls autoplay playsinline src="@_voicePreviewUrl" @key="_voicePreviewUrl"></video>
            }

            <hr class="my-3" />
        }
        @* Mic capture is always available (sample stays on the client).
           Provider key is only required later when applying the clone while filming. *@
        <div class="ptm-voice-clone" data-testid="voice-clone-gate">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <div>
                    <strong class="small">@(_simpleMode ? "Your voice" : "Voice sample")</strong>
                </div>
                @if (_selected?.HasVoiceCloneSample == true)
                {
                    <span class="badge text-bg-success" style="font-size:0.65rem">Ready</span>
                }
            </div>
            @if (!Caps.VoiceCloneReady)
            {
                <InlineAlert Variant="warning" CssClass="py-2 small mb-2" data-testid="voice-clone-setup-hint">
                    <div class="mb-1">@Caps.VoiceCloneBlockedReason</div>
                    <a class="alert-link" href="@Caps.VoiceCloneSettingsHref">Open Settings →</a>
                    <div class="text-muted mt-1 mb-0">
                        You can still record a sample now — the key is only needed when we apply your voice to the film.
                    </div>
                </InlineAlert>
            }
            <p class="form-text mb-2">@(_simpleMode ? "Record a short sample for the narrator." : "Record a short sample for cloning.")</p>
            <div class="ptm-voice-script border border-secondary border-opacity-50 rounded p-2 mb-2 bg-dark bg-opacity-25"
                 data-testid="voice-clone-script">
                <div class="small fw-semibold text-info mb-1">
                    @(_useKidsScript ? "Read this aloud (story voice)" : "Read this aloud")
                </div>
                @if (_useKidsScript)
                {
                    <div class="small text-muted mb-1">Coach: smile, warm energy; soft on the bedtime ending — don't read stage directions.</div>
                }
                <p class="mb-0 small lh-sm" style="white-space: pre-wrap;">@VoiceCloneReadScript</p>
                @if (_useKidsScript)
                {
                    <button type="button" class="btn btn-link btn-sm px-0 mt-1"
                            @onclick="() => _showKidsFullScript = !_showKidsFullScript">
                        @(_showKidsFullScript ? "Hide longer kids script" : "Longer kids script (richer clone)")
                    </button>
                    @if (_showKidsFullScript)
                    {
                        <p class="mb-0 small lh-sm mt-1 text-muted" style="white-space: pre-wrap;">@VoiceCloneScripts.KidsFull</p>
                    }
                }
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                @if (!_voiceRecRecording)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            disabled="@(_busy || _voiceCloneBusy || VoiceJobRunning)"
                            @onclick="StartVoiceCloneMicAsync"
                            data-testid="voice-clone-mic-start">
                        Record
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-danger"
                            disabled="@_voiceCloneBusy"
                            @onclick="StopVoiceCloneMicAsync"
                            data-testid="voice-clone-mic-stop">
                        Done
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            disabled="@_voiceCloneBusy"
                            @onclick="CancelVoiceCloneMicAsync">
                        Cancel
                    </button>
                    <span class="small text-danger">Recording…</span>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        disabled="@(_busy || _voiceCloneBusy || VoiceJobRunning)"
                        @onclick="OpenMediaFolderAudioPickerAsync"
                        data-testid="voice-clone-from-folder">
                    Use existing audio
                </button>
                @if (_selected?.HasVoiceCloneSample == true)
                {
                    <button type="button" class="btn btn-sm btn-primary"
                            disabled="@(_busy || _voiceCloneBusy || VoiceJobRunning)"
                            @onclick="ApplyVoiceCloneToProviderAsync"
                            data-testid="voice-clone-apply">
                        @(_voiceCloneBusy ? "Applying…" : "Apply voice")
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            disabled="@(_busy || _voiceCloneBusy)"
                            @onclick="DeleteVoiceCloneSampleAsync">
                        Remove sample
                    </button>
                }
            </div>
            @if (_showMediaAudioPicker)
            {
                <div class="border border-secondary border-opacity-50 rounded p-2 mt-2 bg-dark bg-opacity-50"
                     data-testid="voice-clone-folder-picker">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="small">Your audio files</strong>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0"
                                @onclick="() => _showMediaAudioPicker = false">✕</button>
                    </div>
                    @if (_loadingMediaAudio)
                    {
                        <div class="small text-muted">Scanning folder…</div>
                    }
                    else if (_mediaAudioFiles.Count == 0)
                    {
                        <div class="small text-muted mb-2">No audio files found yet.</div>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                @onclick="OpenMediaFolderAudioPickerAsync">Refresh</button>
                    }
                    else
                    {
                        <div class="list-group list-group-flush" style="max-height: 220px; overflow-y: auto;">
                            @foreach (var f in _mediaAudioFiles)
                            {
                                <button type="button"
                                        class="list-group-item list-group-item-action list-group-item-dark py-1 px-2 small text-start"
                                        disabled="@(_busy || _voiceCloneBusy)"
                                        @onclick="@(() => PickMediaFolderAudioAsync(f))">
                                    <span class="text-truncate d-block">@f.Name</span>
                                    <span class="text-muted" style="font-size:0.7rem;">@f.RelativePath · @(Math.Max(1, f.SizeBytes / 1024)) KB</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(_voiceCloneHint))
            {
                <div class="form-text">@_voiceCloneHint</div>
            }
            @if (!string.IsNullOrEmpty(_voiceCloneError))
            {
                <InlineAlert Message="@_voiceCloneError" CssClass="py-1 small mb-0" />
            }
            @if (!string.IsNullOrEmpty(_voiceClonePlayUrl))
            {
                <audio class="mt-2 w-100" controls src="@_voiceClonePlayUrl" @key="_voiceClonePlayUrl"></audio>
            }
        </div>

    };
}
