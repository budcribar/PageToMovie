@page "/characters"
@implements IAsyncDisposable
@inject EngineApiClient Engine
@inject StudioCapabilityState Caps
@inject JobHubClient Hub
@inject AdminSessionService Session
@inject ActiveProjectState ActiveProject
@inject ClientMediaFolderService MediaFolder
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject IAppLocalizer L
@using PageToMovie.Core.Models
@using PageToMovie.Web.Services
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@L["Nav.Cast"]</PageTitle>

<StudioPageHeader Kicker="@(List._simpleMode ? "Simple · your voice" : "Studio · Step 4 · Cast")"
                   Title="@(List._simpleMode ? L["CharactersPage.NarratorVoice"] : L["Nav.Cast"])" LedeClass="mb-1">
    <ChildContent>
        @if (List._simpleMode)
        {
            <text>Record one sample for the narrator. Library pictures stay as-is — we only re-voice the lines. Want faces of family? Use full studio.</text>
        }
        else
        {
            <text>@L["CharactersPage.Subtitle"]</text>
        }
    </ChildContent>
    <Actions>
        @if (List.IsCastComplete)
        {
            @if (ActiveProject.CanScenes)
            {
                <a class="btn btn-success btn-sm" data-testid="characters-to-locations" href="locations">@L["CharactersPage.ToLocations"]</a>
            }
            else
            {
                <a class="btn btn-success btn-sm" data-testid="characters-to-shots" href="adaptation/shots">@L["CharactersPage.BuildShotPlan"]</a>
            }
        }
        <div data-testid="characters-status"
             data-cast-complete="@(List.IsCastComplete ? "true" : "false")"
             data-has-cast="@(List.HasCast ? "true" : "false")"
             class="visually-hidden"
             aria-hidden="true"></div>
    </Actions>
</StudioPageHeader>

@if (StudioDeepLinks.FilmReturnHref(Nav) is { } filmReturn)
{
    <div class="alert alert-info py-2 small mb-2 d-flex flex-wrap align-items-center justify-content-between gap-2" data-testid="cast-return-film">
        <span>@L["CharactersPage.EditingFromFilm"]</span>
        <a class="btn btn-sm btn-primary" href="@filmReturn" data-testid="cast-return-film-go">@L["Adaptation.BackToFilm"]</a>
    </div>
}


@if (List._simpleMode)
{
    <div class="alert alert-primary border-primary border-opacity-50 py-2 small mb-2" data-testid="simple-voice-banner">
        <strong>Simple path.</strong>
        Pick the narrator (or lead), record the script below, then go to
        <a href="cost" class="alert-link">Estimate</a> or
        <a href="scenes" class="alert-link">Film</a>.
        <button type="button" class="btn btn-link btn-sm p-0 align-baseline alert-link" @onclick="List.ExitSimplePathAsync">Exit simple → full cast</button>
        @if (_easyStartAvailable)
        {
            <text> · </text>
            <a href="simple-voice" class="alert-link">Library books</a>
        }
    </div>
}

@* Full studio: cast is craft under Edit — highlight Estimate; simple path still uses cast step *@
<StudioProcessStrip Active="cast" SimpleMode="@List._simpleMode" FullStudio="@(!List._simpleMode)" />

@if (_gateChecked && !ActiveProject.CanCharacters)
{
    <ReadinessGateBanner Visible="true"
                         Reason="@ActiveProject.CharactersBlockedReason"
                         FallbackReason="Approve the screenplay first."
                         ActionHref="adaptation/screenplay"
                         ActionLabel="Open screenplay →" />
}
else
{
@* Setup actions only when needed — hide once cast exists / book pictures are matched *@
@if (List.NeedsCastBuild)
{
    <div class="mb-2">
        <button type="button"
                class="btn btn-primary btn-sm"
                data-testid="characters-extract-cast"
                disabled="@(_busy || Jobs.JobRunning || List._extractingCast)"
                title="One step: names + looks from screenplay and book (when present)"
                @onclick="List.ExtractCastAsync">
            @(List._extractingCast ? L["CharactersPage.BuildingCast"] : L["CharactersPage.BuildCast"])
        </button>
        <span class="small text-muted ms-2">Screenplay + book → names, voices, and portrait-ready looks</span>
    </div>
}
else if (List.HasCast && !Jobs.JobRunning && !List._extractingCast)
{
    @if (!List.PlanLooksAlreadyDone)
    {
    <div class="mb-2 d-flex flex-wrap align-items-center gap-2">
        <button type="button"
                class="btn btn-primary btn-sm"
                data-testid="characters-plan-looks"
                disabled="@(_busy || Jobs.JobRunning)"
                title="Generate 3 looks for each used-in-plan face and place, AI locks the best. You can re-lock anytime."
                @onclick="Jobs.StartPlanLooksAsync">
            @L["CharactersPage.GenerateLooksForPlan"]
        </button>
        <span class="small text-muted">Used cast + places · 3 options each · AI auto-locks best (override anytime)</span>
    </div>
    }
    @if (Session.IsAdmin)
    {
        @* Admin-only redo. These are NOT the same step:
           • Rebuild cast — AI re-reads Fountain (+ book) and replaces character_seed_tokens (names, looks, voices, locations).
           • Re-match book pictures — only re-sorts book plates onto the existing cast; does not change who is in the cast. *@
        <details class="mb-2">
            <summary class="small text-muted" style="cursor:pointer">@L["CharactersPage.SetupAgainAdmin"]</summary>
            <div class="d-flex flex-column gap-2 mt-2" style="max-width: 36rem;">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-testid="characters-extract-cast"
                            disabled="@_busy"
                            title="AI: re-read screenplay + book and rebuild the cast list, looks, and location seeds. Overwrites cast_seeds.json."
                            @onclick="List.ExtractCastAsync">
                        @L["CharactersPage.RebuildCastFromScreenplay"]
                    </button>
                    <span class="small text-muted">Replaces who is in the cast and their text looks</span>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            disabled="@_busy"
                            title="Vision: re-match book illustration pages to the current cast. Does not add/remove characters."
                            @onclick="LookBook.StartSortCharacterPlatesAsync">
                        @L["CharactersPage.RematchBookPictures"]
                    </button>
                    <span class="small text-muted">Keeps the cast list; only re-assigns book plates</span>
                </div>
            </div>
        </details>
    }
}

@if (LookPipe._styleRejectCandidate is not null && !Jobs.JobRunning)
{
    @* Style classifier flagged a mismatch — but the creator's intent wins. Two-step: pick WHY you're
       overriding (feeds the AI feedback loop: a wrong verdict is a defect to tune; a creative choice
       is the classifier working as intended), then the look locks. Dismiss keeps the verdict. *@
    <div class="alert alert-warning" data-testid="char-style-override">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
            <div>
                <strong>@L["CharactersPage.StyleMismatchProject"]</strong>
                <div class="small">@LookPipe._styleRejectMessage</div>
                <div class="small mt-1">@L["CharactersPage.TellUsWhyOverride"]</div>
            </div>
            <button type="button" class="btn-close" aria-label="@L["CharactersPage.DismissStyleSuggestion"]"
                    data-testid="char-style-override-dismiss"
                    @onclick="LookPipe.DismissStyleReject"></button>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-2">
            <button type="button" class="btn btn-sm btn-warning fw-semibold"
                    data-testid="char-override-ai-wrong"
                    disabled="@_busy"
                    @onclick='() => LookPipe.LockCandidateAsync(LookPipe._styleRejectCandidate, overrideStyle: true, overrideReason: "ai_wrong")'>
                @L["CharactersPage.CheckIsWrong"]
            </button>
            <button type="button" class="btn btn-sm btn-warning fw-semibold"
                    data-testid="char-override-preference"
                    disabled="@_busy"
                    @onclick='() => LookPipe.LockCandidateAsync(LookPipe._styleRejectCandidate, overrideStyle: true, overrideReason: "user_preference")'>
                @L["CharactersPage.CreativeChoice"]
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-testid="char-override-other"
                    disabled="@_busy"
                    @onclick='() => LookPipe.LockCandidateAsync(LookPipe._styleRejectCandidate, overrideStyle: true, overrideReason: "other")'>
                @L["CharactersPage.OtherReason"]
            </button>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(_error) && !Jobs.JobRunning)
{
    <InlineAlert Message="@_error" />
}
@* One outcome surface: success flash, not a second “ready” next to the header next button *@
@if (!string.IsNullOrEmpty(_message) && !List._extractingCast && !Jobs.JobRunning && !List.IsCastComplete)
{
    <InlineAlert Message="@_message" Variant="success" />
}
@if (Session.IsAdmin && List._lastCastExtractKeys is { Count: > 0 } && !List._extractingCast)
{
    <div class="alert alert-secondary py-2 small mb-3">
        <strong>Admin · last cast extract</strong>
        · @List._lastCastExtractKeys.Count:
        <code class="user-select-all">@string.Join(", ", List._lastCastExtractKeys)</code>
    </div>
}

@* In-progress: busy shimmer (not a fake % bar that looks done at 100% or stuck at 30%). *@
@if (List._extractingCast)
{
    <div class="card mb-3 border-primary" data-testid="characters-building-cast">
        <div class="card-body py-3">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></div>
                <div class="small fw-semibold">
                    @(List._rebuildCastHadExisting ? L["CharactersPage.RebuildingCast"] : L["CharactersPage.BuildingCast"])
                </div>
            </div>
            <div class="progress progress-busy" style="height: 0.35rem;"
                 role="progressbar"
                 aria-valuetext="in progress"
                 aria-label="@(List._rebuildCastHadExisting ? "Rebuilding cast" : "Building cast")">
                <div class="progress-busy__shine" aria-hidden="true"></div>
            </div>
            <div class="form-text mt-2 mb-0">
                Reading screenplay and book for names and looks.
            </div>
        </div>
    </div>
}
else if (Jobs._job is not null &&
     (Jobs._job.Kind is "character" or "character_variants" or "character-plates" or "voice-preview" or "cast-extract" or "plan_looks") &&
     (Jobs._job.Status is "running" or "queued" or "partial"))
{
    var voiceDetail = !string.IsNullOrEmpty(Jobs._job.Message)
        && string.Equals(Jobs._job.Kind, "voice-preview", StringComparison.OrdinalIgnoreCase)
            ? Jobs._job.Message
            : null;
    <JobProgressCard @key="Jobs._job.JobId"
                     Status="@Jobs._job.Status"
                     Message="@CharactersJobs.FriendlyCharacterJobStatus(Jobs._job)"
                     Index="Jobs._job.Index"
                     Total="Jobs._job.Total"
                     DetailMessage="@voiceDetail"
                     ShowCancel="true"
                     CancelDisabled="false"
                     OnCancel="Jobs.CancelAsync"
                     Kind="@Jobs._job.Kind"
                     StartedAt="Jobs._job.StartedAt"
                     ShowLog="Session.IsAdmin"
                     LogLines="Jobs._job.Log"
                     TestId="characters-job" />
}

@if (List._chars is null)
{
    <EmptyState Message="@L["Common.Loading"]" CssClass="text-muted" />
}
else if (List._extractingCast)
{
    <span class="visually-hidden" data-testid="characters-extracting">Updating cast</span>
}
else if (!List.HasCast)
{
    <InlineAlert Variant="warning" Message="@L["CharactersPage.NoCastYet"]"
                 data-testid="characters-empty" />
}
else if (List.OperatorCastCount == 0)
{
    @* Cast exists but is entirely ensemble/crowd roles — those need no individual portraits, so the
       operator roster below is empty. Acknowledge the cast instead of the misleading "No cast yet". *@
    <div class="alert alert-info" data-testid="characters-all-ensembles">
        The speaking cast here are all ensemble roles
        (@string.Join(", ", List._chars.Where(c => c.IsGroup).Select(c => c.DisplayName))) —
        no individual portraits needed. You can continue to the next step.
    </div>
}
else
{
    <div class="row">

    <CascadingValue Value="this" IsFixed="true">
    <CascadingValue Value="List" IsFixed="true">
    <CascadingValue Value="Jobs" IsFixed="true">
    <CascadingValue Value="LookPipe" IsFixed="true">
    <CascadingValue Value="LookEdit" IsFixed="true">
    <CascadingValue Value="LookBook" IsFixed="true">
    <CascadingValue Value="Voice" IsFixed="true">

        <CharactersCastList />
        <div class="col-12 col-md-8 col-lg-9">
            @if (List._selected is null)
            {
                <p class="text-muted">
                    @(List._simpleMode
                        ? "Pick the narrator (or lead) on the left, then record your sample."
                        : L["CharactersPage.ClickCharacterIndex"])
                </p>
            }
            else if (List._simpleMode)
            {
                @* Simple path: voice first — no picture routing required to reach Record. *@
                <div class="card mb-3 border-primary border-opacity-50" data-testid="simple-voice-card">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span class="fw-semibold">@List._selected.DisplayName · voice sample</span>
                        <span class="badge text-bg-primary">Simple · your voice</span>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted mb-3">
                            Record (or pick) one sample for this character. Library pictures stay as-is — we re-speak lines in your voice when you film.
                        </p>
                        @VoiceEditorUI()
                    </div>
                </div>
                <p class="small text-muted mb-0">
                    Want to change looks later?
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="List.ExitSimplePathAsync">@L["CharactersPage.SwitchToFullCast"]</button>
                </p>
            }
            else if (List._selected.VoiceOnly)
            {
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><code>@List._selected.Key</code> — @List._selected.DisplayName</span>
                        <span class="badge bg-secondary">voice-only (no image)</span>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted mb-3">
                            <strong>Voice style</strong> — used when this character speaks (for example narrator voice-over).
                        </p>
                        @VoiceEditorUI()
                    </div>
                </div>
            }
            else if (List._selected.IsGroup)
            {
                // Groups are filtered from the list; clear stale selection.
                List._selectedKey = null;
                List._selected = null;
            }
            else
            {
                @* Name + actions — no middle thumbnail (sidebar already shows look). *@
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <div class="fw-semibold">@List._selected.DisplayName</div>
                    <div class="ms-auto d-flex flex-wrap gap-1">
                        @if (LookPipe._mode != Mode.PickSource)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LookPipe.BackToSource">← Edit</button>
                        }
                    </div>
                </div>


                <CharactersLookPanel />
                @if (LookPipe._deleteConfirm is not null)
                {
                    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2 py-2">
                        <span class="small">@L["CharactersPage.DeletePictureConfirm"]</span>
                        <button type="button" class="btn btn-sm btn-danger" disabled="@_busy" @onclick="LookPipe.ConfirmDeleteImageAsync">@L["Common.Delete"]</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="LookPipe.CancelDeleteImage">@L["Common.Cancel"]</button>
                    </div>
                }
            }

        </div>
    
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
</CascadingValue>
    </div>
}
} @* end CanCharacters gate *@
