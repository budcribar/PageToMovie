@* Page-local to Scenes — scene detail *@
@inject StudioCapabilityState Caps
@inject AdminSessionService Session
@inject IAppLocalizer L
@inject ClientMediaFolderService MediaFolder
@inject EngineApiClient Engine
@using Microsoft.AspNetCore.Components
@using PageToMovie.Core.Models


    <InlineAlert Message="@Host._error" CssClass="mb-3" />
    @if (!Host.JobRunning)
    {
        <InlineAlert Message="@Host._message" Variant="info" CssClass="mb-3" />
    }

    @* Live gen: one compact surface — status + bar + Cancel only (no badges, no Grok dump, no log). *@
    @if (Host.ShowLiveGenProgress && Gen!._job is not null)
    {
        <JobProgressCard Status="@Gen!._job.Status"
                         Message="@Scenes.LiveGenStatusLabel(Gen!._job)"
                         Index="Gen!._job.Index"
                         Total="Gen!._job.Total"
                         Percent="Host.LiveGenProgressPercent(Gen!._job)"
                         ShowCancel="true"
                         CancelDisabled="Host._busy"
                         OnCancel="Host.CancelAsync"
                         Kind="@Gen!._job.Kind"
                         TestId="scenes-gen-progress"
                         CancelTestId="scenes-gen-cancel" />
    }
    else if (Host.ShowOperatorGenPartial && Gen!._job is not null)
    {
        <Scenes_GenPartialAlert />
    }
    else if (Host.ShowOperatorGenError && Gen!._job is not null)
    {
        <Scenes_GenErrorAlert />
    }
    else if (Session.IsAdmin && Gen!._job is not null &&
             (Gen!._job.Status is "done" or "partial" or "error" or "cancelled"))
    {
        @* Admin: finished-job summary only — no live log dump (that belonged under generating). *@
        <div class="card mb-3 border-@(Gen!._job.Status == "error" ? "danger" : Gen!._job.Status == "partial" ? "warning" : "secondary")">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="small">@(Gen!._job.Message ?? Gen!._job.Status)</span>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@Host._busy" @onclick="Host.ReloadListAsync">Refresh list</button>
                </div>
                @if (Gen!._job.Log.Count > 0)
                {
                    <button type="button"
                            class="btn btn-sm btn-link text-muted p-0 mt-1 text-decoration-none"
                            @onclick="() => Gen!._showAdminJobLog = !Gen!._showAdminJobLog">
                        @(Gen!._showAdminJobLog ? "Hide details" : "Details (admin)")
                    </button>
                    @if (Gen!._showAdminJobLog)
                    {
                        <pre class="small mb-0 mt-1" style="max-height: 120px; overflow: auto;">@string.Join("\n", Gen!._job.Log.TakeLast(20))</pre>
                    }
                }
            </div>
        </div>
    }

    @* ---- Scene detail ---- *@
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
                <strong>Scene @(List!._detail.SceneNumber.ToString("D2"))</strong>
                — @(List!._detail.Setting is { Length: > 0 } st ? st : "—")
            </span>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button type="button"
                        class="btn btn-sm btn-outline-info"
                        title="View history & changes for this scene"
                        @onclick="() => Host.OpenSceneHistoryAsync(List!._detail.SceneNumber)">
                    📜 History
                </button>
                <div class="d-flex align-items-center gap-1">
                    <label class="small text-muted mb-0" for="genResDetail">Res</label>
                    <select id="genResDetail"
                            class="form-select form-select-sm"
                            style="width:auto"
                            @bind="Gen!._genResolution"
                            @bind:after="Host.RefreshCostEstimateAsync"
                            disabled="@(Host._busy || Host.ResolutionLocked)"
                            title="@(Host.ResolutionLocked ? $"Locked at {List!._resolutionLock} — this project already has clips at that resolution." : null)">
                        <option value="480p">480p</option>
                        <option value="720p">720p</option>
                        <option value="1080p">1080p</option>
                    </select>
                    @if (Host.ResolutionLocked)
                    {
                        <span class="small text-muted" title="Locked to on-disk resolution">🔒</span>
                    }
                </div>
                <button class="btn btn-sm btn-success"
                        disabled="@(Host._busy || Host.JobRunning || (List!._detail.ClipsOnDisk == 0 && !List!._detail.CompositeExists))"
                        title="Play scene (browser stitch from clips)"
                        @onclick="() => Host.PlaySceneCompositeAsync(List!._detail.SceneNumber)">
                    ▶ Play scene
                </button>
                <button class="btn btn-sm btn-outline-secondary"
                        data-testid="clip-add-open"
                        disabled="@(Host._busy || Host.JobRunning)"
                        title="Add a new clip to this scene (define fields, then generate its video)"
                        @onclick="Host.OpenAddClipDialog">
                    + Add clip
                </button>
                @if (List!._detail.ClipsOnDisk > 0)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            disabled="@(Host._busy || Host.JobRunning || Dialogue!._verifyingClip)"
                            title="@(ClipSel!._selectedClips.Count > 0 ? $"Run dialogue & speaker verification on {ClipSel!._selectedClips.Count} selected clip(s)" : "Run dialogue & speaker verification on selected clips in the first column")"
                            @onclick="Host.VerifySelectedScenesDialogueAsync">
                        @(ClipSel!._selectedClips.Count > 0 ? $"🔍 Verify ({ClipSel!._selectedClips.Count}) Selected Clips" : "🔍 Verify Clip Dialogue")
                    </button>
                }
                @* Background music is scored from the All-scenes overview (one control per scene row),
                   since music is a per-scene concern and this view is about the scene's clips. *@
                @if (List!._detail.HasBackgroundMusic)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-info"
                            disabled="@(Host._busy || Host.JobRunning)"
                            title="View past audio takes & compare against the current one"
                            @onclick="() => Host.OpenMusicCompareAsync(List!._detail.SceneNumber)">
                        🎧 Audio Takes
                    </button>
                }
                @if (List!._detail.CompositeExists || List!._detail.ClipsOnDisk > 0)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-info"
                            data-testid="scene-open-external-editor"
                            disabled="@(Host._busy || Host.JobRunning)"
                            title="Open scene video in @Host.ClipRegen._preferredVideoEditor"
                            @onclick="() => Host.OpenInExternalEditorAsync(List!._detail.SceneNumber, ClipForm!._selectedClip)">
                        🎬 Open in @Host.ClipRegen._preferredVideoEditor
                    </button>
                }
                @if (Host.DetailLockedByOther)
                {
                    <span class="badge bg-warning text-dark">🔒 @Host._detailLockOwner</span>
                }
            </div>
        </div>
        <div class="card-body">
            <p class="small text-muted mb-2">
                @List!._detail.ClipsOnDisk/@List!._detail.ClipCount clips on disk
                @if (List!._detail.ActualDurationSeconds is double actD)
                {
                    <span>· <strong class="text-body">@Scenes.FormatClock(actD)</strong> actual</span>
                    @if (List!._detail.PlannedDurationSeconds is double planD)
                    {
                        <span>· plan @Scenes.FormatClock(planD)</span>
                    }
                }
                else if (List!._detail.PlannedDurationSeconds is double planOnly)
                {
                    <span>· plan ~@Scenes.FormatClock(planOnly)</span>
                }
                @if (List!._detail.CharactersOnScreen.Count > 0)
                {
                    <span>· cast: @string.Join(", ", List!._detail.CharactersOnScreen.Select(Scenes.ShortChar))</span>
                }
                @if (!string.IsNullOrEmpty(List!._detail.PrimaryLocationId))
                {
                    <span>· loc: <code>@Scenes.ShortLoc(List!._detail.PrimaryLocationId)</code></span>
                }
                @{
                    var verifiedCount = List!._detail.Clips.Count(c => c.DialogueVerification is { } v && (string.Equals(v.Status, "verified", StringComparison.OrdinalIgnoreCase) || string.Equals(v.Status, "no_speech", StringComparison.OrdinalIgnoreCase)));
                    var totalWithDialogue = List!._detail.Clips.Count(c => !string.IsNullOrWhiteSpace(c.Dialogue));
                }
                @if (totalWithDialogue > 0 && verifiedCount > 0)
                {
                    <span>· <span class="text-success fw-semibold" title="Clips with dialogue verified via native video/audio QA">✓ @verifiedCount/@totalWithDialogue dialogue verified</span></span>
                }
            </p>

            @* Full scene composite — hide while clip selected, remux/gen busy, or full player open *@
            @if (Host.IsSceneGenBusy(List!._detail.SceneNumber))
            {
                <p class="small text-muted mb-2">
                    Scene composite hidden while combining…
                </p>
            }
            else if (Playback!._showScenePlayer && Playback!._playingScene == List!._detail.SceneNumber)
            {
                <p class="small text-muted mb-2">
                    Playing full scene above.
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="Host.HideScenePlayer">Show inline preview</button>
                </p>
            }
            else if (List!._detail.CompositeExists && ClipForm!._selectedClip is null)
            {
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h6 class="text-muted mb-0">Scene composite <span class="small fw-normal">(all clips · full scene)</span></h6>
                        <button class="btn btn-sm btn-link" type="button"
                                @onclick="() => Host.PlaySceneCompositeAsync(List!._detail.SceneNumber)">
                            Play full scene
                        </button>
                    </div>
                    <video controls playsinline
                           style="max-width:100%; max-height:280px; background:#111; border-radius:0.35rem;"
                           src="@(Playback!._sceneCompositeVideoUrl ?? Playback!._sceneCompositeServerUrl)"
                           @key="Playback!._inlineCompositeKey"
                           poster=""></video>
                    <p class="small text-muted mb-0 mt-1">
                        Scene composite on disk (~@(List!._detail.ActualDurationSeconds is double ad ? Scenes.FormatClock(ad) : "?")).
                        Select a clip row below to play one clip only.
                    </p>
                </div>
            }
            else if (List!._detail.CompositeExists && ClipForm!._selectedClip is int)
            {
                <p class="small text-muted mb-2">
                    Viewing single clip — full scene composite hidden.
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => Host.SelectClip(null)">Show scene composite</button>
                </p>
            }

            @{
                var hasMissingClips = List!._detail.Clips.Any(c => !c.OnDisk);
            }
            @if (hasMissingClips || ClipSel!._selectedClips.Count > 0)
            {
                <div class="d-flex align-items-center flex-wrap gap-2 mb-2" data-testid="clip-select-bar">
                    @if (hasMissingClips)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                data-testid="clip-select-missing"
                                disabled="@Host._busy"
                                title="Check clips not yet on disk"
                                @onclick="Host.SelectMissingClips">
                            Select missing
                        </button>
                    }
                    @if (List!._detail.Clips.Any(c => c.DialogueVerification is { Status: "mismatch" } or { Status: "speaker_swap" }))
                    {
                        <button type="button"
                                class="btn btn-sm btn-warning text-black fw-semibold"
                                data-testid="clip-select-mismatched"
                                disabled="@Host._busy"
                                title="Check all clips in this scene with dialogue mismatches or speaker swaps"
                                @onclick="Host.SelectMismatchedClips">
                            Select mismatched (@List!._detail.Clips.Count(c => c.DialogueVerification is { Status: "mismatch" } or { Status: "speaker_swap" }))
                        </button>
                    }
                    @if (ClipSel!._selectedClips.Count > 0)
                    {
                        <span class="small">
                            <strong>@ClipSel!._selectedClips.Count</strong> selected
                            @if (Host.EstimateSelectedClipsCostUsd() is { } scc)
                            {
                                <span class="text-muted">· ~$@(scc.ToString("0.00"))</span>
                            }
                        </span>
                        <button type="button" class="btn btn-sm btn-warning"
                                data-testid="clip-batch-regen"
                                disabled="@(Host._busy || Host.JobRunning || !Host.CastReady || Host.DetailLockedByOther)"
                                title="@(!Host.CastReady
                                    ? Host.CastBlockedTitle
                                    : Host.DetailLockedByOther
                                    ? $"Locked by {Host._detailLockOwner}"
                                    : "Generate (or re-generate) every selected clip")"
                                @onclick="Host.RegenSelectedClipsAsync">
                            Generate selected
                        </button>
                    }
                </div>
            }

                        <Scenes_ClipTable />


        </div>
    </div>

    <Scenes_ClipInspector />
}
