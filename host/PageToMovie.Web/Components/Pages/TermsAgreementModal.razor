@using Microsoft.AspNetCore.Components
@using System.Net.Http
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

@if (IsOpen)
{
    @* Backdrop and panel are siblings — nesting under .modal-backdrop applies opacity to text. *@
    <div class="modal-backdrop fade show" style="z-index: 1050;"></div>
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="terms-title"
         style="z-index: 1055;">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header py-3">
                    <h5 class="modal-title fw-semibold" id="terms-title">Terms of Service</h5>
                </div>
                <div class="modal-body" style="max-height: 55vh;">
                    <div class="alert alert-info py-2 small mb-3">
                        Review and accept these terms before using the studio.
                    </div>

                    <h6 class="fw-semibold mt-2">1. Content &amp; adaptation warranty</h6>
                    <p class="small mb-2">
                        You certify that any screenplay, book text, dialogue, character portrait, or prompt
                        you use is either an original work you own, in the public domain, or duly licensed
                        for adaptation and generation.
                    </p>

                    <h6 class="fw-semibold mt-3">2. Platform non-liability</h6>
                    <p class="small mb-2">
                        PageToMovie is a creation platform. You are responsible for the content you upload
                        and generate; the platform disclaims liability for intellectual property claims
                        arising from user content.
                    </p>

                    <h6 class="fw-semibold mt-3">3. User indemnification</h6>
                    <p class="small mb-2">
                        You agree to indemnify PageToMovie and its operators against third-party claims
                        resulting from your content or adaptations.
                    </p>

                    <h6 class="fw-semibold mt-3">4. Public gallery &amp; forking</h6>
                    <p class="small mb-0">
                        If you publish a demo or mark a project public (forkable), you grant PageToMovie a
                        non-exclusive license to display the film and let others fork the project package
                        inside the product.
                    </p>
                </div>
                <div class="modal-footer flex-column align-items-stretch gap-2 py-3">
                    <label for="termsCheck" class="d-flex align-items-center gap-3 p-3 rounded border border-secondary bg-dark text-white user-select-none" style="cursor: pointer;">
                        <input class="form-check-input flex-shrink-0 m-0"
                               type="checkbox"
                               id="termsCheck"
                               style="width: 1.35rem; height: 1.35rem; cursor: pointer; accent-color: #3b82f6;"
                               @bind="hasAgreed" />
                        <span class="fw-semibold text-white">
                            I have read and agree to the Terms of Service.
                        </span>
                    </label>
                    <button type="button"
                            class="btn btn-primary btn-lg w-100"
                            disabled="@(!hasAgreed || isSubmitting)"
                            @onclick="AcceptTerms">
                        @(isSubmitting ? "Saving…" : "Agree & continue")
                    </button>
                </div>
            </div>
        </div>
    </div>
}
