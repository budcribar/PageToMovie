@inherits PageToMovie.Web.Components.PageSliceComponent
@* Page-local to Scenes — the one Scene Index (sidebar): states, selection toolbar, scene list.
   This is the only overview of the shot plan (the flat all-scenes table was retired 2026-08-18). *@
@inject StudioCapabilityState Caps
@inject AdminSessionService Session
@inject IAppLocalizer L
@inject EngineApiClient Engine
@inject ClientMediaFolderService MediaFolder
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using PageToMovie.Core.Models
@using PageToMovie.Web.Services

@{
    var list = ListState ?? Host.List;
    var scenes = FilteredScenes.ToList();
    var totalCount = list._scenes?.Count ?? 0;
    var completeCount = list._scenes?.Count(s => s.ClipsComplete) ?? 0;
    var missingCount = totalCount - completeCount;
    var selCount = list._selected.Count;
    var canGenerate = (Host.IsSimpleFilm || (selCount > 0 && list.CastReady)) && !Host.Gen.JobRunning;
    var genDisabled = Host._busy || Host.Gen.JobRunning || list.SelectedLockedByOther
                      || (!Host.IsSimpleFilm && (selCount == 0 || !list.CastReady));
    var playSelectedDisabled = Host._busy
        || (Playback?._clientStitching ?? false)
        || !(Playback?.CanPlaySelected ?? false);
    var verifyDialogueDisabled = Host._busy
        || Host.Gen.JobRunning
        || (Dialogue?._verifyingClip ?? false)
        || !(Dialogue?.SelectedScenesHaveClipsToVerify ?? false);
    var checkedSceneWord = selCount == 1 ? "scene" : "scenes";
    var rebuildShotPlanTitle = selCount > 0
        ? $"Regenerate the shot plan for only the {selCount} checked {checkedSceneWord} from the screenplay (others untouched)"
        : "Check the scene(s) to re-plan first — Select all rebuilds the whole shot plan";
}

<div class="col-12 col-md-4 col-lg-3" data-testid="scene-index">
@* Live job progress belongs here whatever the plan looks like. This card used to sit inside the
   "no scenes yet" branch only, so REBUILDING an existing shot plan showed no progress at all in
   the sidebar — and the other copy lives in the scene detail pane, which is not rendered unless a
   scene is open. A rebuild with a plan already present and nothing selected showed nothing. *@
@if (Host.Gen.ShowLiveGenProgress && Host.Gen._job is not null)
{
    <div class="my-3">
        <JobProgressCard Status="@Host.Gen._job.Status"
                         Message="@Scenes.ScenesGeneration.LiveGenStatusLabel(Host.Gen._job)"
                         Index="Host.Gen._job.Index"
                         Total="Host.Gen._job.Total"
                         Percent="Host.Gen.LiveGenProgressPercent(Host.Gen._job)"
                         TestId="scenes-live-progress"
                         CssClass="border-primary shadow-sm" />
    </div>
}
@if (Scenes.ScenesListState.IsSceneListPending(list._scenes))
{
    @* Null list = first load has not finished (or failed). Never treat that as empty. *@
    @if (!string.IsNullOrWhiteSpace(Host._error))
    {
        <EmptyState Message="@($"Could not load scenes: {Host._error}")"
                    ActionHref="scenes"
                    ActionLabel="Retry"
                    CssClass="text-muted" />
    }
    else
    {
        <div class="card p-4 text-center my-3 bg-dark bg-opacity-25 border-secondary border-opacity-25" data-testid="scenes-loading">
            <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
            <h5 class="fw-semibold mb-1">Loading scenes…</h5>
        </div>
    }
}
else if (Scenes.ScenesListState.IsEmptyShotPlan(list._scenes))
{
    @* The running-job card is rendered once above, for every plan state. *@
    @if (Host.Gen.JobRunning && Host.Gen._job is not null && !Host.Gen.ShowLiveGenProgress)
    {
        <div class="my-3">
            <JobProgressCard Status="@Host.Gen._job.Status"
                             Message="@Scenes.ScenesGeneration.LiveGenStatusLabel(Host.Gen._job)"
                             Index="Host.Gen._job.Index"
                             Total="Host.Gen._job.Total"
                             Percent="Host.Gen.LiveGenProgressPercent(Host.Gen._job)"
                             TestId="scenes-live-progress-other"
                             CssClass="border-primary shadow-sm" />
        </div>
    }
    else if (Host._busy)
    {
        <div class="card p-4 text-center my-3 bg-dark bg-opacity-25 border-secondary border-opacity-25" data-testid="scenes-empty-shotplan">
            <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
            <h5 class="fw-semibold mb-1">Building shot plan…</h5>
            <p class="text-muted small mb-0">Converting your approved screenplay into scenes and clips.</p>
        </div>
    }
    else
    {
        <div class="card p-4 text-center my-3 bg-dark bg-opacity-25 border-secondary border-opacity-25" data-testid="scenes-empty-shotplan">
            <h5 class="fw-semibold mb-1">No shot plan yet</h5>
            <p class="text-muted small mb-3">Build the shot plan to convert your approved screenplay into scenes and clips.</p>
            <div>
                <button type="button"
                        class="btn btn-primary fw-semibold"
                        disabled="@Host._busy"
                        @onclick="list.RebuildShotPlanAsync"
                        data-testid="scenes-build-shotplan-btn">
                    Build shot plan
                </button>
            </div>
        </div>
    }
}
else
{
    @* ---- Summary line ---- *@
    <div class="small text-muted mb-2 px-1 d-flex flex-wrap align-items-center justify-content-between gap-1" data-testid="scene-index-summary">
        <div class="d-flex align-items-center gap-1">
            <span>@totalCount @(totalCount == 1 ? "scene" : "scenes")</span>
            <span>·</span>
            <span class="text-success">@completeCount ready</span>
            @if (missingCount > 0)
            {
                <span>·</span>
                <span class="text-warning">@missingCount missing</span>
            }
        </div>
        <div class="d-flex flex-wrap align-items-center gap-1">
            @if (list.CastReady)
            {
                <span class="badge bg-success-subtle text-success border border-success border-opacity-25" style="font-size:0.65rem;" title="Cast looks & voices locked in Cast page">🔒 Cast Locked</span>
            }
            else
            {
                <a href="characters" class="badge bg-warning-subtle text-warning border border-warning border-opacity-50 text-decoration-none" style="font-size:0.65rem;" title="@list.CastBlockedTitle">⚠️ Cast Unlocked →</a>
            }
            @if (list._detail is not null && !string.IsNullOrEmpty(list._detail.PrimaryLocationId))
            {
                @if (list._detail.PrimaryLocationLocked)
                {
                    <span class="badge bg-success-subtle text-success border border-success border-opacity-25" style="font-size:0.65rem;" title="Location set plate locked">🔒 Loc Locked</span>
                }
                else
                {
                    <a href="@($"/locations?loc={Uri.EscapeDataString(list._detail.PrimaryLocationId)}")" class="badge bg-warning-subtle text-warning border border-warning border-opacity-50 text-decoration-none" style="font-size:0.65rem;" title="Lock location set plate on Locations page before generating clips">⚠️ Loc Unlocked →</a>
                }
            }
            @if (list._selectedScene is not null)
            {
                <button type="button"
                        class="btn btn-link btn-sm py-0 px-1 text-decoration-none text-info"
                        style="font-size:0.75rem;"
                        data-testid="scene-index-to-history"
                        title="View history & changes for this scene"
                        @onclick="() => History.OpenSceneHistoryAsync(list._selectedScene.Value)">
                    📜 History
                </button>
            }
        </div>
    </div>

    @* ---- Selection + actions ---- *@
    <div class="card mb-2 p-2 bg-dark bg-opacity-25 border-secondary border-opacity-50">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-1">
            <div class="form-check form-check-inline mb-0 small">
                <input class="form-check-input" type="checkbox" id="masterSceneCheck"
                       data-testid="scenes-select-all"
                       checked="@list.AreAllVisibleSelected(scenes)"
                       disabled="@(Host._busy || scenes.Count == 0)"
                       @onchange="e => list.ToggleSelectAllShown(scenes, (bool)(e.Value ?? false))" />
                <label class="form-check-label text-muted" for="masterSceneCheck" style="cursor:pointer;">
                    @(selCount > 0 ? $"{selCount} selected" : L["ScenesPage.SelectAll"])
                </label>
            </div>
            @if (selCount > 0)
            {
                <button type="button" class="btn btn-link btn-sm py-0 px-1 text-muted text-decoration-none small"
                        data-testid="scene-index-clear-selection"
                        @onclick="list.ClearSelection">
                    @L["ScenesPage.ClearSelection"]
                </button>
            }
            else if (scenes.Any(s => !s.ClipsComplete || s.ClipsOnDisk < s.ClipCount))
            {
                <div class="d-flex align-items-center gap-1">
                    <button type="button" class="btn btn-link btn-sm py-0 px-1 text-warning text-decoration-none small"
                            data-testid="scene-index-select-missing"
                            disabled="@Host._busy"
                            title="Select scenes that still need clips"
                            @onclick="list.SelectMissingScenes">
                        @L["ScenesPage.SelectMissing"]
                    </button>
                    <button type="button" class="btn btn-link btn-sm py-0 px-1 text-warning text-decoration-none small"
                            data-testid="scene-index-select-stale"
                            disabled="@Host._busy"
                            title="Select scenes with stale clips"
                            @onclick="list.SelectStaleScenes">
                        @L["ScenesPage.SelectStale"]
                    </button>
                </div>
            }
        </div>

        @* Generate is the primary action; the confirm modal (cost + resolution) is the only way to start a batch. *@
        <CapabilityLockedControl Enabled="@(Host.IsSimpleFilm || Caps.VideoReady)"
                                 BlockedReason="@StudioCapabilityState.VideoBlockedReason"
                                 SettingsHref="@StudioCapabilityState.VideoSettingsHref"
                                 TestId="scenes-generate-batch-cap">
            <button type="button"
                    data-testid="scenes-generate-batch"
                    class="btn batch-go w-100 mb-1 @(canGenerate ? "batch-go--ready" : "")"
                    disabled="@genDisabled"
                    title="@(Host.IsSimpleFilm ? "Put your voice on the existing pictures" : "Generate clips for selected scenes")"
                    @onclick="Host.Gen.OpenGenerateConfirmAsync">
                @* Progress lives in the generation modal (and the card above the scene); the button just disables. *@
                <span class="batch-go__play" aria-hidden="true">▶</span>
                <span>
                    Generate @list.GenerateBatchNoun
                    @if (selCount > 0)
                    {
                        var clipHint = ClipSel?.EstimateSelectedClips() ?? 0;
                        if (clipHint == 0)
                            clipHint = ClipSel?.EstimateSelectedClips(forceAllTakes: true) ?? 0;
                        <span class="batch-go__meta">· ~@clipHint clips</span>
                    }
                </span>
            </button>
        </CapabilityLockedControl>

        @* Selection-scoped actions: always visible so they are discoverable, disabled until a scene is checked. *@
            <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2 flex-grow-1 text-nowrap" style="font-size:0.75rem;"
                        data-testid="scenes-play-selected"
                        disabled="@playSelectedDisabled"
                        title="@PlaySelectedTitle"
                        @onclick="() => Playback?.PlaySelectedAsync() ?? Task.CompletedTask">
                    ▶ @L["ScenesPage.PlaySelected"]@(selCount > 0 ? $" ({selCount})" : "")
                </button>
                <CapabilityLockedControl Enabled="Caps.VideoReviewReady"
                                         BlockedReason="@StudioCapabilityState.VideoReviewBlockedReason"
                                         SettingsHref="@StudioCapabilityState.VideoReviewSettingsHref"
                                         TestId="scenes-verify-dialogue-cap">
                    <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2 text-nowrap" style="font-size:0.75rem;"
                            disabled="@verifyDialogueDisabled"
                            title="@VerifyDialogueTitle"
                            @onclick="() => Dialogue?.VerifySelectedScenesDialogueAsync() ?? Task.CompletedTask">
                        🔍 @L["ScenesPage.VerifySceneDialogue"]@(selCount > 0 ? $" ({selCount})" : "")
                    </button>
                </CapabilityLockedControl>
            </div>

        <div class="input-group input-group-sm">
            <span class="input-group-text bg-dark border-secondary text-muted py-0 px-2">🔍</span>
            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                   placeholder="Filter scenes…"
                   data-testid="scene-index-search"
                   @bind="_filterText"
                   @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_filterText))
            {
                <button class="btn btn-outline-secondary py-0 px-2" type="button" @onclick="() => _filterText = string.Empty">✕</button>
            }
            <button class="btn btn-outline-secondary py-0 px-2" type="button"
                    data-testid="scenes-select-toggle"
                    disabled="@Host._busy"
                    title="Filter by character, location or setting text"
                    @onclick="() => list._showFilters = !list._showFilters">
                @(list.HasActiveFilters ? "Filters •" : "Filters")
            </button>
        </div>

        @* Shot-plan level actions: small and secondary, but present (they used to live only on the retired table view). *@
        <div class="d-flex flex-wrap align-items-center gap-1 mt-2 pt-2 border-top border-secondary border-opacity-50 small">
            <button type="button" class="btn btn-link btn-sm py-0 px-1 text-decoration-none text-muted"
                    disabled="@(Host._busy || Host.Gen.JobRunning)"
                    title="@rebuildShotPlanTitle"
                    data-testid="scenes-regenerate-selected-scenes"
                    @onclick="list.RegenerateSelectedScenesAsync">
                📝 @L["ScenesPage.RebuildShotPlan"]
            </button>
            <button type="button" class="btn btn-link btn-sm py-0 px-1 text-decoration-none text-muted"
                    data-testid="scenes-add-scene"
                    disabled="@(Host._busy || Host.Gen.JobRunning)"
                    title="Add a new empty scene to the shot plan"
                    @onclick="() => list.AddSceneAsync(false)">
                ➕ @L["ScenesPage.AddScene"]
            </button>
            @if (!Host.Gen.HasCreditsScene)
            {
                <button type="button" class="btn btn-link btn-sm py-0 px-1 text-decoration-none text-muted"
                        data-testid="scenes-add-credits"
                        disabled="@(Host._busy || Host.Gen.JobRunning)"
                        title="Re-add the end-credits scene (normally added automatically)"
                        @onclick="() => list.AddSceneAsync(true)">
                    🎬 @L["ScenesPage.AddCredits"]
                </button>
            }
            @if (!Host.IsSimpleFilm)
            {
                <button type="button" class="btn btn-link btn-sm py-0 px-1 text-decoration-none text-muted"
                        data-testid="scenes-view-screenplay"
                        disabled="@Host._busy"
                        title="Read the current screenplay (view only — does not re-open it)"
                        @onclick="Host.ViewScreenplay">
                    📄 @L["ScenesPage.Screenplay"] @L["ScenesPage.View"]
                </button>
            }
        </div>
    </div>

    @* ---- Scene list ---- *@
    <div class="list-group list-group-flush border rounded scene-index-list"
         style="max-height: 72vh; overflow-y: auto;">
        @{ var shown = scenes; }
        @for (var i = 0; i < shown.Count; i++)
        {
            var s = shown[i];
            var sn = s.SceneNumber;
            var isSel = list._selected.Contains(sn);
            var isActive = list._selectedScene == sn;
            var (pg, pgCls, pgTitle) = Scenes.ScenesListState.SceneProgressGlyph(s);

            <div @key="sn"
                 class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-2 px-2 @(isActive ? "active" : "") @(isSel ? "border-start border-3 border-primary" : "")"
                 style="cursor:pointer;"
                 data-testid="scene-row"
                 data-scene-number="@sn"
                 title="@ItemTitle(s)"
                 draggable="@(CanDragScenes ? "true" : "false")"
                 @ondragstart="() => HandleSceneDragStart(sn)"
                 @ondragover:preventDefault
                 @ondrop="() => HandleSceneDropAsync(sn)"
                 @onclick="() => list.OpenSceneAsync(sn)">

                <span class="flex-shrink-0 text-muted"
                      title="@(CanDragScenes ? "Drag to reorder scenes (renumbers files + screenplay)" : "Reorder is off while filtered or a job runs")"
                      style="cursor:@(CanDragScenes ? "grab" : "default"); letter-spacing:-2px; opacity:.5;">⠿</span>

                <div class="form-check mb-0 flex-shrink-0" @onclick:stopPropagation="true">
                    <input class="form-check-input" type="checkbox"
                           checked="@isSel"
                           disabled="@Host._busy"
                           @onchange="e => list.ToggleSelectAndOpenAsync(sn, (bool)(e.Value ?? false))" />
                </div>

                <div class="flex-shrink-0">
                    <span class="badge @SceneBadgeClass(s) px-1 py-1 rounded">
                        S@(sn.ToString("D2"))
                    </span>
                </div>

                <div class="flex-grow-1 min-w-0" style="line-height:1.2;">
                    <div class="text-truncate small fw-semibold @(isActive ? "text-white" : "")">
                        @(string.IsNullOrWhiteSpace(s.Setting) ? "—" : s.Setting)
                    </div>
                    <div class="d-flex align-items-center gap-1 small text-muted" style="font-size:0.75rem;">
                        <span class="@pgCls" title="@pgTitle">@pg</span>
                        <span class="@Scenes.ScenesListState.ClipsCountClass(s)">@s.ClipsOnDisk/@s.ClipCount</span>
                        @if (s.ActualDurationSeconds is double ad)
                        {
                            <span>· @Scenes.FormatClock(ad)</span>
                        }
                        else if (s.PlannedDurationSeconds is double pd)
                        {
                            <span>· ~@Scenes.FormatClock(pd)</span>
                        }
                        @if (s.LockedByOther)
                        {
                            <span class="badge bg-warning text-dark" style="font-size:0.6rem;" title="Locked by @s.LockOwnerUserId">🔒</span>
                        }
                    </div>
                </div>

                <div class="flex-shrink-0 d-flex align-items-center gap-1" @onclick:stopPropagation="true">
                    @if (s.HasBackgroundMusic)
                    {
                        <span title="Has background music" class="small">🎵</span>
                    }
                    @if (s.CompositeExists)
                    {
                        <span class="badge bg-dark border border-secondary text-muted px-1" style="font-size:0.65rem;">mux</span>
                    }
                </div>
            </div>

            @if (i + 1 < shown.Count && ShouldShowJoin(list, shown, i))
            {
                var incoming = shown[i + 1];
                <ScenesJoinRow @key="@($"join-{incoming.SceneNumber}")"
                                BeforeScene="incoming.SceneNumber"
                                Kind="@(string.IsNullOrWhiteSpace(incoming.IncomingJoinKind) ? "cut" : incoming.IncomingJoinKind)"
                                Card="@incoming.IncomingJoinCard"
                                Disabled="@(Host._busy || Host.Gen.JobRunning)"
                                OnChanged="list.SetSceneJoinAsync" />
            }
        }

        @if (scenes.Count == 0)
        {
            <div class="p-3 small text-muted text-center">
                @if (!string.IsNullOrWhiteSpace(_filterText))
                {
                    <span>No scenes match "@_filterText".</span>
                }
                else if (list.HasActiveFilters)
                {
                    <span>No scenes match the current filters.</span>
                }
                else
                {
                    <span>No scenes in this shot plan.</span>
                }
            </div>
        }
    </div>
}
</div>
