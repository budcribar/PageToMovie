@page "/account/costs"
@inject EngineApiClient Engine
@inject AdminSessionService Session
@inject IAppLocalizer L
@using System.Globalization
@using static PageToMovie.Web.Components.CostFormatting

<PageTitle>@L["Nav.AccountCosts"]</PageTitle>

<StudioPageHeader Kicker="Account · Billing" Title="@L["Nav.AccountCosts"]">
    Everything you’ve spent across every project, by project and by vendor.
</StudioPageHeader>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <a href="cost" class="btn btn-sm btn-outline-secondary" data-testid="account-back">← @L["Nav.Estimate"]</a>
    <button class="btn btn-sm btn-outline-secondary" disabled="@_loading" @onclick="LoadAsync">@L["Common.Refresh"]</button>
</div>

<InlineAlert Message="@_error" />

@if (_loading)
{
    <p class="text-muted">@L["Common.Loading"]</p>
}
else if (_mySpend is null || (_mySpend.ByProject.Count == 0 && _mySpend.ByProvider.Count == 0))
{
    <div class="alert alert-light border">No tracked spend yet.</div>
}
else
{
    var projectSlices = BuildProjectSlices();
    var vendorSlices = BuildVendorSlices();
    var projectTotal = projectSlices.Sum(x => x.Usd);
    var vendorTotal = vendorSlices.Sum(x => x.Usd);

    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <div class="border rounded p-3 h-100">
                <div class="small text-muted text-uppercase">All projects</div>
                <div class="fs-4 fw-semibold" data-testid="account-my-total-charge">@Usd(_mySpend.TotalChargeUsd)</div>
                <div class="small text-muted">List @Usd(_mySpend.TotalListUsd) · @_mySpend.TotalCalls calls</div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="border rounded p-3 h-100">
                <div class="small text-muted text-uppercase">Projects with spend</div>
                <div class="fs-4 fw-semibold">@_mySpend.ByProject.Count(p => p.ChargeUsd > 0)</div>
                <div class="small text-muted">across your account</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @* —— By project —— *@
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="fw-semibold mb-2">By project</div>
                    <div class="row g-3 align-items-center">
                        <div class="col-5 d-flex justify-content-center">
                            <CostPie Segments="@projectSlices.Select(s => new CostPie.Segment(s.Usd, s.Color)).ToList()" Total="@projectTotal" CenterLabel="Total" CenterValue="@Usd(projectTotal)" TestId="account-project-pie" Size="180" AriaLabel="@($"Total by slice")" EmptyText="Nothing yet" />
                        </div>
                        <div class="col-7">
                            <CostLegend Items="@projectSlices.Select(s => new CostLegend.Item(s.Label, s.Usd, s.Color)).ToList()" Total="@projectTotal" />
                        </div>
                    </div>
                    <details class="mt-3" data-testid="account-project-details">
                        <summary class="small fw-semibold text-body" style="cursor:pointer;">Show table</summary>
                        <div class="table-responsive mt-2">
                            <table class="table table-sm mb-0" data-testid="account-my-by-project">
                                <thead>
                                    <tr class="small text-muted">
                                        <th>Project</th>
                                        <th class="text-end">Calls</th>
                                        <th class="text-end">List</th>
                                        <th class="text-end">Charge</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in _mySpend.ByProject.OrderByDescending(x => x.ChargeUsd))
                                    {
                                        <tr class="@(string.Equals(p.ProjectId, _activeProjectId, StringComparison.OrdinalIgnoreCase) ? "table-primary" : "")">
                                            <td>@p.ProjectId</td>
                                            <td class="text-end">@p.Calls</td>
                                            <td class="text-end">@Usd(p.ListUsd)</td>
                                            <td class="text-end">@Usd(p.ChargeUsd)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                </div>
            </div>
        </div>

        @* —— By vendor —— *@
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="fw-semibold mb-2">By vendor</div>
                    <div class="row g-3 align-items-center">
                        <div class="col-5 d-flex justify-content-center">
                            <CostPie Segments="@vendorSlices.Select(s => new CostPie.Segment(s.Usd, s.Color)).ToList()" Total="@vendorTotal" CenterLabel="Total" CenterValue="@Usd(vendorTotal)" TestId="account-vendor-pie" Size="180" AriaLabel="@($"Total by slice")" EmptyText="Nothing yet" />
                        </div>
                        <div class="col-7">
                            <CostLegend Items="@vendorSlices.Select(s => new CostLegend.Item(s.Label, s.Usd, s.Color)).ToList()" Total="@vendorTotal" />
                        </div>
                    </div>
                    <details class="mt-3" data-testid="account-vendor-details">
                        <summary class="small fw-semibold text-body" style="cursor:pointer;">Show table</summary>
                        <div class="table-responsive mt-2">
                            <table class="table table-sm mb-0" data-testid="account-my-by-vendor">
                                <thead>
                                    <tr class="small text-muted">
                                        <th>Vendor</th>
                                        <th class="text-end">Calls</th>
                                        <th class="text-end">List</th>
                                        <th class="text-end">Charge</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var kv in _mySpend.ByProvider.OrderByDescending(kv => kv.Value.TotalChargeUsd > 0 ? kv.Value.TotalChargeUsd : kv.Value.TotalUsd))
                                    {
                                        var charge = kv.Value.TotalChargeUsd > 0 ? kv.Value.TotalChargeUsd : kv.Value.TotalUsd;
                                        var list = kv.Value.TotalListUsd > 0 ? kv.Value.TotalListUsd : kv.Value.TotalUsd;
                                        <tr>
                                            <td>@ProviderLabel(kv.Key)</td>
                                            <td class="text-end">@kv.Value.Count</td>
                                            <td class="text-end">@Usd(list)</td>
                                            <td class="text-end">@Usd(charge)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-semibold">
                                        <td>Total</td>
                                        <td class="text-end">@_mySpend.TotalCalls</td>
                                        <td class="text-end">@Usd(_mySpend.TotalListUsd)</td>
                                        <td class="text-end">@Usd(_mySpend.TotalChargeUsd)</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </div>
}
