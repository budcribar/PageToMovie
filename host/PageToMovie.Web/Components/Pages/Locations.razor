@page "/locations"
@using PageToMovie.Core.Models
@using PageToMovie.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject EngineApiClient Engine
@inject ActiveProjectState ActiveProject
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject ClientMediaFolderService MediaFolder
@implements IDisposable

<PageTitle>Locations — PageToMovie</PageTitle>

<div class="container-fluid py-3" data-testid="locations-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h4 mb-0">Locations</h1>
            <p class="small text-muted mb-0">Set plates for every place in the plan — same flow as Cast: 3 looks, AI picks best, override anytime.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (NeedPlateCount > 0)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        data-testid="locations-restore-media"
                        disabled="@(_busy || _loading || string.IsNullOrWhiteSpace(_projectId))"
                        title="Re-upload locked plates from your connected media folder (assets/locations/*_ref.png) when the server lost them"
                        @onclick="RestorePlatesFromMediaFolderAsync">
                    Restore plates from media folder
                </button>
            }
            <button type="button"
                    class="btn btn-sm btn-primary"
                    data-testid="locations-plan-looks"
                    disabled="@(_busy || string.IsNullOrWhiteSpace(_projectId) || (_job is { Status: "running" or "queued" }))"
                    title="Generate 3 set plates for each used place (and cast faces). AI locks the best."
                    @onclick="StartPlanLooksAsync">
                Generate looks for plan
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="LoadAsync">Refresh</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2" data-testid="locations-error">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-success py-2">@_message</div>
    }

    @if (StudioDeepLinks.FilmReturnHref(Nav) is { } filmReturn)
    {
        <div class="alert alert-info py-2 small mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2" data-testid="locs-return-film">
            <span>Editing from Film — return when you are done (regen the scene if the set plate changed).</span>
            <a class="btn btn-sm btn-primary" href="@filmReturn" data-testid="locs-return-film-go">← Back to Film</a>
        </div>
    }

    @if (_job is { } j && (j.Status is "running" or "queued"))
    {
        <JobProgressCard Status="@j.Status"
                         Message="@(j.Message ?? "")"
                         Index="@j.Index"
                         Total="@j.Total"
                         Kind="@j.Kind"
                         LogLines="@j.Log"
                         ShowLog="true"
                         CssClass="mb-3"
                         TestId="loc-job-panel" />
    }

    @if (string.IsNullOrWhiteSpace(_projectId))
    {
        <div class="text-muted">Select a project on Home first.</div>
    }
    else if (_loading)
    {
        <div class="text-muted">Loading locations…</div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-12 col-md-4 col-lg-3" data-testid="loc-index">
                <div class="d-flex align-items-center justify-content-between gap-1 mb-1 px-1">
                    <span class="small fw-semibold">Places index</span>
                    @if (UnusedInPlanCount > 0)
                    {
                        <button type="button"
                                class="btn btn-link btn-sm py-0 px-1"
                                data-testid="loc-toggle-unused"
                                title="Seeds kept on disk but not used in the current shot plan"
                                @onclick="() => _showUnusedInPlan = !_showUnusedInPlan">
                            @(_showUnusedInPlan
                                ? "Hide unused"
                                : $"Show unused ({UnusedInPlanCount})")
                        </button>
                    }
                </div>
                <div class="small text-muted mb-2 px-1" data-testid="loc-index-summary">
                    <span>@UsedInPlanCount used</span>
                    <span class="mx-1">·</span>
                    <span>@LockedPlateCount locked</span>
                    <span class="mx-1">·</span>
                    <span class="@(NeedPlateCount > 0 ? "text-warning" : "")">@NeedPlateCount need plate</span>
                </div>
                <div class="list-group list-group-flush border rounded loc-index-list" style="max-height: 70vh; overflow: auto;">
                    @foreach (var loc in LocationsForUi)
                    {
                        var key = loc.Key;
                        var active = string.Equals(key, _selectedKey, StringComparison.OrdinalIgnoreCase);
                        var thumb = ListThumbUrl(loc);
                        var isLocked = loc.Locked || loc.HasPreferred;
                        <button type="button"
                                class="list-group-item list-group-item-action loc-list-item text-start d-flex align-items-center gap-2 @(active ? "active" : "") @(!loc.UsedInPlan ? "opacity-75" : "")"
                                data-loc-used="@(loc.UsedInPlan ? "true" : "false")"
                                data-testid="loc-list-item"
                                title="@(!loc.UsedInPlan ? "Not in current shot plan — kept for later" : null)"
                                @onclick="() => SelectAsync(key)">
                            <span class="loc-list-thumb-wrap">
                                @if (thumb is { Length: > 0 })
                                {
                                    <img src="@thumb" alt="" class="loc-list-thumb" />
                                }
                                else
                                {
                                    <span class="loc-list-thumb loc-list-thumb--empty" title="No plate yet" aria-hidden="true">⌂</span>
                                }
                                <span class="loc-list-lock-badge @(isLocked ? "is-locked" : "is-open")"
                                      title="@(isLocked ? "Plate locked" : "No locked plate")"
                                      aria-hidden="true">@(isLocked ? "🔒" : "🔓")</span>
                            </span>
                            <div class="min-w-0 flex-grow-1">
                                <div class="loc-list-name text-uppercase small text-truncate">
                                    @loc.DisplayName
                                    @if (!loc.UsedInPlan)
                                    {
                                        <span class="badge text-bg-secondary ms-1">unused</span>
                                    }
                                </div>
                                <div class="loc-list-meta small">
                                    @(isLocked
                                        ? "Locked"
                                        : loc.Variants.Any(v => v.Exists)
                                            ? $"{loc.Variants.Count(v => v.Exists)} looks"
                                            : "No plate")
                                </div>
                            </div>
                        </button>
                    }
                    @if (!LocationsForUi.Any())
                    {
                        <div class="p-3 small text-muted">No locations yet. Approve a screenplay / rebuild cast so places are seeded.</div>
                    }
                </div>
            </div>
            <div class="col-12 col-md-8 col-lg-9">
                @if (_selected is null)
                {
                    <div class="text-muted border rounded p-4">Select a place from the index to edit its look.</div>
                }
                else
                {
                    var selectedLocked = _selected.Locked || _selected.HasPreferred;
                    <div class="card bg-dark border-secondary">
                        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <span class="fw-bold text-info text-uppercase">@_selected.DisplayName</span>
                            <span class="badge @(selectedLocked ? "text-bg-success" : "text-bg-secondary")"
                                  title="@(selectedLocked ? "Preferred plate is locked for video" : "No preferred plate yet")">
                                @(selectedLocked ? "🔒 Locked" : "🔓 Unlocked")
                            </span>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrWhiteSpace(_plateUrl))
                            {
                                <div class="mb-3" data-testid="loc-locked-plate">
                                    <div class="small text-muted mb-1">Preferred plate</div>
                                    <div class="loc-preferred-frame">
                                        <img src="@_plateUrl" alt="Location plate" class="rounded border border-secondary loc-preferred-preview" />
                                        <span class="loc-plate-lock-icon is-locked" title="Locked preferred plate" aria-label="Locked">🔒</span>
                                    </div>
                                </div>
                            }
                            else if (!_selected.Variants.Any(v => v.Exists))
                            {
                                <div class="alert alert-secondary py-2 small mb-3" data-testid="loc-no-plate-yet">
                                    No set plate yet. Use <strong>Generate looks for plan</strong> (all places + cast) or
                                    <strong>Generate 3 looks</strong> for this place — AI auto-locks the best; you can re-lock anytime.
                                </div>
                            }

                            @if (_selected.Variants.Any(v => v.Exists))
                            {
                                <div class="mb-3" data-testid="loc-variants">
                                    <div class="small fw-semibold mb-1">Pick a set look</div>
                                    <p class="small text-muted mb-2">
                                        Click the lock on a look to make it preferred. AI auto-picks on generate; switch anytime.
                                        To tweak the locked one without rewriting the description, use <strong>Tweak locked plate</strong> below.
                                    </p>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var v in _selected.Variants.Where(x => x.Exists).OrderBy(x => x.Index))
                                        {
                                            var vi = v.Index ?? 1;
                                            var src = KeyFormatting.CacheBust(Engine.LocationVariantUrl(_projectId, _selected.Key, vi));
                                            <div class="loc-variant-tile @(selectedLocked && IsPreferredVariant(vi) ? "is-preferred" : "")">
                                                <button type="button"
                                                        class="loc-variant-frame"
                                                        disabled="@_busy"
                                                        title="@(selectedLocked && IsPreferredVariant(vi) ? $"Look #{vi} is preferred" : $"Use look #{vi} as preferred plate")"
                                                        data-testid="@($"loc-lock-v{vi}")"
                                                        @onclick="() => LockVariantAsync(vi)">
                                                    <img src="@src" alt="Variant @vi" class="loc-variant-img" />
                                                    <span class="loc-plate-lock-icon @(selectedLocked && IsPreferredVariant(vi) ? "is-locked" : "is-open")"
                                                          aria-hidden="true">
                                                        @(selectedLocked && IsPreferredVariant(vi) ? "🔒" : "🔓")
                                                    </span>
                                                    <span class="loc-variant-num">#@vi</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <LocationLookPanel Description="@_editDescription"
                                               DescriptionChanged="OnDescriptionChanged"
                                               VisualLock="@_editVisualLock"
                                               VisualLockChanged="OnVisualLockChanged"
                                               ImageEditInstruction="@_imageEditInstruction"
                                               ImageEditInstructionChanged="OnImageEditChanged"
                                               ShowImageEditInstruction="@(_selected.HasPreferred || _selected.Locked)"
                                               Busy="@_busy"
                                               Hint="@(_saveHint ?? "Description saves automatically.")"

                                               TestId="loc-look-panel">
                                <Actions>
                                    <button type="button" class="btn btn-sm btn-primary"
                                            disabled="@(_busy || (string.IsNullOrWhiteSpace(_editDescription) && string.IsNullOrWhiteSpace(_editVisualLock) && string.IsNullOrWhiteSpace(_imageEditInstruction)))"
                                            data-testid="loc-generate-looks"
                                            @onclick="StartGenerateAsync">
                                        @(string.IsNullOrWhiteSpace(_imageEditInstruction) || !(_selected.HasPreferred || _selected.Locked)
                                            ? "Generate 3 looks"
                                            : "Tweak plate")
                                    </button>
                                    <label class="btn btn-sm btn-outline-primary mb-0">
                                        Upload & lock plate
                                        <InputFile OnChange="OnUploadAsync" accept="image/*" class="d-none" disabled="@_busy" />
                                    </label>
                                </Actions>
                            </LocationLookPanel>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    /* Places index — high-contrast cards (dark theme) */
    .loc-index-list {
        background: var(--fs-bg-card, #1a222d);
        border-color: var(--fs-border-color, #3a4554) !important;
    }
    .loc-list-item {
        background: var(--fs-bg-card, #1a222d) !important;
        color: var(--fs-text-primary, #e8eef6) !important;
        border-color: rgba(148, 163, 184, 0.12) !important;
        padding: 0.45rem 0.55rem !important;
    }
    .loc-list-item:hover:not(.active) {
        background: var(--fs-bg-card-hover, #232d3b) !important;
        color: var(--fs-text-primary, #e8eef6) !important;
    }
    .loc-list-item.active {
        background: var(--fs-accent-indigo, #4f46e5) !important;
        border-color: var(--fs-accent-indigo, #4f46e5) !important;
        color: #fff !important;
        z-index: 1;
    }
    .loc-list-name {
        font-weight: 650;
        color: inherit;
    }
    .loc-list-meta {
        color: rgba(232, 238, 246, 0.72);
    }
    .loc-list-item.active .loc-list-meta {
        color: rgba(255, 255, 255, 0.85);
    }
    .loc-list-thumb-wrap {
        position: relative;
        flex-shrink: 0;
        width: 44px;
        height: 32px;
    }
    .loc-list-thumb {
        width: 44px;
        height: 32px;
        border-radius: 0.3rem;
        object-fit: cover;
        background: #0b0f14;
        border: 1px solid rgba(255,255,255,0.12);
        display: block;
    }
    .loc-list-thumb--empty {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        color: #fde68a;
        background: #422006;
        border-color: #b45309;
    }
    .loc-list-lock-badge {
        position: absolute;
        right: -4px;
        bottom: -4px;
        font-size: 0.7rem;
        line-height: 1;
        filter: drop-shadow(0 1px 1px rgba(0,0,0,0.65));
    }
    .loc-list-item.active .loc-list-thumb--empty {
        background: rgba(255,255,255,0.18);
        border-color: rgba(255,255,255,0.35);
        color: #fff;
    }

    .loc-preferred-frame,
    .loc-variant-frame {
        position: relative;
        display: inline-block;
        padding: 0;
        border: none;
        background: transparent;
        color: inherit;
    }
    .loc-preferred-preview {
        max-height: 160px;
        max-width: min(100%, 320px);
        object-fit: contain;
        background: #0b0f14;
        display: block;
    }
    .loc-variant-tile {
        width: 148px;
    }
    .loc-variant-tile.is-preferred .loc-variant-frame {
        box-shadow: 0 0 0 2px #22c55e;
        border-radius: 0.4rem;
    }
    .loc-variant-frame {
        width: 100%;
        border-radius: 0.4rem;
        overflow: hidden;
        cursor: pointer;
        border: 1px solid rgba(148, 163, 184, 0.25) !important;
    }
    .loc-variant-frame:hover:not(:disabled) {
        border-color: rgba(125, 211, 252, 0.7) !important;
    }
    .loc-variant-frame:disabled {
        opacity: 0.65;
        cursor: wait;
    }
    .loc-variant-img {
        width: 100%;
        height: 84px;
        object-fit: cover;
        display: block;
        background: #0b0f14;
    }
    .loc-plate-lock-icon {
        position: absolute;
        right: 0.35rem;
        bottom: 0.35rem;
        font-size: 1rem;
        line-height: 1;
        padding: 0.15rem 0.25rem;
        border-radius: 0.35rem;
        background: rgba(0, 0, 0, 0.62);
        border: 1px solid rgba(255, 255, 255, 0.14);
        filter: none;
    }
    .loc-plate-lock-icon.is-locked {
        background: rgba(22, 101, 52, 0.85);
    }
    .loc-plate-lock-icon.is-open {
        background: rgba(0, 0, 0, 0.62);
    }
    .loc-variant-num {
        position: absolute;
        left: 0.35rem;
        top: 0.3rem;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.1rem 0.35rem;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.55);
        color: #e8eef6;
    }
</style>
