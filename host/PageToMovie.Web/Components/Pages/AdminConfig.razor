@page "/admin/config"
@inject EngineApiClient Api
@inject AdminSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Admin config — PageToMovie</PageTitle>

<div class="container-fluid py-3" style="max-width: 72rem;">
    <AdminPageHeader Title="Server configuration">
        <Subtitle>Hot-apply capacity &amp; fakes · persists under <code>.filmstudio/runtime-config.json</code></Subtitle>
    </AdminPageHeader>

    @if (!Session.IsAdmin)
    {
        <InlineAlert Variant="warning">Admin session required. <a href="/admin/login">Sign in</a></InlineAlert>
    }
    else if (_cfg is null && string.IsNullOrEmpty(_error))
    {
        <EmptyState Message="Loading…" CssClass="text-muted" />
    }
    else
    {
        <InlineAlert Message="@_error" />
        <InlineAlert Message="@_message" Variant="success" />

        @if (_cfg is not null)
        {
            <div class="row"
                 data-masonry='{"percentPosition": true}'
                 data-testid="admin-config-masonry"
                 id="admin-config-masonry">
                <div class="col-sm-6 col-lg-4 mb-4 ptm-masonry-item">
                    <div class="card">
                        <div class="card-header">Capacity</div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label">MaxVideoInFlight</label>
                                    <InputNumber class="form-control" @bind-Value="_maxVideo" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">MaxVideoInFlightPerUser</label>
                                    <InputNumber class="form-control" @bind-Value="_maxVideoPerUser" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">MaxQueuePerUser</label>
                                    <InputNumber class="form-control" @bind-Value="_maxQueue" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-4 mb-4 ptm-masonry-item">
                    <div class="card">
                        <div class="card-header">Billing · customer charge</div>
                        <div class="card-body">
                            <label class="form-label">Charge multiplier</label>
                            <InputNumber class="form-control" @bind-Value="_chargeMultiplier" step="0.05" min="0" max="100" />
                            <div class="form-text">
                                Applied to estimates and actual charges (list rate × multiplier).
                                1.0 = vendor list rate; 1.5 = 50% markup. Debits credits at the charged amount.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-4 mb-4 ptm-masonry-item">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-1">
                            <span>Fakes</span>
                            @if (_cfg.RestartRequired?.Contains("UseFakes") ?? false)
                            {
                                <span class="badge text-bg-warning">UseFakes: restart for full DI effect</span>
                            }
                        </div>
                        <div class="card-body">
                            <div class="form-check mb-2">
                                <InputCheckbox class="form-check-input" id="useFakes" @bind-Value="_useFakes" />
                                <label class="form-check-label" for="useFakes">UseFakes (flag only; clients fixed at process start)</label>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label">VideoMode</label>
                                    <InputText class="form-control" @bind-Value="_videoMode" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">VideoDelayMs</label>
                                    <InputNumber class="form-control" @bind-Value="_videoDelayMs" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">FailRate (0–1)</label>
                                    <InputNumber class="form-control" @bind-Value="_failRate" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">RateLimitEveryN</label>
                                    <InputNumber class="form-control" @bind-Value="_rateLimitEveryN" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-4 mb-4 ptm-masonry-item">
                    <div class="card">
                        <div class="card-header">Adaptation defaults</div>
                        <div class="card-body">
                            <div class="form-text mb-2">
                                Admin-global fallback for Stage 1 adaptation tunables. Blank = use the
                                built-in default. The first five can be overridden further per-project on
                                Configuration's Advanced Adaptation Settings; the last three are admin-only.
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label">Max speaking cast</label>
                                    <InputNumber class="form-control" @bind-Value="_maxSpeakingCast" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Max dialogue words</label>
                                    <InputNumber class="form-control" @bind-Value="_maxDialogueWords" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">VO max sentences</label>
                                    <InputNumber class="form-control" @bind-Value="_voMaxSentences" />
                                </div>
                                <div class="col-6"></div>
                                <div class="col-6">
                                    <label class="form-label">Scene count min</label>
                                    <InputNumber class="form-control" @bind-Value="_sceneCountMin" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Scene count max</label>
                                    <InputNumber class="form-control" @bind-Value="_sceneCountMax" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Min audio cues / scene</label>
                                    <InputNumber class="form-control" @bind-Value="_minAudioCuesPerScene" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Min audio cues at peak</label>
                                    <InputNumber class="form-control" @bind-Value="_minAudioCuesAtPeak" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Body words / minute</label>
                                    <InputNumber class="form-control" @bind-Value="_bodyWordsPerMinute" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-4 mb-4 ptm-masonry-item">
                    <div class="card">
                        <div class="card-header">Network &amp; timeouts</div>
                        <div class="card-body">
                            <div class="form-text mb-2">
                                Per-request time limits (seconds) for provider API calls, applied immediately. Under each field: what recent successful calls actually took
                                (green = comfortable, amber = limit is &gt;3× p99 and could be tighter, red = p99 already exceeds the limit).
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label">Image (sec)</label>
                                    <InputNumber class="form-control" @bind-Value="_imageTimeoutSeconds" min="10" max="3600" />
                                    <div class="form-text @TimeoutEvidenceClassFor("Image", _imageTimeoutSeconds)" data-testid="timeout-evidence-image">@TimeoutEvidence("Image")</div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Video (sec)</label>
                                    <InputNumber class="form-control" @bind-Value="_videoTimeoutSeconds" min="30" max="7200" />
                                    <div class="form-text @TimeoutEvidenceClassFor("Video", _videoTimeoutSeconds)" data-testid="timeout-evidence-video">@TimeoutEvidence("Video")</div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Chat / Script (sec)</label>
                                    <InputNumber class="form-control" @bind-Value="_chatTimeoutSeconds" min="30" max="7200" />
                                    <div class="form-text @TimeoutEvidenceClassFor("Chat", _chatTimeoutSeconds)" data-testid="timeout-evidence-chat">@TimeoutEvidence("Chat")</div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Audio / Music (sec)</label>
                                    <InputNumber class="form-control" @bind-Value="_audioTimeoutSeconds" min="10" max="3600" />
                                    <div class="form-text @TimeoutEvidenceClassFor("Audio", _audioTimeoutSeconds)" data-testid="timeout-evidence-audio">@TimeoutEvidence("Audio")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-4 mb-4 ptm-masonry-item">
                    <div class="card">
                        <div class="card-header">Status</div>
                        <div class="card-body small text-muted">
                            <div class="mb-2">
                                Path: <code class="user-select-all">@(_cfg.ConfigPath ?? "—")</code>
                            </div>
                            <div>
                                Last update: @(_cfg.UpdatedAt?.ToLocalTime().ToString("g") ?? "—")
                                by @(_cfg.UpdatedBy ?? "—")
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-top-0 pt-0">
                            <BusyButton Label="Save & hot-apply" BusyLabel="Saving…" Busy="_busy"
                                        CssClass="btn btn-primary w-100" OnClick="SaveAsync" />
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
