@page "/adaptation/screenplay"
@inherits AdaptationPageBase
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject AdminSessionService Session
@inject IAppLocalizer L

<PageTitle>Book · @L["Adaptation.Screenplay"]</PageTitle>

<AdaptationShell Host="this" Step="screenplay">
    @* Visual style → "Look & medium" stage; film length → "Fit length" stage. This step is edit-only. *@

    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>@L["Adaptation.Screenplay"]</span>
            <div class="fe-status-line d-flex flex-wrap gap-1 align-items-center">
                @if (IsApprovedClean)
                {
                    <span class="badge bg-success">@L["ScreenplayPage.Approved"]</span>
                }
                else if (NeedsReapprove)
                {
                    <span class="badge bg-warning text-dark">@L["ScreenplayPage.EditedSinceApproval"]</span>
                }
                else if (_screenplayStatus?.DraftExists == true || !string.IsNullOrWhiteSpace(_text))
                {
                    <span class="badge bg-warning text-dark">@L["ScreenplayPage.Draft"]</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">@L["ScreenplayPage.NoDraft"]</span>
                }

                @if (!string.IsNullOrWhiteSpace(StatusTitle))
                {
                    <span class="small fw-semibold">@StatusTitle</span>
                }
                @if (_sceneCount > 0)
                {
                    <span class="badge text-bg-light border">@_sceneCount scenes</span>
                }
                @if (_dirtyLocal)
                {
                    <span class="small text-muted">· unsaved</span>
                }
                else if (_lastSavedUtc is not null)
                {
                    <span class="small text-muted">· saved</span>
                }
            </div>
        </div>
        <div class="card-body">
            @if (!_editorReady && string.IsNullOrEmpty(_text) && Status?.Book.BookTextExists == true)
            {
                <div class="alert alert-light border small mb-2">
                    You have book text ready.
                    <button class="btn btn-sm btn-outline-primary ms-1"
                            data-testid="screenplay-from-book"
                            disabled="@(Busy || JobRunning)"
                            @onclick="CreateFromBookAsync">
                        Create draft from book
                    </button>
                </div>
            }

            @if (_signOffWarnings.Count > 0 && !IsApprovedClean)
            {
                <div class="alert alert-warning py-2 small fe-warnings">
                    <strong>Before approving:</strong>
                    <ul class="mb-0 ps-3">
                        @foreach (var w in _signOffWarnings)
                        {
                            <li>@w</li>
                        }
                    </ul>
                </div>
            }

            <div class="fe-wrap">
                <div class="fe-toolbar">
                    <details class="fe-scenes-pop">
                        <summary class="btn btn-outline-secondary btn-sm"
                                 title="Jump to a scene heading in the editor">
                            Jump to scene@(_sceneCount > 0 ? $" ({_sceneCount})" : "")
                        </summary>
                        <div class="fe-scenes-pop-panel" @ref="_scenesEl"></div>
                    </details>

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            disabled="@(!CanEdit)"
                            @onclick='() => InsertAsync("\n\nINT.  - DAY\n\n")'
                            title="Insert a new scene heading">
                        New scene
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            data-testid="screenplay-copy"
                            @onclick="CopyScreenplayAsync"
                            title="Copy the whole screenplay to the clipboard">
                        @(_copied ? "Copied ✓" : "📋 Copy")
                    </button>

                    <details class="fe-advanced-pop">
                        <summary class="btn btn-outline-secondary btn-sm"
                                 title="Fountain formatting helpers for advanced edits">
                            Advanced…
                        </summary>
                        <div class="fe-advanced-panel d-flex flex-wrap gap-1">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-testid="screenplay-insert-title" disabled="@(!CanEdit)" @onclick='() => InsertTitleFieldAsync("Title")' title="Insert or jump to the Title: line on the title page (shown on the end-credits card)">Title:</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-testid="screenplay-insert-author" disabled="@(!CanEdit)" @onclick='() => InsertTitleFieldAsync("Author")' title="Insert or jump to the Author: line on the title page (shown on the end-credits card)">Author:</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!CanEdit)" @onclick='() => InsertAsync("\n\nCHARACTER\n")'>Character</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!CanEdit)" @onclick='() => InsertAsync("\n\nCUT TO:\n\n")'>Transition</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!CanEdit)" @onclick='() => InsertAsync("\n\n> THE END <\n\n")'>Centered</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!CanEdit)" @onclick='() => InsertAsync("\n\n.FORCED HEADING\n\n")'>Force scene</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!CanEdit)" @onclick='() => InsertAsync("\n\n@Name\n")'>Force character</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!CanEdit)" @onclick='() => InsertAsync("\n!ACTION LINE\n")'>Force action</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!CanEdit)" @onclick='() => InsertAsync("\n~Lyric line\n")'>Lyric</button>
                        </div>
                    </details>

                    <span class="flex-grow-1"></span>

                    @* Autosave keeps drafts; quiet Save for dirty state / tests (stable DOM so scenes popover stays). *@
                    <button type="button"
                            class="@(_dirtyLocal ? "btn btn-link btn-sm text-muted px-1" : "visually-hidden")"
                            data-testid="screenplay-save"
                            disabled="@(Busy || JobRunning || !_dirtyLocal)"
                            @onclick="() => SaveDraftAsync(manual: true)"
                            tabindex="@(_dirtyLocal ? 0 : -1)"
                            aria-hidden="@(!_dirtyLocal)">
                        Save now
                    </button>

                    @if (IsApprovedClean)
                    {
                        <a class="btn btn-success btn-sm" href="characters" data-testid="screenplay-signoff-done">
                            @L["ScreenplayPage.ToCharacters"]
                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-success btn-sm"
                                data-testid="screenplay-signoff"
                                disabled="@(Busy || JobRunning || string.IsNullOrWhiteSpace(_text))"
                                @onclick="SignOffAsync">
                            @if (Busy && !string.IsNullOrWhiteSpace(BusyMessage))
                            {
                                @BusyMessage
                            }
                            else if (NeedsReapprove)
                            {
                                <text>@L["ScreenplayPage.ReapproveAndContinue"]</text>
                            }
                            else
                            {
                                <text>@L["ScreenplayPage.LooksGoodContinue"]</text>
                            }
                        </button>
                    }

                    <div data-testid="screenplay-status"
                         data-signed="@(IsApprovedClean ? "true" : "false")"
                         data-draft="@(!string.IsNullOrWhiteSpace(_text) ? "true" : "false")"
                         data-scenes="@_sceneCount"
                         class="visually-hidden"
                         aria-hidden="true"></div>
                </div>

                <div class="fe-main fe-main-two-col">
                    <div class="fe-panel fe-editor-col">
                        <div class="fe-panel-header">
                            <span>Edit</span>
                            <span class="fe-preview-hint">scroll to read</span>
                        </div>
                        <div class="fe-editor-host" @ref="_editorHost"></div>
                    </div>
                    <div class="fe-panel fe-preview-col">
                        <div class="fe-panel-header">
                            <span>Preview</span>
                            <span class="fe-preview-hint">read only</span>
                        </div>
                        <div class="fe-preview-body"
                             @ref="_previewEl"
                             tabindex="-1"
                             aria-readonly="true"
                             title="Read-only layout — edit on the left"></div>
                    </div>
                </div>
            </div>

            @* Manual re-draft controls are admin-only. *@
            @if (Session.IsAdmin)
            {
                <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                    @if (Status?.Book.BookTextExists == true)
                    {
                        <button class="btn btn-outline-secondary btn-sm"
                                disabled="@(Busy || JobRunning)"
                                @onclick="CreateFromBookAsync"
                                title="Replace draft with a first pass from book text (admin)">
                            Draft from book
                        </button>
                    }
                    @if (CanRunOutline && Status?.XaiConfigured == true && Status?.Book.BookTextExists == true)
                    {
                        <button class="btn btn-outline-secondary btn-sm"
                                disabled="@(Busy || JobRunning)"
                                @onclick="RunOutlineAsync"
                                title="Draft screenplay from book and approve for shot planning (admin)">
                            Draft &amp; approve from book
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    @if (_showBookModal)
    {
        <div class="fe-book-window"
             @ref="_bookWindowEl"
             role="dialog"
             aria-modal="false"
             aria-labelledby="fe-book-modal-title">
            <div class="fe-book-window-header" data-drag-handle="1">
                <div>
                    <h2 id="fe-book-modal-title">From the book</h2>
                    <div class="fe-book-sub">
                        @if (!string.IsNullOrWhiteSpace(_bookContext?.Heading))
                        {
                            <span>@_bookContext.Heading</span>
                        }
                        else
                        {
                            <span>Source passage for this scene</span>
                        }
                        @if (_bookContext?.PageNumber is int pn && Status?.Book.BookTextExists == true)
                        {
                            <span class="text-muted"> · section @pn</span>
                        }
                    </div>
                    <div class="fe-book-window-drag-hint">Drag to move · resize from corner</div>
                </div>
                <button type="button" class="fe-book-window-close" @onclick="CloseBookModal" aria-label="Close">×</button>
            </div>
            <div class="fe-book-window-body">
                @if (_bookLoading)
                {
                    <div class="fe-book-empty">Looking up book text…</div>
                }
                else if (_bookContext is null)
                {
                    <div class="fe-book-empty">No book context yet.</div>
                }
                else if (!_bookContext.HasBook)
                {
                    <div class="fe-book-empty">No prepared book text for this project.</div>
                }
                else if (string.IsNullOrWhiteSpace(_bookContext.Excerpt))
                {
                    <div class="fe-book-empty">No matching book passage for this scene. Try editing the scene so dialogue or action echoes the book wording.</div>
                }
                else
                {
                    @_bookContext.Excerpt
                }
            </div>
        </div>
    }

    @if (Status?.Stage1.Present == true && Status.Stage1.Scenes.Count > 0 && Status.Screenplay.Signed && !_dirtyLocal)
    {
        <div class="card">
            <div class="card-header">Approved scenes</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th style="width:4rem">#</th>
                                <th>Setting</th>
                                <th style="width:5rem">Beats</th>
                                <th style="width:5rem">Dur</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Status.Stage1.Scenes)
                            {
                                <tr>
                                    <td><code>S@(s.SceneNumber.ToString("D2"))</code></td>
                                    <td class="small">@(string.IsNullOrEmpty(s.Setting) ? "—" : s.Setting)</td>
                                    <td class="small">@s.BeatCount</td>
                                    <td class="small text-muted">@(s.DurationSeconds is double d ? $"{d:0}s" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</AdaptationShell>
