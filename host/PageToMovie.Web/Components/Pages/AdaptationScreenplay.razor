@page "/adaptation/screenplay"
@inherits AdaptationPageBase
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject AdminSessionService Session
@inject IAppLocalizer L

@{
    var pageTitle = !string.IsNullOrWhiteSpace(SignOff.StatusTitle) && SignOff.StatusTitle != "Untitled"
        ? SignOff.StatusTitle
        : !string.IsNullOrWhiteSpace(ProjectLabel) ? ProjectLabel
        : L["Adaptation.Screenplay"];
}

<PageTitle>@pageTitle</PageTitle>

<AdaptationShell Host="this" Step="screenplay">
    @* Exactly two chrome rows, then the editor. *@
    <div class="card mb-3 fe-screenplay-card fe-screenplay-card--compact">
        @* Row 1 — title, status, menu, Approve *@
        <div class="fe-sp-bar fe-sp-bar--primary" data-testid="screenplay-bar-primary">
            <div class="fe-sp-bar__left">
                <h1 class="fe-sp-title mb-0">@pageTitle</h1>
                <div class="fe-status-line d-flex flex-wrap gap-1 align-items-center">
                    @if (SignOff.IsApprovedClean)
                    {
                        <span class="badge bg-success">@L["ScreenplayPage.Approved"]</span>
                    }
                    else if (SignOff.NeedsReapprove)
                    {
                        <span class="badge bg-warning text-dark">@L["ScreenplayPage.EditedSinceApproval"]</span>
                    }
                    else if (SignOff._screenplayStatus?.DraftExists == true || !string.IsNullOrWhiteSpace(Editor._text))
                    {
                        <span class="badge bg-warning text-dark">@L["ScreenplayPage.Draft"]</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">@L["ScreenplayPage.NoDraft"]</span>
                    }

                    @if (Editor._sceneCount > 0)
                    {
                        <span class="small text-body-secondary">@Editor._sceneCount scenes</span>
                    }
                    @if (Save._dirtyLocal)
                    {
                        <span class="small text-muted">· unsaved</span>
                    }
                    else if (Save._lastSavedUtc is not null)
                    {
                        <span class="small text-muted">· saved</span>
                    }
                </div>
            </div>

            <div class="fe-sp-bar__right">
                <button type="button"
                        class="@(Save._dirtyLocal ? "btn btn-link btn-sm text-muted px-1" : "visually-hidden")"
                        data-testid="screenplay-save"
                        disabled="@(Busy || Jobs.JobRunning || !Save._dirtyLocal)"
                        @onclick="() => Save.SaveDraftAsync(manual: true)"
                        tabindex="@(Save._dirtyLocal ? 0 : -1)"
                        aria-hidden="@(!Save._dirtyLocal)">
                    Save now
                </button>

                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                            type="button"
                            data-testid="screenplay-menu"
                            title="Editor menu"
                            aria-expanded="@_menuOpen"
                            @onclick="ToggleMenu"
                            @onclick:stopPropagation="true">
                        Menu
                    </button>
                    @if (_menuOpen)
                    {
                        <div class="fe-menu-backdrop" @onclick="CloseMenu"></div>
                    }
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow @(_menuOpen ? "show" : "")"
                        style="@(_menuOpen ? "display:block; position:absolute; right:0; left:auto;" : null)">
                        <li><h6 class="dropdown-header">Story Setup</h6></li>
                        @if (Status?.Book.BookTextExists == true)
                        {
                            <li>
                                <button class="dropdown-item" type="button"
                                        data-testid="menu-rewrite-from-book"
                                        disabled="@(Busy || Jobs.JobRunning)"
                                        @onclick="async () => { CloseMenu(); await Book.CreateFromBookAsync(); }">
                                    @(Book.NeedsDraftFromBook ? "Create draft from book…" : "Rewrite draft from book…")
                                </button>
                            </li>
                        }
                        <li>
                            <button class="dropdown-item" type="button" disabled="@(_structuredUi is null)" @onclick="MenuOpenCharacters">
                                Edit Story Characters…
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" disabled="@(_structuredUi is null)" @onclick="MenuOpenLocations">
                                Edit Story Locations…
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button class="dropdown-item" type="button" disabled="@(_structuredUi is null)" @onclick="MenuOpenExport">
                                Export Fountain…
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" disabled="@(_structuredUi is null)" @onclick="MenuOpenExportPdf">
                                Export PDF…
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">View</h6></li>
                        <li>
                            <button class="dropdown-item" type="button" disabled="@(_structuredUi is null)" @onclick="MenuCollapseAllAsync">
                                Collapse All Scenes
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" disabled="@(_structuredUi is null)" @onclick="MenuExpandAllAsync">
                                Expand All Scenes
                            </button>
                        </li>
                    </ul>
                </div>

                @if (SignOff.IsApprovedClean)
                {
                    <a class="btn btn-success btn-sm" href="characters" data-testid="screenplay-signoff-done">
                        @L["ScreenplayPage.ToCharacters"]
                    </a>
                }
                else
                {
                    <button type="button"
                            class="btn btn-success btn-sm"
                            data-testid="screenplay-signoff"
                            disabled="@(Busy || Jobs.JobRunning || string.IsNullOrWhiteSpace(Editor._text))"
                            @onclick="SignOff.SignOffAsync">
                        @if (Busy && !string.IsNullOrWhiteSpace(BusyMessage))
                        {
                            @BusyMessage
                        }
                        else if (SignOff.NeedsReapprove)
                        {
                            <text>@L["ScreenplayPage.ReapproveAndContinue"]</text>
                        }
                        else
                        {
                            <text>@L["ScreenplayPage.LooksGoodContinue"]</text>
                        }
                    </button>
                }

                <div data-testid="screenplay-status"
                     data-signed="@(SignOff.IsApprovedClean ? "true" : "false")"
                     data-draft="@(!string.IsNullOrWhiteSpace(Editor._text) ? "true" : "false")"
                     data-scenes="@Editor._sceneCount"
                     class="visually-hidden"
                     aria-hidden="true"></div>
            </div>
        </div>

        @* Row 2 — Look / Enrich / Fit (tools that shape the draft) *@
        @if (!string.IsNullOrWhiteSpace(ProjectId) && Tools.DraftExists)
        {
            <div class="fe-sp-bar fe-sp-bar--tools" data-testid="screenplay-tools" role="toolbar" aria-label="Screenplay tools">
                <button type="button"
                        class="fe-sp-tools__tab @(Tools.OpenPanel == "look" ? "is-active" : "")"
                        data-testid="screenplay-tool-look"
                        disabled="@(Busy || Jobs.JobRunning)"
                        @onclick='() => Tools.Toggle("look")'>
                    @L["Adaptation.Look"]
                    @if (Tools.LookDone)
                    {
                        <span class="fe-sp-tools__done" title="Done">✓</span>
                    }
                </button>
                <button type="button"
                        class="fe-sp-tools__tab @(Tools.OpenPanel == "enrich" ? "is-active" : "")"
                        data-testid="screenplay-tool-enrich"
                        disabled="@(Busy || Jobs.JobRunning)"
                        @onclick='() => Tools.Toggle("enrich")'>
                    @L["Adaptation.Enrich"]
                    @if (Tools.EnrichDone)
                    {
                        <span class="fe-sp-tools__done" title="Done">✓</span>
                    }
                </button>
                <button type="button"
                        class="fe-sp-tools__tab @(Tools.OpenPanel == "fit" ? "is-active" : "")"
                        data-testid="screenplay-tool-fit"
                        disabled="@(Busy || Jobs.JobRunning)"
                        @onclick='() => Tools.Toggle("fit")'>
                    @L["Adaptation.FitLength"]
                    @if (Tools.FitDone)
                    {
                        <span class="fe-sp-tools__done" title="Done">✓@(Tools.FitMins is > 0 ? $" ~{Math.Round(Tools.FitMins.Value)}m" : "")</span>
                    }
                </button>
            </div>
        }

        <div class="card-body fe-screenplay-body pt-2">
            @if (Book.NeedsDraftFromBook)
            {
                <div class="alert alert-primary border small mb-2 d-flex flex-wrap align-items-center justify-content-between gap-2"
                     data-testid="screenplay-from-book-banner">
                    <div>
                        <strong>No usable screenplay yet.</strong>
                        You already have book text for this project — generate a draft from it
                        (or re-import on Book if you want a new source file).
                    </div>
                    <button class="btn btn-sm btn-primary"
                            data-testid="screenplay-from-book"
                            disabled="@(Busy || Jobs.JobRunning)"
                            @onclick="Book.CreateFromBookAsync">
                        @(string.IsNullOrWhiteSpace(Editor._text) || Editor._text.Length < 80
                            ? "Create draft from book"
                            : "Rewrite draft from book")
                    </button>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(ProjectId) && Status?.Book.BookTextExists != true && string.IsNullOrWhiteSpace(Editor._text))
            {
                <div class="alert alert-light border small mb-3">
                    Import a book or fountain first.
                    <a class="ms-1" href="adaptation/import" data-testid="screenplay-go-import">Go to Import →</a>
                </div>
            }

            @if (!Editor._editorReady && string.IsNullOrEmpty(Editor._text) && Status?.Book.BookTextExists == true && !Book.NeedsDraftFromBook)
            {
                <div class="alert alert-light border small mb-2">
                    You have book text ready.
                    <button class="btn btn-sm btn-outline-primary ms-1"
                            data-testid="screenplay-from-book"
                            disabled="@(Busy || Jobs.JobRunning)"
                            @onclick="Book.CreateFromBookAsync">
                        Create draft from book
                    </button>
                </div>
            }

            @if (SignOff._signOffWarnings.Count > 0 && !SignOff.IsApprovedClean)
            {
                <div class="alert alert-warning py-2 small fe-warnings">
                    <strong>Before approving:</strong>
                    <ul class="mb-0 ps-3">
                        @foreach (var w in SignOff._signOffWarnings)
                        {
                            <li>@w</li>
                        }
                    </ul>
                    @if (Book.NeedsDraftFromBook)
                    {
                        <div class="mt-2">
                            <button class="btn btn-sm btn-outline-primary"
                                    data-testid="screenplay-from-book-warn"
                                    disabled="@(Busy || Jobs.JobRunning)"
                                    @onclick="Book.CreateFromBookAsync">
                                Rewrite draft from book
                            </button>
                        </div>
                    }
                </div>
            }

            @if (Tools.OpenPanel == "look" && Tools.DraftExists)
            {
                <div class="fe-sp-tools__panel mb-2" data-testid="screenplay-panel-look">
                    <VisualMediumCard ProjectId="@ProjectId"
                                      Embedded="true"
                                      Disabled="@(Busy || Jobs.JobRunning)"
                                      SaveLabel="Save & apply to screenplay"
                                      OnChanged="Tools.OnLookChangedAsync" />
                    <p class="small text-body-secondary mb-0 mt-2">
                        Saving re-applies the look — dialogue, scenes, and story stay the same. Re-approve afterward.
                    </p>
                </div>
            }
            else if (Tools.OpenPanel == "enrich" && Tools.DraftExists)
            {
                <div class="fe-sp-tools__panel mb-2" data-testid="screenplay-panel-enrich">
                    @if (!Tools.EnrichDone)
                    {
                        <p class="small text-body-secondary mb-2">
                            Add concrete visual detail — setting, lighting, small action — from the book’s language where it’s rich.
                            Dialogue, scenes, and story stay the same.
                        </p>
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                data-testid="embellish-run"
                                disabled="@(Busy || Jobs.JobRunning)"
                                @onclick="Tools.EmbellishAsync">
                            Enrich the screenplay
                        </button>
                    }
                    else
                    {
                        <p class="small text-body-secondary mb-2">
                            Visual detail added. Enrich again to add more, or re-approve when you’re happy.
                        </p>
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                data-testid="embellish-run"
                                disabled="@(Busy || Jobs.JobRunning)"
                                @onclick="Tools.EmbellishAsync">
                            Enrich again
                        </button>
                    }
                </div>
            }
            else if (Tools.OpenPanel == "fit" && Tools.DraftExists)
            {
                <div class="fe-sp-tools__panel mb-2" data-testid="screenplay-panel-fit">
                    <p class="small text-body-secondary mb-2">
                        Set the film length. We trim the screenplay to fit — your full-length version is kept so you can re-fit anytime.
                    </p>
                    <FilmLengthCard ProjectId="@ProjectId"
                                    Embedded="true"
                                    Disabled="@(Busy || Jobs.JobRunning)"
                                    OnChanged="Tools.OnLengthChangedAsync" />
                    @if (Tools.EstimateUsd is double est)
                    {
                        <div class="border rounded p-2 my-2 small text-body-secondary" data-testid="trim-cost-preview">
                            Rough estimate at this length:
                            <strong class="text-body">@($"${est:0.00}")</strong>
                            — firms up after cast & voice.
                        </div>
                    }
                    <button type="button"
                            class="btn btn-primary btn-sm mt-1"
                            data-testid="trim-run"
                            disabled="@(Busy || Jobs.JobRunning)"
                            @onclick="Tools.TrimAsync">
                        Fit screenplay to this length
                    </button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(ProjectId) && Status?.Book.BookTextExists != true && string.IsNullOrWhiteSpace(Editor._text) && !Book.NeedsDraftFromBook)
            {
                <div class="alert alert-light border small mb-3">
                    Import a book or fountain first.
                    <a class="ms-1" href="adaptation/import" data-testid="screenplay-go-import">Go to Import →</a>
                </div>
            }

            <div class="fe-wrap fe-wrap--compact">
                <div class="fe-structured-editor overflow-hidden" data-testid="screenplay-structured-editor">
                    @if (Editor._editorReady)
                    {
                        <PageToMovie.ScreenplayEditor.Components.ScreenplayEditor @ref="_structuredUi"
                                                                                   Model="Editor._model"
                                                                                   ModelChanged="Editor.OnStructuredModelChanged"
                                                                                   HideChrome="true"
                                                                                   OnPlayScene="PlaySceneOnFilmPage" />
                    }
                    else
                    {
                        <div class="p-4 text-muted small">Loading screenplay editor…</div>
                    }
                </div>
                @* Hidden refs retained for book-context host bindings. *@
                <div class="visually-hidden" aria-hidden="true">
                    <div @ref="Editor._editorHost"></div>
                    <div @ref="Editor._previewEl"></div>
                    <div @ref="Editor._scenesEl"></div>
                </div>
            </div>

            @if (Session.IsAdmin)
            {
                <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                    @if (Status?.Book.BookTextExists == true)
                    {
                        <button class="btn btn-outline-secondary btn-sm"
                                disabled="@(Busy || Jobs.JobRunning)"
                                @onclick="Book.CreateFromBookAsync"
                                title="Replace draft with a first pass from book text (admin)">
                            Draft from book
                        </button>
                    }
                    @if (Pipeline.CanRunOutline && Status?.XaiConfigured == true && Status?.Book.BookTextExists == true)
                    {
                        <button class="btn btn-outline-secondary btn-sm"
                                disabled="@(Busy || Jobs.JobRunning)"
                                @onclick="Pipeline.RunOutlineAsync"
                                title="Draft screenplay from book and approve for shot planning (admin)">
                            Draft & approve from book
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    @if (Book._showBookModal)
    {
        <div class="fe-book-window"
             @ref="Book._bookWindowEl"
             role="dialog"
             aria-modal="false"
             aria-labelledby="fe-book-modal-title">
            <div class="fe-book-window-header" data-drag-handle="1">
                <div>
                    <h2 id="fe-book-modal-title">From the book</h2>
                    <div class="fe-book-sub">
                        @if (!string.IsNullOrWhiteSpace(Book._bookContext?.Heading))
                        {
                            <span>@Book._bookContext.Heading</span>
                        }
                        else
                        {
                            <span>Source passage for this scene</span>
                        }
                        @if (Book._bookContext?.PageNumber is int pn && Status?.Book.BookTextExists == true)
                        {
                            <span class="text-muted"> · section @pn</span>
                        }
                    </div>
                    <div class="fe-book-window-drag-hint">Drag to move · resize from corner</div>
                </div>
                <button type="button" class="fe-book-window-close" @onclick="Book.CloseBookModal" aria-label="Close">×</button>
            </div>
            <div class="fe-book-window-body">
                @if (Book._bookLoading)
                {
                    <div class="fe-book-empty">Looking up book text…</div>
                }
                else if (Book._bookContext is null)
                {
                    <div class="fe-book-empty">No book context yet.</div>
                }
                else if (!Book._bookContext.HasBook)
                {
                    <div class="fe-book-empty">No prepared book text for this project.</div>
                }
                else if (string.IsNullOrWhiteSpace(Book._bookContext.Excerpt))
                {
                    <div class="fe-book-empty">No matching book passage for this scene. Try editing the scene so dialogue or action echoes the book wording.</div>
                }
                else
                {
                    @Book._bookContext.Excerpt
                }
            </div>
        </div>
    }

    @if (Status?.Stage1.Present == true && Status.Stage1.Scenes.Count > 0 && Status.Screenplay.Signed && !Save._dirtyLocal)
    {
        <div class="card">
            <div class="card-header">Approved scenes</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th style="width:4rem">#</th>
                                <th>Setting</th>
                                <th style="width:5rem">Beats</th>
                                <th style="width:5rem">Dur</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Status.Stage1.Scenes)
                            {
                                <tr>
                                    <td><code>S@(s.SceneNumber.ToString("D2"))</code></td>
                                    <td class="small">@(string.IsNullOrEmpty(s.Setting) ? "—" : s.Setting)</td>
                                    <td class="small">@s.BeatCount</td>
                                    <td class="small text-muted">@(s.DurationSeconds is double d ? $"{d:0}s" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</AdaptationShell>
