@page "/adaptation/screenplay"
@inherits AdaptationPageBase
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject AdminSessionService Session
@inject IAppLocalizer L

<PageTitle>Book · @L["Adaptation.Screenplay"]</PageTitle>

<AdaptationShell Host="this" Step="screenplay">
    @* Visual style → "Look & medium" stage; film length → "Fit length" stage. This step is edit-only. *@

    <div class="card mb-3 fe-screenplay-card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>@L["Adaptation.Screenplay"]</span>
            <div class="fe-status-line d-flex flex-wrap gap-1 align-items-center">
                @if (SignOff.IsApprovedClean)
                {
                    <span class="badge bg-success">@L["ScreenplayPage.Approved"]</span>
                }
                else if (SignOff.NeedsReapprove)
                {
                    <span class="badge bg-warning text-dark">@L["ScreenplayPage.EditedSinceApproval"]</span>
                }
                else if (SignOff._screenplayStatus?.DraftExists == true || !string.IsNullOrWhiteSpace(Editor._text))
                {
                    <span class="badge bg-warning text-dark">@L["ScreenplayPage.Draft"]</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">@L["ScreenplayPage.NoDraft"]</span>
                }

                @if (!string.IsNullOrWhiteSpace(SignOff.StatusTitle))
                {
                    <span class="small fw-semibold">@SignOff.StatusTitle</span>
                }
                @if (Editor._sceneCount > 0)
                {
                    <span class="badge text-bg-light border">@Editor._sceneCount scenes</span>
                }
                @if (Save._dirtyLocal)
                {
                    <span class="small text-muted">· unsaved</span>
                }
                else if (Save._lastSavedUtc is not null)
                {
                    <span class="small text-muted">· saved</span>
                }
            </div>
        </div>
        <div class="card-body">
            @if (!Editor._editorReady && string.IsNullOrEmpty(Editor._text) && Status?.Book.BookTextExists == true)
            {
                <div class="alert alert-light border small mb-2">
                    You have book text ready.
                    <button class="btn btn-sm btn-outline-primary ms-1"
                            data-testid="screenplay-from-book"
                            disabled="@(Busy || Jobs.JobRunning)"
                            @onclick="Book.CreateFromBookAsync">
                        Create draft from book
                    </button>
                </div>
            }

            @if (SignOff._signOffWarnings.Count > 0 && !SignOff.IsApprovedClean)
            {
                <div class="alert alert-warning py-2 small fe-warnings">
                    <strong>Before approving:</strong>
                    <ul class="mb-0 ps-3">
                        @foreach (var w in SignOff._signOffWarnings)
                        {
                            <li>@w</li>
                        }
                    </ul>
                </div>
            }

            <div class="fe-wrap">
                <div class="fe-toolbar">
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            data-testid="screenplay-copy"
                            @onclick="Editor.CopyScreenplayAsync"
                            title="Copy the whole screenplay to the clipboard">
                        @(Editor._copied ? "Copied" : "Copy")
                    </button>

                    <span class="flex-grow-1"></span>

                    <button type="button"
                            class="@(Save._dirtyLocal ? "btn btn-link btn-sm text-muted px-1" : "visually-hidden")"
                            data-testid="screenplay-save"
                            disabled="@(Busy || Jobs.JobRunning || !Save._dirtyLocal)"
                            @onclick="() => Save.SaveDraftAsync(manual: true)"
                            tabindex="@(Save._dirtyLocal ? 0 : -1)"
                            aria-hidden="@(!Save._dirtyLocal)">
                        Save now
                    </button>

                    @if (SignOff.IsApprovedClean)
                    {
                        <a class="btn btn-success btn-sm" href="characters" data-testid="screenplay-signoff-done">
                            @L["ScreenplayPage.ToCharacters"]
                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-success btn-sm"
                                data-testid="screenplay-signoff"
                                disabled="@(Busy || Jobs.JobRunning || string.IsNullOrWhiteSpace(Editor._text))"
                                @onclick="SignOff.SignOffAsync">
                            @if (Busy && !string.IsNullOrWhiteSpace(BusyMessage))
                            {
                                @BusyMessage
                            }
                            else if (SignOff.NeedsReapprove)
                            {
                                <text>@L["ScreenplayPage.ReapproveAndContinue"]</text>
                            }
                            else
                            {
                                <text>@L["ScreenplayPage.LooksGoodContinue"]</text>
                            }
                        </button>
                    }

                    <div data-testid="screenplay-status"
                         data-signed="@(SignOff.IsApprovedClean ? "true" : "false")"
                         data-draft="@(!string.IsNullOrWhiteSpace(Editor._text) ? "true" : "false")"
                         data-scenes="@Editor._sceneCount"
                         class="visually-hidden"
                         aria-hidden="true"></div>
                </div>

                <div class="fe-structured-editor overflow-hidden" data-testid="screenplay-structured-editor">
                    @if (Editor._editorReady)
                    {
                        <PageToMovie.ScreenplayEditor.Components.ScreenplayEditor Model="Editor._model"
                                                                                   ModelChanged="Editor.OnStructuredModelChanged" />
                    }
                    else
                    {
                        <div class="p-4 text-muted small">Loading screenplay editor…</div>
                    }
                </div>
                @* Hidden refs retained for book-context host bindings. *@
                <div class="visually-hidden" aria-hidden="true">
                    <div @ref="Editor._editorHost"></div>
                    <div @ref="Editor._previewEl"></div>
                    <div @ref="Editor._scenesEl"></div>
                </div>
            </div>

            @* Manual re-draft controls are admin-only. *@
            @if (Session.IsAdmin)
            {
                <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                    @if (Status?.Book.BookTextExists == true)
                    {
                        <button class="btn btn-outline-secondary btn-sm"
                                disabled="@(Busy || Jobs.JobRunning)"
                                @onclick="Book.CreateFromBookAsync"
                                title="Replace draft with a first pass from book text (admin)">
                            Draft from book
                        </button>
                    }
                    @if (Pipeline.CanRunOutline && Status?.XaiConfigured == true && Status?.Book.BookTextExists == true)
                    {
                        <button class="btn btn-outline-secondary btn-sm"
                                disabled="@(Busy || Jobs.JobRunning)"
                                @onclick="Pipeline.RunOutlineAsync"
                                title="Draft screenplay from book and approve for shot planning (admin)">
                            Draft &amp; approve from book
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    @if (Book._showBookModal)
    {
        <div class="fe-book-window"
             @ref="Book._bookWindowEl"
             role="dialog"
             aria-modal="false"
             aria-labelledby="fe-book-modal-title">
            <div class="fe-book-window-header" data-drag-handle="1">
                <div>
                    <h2 id="fe-book-modal-title">From the book</h2>
                    <div class="fe-book-sub">
                        @if (!string.IsNullOrWhiteSpace(Book._bookContext?.Heading))
                        {
                            <span>@Book._bookContext.Heading</span>
                        }
                        else
                        {
                            <span>Source passage for this scene</span>
                        }
                        @if (Book._bookContext?.PageNumber is int pn && Status?.Book.BookTextExists == true)
                        {
                            <span class="text-muted"> · section @pn</span>
                        }
                    </div>
                    <div class="fe-book-window-drag-hint">Drag to move · resize from corner</div>
                </div>
                <button type="button" class="fe-book-window-close" @onclick="Book.CloseBookModal" aria-label="Close">×</button>
            </div>
            <div class="fe-book-window-body">
                @if (Book._bookLoading)
                {
                    <div class="fe-book-empty">Looking up book text…</div>
                }
                else if (Book._bookContext is null)
                {
                    <div class="fe-book-empty">No book context yet.</div>
                }
                else if (!Book._bookContext.HasBook)
                {
                    <div class="fe-book-empty">No prepared book text for this project.</div>
                }
                else if (string.IsNullOrWhiteSpace(Book._bookContext.Excerpt))
                {
                    <div class="fe-book-empty">No matching book passage for this scene. Try editing the scene so dialogue or action echoes the book wording.</div>
                }
                else
                {
                    @Book._bookContext.Excerpt
                }
            </div>
        </div>
    }

    @if (Status?.Stage1.Present == true && Status.Stage1.Scenes.Count > 0 && Status.Screenplay.Signed && !Save._dirtyLocal)
    {
        <div class="card">
            <div class="card-header">Approved scenes</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th style="width:4rem">#</th>
                                <th>Setting</th>
                                <th style="width:5rem">Beats</th>
                                <th style="width:5rem">Dur</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Status.Stage1.Scenes)
                            {
                                <tr>
                                    <td><code>S@(s.SceneNumber.ToString("D2"))</code></td>
                                    <td class="small">@(string.IsNullOrEmpty(s.Setting) ? "—" : s.Setting)</td>
                                    <td class="small">@s.BeatCount</td>
                                    <td class="small text-muted">@(s.DurationSeconds is double d ? $"{d:0}s" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</AdaptationShell>
