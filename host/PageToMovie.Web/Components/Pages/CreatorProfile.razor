@page "/creator/{handle}"
@inject EngineApiClient Engine
@inject NavigationManager Nav
@using PageToMovie.Core.Models

<PageTitle>Creator Profile - @(Handle ?? "")</PageTitle>

@if (_loading)
{
    <CenteredSpinner HiddenText="Loading creator profile..." />
}
else if (!string.IsNullOrEmpty(_error))
{
    <InlineAlert Variant="danger" CssClass="my-4">
        <h4>Creator Not Found</h4>
        <p>@_error</p>
        <a href="demo" class="btn btn-outline-primary mt-2">← Back to Gallery</a>
    </InlineAlert>
}
else if (_profile is not null)
{
    <div class="container py-3">
        <div class="mb-3">
            <a href="demo" class="btn btn-sm btn-outline-secondary">← Public Gallery</a>
        </div>

        <CreatorProfileHeader Profile="_profile" />

        <h3 class="mt-4 mb-3">Published Movies by @@@_profile.Username</h3>

        @if (_demos is null || _demos.Count == 0)
        {
            <EmptyState Message="@($"No public movies published yet by @{_profile.Username}.")"
                        CssClass="text-muted p-4 border border-secondary rounded bg-dark" />
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 g-4">
                @foreach (var d in _demos)
                {
                    <div class="col">
                        <div class="card h-100 bg-dark border-secondary text-white shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title text-primary">@d.Title</h5>
                                @if (!string.IsNullOrWhiteSpace(d.Description))
                                {
                                    <p class="card-text text-muted small mb-3">@d.Description</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(d.YoutubeId))
                                {
                                    var ytWatchUrl = !string.IsNullOrWhiteSpace(d.YoutubeUrl)
                                        ? d.YoutubeUrl
                                        : $"https://www.youtube.com/watch?v={d.YoutubeId}";
                                    var thumbUrl = $"https://img.youtube.com/vi/{d.YoutubeId}/hqdefault.jpg";

                                    <div class="ratio ratio-16x9 mb-3 rounded overflow-hidden position-relative">
                                        <a href="@ytWatchUrl" target="_blank" rel="noopener" class="d-block w-100 h-100 position-relative text-decoration-none" title="Watch '@d.Title' on YouTube">
                                            <img src="@thumbUrl" alt="@d.Title" style="width:100%; height:100%; object-fit:cover;" />
                                            <div class="position-absolute top-50 start-50 translate-middle text-center">
                                                <div class="btn btn-danger btn-lg rounded-circle shadow px-3 py-2" style="background:#ff0000; border:none; box-shadow:0 4px 15px rgba(255,0,0,0.5);">
                                                    <span class="fs-4">▶</span>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                }

                            </div>
                            <div class="card-footer border-secondary d-flex justify-content-between align-items-center small text-muted">
                                <span>Published @d.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                                <span class="text-warning fw-bold">★ @d.UpvoteCount Upvotes</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}
