@page "/admin"
@implements IAsyncDisposable
@inject EngineApiClient Api
@inject AdminSessionService Session
@inject JobHubClient Hub
@inject NavigationManager Nav
@inject ClientMediaFolderService MediaFolder
@inject IJSRuntime Js
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Admin — PageToMovie</PageTitle>

<div class="container-fluid py-3">
    <AdminPageHeader Title="Admin dashboard">
        <Subtitle>
            Live ops · SignalR <code>admin:ops</code>
            @if (_hubLive)
            {
                <span class="badge text-bg-success ms-1">live</span>
            }
            else
            {
                <span class="badge text-bg-secondary ms-1">poll 5s</span>
            }
        </Subtitle>
        <Actions>
            @if (Session.IsAuthenticated)
            {
                <span class="badge text-bg-secondary">@Session.UserId</span>
                <button class="btn btn-sm btn-outline-info" @onclick="ExportLogsAsync" disabled="@(_archiveBusy && _archiveAction == "export_logs")" title="Download zip archive of all server logs, prompts, edit history, and system state">
                    @(_archiveBusy && _archiveAction == "export_logs" ? "Exporting logs…" : "📥 Download Server Logs")
                </button>
                <button class="btn btn-sm btn-outline-warning" @onclick="OpenTestEmailModal" title="Send a test outbound email and verify server mail sender configuration">
                    ✉️ Test Email
                </button>
                <a href="/admin/demos" class="btn btn-sm btn-outline-primary" title="Connect YouTube channel & sync gallery">🎬 YouTube gallery</a>
                <a href="/admin/models-catalog" class="btn btn-sm btn-outline-primary" title="Manage model catalog entries and enablement toggles">🤖 Models Catalog</a>
                <a href="/admin/ai-calls" class="btn btn-sm btn-outline-primary" data-testid="admin-link-ai-calls" title="AI/model call analytics — success, retries, cost, failures">🔁 AI Calls</a>
                <a href="/admin/generation-errors" class="btn btn-sm btn-outline-primary" data-testid="admin-link-generation-errors" title="Transient-retry and partial-coverage events per call">⚠️ Generation Errors</a>
                <a href="/admin/book-cache" class="btn btn-sm btn-outline-primary" title="Book text registry, adaptation cache, xAI file_id">📚 Book cache</a>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ExpandAllCards" title="Expand all card sections">📂 Expand All</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CollapseAllCards" title="Collapse all card sections">📁 Collapse All</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync" disabled="@_busy">Refresh</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="LogoutAsync">Log out</button>
            }
        </Actions>
    </AdminPageHeader>

    @if (!_started)
    {
        <p class="text-muted">Loading admin session…</p>
    }
    else if (!Session.IsAdmin)
    {
        <InlineAlert Variant="warning">Admin session required. <a href="/admin/login">Sign in</a></InlineAlert>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <InlineAlert Message="@_error" />
        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync">Retry</button>
    }
    else if (_state is null)
    {
        <p class="text-muted">Loading server state…</p>
    }
    else
    {
        <InlineAlert Message="@_actionMsg" Variant="info" CssClass="py-2" />

        @* ── Quick Status KPI Bar ───────────────────────────────────────── *@
        <div class="row g-2 mb-3 align-items-center">
            <div class="col-6 col-sm-4 col-md-2">
                <div class="p-2 rounded bg-dark border border-secondary text-light text-center small">
                    <div class="text-muted" style="font-size: 0.75rem;">ACTIVE JOBS</div>
                    <div class="fw-bold text-info fs-5">@(_state.Jobs?.Count ?? 0)</div>
                </div>
            </div>
            <div class="col-6 col-sm-4 col-md-2">
                <div class="p-2 rounded bg-dark border border-secondary text-light text-center small">
                    <div class="text-muted" style="font-size: 0.75rem;">RESOURCE LOCKS</div>
                    <div class="fw-bold text-warning fs-5">@_locks.Count</div>
                </div>
            </div>
            <div class="col-6 col-sm-4 col-md-2">
                <div class="p-2 rounded bg-dark border border-secondary text-light text-center small">
                    <div class="text-muted" style="font-size: 0.75rem;">UPTIME / HEAP</div>
                    <div class="fw-bold text-success fs-6">@FormatUptime(_state.Process?.UptimeSec ?? 0)</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@(_state.Process?.GcHeapMb ?? 0) MB heap</div>
                </div>
            </div>
            <div class="col-6 col-sm-4 col-md-3">
                <div class="p-2 rounded bg-dark border border-secondary text-light text-center small">
                    <div class="text-muted" style="font-size: 0.75rem;">HTTP TRAFFIC (5s)</div>
                    <div class="fw-bold text-primary fs-6">@(_state.Http?.NonAdminLast5Sec ?? 0) non-admin reqs</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@(_state.Http?.RequestsLast5Sec ?? 0) total (30s: @(_state.Http?.NonAdminLast30Sec ?? 0))</div>
                </div>
            </div>
            <div class="col-12 col-sm-4 col-md-3">
                <div class="p-2 rounded bg-dark border border-secondary text-light text-center small">
                    <div class="text-muted" style="font-size: 0.75rem;">STORAGE FREE</div>
                    <div class="fw-bold text-success fs-6">@(_state.Disk?.FormattedFree ?? "—")</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@(_state.Disk?.UsedPercent ?? 0)% used of @(_state.Disk?.FormattedTotal ?? "—")</div>
                </div>
            </div>
        </div>

        @if (_state.Http is { } http && http.NonAdminLast5Sec <= 2)
        {
            <div class="alert alert-warning py-2 small mb-3">
                <strong>HTTP Traffic Note:</strong> LoadSim does not appear to be hitting this API (only admin poll).
                Check LoadSim console: “running…”, baseUrl <code>http://127.0.0.1:5088</code>, project <code>LoadSimBuster</code>.
                @if (http.ByPrefixLast5Sec is { Count: > 0 } pref)
                {
                    <div class="mt-1 font-monospace" style="font-size:0.75rem;">
                        @foreach (var kv in pref.OrderByDescending(k => k.Value).Take(8))
                        {
                            <span class="me-2">@kv.Key=@(kv.Value)</span>
                        }
                    </div>
                }
            </div>
        }

        @* ── Section 1: Active Jobs & Resource Locks (Expanded by Default) ─── *@
        <Admin_CollapsibleCard Title="⚡ Active Jobs & Resource Locks"
                               Expanded="_showJobsAndLocks"
                               ExpandedChanged="@(v => _showJobsAndLocks = v)">
                    <div class="row g-3">
                        <div class="col-lg-7">
                            <div class="card border">
                                <div class="card-header d-flex justify-content-between py-2">
                                    <span class="fw-semibold">Jobs (running / queued)</span>
                                    <span class="badge text-bg-primary">@(_state.Jobs?.Count ?? 0)</span>
                                </div>
                                <div class="card-body p-0">
                                    @if (MediaFolder.IsSyncing)
                                    {
                                        <div class="p-3 border-bottom bg-light">
                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                                <div>
                                                    <span class="spinner-border spinner-border-sm text-primary me-2" role="status" aria-hidden="true"></span>
                                                    <strong>Syncing MP4 clips to client disk…</strong>
                                                    @if (!string.IsNullOrEmpty(MediaFolder.SyncCurrentFile))
                                                    {
                                                        <span class="text-muted ms-2"><code>@MediaFolder.SyncCurrentFile</code></span>
                                                    }
                                                </div>
                                                <div class="d-flex align-items-center gap-2" style="min-width: 180px;">
                                                    <div class="progress flex-grow-1" style="height: 6px;">
                                                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" style="width: @(MediaFolder.SyncPercent)%"></div>
                                                    </div>
                                                    <span class="small font-monospace">@MediaFolder.SyncCurrent / @MediaFolder.SyncTotal</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    @if (_state.Jobs?.Items is { Count: > 0 } items)
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-striped mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Job</th>
                                                        <th>User</th>
                                                        <th>Kind</th>
                                                        <th>Scene</th>
                                                        <th>Status</th>
                                                        <th>Progress</th>
                                                        <th>Age</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var j in items)
                                                    {
                                                        var selected = string.Equals(j.JobId, _logJobId, StringComparison.OrdinalIgnoreCase);
                                                        <tr class="@(selected ? "table-active" : null)">
                                                            <td class="font-monospace small">@(ShortId(j.JobId))</td>
                                                            <td>@(j.UserId ?? "—")</td>
                                                            <td>@(j.Kind ?? "—")</td>
                                                            <td>@(j.Scene?.ToString() ?? "—")</td>
                                                            <td>@(j.Status ?? "—")</td>
                                                            <td>@(j.Total > 0 ? $"{j.Index}/{j.Total}" : "—")</td>
                                                            <td>@FormatAge(j.AgeMs)</td>
                                                            <td class="text-nowrap">
                                                                <button class="btn btn-sm btn-outline-primary me-1"
                                                                        disabled="@(string.IsNullOrEmpty(j.JobId))"
                                                                        title="Load job log"
                                                                        @onclick="() => LoadJobLogAsync(j.JobId!)">
                                                                    Log
                                                                </button>
                                                                <button class="btn btn-sm btn-outline-danger"
                                                                        disabled="@_busy || string.IsNullOrEmpty(j.JobId)"
                                                                        @onclick="() => CancelJobAsync(j.JobId!)">
                                                                    Cancel
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted p-3 mb-0">No active jobs.</p>
                                    }

                                    <div class="border-top p-3">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                            <div class="small fw-semibold">Job log</div>
                                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                                <input class="form-control form-control-sm font-monospace"
                                                       style="width: 12rem;"
                                                       placeholder="Job id…"
                                                       @bind="_logJobIdInput"
                                                       @bind:event="oninput"
                                                       title="Paste a job id from Home / Characters or this table" />
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        disabled="@(string.IsNullOrWhiteSpace(_logJobIdInput))"
                                                        @onclick="() => LoadJobLogAsync(_logJobIdInput.Trim())">
                                                    Load
                                                </button>
                                                @if (_jobLog is not null)
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearJobLog">Clear</button>
                                                }
                                            </div>
                                        </div>
                                        <InlineAlert Message="@_logError" Variant="warning" CssClass="py-1 small mb-2" />
                                        @if (_jobLog is null)
                                        {
                                            <p class="text-muted small mb-0">
                                                Click <strong>Log</strong> on a running job, or paste a job id.
                                                Cast “Build cast” is not a job (no log) — use Characters admin details after extract.
                                            </p>
                                        }
                                        else
                                        {
                                            <div class="small mb-2">
                                                <code>@_jobLog.JobId</code>
                                                · @(_jobLog.Kind ?? "—")
                                                · <span class="badge text-bg-secondary">@(_jobLog.Status ?? "—")</span>
                                                @if (!string.IsNullOrWhiteSpace(_jobLog.ProjectId))
                                                {
                                                    <span class="text-muted"> · @_jobLog.ProjectId</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(_jobLog.Message))
                                                {
                                                    <div class="text-muted mt-1">@_jobLog.Message</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(_jobLog.Error))
                                                {
                                                    <div class="text-danger mt-1">@_jobLog.Error</div>
                                                }
                                            </div>
                                            <pre class="small mb-0 p-2 rounded border bg-dark text-light"
                                                 style="max-height: 22rem; overflow: auto; white-space: pre-wrap;">@JobLogText</pre>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="card border">
                                <div class="card-header d-flex justify-content-between py-2">
                                    <span class="fw-semibold">Locks</span>
                                    <span class="badge text-bg-secondary">@_locks.Count</span>
                                </div>
                                <div class="card-body p-0">
                                    @if (_locks.Count == 0)
                                    {
                                        <p class="text-muted p-3 mb-0 small">No active locks.</p>
                                    }
                                    else
                                    {
                                        <ul class="list-group list-group-flush small">
                                            @foreach (var l in _locks.Take(20))
                                            {
                                                <li class="list-group-item d-flex justify-content-between align-items-start py-2">
                                                    <div>
                                                        <code>@l.Resource</code>
                                                        <div>@l.UserId
                                                            @if (!string.IsNullOrEmpty(l.Reason))
                                                            {
                                                                <span class="text-muted"> · @l.Reason</span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <button class="btn btn-sm btn-outline-warning"
                                                            disabled="@_busy || string.IsNullOrEmpty(l.Resource)"
                                                            @onclick="() => ReleaseLockAsync(l.Resource!)">
                                                        Force release
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
        </Admin_CollapsibleCard>

        @* ── Section 2: Project Export, Import & Music Synthesis (Expanded by Default) ── *@
        <div class="card mb-3 border shadow-sm">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 user-select-none"
                 style="cursor: pointer;"
                 @onclick="ToggleProjectArchiving">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">📦</span>
                    <strong>Project Export, Import &amp; Music Synthesis</strong>
                    <span class="badge bg-secondary">@_projectOptions.Count projects</span>
                </div>
                <div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick:stopPropagation="true" @onclick="ToggleProjectArchiving">
                        @(_showProjectArchiving ? "▲ Collapse" : "▼ Expand")
                    </button>
                </div>
            </div>
            @if (_showProjectArchiving)
            {
                <div class="card-body p-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="fw-semibold small mb-2">Export (download zip)</div>
                            <p class="small text-muted mb-2">
                                Stage 1: server project folder. Stage 2: merge MP4/MP3/etc. from your
                                connected media folder under this project id. Connect the media folder first for a complete archive.
                            </p>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <select class="form-select form-select-sm" style="max-width: 16rem;"
                                        @bind="_exportProjectId"
                                        disabled="@(_archiveBusy || _projectOptions.Count == 0)">
                                    @if (_projectOptions.Count == 0)
                                    {
                                        <option value="">No projects</option>
                                    }
                                    else
                                    {
                                        @foreach (var p in _projectOptions)
                                        {
                                            <option value="@p">@p</option>
                                        }
                                    }
                                </select>
                                <button type="button" class="btn btn-sm btn-primary"
                                        disabled="@(_archiveBusy || string.IsNullOrWhiteSpace(_exportProjectId))"
                                        @onclick="ExportProjectAsync">
                                    @(_archiveBusy && _archiveAction == "export" ? "Exporting…" : "Download full project + media")
                                </button>
                            </div>
                            <p class="form-text mb-0 mt-1">
                                Includes <code>source/</code>, <code>assets/</code>, scenes, cast, book page PNGs, clips.
                            </p>
                        </div>
                        <div class="col-md-6">
                            <div class="fw-semibold small mb-2">Import (upload zip)</div>
                            <p class="small text-muted mb-2">
                                Stage 1: project files to the server. Stage 2: MP4/MP3/etc. into your
                                connected media folder (same layout as export). Connect the media folder first for a full restore.
                            </p>
                            <InputFile OnChange="OnImportFileSelected" accept=".zip,application/zip"
                                       class="form-control form-control-sm mb-2"
                                       disabled="@_archiveBusy" />
                            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                                <input class="form-control form-control-sm" style="max-width: 11rem;"
                                       placeholder="Optional new id"
                                       @bind="_importPreferredId"
                                       disabled="@_archiveBusy" />
                                <select class="form-select form-select-sm" style="max-width: 13rem;"
                                        @bind="_importTargetUserId"
                                        disabled="@_archiveBusy"
                                        title="Select a target user to own the imported project area">
                                    <option value="">Target owner: (unassigned / admin)</option>
                                    @foreach (var u in _userList)
                                    {
                                        <option value="@u">User: @u</option>
                                    }
                                </select>
                                <div class="form-check mb-0">
                                    <InputCheckbox class="form-check-input" id="importOverwrite" @bind-Value="_importOverwrite" />
                                    <label class="form-check-label small" for="importOverwrite">Overwrite</label>
                                </div>
                                <button type="button" class="btn btn-sm btn-success"
                                        disabled="@(_archiveBusy || _importFile is null)"
                                        @onclick="ImportProjectAsync">
                                    @(_archiveBusy && _archiveAction == "import" ? "Importing…" : "Import project")
                                </button>
                            </div>
                            <p class="form-text mb-0 mt-1">
                                Max ~512&nbsp;MB. Zip should contain <code>project.json</code> (optionally under a top folder).
                            </p>
                        </div>
                        <div class="col-md-12 mt-3 pt-3 border-top">
                            <div class="fw-semibold small mb-2">🎵 Augment &amp; Synthesize Project Music Scores</div>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <select class="form-select form-select-sm" style="max-width: 16rem;"
                                        @bind="_augmentProjectId"
                                        disabled="@(_archiveBusy || _projectOptions.Count == 0)">
                                    @if (_projectOptions.Count == 0)
                                    {
                                        <option value="">No projects</option>
                                    }
                                    else
                                    {
                                        @foreach (var p in _projectOptions)
                                        {
                                            <option value="@p">@p</option>
                                        }
                                    }
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        disabled="@(_archiveBusy || string.IsNullOrWhiteSpace(_augmentProjectId))"
                                        @onclick="AugmentMusicAsync">
                                    @(_archiveBusy && _archiveAction == "augment" ? "Composing Scores…" : "1. Compose Score Prompts")
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-success ms-1"
                                        disabled="@(_archiveBusy || string.IsNullOrWhiteSpace(_augmentProjectId))"
                                        @onclick="SynthesizeAudioAsync">
                                    @(_archiveBusy && _archiveAction == "synthesize" ? $"Synthesizing Audio ({_synthesizeCurrent}/{_synthesizeTotal})…" : "🎼 Synthesize Scene Audio Tracks (Skip Existing)")
                                </button>
                            </div>
                            @if (_archiveBusy && _archiveAction == "synthesize" && _synthesizeTotal > 0)
                            {
                                var pct = Math.Min(100, Math.Max(5, (int)Math.Round((double)_synthesizeCurrent / _synthesizeTotal * 100.0)));
                                <div class="progress mt-2 mb-1" style="height: 20px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                                         role="progressbar"
                                         style="width: @pct%"
                                         aria-valuenow="@pct"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        @_synthesizeCurrent / @_synthesizeTotal scenes (@pct%)
                                    </div>
                                </div>
                            }
                            <p class="form-text mb-0 mt-2">
                                1. <strong>Compose Score Prompts</strong> non-destructively enriches <code>blueprint.clips.grok.json</code> with AI background music score prompts across all scenes.<br/>
                                2. <strong>Synthesize Scene Audio Tracks</strong> checks each scene and queues AI stereo background music generation for any scene missing audio.
                            </p>
                            @if (_archiveBusy && _archiveAction == "synthesize")
                            {
                                <p class="form-text mb-0 mt-1">
                                    Local media folder:
                                    @if (MediaFolder.IsConnected)
                                    {
                                        <span class="text-success">connected (@MediaFolder.FolderName)</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">not connected — generated audio cannot be saved</span>
                                    }
                                    @if (!string.IsNullOrEmpty(MediaFolder.LastStatus))
                                    {
                                        <text> · </text><code>@MediaFolder.LastStatus</code>
                                    }
                                </p>
                            }
                        </div>
                    </div>
                    <InlineAlert Message="@_archiveMsg" Variant="info" CssClass="py-2 small mt-3 mb-0" />
                    <InlineAlert Message="@_archiveError" CssClass="py-2 small mt-3 mb-0" />
                </div>
            }
        </div>

        @* ── Section 3: LoadSim Performance & Telemetry (Collapsible) ─── *@
        <div class="card mb-3 border shadow-sm loadsim-panel">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 user-select-none"
                 style="background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%); color: #e2e8f0; cursor: pointer;"
                 @onclick="ToggleLoadSim">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">📊</span>
                    <strong>LoadSim Performance &amp; System Latency</strong>
                    @if (_loadSim?.Active == true)
                    {
                        <span class="badge bg-success">LIVE</span>
                    }
                    else if (_loadSim?.Latest is not null)
                    {
                        <span class="badge bg-secondary">@(_loadSim.Latest.Status ?? "idle")</span>
                    }
                    else
                    {
                        <span class="badge bg-dark">idle</span>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (_loadSim?.Latest is { } ls)
                    {
                        <span class="small me-2" style="opacity:0.9;">
                            run <code class="text-info">@ls.RunId</code> · @ls.Users VU · @ls.Scenario
                        </span>
                    }
                    <button type="button" class="btn btn-sm btn-outline-light" @onclick:stopPropagation="true" @onclick="ToggleLoadSim">
                        @(_showLoadSim ? "▲ Collapse" : "▼ Expand")
                    </button>
                </div>
            </div>
            @if (_showLoadSim)
            {
                <div class="card-body" style="background:#0b1220; color:#cbd5e1;">
                    @if (_loadSim?.Latest is null)
                    {
                        <p class="small mb-0" style="opacity:0.7;">
                            No LoadSim telemetry yet. Start LoadSim — it posts every 2s to
                            <code class="text-info">POST /api/loadsim/progress</code>.
                        </p>
                    }
                    else
                    {
                        var L = _loadSim.Latest;
                        <div class="row g-2 mb-3 text-center">
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val">@L.ActionsTotal.ToString("N0")</div>
                                    <div class="loadsim-kpi__lbl">actions</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val">@L.ActionsPerSec.ToString("0.0")</div>
                                    <div class="loadsim-kpi__lbl">actions/s</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val @(L.ErrorRate > 0.01 ? "text-warning" : "text-success")">
                                        @((L.ErrorRate * 100).ToString("0.00"))%
                                    </div>
                                    <div class="loadsim-kpi__lbl">error rate</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val">@L.BrowseP95Ms<span class="fs-6">ms</span></div>
                                    <div class="loadsim-kpi__lbl">browse p95</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val">@L.P50Ms<span class="fs-6">ms</span></div>
                                    <div class="loadsim-kpi__lbl">p50 latency</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val">@L.JobsSubmitted</div>
                                    <div class="loadsim-kpi__lbl">jobs ok</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val">@L.JobsRejected</div>
                                    <div class="loadsim-kpi__lbl">409 rejects</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="loadsim-kpi">
                                    <div class="loadsim-kpi__val @(L.Jobs5xx > 0 ? "text-danger" : "")">@L.Jobs5xx</div>
                                    <div class="loadsim-kpi__lbl">5xx</div>
                                </div>
                            </div>
                        </div>
                        @if (_chartWarning is { Length: > 0 } cw)
                        {
                            <InlineAlert Variant="warning" CssClass="py-1 small mb-2">
                                Charts failed to update: @cw
                                <button type="button" class="btn btn-sm btn-link p-0 ms-1 align-baseline" @onclick="UpdateChartsAsync">Retry</button>
                            </InlineAlert>
                        }
                        <div class="row g-3">
                            <div class="col-lg-6">
                                <div class="loadsim-chart-wrap">
                                    <div class="loadsim-chart-title">Throughput</div>
                                    <canvas id="chartLoadSimThroughput"></canvas>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="loadsim-chart-wrap">
                                    <div class="loadsim-chart-title">Latency &amp; errors</div>
                                    <canvas id="chartLoadSimLatency"></canvas>
                                </div>
                            </div>
                        </div>
                        @if (L.ActionLatency is { Count: > 0 } al)
                        {
                            <div class="mt-3">
                                <div class="loadsim-chart-title mb-1">Per-action latency (p95 desc)</div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-dark loadsim-action-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>action</th>
                                                <th class="text-end">count</th>
                                                <th class="text-end">p50</th>
                                                <th class="text-end">p95</th>
                                                <th class="text-end">p99</th>
                                                <th class="text-end">errs</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var a in al)
                                            {
                                                <tr class="@(a.P95Ms >= 1000 ? "table-warning" : null)">
                                                    <td class="font-monospace">@a.Action</td>
                                                    <td class="text-end font-monospace">@a.Count.ToString("N0")</td>
                                                    <td class="text-end font-monospace">@a.P50Ms<span class="text-secondary">ms</span></td>
                                                    <td class="text-end font-monospace fw-semibold">@a.P95Ms<span class="text-secondary">ms</span></td>
                                                    <td class="text-end font-monospace">@a.P99Ms<span class="text-secondary">ms</span></td>
                                                    <td class="text-end font-monospace @(a.Errors > 0 ? "text-warning" : "")">@a.Errors</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }

                    <div class="row g-3 mt-1">
                        <div class="col-12">
                            <div class="loadsim-chart-wrap loadsim-chart-wrap--tall">
                                <div class="loadsim-chart-title">
                                    Process memory
                                    @if (_state.Process is { } proc)
                                    {
                                        <span class="ms-2" style="font-weight:400; opacity:0.85;">
                                            WS <strong>@proc.WorkingSetMb</strong> MB · GC <strong>@proc.GcHeapMb</strong> MB · threads @proc.ThreadCount
                                        </span>
                                    }
                                </div>
                                <canvas id="chartProcessMemory"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* ── Section 4: Action & Camera Timing Telemetry (Collapsible) ─── *@
        <div class="card mb-3 border shadow-sm" style="background: #0f172a; color: #e2e8f0;">
            <div class="card-header border-bottom border-dark d-flex flex-wrap justify-content-between align-items-center gap-2 user-select-none"
                 style="background: rgba(255,255,255,0.03); cursor: pointer;"
                 @onclick="ToggleTimingTelemetry">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">⏱️</span>
                    <strong class="text-info">Action &amp; Camera Timing Telemetry</strong>
                    <span class="badge bg-success">SQLite Active</span>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <span class="badge bg-dark border border-secondary text-info">Hit Rate: @(_timingTelemetry?.Stats?.HitRatePercent.ToString("F1") ?? "0.0")%</span>
                    <span class="badge bg-dark border border-secondary text-success">MAE: @(_timingTelemetry?.Stats?.MeanAbsoluteErrorSec.ToString("F2") ?? "0.00")s Error</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-light ms-2" @onclick:stopPropagation="true" @onclick="ToggleTimingTelemetry">
                        @(_showTimingTelemetry ? "▲ Collapse" : "▼ Expand")
                    </button>
                </div>
            </div>
            @if (_showTimingTelemetry)
            {
                <div class="card-body">
                    <div class="d-flex justify-content-end mb-3">
                        <button class="btn btn-sm btn-outline-success border border-success" @onclick="SeedTimingDatabaseAsync" disabled="@_seedingTiming">
                            🌱 Seed Database with Benchmarks
                        </button>
                    </div>
                    @if (_seedingTiming)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="text-success fw-bold">🌱 Seeding Database with Ground-Truth Benchmark Categories...</span>
                                <span class="text-success">Executing</span>
                            </div>
                            <div class="progress" style="height: 8px; background: rgba(255,255,255,0.05);">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 100%;"></div>
                            </div>
                        </div>
                    }

                    <div class="row align-items-center">
                        <div class="col-md-4 mb-3 mb-md-0">
                            <div class="p-3 rounded" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                                <div class="text-muted small mb-1">DATABASE CACHE HIT RATE</div>
                                <div class="h2 text-success mb-1">@(_timingTelemetry?.Stats?.HitRatePercent.ToString("F1") ?? "0.0")%</div>
                                <div class="progress mb-2" style="height: 6px; background: rgba(255,255,255,0.08);">
                                    <div class="progress-bar bg-success" style="width: @(Math.Clamp(_timingTelemetry?.Stats?.HitRatePercent ?? 0.0, 0.0, 100.0))%;"></div>
                                </div>
                                <div class="small text-muted">@(_timingTelemetry?.Stats?.TotalHits ?? 0) Cache Hits · @(_timingTelemetry?.Stats?.TotalMisses ?? 0) Misses</div>
                            </div>
                            <div class="p-3 rounded mt-2" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                                <div class="text-muted small mb-1">ESTIMATE vs ACTUAL ACCURACY</div>
                                <div class="h2 text-info mb-1">@(_timingTelemetry?.Stats?.MeanAbsoluteErrorSec.ToString("F2") ?? "0.00")s</div>
                                <div class="progress mb-2" style="height: 6px; background: rgba(255,255,255,0.08);">
                                    <div class="progress-bar bg-info" style="width: 85%;"></div>
                                </div>
                                <div class="small text-muted">Mean Absolute Error (measured across scene cuts)</div>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="text-muted small mb-2 d-flex justify-content-between">
                                <span>CACHE HIT RATE &amp; ERROR TREND OVER TIME</span>
                                <span>Legend: <span class="text-success">■ Hit Rate (%)</span> · <span class="text-info">■ MAE (x10 sec)</span></span>
                            </div>
                            <svg viewBox="0 0 500 120" style="width:100%; height:120px; background: rgba(0,0,0,0.3); border-radius:6px; padding:10px;">
                                <line x1="40" y1="20" x2="480" y2="20" stroke="#334155" stroke-dasharray="2,2"/>
                                <line x1="40" y1="60" x2="480" y2="60" stroke="#334155" stroke-dasharray="2,2"/>
                                <line x1="40" y1="100" x2="480" y2="100" stroke="#334155"/>
                                
                                @if (_timingTelemetry?.Trend is { Count: > 0 } trendList)
                                {
                                    var count = trendList.Count;
                                    var stepX = count > 1 ? (440.0 - 50.0) / (count - 1) : 0;

                                    <polyline fill="none" stroke="#22c55e" stroke-width="3" points="@GetHitRatePolylinePoints()" />
                                    @for (int i = 0; i < count; i++)
                                    {
                                        var idx = i;
                                        var x = 50.0 + (idx * stepX);
                                        var hitRate = Math.Clamp(trendList[idx].HitRatePercent, 0.0, 100.0);
                                        var y = 100.0 - (hitRate / 100.0 * 80.0);
                                        <circle cx="@x.ToString("F1")" cy="@y.ToString("F1")" r="4" fill="#22c55e">
                                            <title>Hit Rate: @trendList[idx].HitRatePercent.ToString("F1")% (@trendList[idx].Timestamp)</title>
                                        </circle>
                                    }

                                    <polyline fill="none" stroke="#38bdf8" stroke-width="3" points="@GetMaePolylinePoints()" />
                                    @for (int i = 0; i < count; i++)
                                    {
                                        var idx = i;
                                        var x = 50.0 + (idx * stepX);
                                        var mae = Math.Clamp(trendList[idx].MeanAbsoluteErrorSec, 0.0, 2.0);
                                        var y = 100.0 - (mae / 2.0 * 80.0);
                                        <circle cx="@x.ToString("F1")" cy="@y.ToString("F1")" r="4" fill="#38bdf8">
                                            <title>MAE: @trendList[idx].MeanAbsoluteErrorSec.ToString("F2")s (@trendList[idx].Timestamp)</title>
                                        </circle>
                                    }

                                    @for (int i = 0; i < count; i++)
                                    {
                                        var idx = i;
                                        if (idx == 0 || idx == count - 1 || (count > 4 && idx == count / 2))
                                        {
                                            var x = 50.0 + (idx * stepX);
                                            var label = FormatTrendTimestamp(trendList[idx].Timestamp);
                                            @((MarkupString)$"<text x=\"{x:F1}\" y=\"115\" fill=\"#94a3b8\" font-size=\"10\" text-anchor=\"middle\">{label}</text>")
                                        }
                                    }
                                }
                                else
                                {
                                    @((MarkupString)"<text x=\"240\" y=\"65\" fill=\"#94a3b8\" font-size=\"11\" text-anchor=\"middle\">No telemetry trend snapshots recorded yet</text>")
                                }
                            </svg>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* ── Section 5: Generation Errors Panel (Collapsible) ───────────────── *@
        <div class="card mb-3 border shadow-sm">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 user-select-none"
                 style="cursor: pointer;"
                 @onclick="ToggleGenErrors">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">⚠️</span>
                    <strong>Generation Errors &amp; Quality Gates</strong>
                    <span class="badge bg-secondary">@(_genErrors?.Count ?? 0) logged</span>
                </div>
                <div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick:stopPropagation="true" @onclick="ToggleGenErrors">
                        @(_showGenErrors ? "▲ Collapse" : "▼ Expand")
                    </button>
                </div>
            </div>
            @if (_showGenErrors)
            {
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <select class="form-select form-select-sm" style="max-width: 14rem;" @bind="_genErrorTypeFilter" @bind:after="RefreshGenerationErrorsAsync">
                            <option value="">All error types</option>
                            <option value="partial_coverage">partial_coverage</option>
                            <option value="empty_response">empty_response</option>
                            <option value="http_error">http_error</option>
                            <option value="exception">exception</option>
                            <option value="structural_gate_failure">structural_gate_failure</option>
                        </select>
                        <select class="form-select form-select-sm" style="max-width: 16rem;" @bind="_genErrorProjectFilter" @bind:after="RefreshGenerationErrorsAsync">
                            <option value="">All projects</option>
                            @foreach (var p in _projectOptions)
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshGenerationErrorsAsync" disabled="@_genErrorsBusy">
                            @(_genErrorsBusy ? "Loading…" : "Refresh")
                        </button>
                        <span class="badge bg-secondary">@(_genErrors?.Count ?? 0) row(s)</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 small">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Stage</th>
                                    <th>Type</th>
                                    <th>Project</th>
                                    <th>Scene</th>
                                    <th>Coverage</th>
                                    <th>Attempt</th>
                                    <th>Resolved</th>
                                    <th>Message</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_genErrors is { Count: > 0 })
                                {
                                    @foreach (var e in _genErrors)
                                    {
                                        <tr>
                                            <td class="text-nowrap">@e.Ts</td>
                                            <td><code>@e.Stage</code></td>
                                            <td><span class="badge @GetGenErrorTypeBadgeClass(e.ErrorType)">@e.ErrorType</span></td>
                                            <td>@e.ProjectId</td>
                                            <td>@e.Scene</td>
                                            <td>
                                                @if (e.RequestedCount is not null)
                                                {
                                                    @($"{e.ReturnedCount ?? 0}/{e.RequestedCount}")
                                                }
                                                else if (e.HttpStatus is not null)
                                                {
                                                    @($"HTTP {e.HttpStatus}")
                                                }
                                            </td>
                                            <td>@e.Attempt</td>
                                            <td>
                                                @if (e.Resolved)
                                                {
                                                    <span class="text-success">yes</span>
                                                }
                                                else
                                                {
                                                    <span class="text-warning">no</span>
                                                }
                                            </td>
                                            <td class="text-truncate" style="max-width: 28rem;" title="@e.ErrorMessage">@e.ErrorMessage</td>
                                        </tr>
                                    }
                                }
                                else if (!_genErrorsBusy)
                                {
                                    <tr><td colspan="9" class="text-muted text-center py-3">No generation-error events recorded.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        @* ── Section 6: Storage, Memory & System Metrics (Collapsible) ──────── *@
        <div class="card mb-3 border shadow-sm">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 user-select-none"
                 style="cursor: pointer;"
                 @onclick="ToggleStorageAndCapacity">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">💾</span>
                    <strong>Server Capacity, Storage &amp; System Metrics</strong>
                    <span class="badge bg-secondary">@(_state.Disk?.FormattedFree ?? "—") free</span>
                </div>
                <div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick:stopPropagation="true" @onclick="ToggleStorageAndCapacity">
                        @(_showStorageAndCapacity ? "▲ Collapse" : "▼ Expand")
                    </button>
                </div>
            </div>
            @if (_showStorageAndCapacity)
            {
                <div class="card-body p-3">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border">
                                <div class="card-header py-2 fw-semibold">Process</div>
                                <div class="card-body small">
                                    <div>Uptime: <strong>@FormatUptime(_state.Process?.UptimeSec ?? 0)</strong></div>
                                    <div>Working set: <strong>@(_state.Process?.WorkingSetMb ?? 0) MB</strong></div>
                                    <div>GC heap: <strong>@(_state.Process?.GcHeapMb ?? 0) MB</strong></div>
                                    <div>Threads: <strong>@(_state.Process?.ThreadCount ?? 0)</strong></div>
                                    <div>Env: <strong>@(_state.Process?.Environment ?? "?")</strong></div>
                                    <div>Fakes: <strong>@((_state.Process?.UseFakes ?? false) ? "ON" : "off")</strong></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border">
                                <div class="card-header py-2 fw-semibold">Capacity</div>
                                <div class="card-body small">
                                    @if (_state.Capacity is { } c)
                                    {
                                        <div>MaxVideoInFlight: <strong>@c.MaxVideoInFlight</strong></div>
                                        <div>MaxVideoInFlightPerUser: <strong>@c.MaxVideoInFlightPerUser</strong></div>
                                        <div>MaxQueuePerUser: <strong>@c.MaxQueuePerUser</strong></div>
                                    }
                                    <div class="mt-2">
                                        API in-flight: <strong>@_apiInFlight</strong>
                                    </div>
                                    <div>Rejects: <strong>@_capacityRejects</strong> · Lock conflicts: <strong>@_lockConflicts</strong></div>
                                    <a class="btn btn-sm btn-link px-0" href="/admin/config">Edit capacity…</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border">
                                <div class="card-header py-2 fw-semibold">Projects</div>
                                <div class="card-body small">
                                    <div>Active: <strong>@(_state.Projects?.Active ?? "—")</strong></div>
                                    <div class="text-truncate" title="@_state.Projects?.Workspace">
                                        Workspace: <code class="small">@(_state.Projects?.Workspace ?? "—")</code>
                                    </div>
                                    <div class="mt-2 text-muted">
                                        Snapshot @(_state.GeneratedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border">
                                <div class="card-header py-2 fw-semibold">Disk Space &amp; Storage</div>
                                <div class="card-body small">
                                    <div class="text-truncate" title="@(_state.Disk?.VolumePath ?? "/data")">
                                        Volume: <code class="small">@(_state.Disk?.VolumePath ?? "/data")</code>
                                    </div>
                                    <div>Total size: <strong>@(_state.Disk?.FormattedTotal ?? "—")</strong></div>
                                    <div>Used: <strong>@(_state.Disk?.FormattedUsed ?? "—")</strong> (@(_state.Disk?.UsedPercent ?? 0)%)</div>
                                    <div>Free left: <strong class="text-success">@(_state.Disk?.FormattedFree ?? "—")</strong></div>
                                    <div class="progress mt-2" style="height: 6px;">
                                        <div class="progress-bar @GetDiskProgressBarClass(_state.Disk?.UsedPercent ?? 0)"
                                             role="progressbar"
                                             style="width: @(Math.Min(100, Math.Max(0, _state.Disk?.UsedPercent ?? 0)))%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (_state.DiskHistory is { Count: > 0 })
                    {
                        <div class="card border">
                            <div class="card-header d-flex justify-content-between align-items-center py-2">
                                <span>Daily Storage Usage History (Railway Volume <code>@(_state.Disk?.VolumePath ?? "/data")</code>)</span>
                                <span class="badge bg-secondary">@_state.DiskHistory.Count day(s) tracked</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover mb-0 small">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Used Space</th>
                                                <th>Free Space</th>
                                                <th>Total Capacity</th>
                                                <th>Daily Usage Change</th>
                                                <th>Usage %</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var snap in _state.DiskHistory)
                                            {
                                                <tr>
                                                    <td><strong>@snap.SnapshotDate</strong></td>
                                                    <td>@snap.FormattedUsed</td>
                                                    <td><span class="text-muted">@snap.FormattedFree</span></td>
                                                    <td>@snap.FormattedTotal</td>
                                                    <td>
                                                        @if (string.IsNullOrWhiteSpace(snap.FormattedDailyChange))
                                                        {
                                                            <span class="text-muted">—</span>
                                                        }
                                                        else if (snap.DailyChangeBytes > 0)
                                                        {
                                                            <span class="text-danger fw-semibold">@snap.FormattedDailyChange</span>
                                                        }
                                                        else if (snap.DailyChangeBytes < 0)
                                                        {
                                                            <span class="text-success fw-semibold">@snap.FormattedDailyChange</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">0 KB</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="progress flex-grow-1" style="height: 6px; min-width: 60px;">
                                                                <div class="progress-bar @GetDiskProgressBarClass(snap.UsedPercent)" style="width: @(snap.UsedPercent)%"></div>
                                                            </div>
                                                            <span>@snap.UsedPercent%</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <Admin_TestEmailModal Visible="_showTestEmailModal"
                          DefaultAddress="@Session.UserId"
                          OnClose="CloseTestEmailModal" />
</div>
