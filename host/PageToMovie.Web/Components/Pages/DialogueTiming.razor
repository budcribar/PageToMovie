@page "/dialogue-timing"
@using PageToMovie.Core.Models
@inject EngineApiClient Engine
@inject ClientDialogueTimingService Timing
@inject ClientVideoStitchService Stitch
@inject ActiveProjectState ActiveProject
@inject AdminSessionService Session
@inject IJSRuntime Js

<PageTitle>Dialogue timing · PageToMovie</PageTitle>

<style>
    .dt-row { border: 1px solid var(--bs-border-color, #333); border-radius: 10px; padding: 12px 14px; margin-bottom: 10px; }
    .dt-row.dt-warn { border-color: #b8860b; }
    .dt-row.dt-extra { border-style: dashed; opacity: .9; }
    .dt-row.dt-ok { border-color: #2e7d32; }
    .dt-label { width: 58px; flex-shrink: 0; font-size: .75rem; color: #93a3b8; text-transform: uppercase; letter-spacing: .04em; }
    .dt-line { display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px; flex-wrap: wrap; }
    .dt-w { display: inline-block; padding: 0 4px; border-radius: 4px; margin-right: 2px; }
    .dt-hit { background: rgba(52,199,89,.20); }
    .dt-miss { background: rgba(255,59,48,.22); }
    .dt-extra-w { background: rgba(255,204,0,.20); }
    .dt-time { font-size: .62rem; color: #93a3b8; margin-right: 7px; vertical-align: super; }
    .dt-timeline { position: relative; height: 20px; background: rgba(255,255,255,.05); border-radius: 5px; margin-top: 6px; overflow: hidden; }
    .dt-seg { position: absolute; top: 2px; bottom: 2px; background: rgba(147,197,253,.35); border-left: 1px solid rgba(147,197,253,.9); font-size: .58rem; color: #cbd5e1; overflow: hidden; white-space: nowrap; padding-left: 2px; }
    .dt-meta { font-size: .75rem; color: #93a3b8; }
</style>

<StudioPageHeader Kicker="Advanced" Title="Dialogue timing">
    Compare the script against what speech-to-text actually heard, per line — spot where the words, the timing, or the delineation are off.
</StudioPageHeader>

<InlineAlert Message="@_error" data-testid="dt-error" />

@if (_projects.Count > 0)
{
    <div class="d-flex flex-wrap gap-3 mb-3" style="max-width:720px;">
        <div style="flex:1 1 260px;">
            <label class="form-label small text-muted mb-1">Film</label>
            <select class="form-select" value="@_projectId" @onchange="SelectProjectAsync" disabled="@_busy" data-testid="dt-project">
                @foreach (var p in _projects)
                {
                    <option value="@p.Id">@(p.Label ?? p.Title ?? p.Id)</option>
                }
            </select>
        </div>
        @if (_sceneLines.Count > 0)
        {
            <div style="flex:0 0 160px;">
                <label class="form-label small text-muted mb-1">Scene</label>
                <select class="form-select" value="@_scene" @onchange="SelectSceneAsync" disabled="@_busy" data-testid="dt-scene">
                    @foreach (var s in _sceneLines)
                    {
                        <option value="@s.Scene">Scene @s.Scene @(HasCached(s.Scene) ? "✓" : "")</option>
                    }
                </select>
            </div>
        }
    </div>
}

@if (_loading)
{
    <p class="text-muted">Getting things ready…</p>
}
else if (_projects.Count == 0)
{
    <InlineAlert Variant="info" Message="No films yet — create one first, then come back." />
}
else if (_sceneLines.Count == 0)
{
    <InlineAlert Variant="info" Message="No dialogue found for this film yet — generate the shot plan first." />
}
else
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <button class="btn btn-primary btn-sm" disabled="@_busy" data-testid="dt-analyze" @onclick="AnalyzeAsync">
            @AnalyzeButtonLabel
        </button>
        @if (_current is not null)
        {
            <button class="btn btn-success btn-sm" disabled="@(_busy || !_dirty)" data-testid="dt-save" @onclick="SaveSceneAsync">
                @(_dirty ? "Save changes" : "Saved ✓")
            </button>
            <span class="dt-meta">
                @_current.Rows.Count line(s) · @(_current.Rows.Count(r => r.MatchScore >= 0.7)) clear ·
                @(_current.Rows.Count(r => r.Reviewed)) reviewed
            </span>
        }
        @if (!string.IsNullOrEmpty(_status))
        {
            <span class="small text-muted">@_status</span>
        }
    </div>

    @if (_current is null)
    {
        <div class="alert alert-secondary">
            This scene hasn't been analyzed yet. Click <strong>Analyze scene</strong> to run speech-to-text over its dialogue windows.
            (This scene has @(_sceneLines.FirstOrDefault(s => s.Scene == _scene)?.Lines.Count ?? 0) script line(s).)
        </div>
    }
    else
    {
        @foreach (var row in _current.Rows)
        {
            var scriptWords = SplitWords(row.ScriptText);
            var heardSet = TokenSet(row.HeardText);
            var scriptSet = TokenSet(row.ScriptText);
            var rowClass = TimingRowClass(row);

            <div class="@rowClass">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <div class="dt-meta">
                        @if (!string.IsNullOrEmpty(row.Speaker)) { <span class="fw-semibold text-body">@Pretty(row.Speaker)</span> }
                        else { <span class="fst-italic">Heard but not in script</span> }
                        @if (row.WindowEndSec > row.WindowStartSec)
                        {
                            <span> · @row.WindowStartSec.ToString("0.00")–@row.WindowEndSec.ToString("0.00")s</span>
                        }
                        <span> · match @((int)Math.Round(row.MatchScore * 100))%</span>
                        @if (row.Reviewed) { <span class="text-success"> · ✓ reviewed</span> }
                    </div>
                    <div class="d-flex gap-1 flex-shrink-0">
                        @if (row.WindowEndSec > row.WindowStartSec)
                        {
                            <button class="btn btn-sm btn-outline-secondary py-0" disabled="@_busy" @onclick="() => PlayWindowAsync(row)">▶</button>
                        }
                        <button class="btn btn-sm btn-outline-primary py-0" disabled="@_busy" @onclick="() => ToggleEdit(row)">
                            @(_editing.Contains(row) ? "Done" : "Edit")
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(row.ScriptText))
                {
                    <div class="dt-line">
                        <span class="dt-label">Script</span>
                        <span>
                            @foreach (var w in scriptWords)
                            {
                                var cls = heardSet.Contains(NormTok(w)) ? "dt-w dt-hit" : "dt-w dt-miss";
                                <span class="@cls">@w</span><text> </text>
                            }
                        </span>
                    </div>
                }

                <div class="dt-line">
                    <span class="dt-label">Heard</span>
                    <span>
                        @if (row.Words is { Count: > 0 })
                        {
                            @foreach (var wd in row.Words)
                            {
                                var cls = HeardWordClass(scriptSet, wd.Text);
                                <span class="@cls" title="@wd.StartSec.ToString("0.00")–@wd.EndSec.ToString("0.00")s">@wd.Text</span><span class="dt-time">@wd.StartSec.ToString("0.0")</span><text> </text>
                            }
                        }
                        else if (!string.IsNullOrEmpty(row.HeardText))
                        {
                            <span class="fst-italic">@row.HeardText</span>
                        }
                        else
                        {
                            <span class="text-danger">— nothing heard for this line —</span>
                        }
                    </span>
                </div>

                @if (row.Words is { Count: > 0 } && row.DurationSec > 0.01)
                {
                    <div class="dt-timeline">
                        @foreach (var wd in row.Words)
                        {
                            var left = Math.Clamp(wd.StartSec / row.DurationSec, 0, 1) * 100;
                            var width = Math.Clamp((wd.EndSec - wd.StartSec) / row.DurationSec, 0.002, 1) * 100;
                            <div class="dt-seg" style="left:@left.ToString(Ci)%; width:@width.ToString(Ci)%;" title="@wd.Text">@wd.Text</div>
                        }
                    </div>
                }

                @if (_editing.Contains(row))
                {
                    <div class="mt-2 pt-2 border-top">
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-0">Script (the intended line)</label>
                            <textarea class="form-control form-control-sm" rows="1" @bind="row.ScriptText" @bind:after="() => OnRowChanged(row)"></textarea>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-0">Heard (fix here if speech-to-text is wrong)</label>
                            <textarea class="form-control form-control-sm" rows="1" @bind="row.HeardText" @bind:after="() => OnRowChanged(row)"></textarea>
                        </div>
                        <div class="d-flex flex-wrap align-items-end gap-2">
                            <div>
                                <label class="form-label small text-muted mb-0">Start (s)</label>
                                <input type="number" step="0.05" class="form-control form-control-sm" style="width:104px;" @bind="row.WindowStartSec" @bind:after="() => OnRowChanged(row)" />
                            </div>
                            <div>
                                <label class="form-label small text-muted mb-0">End (s)</label>
                                <input type="number" step="0.05" class="form-control form-control-sm" style="width:104px;" @bind="row.WindowEndSec" @bind:after="() => OnRowChanged(row)" />
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => ReSttAsync(row)">Re-run STT on window</button>
                            <div class="form-check ms-1">
                                <input class="form-check-input" type="checkbox" id="rev-@_current.Rows.IndexOf(row)" @bind="row.Reviewed" @bind:after="MarkDirty" />
                                <label class="form-check-label small" for="rev-@_current.Rows.IndexOf(row)">Reviewed</label>
                            </div>
                        </div>
                        <div class="small text-muted mt-1">Script edits are stored on this review only — they don't rewrite the shot plan.</div>
                    </div>
                }
            </div>
        }
    }
}
