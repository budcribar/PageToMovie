@inherits PageToMovie.Web.Components.PageSliceComponent
@* Page-local to Characters — look & voice panel *@
@inject StudioCapabilityState Caps
@inject AdminSessionService Session
@inject IAppLocalizer L
@inject EngineApiClient Engine
@inject ClientMediaFolderService MediaFolder
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using PageToMovie.Core.Models
@using PageToMovie.Web.Services

@if (List._selected is { } selected)
{
    <div class="card mb-2 @(LookPipe._mode == Characters.Mode.PickSource ? "border-primary" : "")">
        <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center gap-2">
            <button type="button"
                    class="char-panel-toggle border-0 bg-transparent text-start p-0 flex-grow-1 d-flex justify-content-between align-items-center gap-2"
                    @onclick="() => LookEdit._panelPictureOpen = !LookEdit._panelPictureOpen">
                <span><strong>Look</strong></span>
                <span class="small text-muted">@(LookEdit._panelPictureOpen ? "▲" : "▼")</span>
            </button>
            @if (selected.Locked)
            {
                <button type="button" class="btn btn-sm btn-outline-warning" disabled="@Host._busy"
                        title="Unlock this character look so it can be changed"
                        @onclick="LookPipe.UnlockAsync"
                        @onclick:stopPropagation="true">@L["Common.Unlock"]</button>
            }
        </div>
        @if (LookEdit._panelPictureOpen)
        {
            <div class="card-body py-2">
                @if (LookPipe._mode == Characters.Mode.WaitingGenerate)
                {
                    <div class="alert alert-info mb-0 py-2">
                        Generating three looks for @selected.DisplayName…
                        @if (Jobs.JobRunning)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger ms-2 py-0"
                                    disabled="@Host._busy" @onclick="Jobs.CancelAsync">@L["Common.Cancel"]</button>
                        }
                    </div>
                }
                else if (LookPipe._mode == Characters.Mode.Compare && LookPipe._allCandidates.Count > 0)
                {
                    <div class="char-pick">
                        <div class="small fw-semibold mb-1">@L["CharactersPage.PickBestLook"]</div>
                        <p class="small text-muted mb-3 mb-md-2">
                            Click a picture to zoom and compare detail. Use <strong>Use this look</strong> only when you’ve chosen.
                        </p>
                        <div class="char-pick__grid" data-testid="char-pick-grid">
                            @foreach (var c in LookPipe._allCandidates)
                            {
                                <CharacterPickCard Label="@c.Label"
                                                   ImageUrl="@c.Url"
                                                   Selected="@(LookPipe._chosenCandidateKey == Characters.CharactersLookPipeline.CandidateKey(c))"
                                                   ShowZoomBadge="true"
                                                   FrameDisabled="@(Host._busy || Jobs.JobRunning)"
                                                   FrameTitle="@($"Click to save this look for {selected.DisplayName}")"
                                                   FrameAriaLabel="@($"Use look {c.Label}")"
                                                   OnFrameClick="@(() => LookPipe.LockCandidateAsync(c))"
                                                   UseLabel="@L["CharactersPage.UseThisLook"]"
                                                   UseTitle="Save as preferred look for film"
                                                   UseDisabled="@(Host._busy || Jobs.JobRunning)"
                                                   OnUse="@(() => LookPipe.LockCandidateAsync(c))"
                                                   UseTestId="char-use-look">
                                    <ExtraActions>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled="@(Host._busy || Jobs.JobRunning)"
                                                title="Zoom — inspect detail"
                                                @onclick="@(() => LookPipe.OpenLookZoom(c))">
                                            Zoom
                                        </button>
                                    </ExtraActions>
                                </CharacterPickCard>
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2"
                                disabled="@(Host._busy || Jobs.JobRunning)"
                                @onclick="LookPipe.BackToSource">
                            ← Change route
                        </button>
                    </div>

                    @* Full-screen zoom lightbox for detail compare *@
                    <Characters_LookZoom Visible="@(LookPipe._zoomCandidate is not null)"
                                         Label="@LookPipe._zoomCandidate?.Label"
                                         ImageUrl="@LookPipe._zoomCandidate?.Url"
                                         Scale="LookPipe._zoomScale"
                                         CanNavigate="@(LookPipe._allCandidates.Count >= 2)"
                                         UseDisabled="@(Host._busy || Jobs.JobRunning)"
                                         OnClose="LookPipe.CloseLookZoom"
                                         OnPrev="LookPipe.ZoomPrev"
                                         OnNext="LookPipe.ZoomNext"
                                         OnToggleScale="LookPipe.ToggleLookZoomScale"
                                         OnUse="LookPipe.LockFromZoomAsync" />
                }
                else if (LookPipe._mode == Characters.Mode.PickSource)
                {
                    @* Already have a preferred look *@
                    @if (selected.HasPreferred && LookPipe._pictureRoute == Characters.PictureRoute.Choose)
                    {
                        <div class="d-flex flex-wrap align-items-start gap-3 mb-2">
                            @if (List.PreferredImageUrl is { Length: > 0 } pu)
                            {
                                <img src="@pu" alt="Preferred" class="rounded border char-preferred-preview" />
                            }
                            <div class="flex-grow-1">
                                <div class="small fw-semibold mb-1">Preferred look saved</div>
                                <p class="small text-muted mb-2">This picture is used for film. Tweak it with words, or generate new looks.</p>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            disabled="@(Host._busy || Jobs.JobRunning)"
                                            @onclick="() => LookPipe.ChoosePictureRoute(Characters.PictureRoute.Generate)">
                                        @L["CharactersPage.GenerateNewLooks"]
                                    </button>
                                    <label class="btn btn-sm btn-outline-primary mb-0 @(Host._busy || Jobs.JobRunning ? "disabled" : "")">
                                        @L["CharactersPage.ReplaceWithUpload"]
                                        <InputFile OnChange="LookPipe.OnUploadRefAsync"
                                                   accept=".png,.jpg,.jpeg,.webp,.gif"
                                                   class="d-none"
                                                   disabled="@(Host._busy || Jobs.JobRunning)" />
                                    </label>
                                    @if (LookBook.CanUseBookPictures)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                disabled="@(Host._busy || Jobs.JobRunning)"
                                                @onclick="() => LookPipe.ChoosePictureRoute(Characters.PictureRoute.Book)">
                                            @L["CharactersPage.FromBookPictures"]
                                        </button>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            disabled="@(Host._busy || Jobs.JobRunning)"
                                            @onclick="@(() => LookPipe.RequestDeleteImage("preferred", 0))">
                                        @L["Common.Remove"]
                                    </button>
                                </div>
                                <CharacterLookPanel Description="@LookEdit._editDescription"
                                                    DescriptionChanged="LookEdit.OnLookDescriptionChanged"
                                                    VisualLock="@LookEdit._editVisualLock"
                                                    VisualLockChanged="LookEdit.OnLookVisualLockChanged"
                                                    ImageEditInstruction="@LookEdit._imageEditInstruction"
                                                    ImageEditInstructionChanged="LookEdit.OnImageEditInstructionChanged"
                                                    ShowDescription="false"
                                                    ShowImageEditInstruction="true"
                                                    Busy="@(Host._busy || Jobs.JobRunning)"
                                                    TestId="char-tweak-preferred">
                                    <Actions>
                                        <CapabilityLockedControl Enabled="Caps.ImageReady"
                                                                 BlockedReason="@StudioCapabilityState.ImageBlockedReason"
                                                                 SettingsHref="@StudioCapabilityState.ImageSettingsHref"
                                                                 TestId="char-tweak-preferred-cap">
                                            <button type="button" class="btn btn-primary btn-sm"
                                                    disabled="@(Host._busy || Jobs.JobRunning || string.IsNullOrWhiteSpace(LookEdit._imageEditInstruction))"
                                                    @onclick="LookPipe.StartRegenerateAsync"
                                                    data-testid="char-tweak-preferred-go">
                                                @L["CharactersPage.TweakFace"]
                                            </button>
                                        </CapabilityLockedControl>
                                    </Actions>
                                </CharacterLookPanel>
                            </div>
                        </div>

                        @* 3 Generated Variants Strip *@
                        @if (selected.Variants.Any(v => v.Exists))
                        {
                            <div class="mt-3 pt-2 border-top border-secondary border-opacity-25" data-testid="char-variants-gallery">
                                <div class="small fw-semibold text-muted mb-2">Generated options (3 variants):</div>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var v in selected.Variants.Where(x => x.Exists).OrderBy(x => x.Index))
                                    {
                                        var vIndex = v.Index ?? 1;
                                        var vUrl = Host.CacheBust(Engine.CharacterVariantUrl(Host._projectId, selected.Key, vIndex));
                                        var isSelected = selected.Locked && string.Equals(List.PreferredImageUrl, vUrl, StringComparison.OrdinalIgnoreCase);
                                        var cand = new Characters.Candidate
                                        {
                                            Kind = "variant",
                                            Index = vIndex,
                                            Label = $"Look #{vIndex}",
                                            Url = vUrl
                                        };
                                        <div class="border rounded p-1 text-center bg-dark"
                                             style="width: 120px; border-color: @(isSelected ? "#6366f1" : "#374151") !important; background: @(isSelected ? "rgba(99, 102, 241, 0.15)" : "#151922") !important;">
                                            <div class="position-relative mb-1" style="height: 100px; background: #000; overflow: hidden; border-radius: 4px; cursor: pointer;"
                                                 @onclick="() => LookPipe.OpenLookZoom(cand)" title="Click to zoom">
                                                <img src="@vUrl" alt="@cand.Label" style="width: 100%; height: 100%; object-fit: contain;" />
                                                @if (isSelected)
                                                {
                                                    <span class="badge bg-primary position-absolute top-0 end-0 m-1" title="Locked preferred look">✓ Locked</span>
                                                }
                                            </div>
                                            <div class="small text-light fw-semibold mb-1" style="font-size: 0.75rem;">@cand.Label</div>
                                            <button type="button" class="btn btn-sm w-100 @(isSelected ? "btn-outline-primary disabled" : "btn-primary") py-0"
                                                    style="font-size: 0.72rem;"
                                                    disabled="@(isSelected || Host._busy || Jobs.JobRunning)"
                                                    @onclick="() => LookPipe.LockCandidateAsync(cand)">
                                                @(isSelected ? "Active" : "Use this")
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else if (LookPipe._pictureRoute == Characters.PictureRoute.Choose)
                    {
                        <p class="small text-muted mb-2">How do you want the look for <strong>@selected.DisplayName</strong>?</p>
                        <div class="d-flex flex-column gap-2">
                            <button type="button"
                                    class="btn btn-outline-primary text-start"
                                    disabled="@(Host._busy || Jobs.JobRunning)"
                                    @onclick="() => LookPipe.ChoosePictureRoute(Characters.PictureRoute.Generate)"
                                    data-testid="char-route-generate">
                                <strong>@L["CharactersPage.GenerateFromDescription"]</strong>
                                <div class="small opacity-75">Edit look text → create 3 options → pick one</div>
                            </button>
                            <label class="btn btn-outline-primary text-start mb-0 @(Host._busy || Jobs.JobRunning ? "disabled" : "")"
                                    data-testid="char-route-upload">
                                <strong>@L["CharactersPage.UploadPhoto"]</strong>
                                <div class="small opacity-75">Your picture becomes the preferred look — no description needed</div>
                                <InputFile OnChange="LookPipe.OnUploadRefAsync"
                                            accept=".png,.jpg,.jpeg,.webp,.gif"
                                            class="d-none"
                                            disabled="@(Host._busy || Jobs.JobRunning)" />
                            </label>
                            @if (LookBook.CanUseBookPictures)
                            {
                                <button type="button"
                                        class="btn btn-outline-primary text-start"
                                        disabled="@(Host._busy || Jobs.JobRunning)"
                                        @onclick="() => LookPipe.ChoosePictureRoute(Characters.PictureRoute.Book)"
                                        data-testid="char-route-book">
                                    <strong>@L["CharactersPage.GuideFromBookPictures"]</strong>
                                    <div class="small opacity-75">Pick illustrations from the PDF, then generate looks from them</div>
                                </button>
                            }
                        </div>
                    }
                    else if (LookPipe._pictureRoute == Characters.PictureRoute.Generate)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-semibold">Generate from description</span>
                            <button type="button" class="btn btn-link btn-sm text-muted p-0"
                                    @onclick="() => LookPipe.ChoosePictureRoute(Characters.PictureRoute.Choose)">← Routes</button>
                        </div>
                        <CharacterLookPanel Description="@LookEdit._editDescription"
                                           DescriptionChanged="LookEdit.OnLookDescriptionChanged"
                                           VisualLock="@LookEdit._editVisualLock"
                                           VisualLockChanged="LookEdit.OnLookVisualLockChanged"
                                           ImageEditInstruction="@LookEdit._imageEditInstruction"
                                           ImageEditInstructionChanged="LookEdit.OnImageEditInstructionChanged"
                                           ShowImageEditInstruction="@(List.PreferredImageUrl is { Length: > 0 })"
                                           Busy="@(Host._busy || Jobs.JobRunning)"
                                           Hint="@(LookEdit._lookSaveHint ?? "Description saves automatically.")"
                                           TestId="char-look-panel">
                            <Actions>
                                <CapabilityLockedControl Enabled="Caps.ImageReady"
                                                         BlockedReason="@StudioCapabilityState.ImageBlockedReason"
                                                         SettingsHref="@StudioCapabilityState.ImageSettingsHref"
                                                         TestId="char-generate-looks-cap">
                                    <button type="button" class="btn btn-primary btn-sm"
                                            disabled="@(Host._busy || Jobs.JobRunning || (string.IsNullOrWhiteSpace(LookEdit._editDescription) && string.IsNullOrWhiteSpace(LookEdit._imageEditInstruction)))"
                                            @onclick="LookPipe.StartRegenerateAsync"
                                            data-testid="char-generate-looks">
                                        @(string.IsNullOrWhiteSpace(LookEdit._imageEditInstruction)
                                            ? "Generate 3 looks"
                                            : "Tweak face")
                                    </button>
                                </CapabilityLockedControl>
                                @if (LookEdit._savingLook)
                                {
                                    <span class="small text-muted">Saving…</span>
                                }
                            </Actions>
                        </CharacterLookPanel>
                    }
                    else if (LookPipe._pictureRoute == Characters.PictureRoute.Book)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-semibold">Guide from book pictures</span>
                            <button type="button" class="btn btn-link btn-sm text-muted p-0"
                                    @onclick="() => { LookBook._showBookCandidateGallery = false; LookPipe.ChoosePictureRoute(Characters.PictureRoute.Choose); }">← Routes</button>
                        </div>
                        <p class="small text-muted mb-2">
                            Select up to 3 illustrations that look like this character, then generate portraits guided by those pages.
                        </p>
                        @if (!LookBook._showBookCandidateGallery && !selected.BookRefs.Any(b => b.Exists))
                        {
                            <button type="button" class="btn btn-primary btn-sm"
                                    disabled="@(Host._busy || Jobs.JobRunning)"
                                    @onclick="LookBook.ToggleBookCandidateGalleryAsync">
                                Browse book pictures…
                            </button>
                        }
                        @if (selected.BookRefs.Any(b => b.Exists))
                        {
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                @foreach (var b in selected.BookRefs.Where(x => x.Exists))
                                {
                                    var bi = b.Index ?? 0;
                                    var src = !string.IsNullOrEmpty(b.Url)
                                        ? Host.CacheBust(b.Url)
                                        : Host.CacheBust(Engine.CharacterBookRefUrl(Host._projectId, selected.Key, bi));
                                    <div class="char-seed-tile-wrap">
                                        <div class="char-seed-tile char-seed-tile--on">
                                            <img src="@src" alt="Book" />
                                            <span class="char-seed-tile__label">Book</span>
                                        </div>
                                        <button type="button" class="char-seed-hide" title="Remove"
                                                disabled="@(Host._busy || Jobs.JobRunning)"
                                                @onclick="@(() => LookPipe.RequestDeleteImage("bookref", bi))">×</button>
                                    </div>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        disabled="@(Host._busy || Jobs.JobRunning)"
                                        @onclick="LookBook.ToggleBookCandidateGalleryAsync">
                                    Change book picks
                                </button>
                                <button type="button" class="btn btn-primary btn-sm"
                                        disabled="@(Host._busy || Jobs.JobRunning)"
                                        @onclick="LookPipe.StartBookGuidedGenerateAsync">
                                    Generate 3 looks from book
                                </button>
                            </div>
                        }

                        @if (LookBook._showBookCandidateGallery)
                        {
                            <div class="border border-secondary border-opacity-50 rounded p-3 mt-3 bg-dark bg-opacity-75 text-white shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="small text-light">Book pictures for @selected.DisplayName</strong>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => LookBook._showBookCandidateGallery = false">✕</button>
                                </div>
                                @if (LookBook._loadingBookCandidates)
                                {
                                    <div class="small text-muted py-2">Scanning book illustrations…</div>
                                }
                                else if (LookBook._rankedBookCandidates is null or { Count: 0 })
                                {
                                    <div class="small text-muted py-2">No book illustration candidates found for this project.</div>
                                }
                                else if (LookBook._rankedBookCandidates is { } candidates)
                                {
                                    <div class="d-flex flex-wrap gap-2 py-2" style="max-height: 320px; overflow-y: auto;">
                                        @foreach (var cand in candidates)
                                        {
                                            var isSel = LookBook._selectedBookCandidatePaths.Contains(cand.PathRel, StringComparer.OrdinalIgnoreCase);
                                            <div class="border rounded p-1 text-center bg-dark"
                                                 style="width: 110px; cursor: pointer; border-color: @(isSel ? "#6366f1" : "#374151"); background: @(isSel ? "rgba(99, 102, 241, 0.25)" : "#151922");"
                                                 @onclick="() => LookBook.ToggleBookCandidateSelection(cand.PathRel)">
                                                <div class="position-relative mb-1" style="height: 100px; background: #000; overflow: hidden; border-radius: 4px;">
                                                    <img src="@cand.Url" alt="@cand.Name" style="width: 100%; height: 100%; object-fit: contain;" />
                                                    @if (isSel)
                                                    {
                                                        <span class="badge bg-primary position-absolute top-0 end-0 m-1">✓</span>
                                                    }
                                                </div>
                                                <div class="small text-truncate text-light fw-semibold" style="font-size: 0.72rem;">@(cand.Page > 0 ? $"Page {cand.Page}" : cand.Name)</div>
                                            </div>
                                        }
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary border-opacity-50">
                                        <span class="small text-muted">@LookBook._selectedBookCandidatePaths.Count of 3 selected</span>
                                        <button type="button" class="btn btn-sm btn-success"
                                                disabled="@(Host._busy || LookBook._savingBookRefs || LookBook._selectedBookCandidatePaths.Count == 0)"
                                                @onclick="LookBook.ApplySelectedBookCandidatesAsync">
                                            @(LookBook._savingBookRefs ? "Saving…" : "Use selected")
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (LookPipe._pictureRoute == Characters.PictureRoute.Upload)
                    {
                        @* Upload is one-shot via InputFile on route cards; this branch is a fallback *@
                        <label class="btn btn-primary btn-sm mb-0">
                            Choose photo…
                            <InputFile OnChange="LookPipe.OnUploadRefAsync"
                                       accept=".png,.jpg,.jpeg,.webp,.gif"
                                       class="d-none"
                                       disabled="@(Host._busy || Jobs.JobRunning)" />
                        </label>
                        <button type="button" class="btn btn-link btn-sm" @onclick="() => LookPipe.ChoosePictureRoute(Characters.PictureRoute.Choose)">← Routes</button>
                    }
                }
            </div>
        }
    </div>

    @* Collapsible Voice Section — opens by default for a speaking role without a voice (see CharactersListState.VoiceCardOpensByDefault) *@
    @if (Voice.ShowVoiceFields(selected))
    {
        <div class="card mb-2" data-testid="char-voice-card">
            <div class="card-header py-1 px-2 d-flex justify-content-between align-items-center gap-2">
                <button type="button"
                        class="char-panel-toggle border-0 bg-transparent text-start p-0 flex-grow-1 d-flex justify-content-between align-items-center gap-2"
                        @onclick="() => LookEdit._panelVoiceOpen = !LookEdit._panelVoiceOpen">
                    <div>
                        <strong class="small">Voice</strong>
                        @* Same rule as cast readiness: a speaking role needs a voice before Film can generate. *@
                        @if (Characters.CharactersVoice.HasVoiceProfile(selected))
                        {
                            <span class="badge text-bg-success ms-1" style="font-size:0.65rem" data-testid="char-voice-badge">Profile set</span>
                        }
                        else if (selected.HasVoiceCloneSample)
                        {
                            <span class="badge text-bg-info text-dark ms-1" style="font-size:0.65rem" data-testid="char-voice-badge">Clone sample</span>
                        }
                        else if (selected.Speaks && !selected.IsGroup)
                        {
                            <span class="badge text-bg-warning text-dark ms-1" style="font-size:0.65rem" data-testid="char-voice-badge" title="This character speaks — pick or record a voice before generating video">Required — speaking role</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary ms-1" style="font-size:0.65rem" data-testid="char-voice-badge">Optional</span>
                        }
                    </div>
                    <span class="small text-muted">@(LookEdit._panelVoiceOpen ? "▲" : "▼")</span>
                </button>
            </div>
            @if (LookEdit._panelVoiceOpen)
            {
                <div class="card-body py-2" data-testid="char-voice-section">
                    <p class="small text-muted mb-2">
                        Describe the voice style, or record a clone sample below.
                    </p>
                    @if (selected.Speaks && !selected.IsGroup && !string.IsNullOrWhiteSpace(Voice._editVoiceProfile) && !VoiceProfileGuard.IsLocked(Voice._editVoiceProfile))
                    {
                        <div class="alert alert-warning py-1 px-2 small d-flex flex-wrap align-items-center gap-2 mb-2" data-testid="char-voice-sex-warning">
                            <span>⚠ @(VoiceProfileGuard.UnlockedReason(Voice._editVoiceProfile) is { } why ? char.ToUpperInvariant(why[0]) + why[1..] : VoiceProfileGuard.MissingSexWarning) — otherwise each clip may pick a different voice.</span>
                            <span class="ms-auto d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-dark py-0" disabled="@Host._busy" @onclick='() => Voice.SetVoiceSexAsync("male")'>Male</button>
                                <button type="button" class="btn btn-sm btn-outline-dark py-0" disabled="@Host._busy" @onclick='() => Voice.SetVoiceSexAsync("female")'>Female</button>
                                <button type="button" class="btn btn-sm btn-outline-dark py-0" disabled="@Host._busy" @onclick='() => Voice.SetVoiceSexAsync("boy")'>Boy</button>
                                <button type="button" class="btn btn-sm btn-outline-dark py-0" disabled="@Host._busy" @onclick='() => Voice.SetVoiceSexAsync("girl")'>Girl</button>
                            </span>
                        </div>
                    }
                    @Host.VoiceEditorUI()
                </div>
            }
        </div>
    }
    else
    {
        <div class="card mb-2" data-testid="char-voice-hidden-hint">
            <div class="card-body py-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <p class="small text-muted mb-0">
                    No voice profile — optional (e.g. animal / non-speaking).
                </p>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="() => { Voice._forceShowVoice = true; LookEdit._panelVoiceOpen = true; }">
                    Add voice…
                </button>
            </div>
        </div>
    }

    @if (List.HasAgeVariants(selected))
    {
        <div class="card mb-2" data-testid="char-age-variants">
            <div class="card-header py-1 px-2">
                <strong class="small">Age variants</strong>
            </div>
            <div class="card-body py-2">
                <p class="small text-muted mb-2">
                    @selected.DisplayName appears at more than one age in this story —
                    each life stage gets its own look and voice.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var sib in List.VariantSiblingsOf(selected))
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                disabled="@(Host._busy || Jobs.JobRunning)"
                                @onclick="() => List.SelectAsync(sib.Key)">
                            @Characters.CharactersListState.AgeVariantLabel(sib)
                        </button>
                    }
                </div>
            </div>
        </div>
    }
}
