<style>
.active-project-loading, .active-project-loading * { cursor: wait !important; }
</style>
@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime Js
@inject ActiveProjectState ActiveProject
@inject NavigationManager Nav
@inject EngineApiClient Engine
@inject AdminSessionService Session
@inject ClientMediaFolderService MediaFolder
@inject IWebAssemblyHostEnvironment Env
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using Microsoft.AspNetCore.WebUtilities
@using PageToMovie.Core.Auth
@using PageToMovie.Core.Options
@using PageToMovie.Web.Services

<div class="page @(_sidebarCollapsed ? "sidebar-collapsed" : null)">
    <div class="sidebar">
        <div class="sidebar-header py-3 px-3">
            <a class="navbar-brand sidebar-brand d-flex align-items-center gap-2" href="/" title="PageToMovie">
                <img src="/favicon.png" alt="Logo" width="38" height="38" class="rounded-3 flex-shrink-0 shadow-sm" />
                @if (!_sidebarCollapsed)
                {
                    <span class="fw-bold fs-5 mb-0">PageToMovie</span>
                }
            </a>
            <button type="button"
                    class="sidebar-toggle"
                    title="@(_sidebarCollapsed ? "Expand menu" : "Collapse menu")"
                    aria-label="@(_sidebarCollapsed ? "Expand menu" : "Collapse menu")"
                    @onclick="ToggleSidebarAsync">
                @(_sidebarCollapsed ? "»" : "«")
            </button>
        </div>
        <NavMenu Collapsed="_sidebarCollapsed" />
    </div>

    <main>
        @if (MediaFolder.IsSyncing)
        {
            <div class="py-2 px-3 mx-4 mt-3 mb-0 d-flex flex-wrap align-items-center justify-content-between gap-3 shadow rounded-3 border border-primary text-white" style="background-color: #0f172a !important; border-color: #3b82f6 !important;" role="status">
                <div class="d-flex align-items-center gap-2 flex-grow-1 overflow-hidden">
                    <span class="spinner-border spinner-border-sm text-info flex-shrink-0" role="status" aria-hidden="true"></span>
                    <span class="fw-bold text-white text-nowrap">Downloading project media to local folder…</span>
                    @if (!string.IsNullOrEmpty(MediaFolder.SyncCurrentFile))
                    {
                        <span class="badge font-monospace text-truncate ms-1" style="max-width: 320px; font-size: 0.75rem; background-color: #1e293b !important; color: #93c5fd !important; border: 1px solid #334155;" title="@MediaFolder.SyncCurrentFile">@MediaFolder.SyncCurrentFile</span>
                    }
                </div>
                <div class="d-flex align-items-center gap-3 flex-shrink-0" style="min-width: 220px;">
                    <div class="progress flex-grow-1" style="height: 8px; background-color: #1e293b; border-radius: 4px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-info"
                             role="progressbar"
                             style="width: @(MediaFolder.SyncPercent)%"
                             aria-valuenow="@MediaFolder.SyncPercent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <span class="small font-monospace fw-bold text-white text-nowrap" style="color: #ffffff !important;">@MediaFolder.SyncCurrent / @MediaFolder.SyncTotal (@(MediaFolder.SyncPercent)%)</span>
                </div>
            </div>
        }
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<TermsAgreementModal IsOpen="@_showTermsModal" UserId="@_currentUserId" OnAccepted="OnTermsAccepted" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
