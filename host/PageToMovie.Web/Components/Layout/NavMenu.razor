@inject AdminSessionService Session
@inject ActiveProjectState ActiveProject
@inject EngineApiClient Engine
@inject ThemeState Theme
@inject ClientMediaFolderService MediaFolder
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject IAppLocalizer L
@implements IDisposable

@* Mobile hamburger (desktop collapse is on MainLayout) *@
<input type="checkbox" title="Navigation menu" class="navbar-toggler" id="nav-toggler" />

<div class="nav-scrollable @(Collapsed ? "nav-collapsed" : null)"
     onclick="document.querySelector('.navbar-toggler')?.click()">
    <nav class="nav flex-column nav-main" aria-label="Main">
        <div class="nav-main-links">
        @* Prototype look-feel: Home · Demo · Settings, then project studio pipeline *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All" title="Home & Studio Overview" data-testid="nav-studio">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                @if (!Collapsed) { <span class="nav-label">@L["Nav.Home"]</span> }
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/demo" title="Public demo gallery — no sign-in required" data-testid="nav-demo">
                <span class="bi bi-film-nav-menu" aria-hidden="true"></span>
                @if (!Collapsed) { <span class="nav-label">@L["Nav.Demo"]</span> }
            </NavLink>
        </div>

        @* Settings always available once signed in. *@
        @if (Session.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/configuration" title="Settings — API keys, models, media folder" data-testid="nav-configuration">
                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">@L["Nav.Settings"]</span> }
                </NavLink>
            </div>
        }

        @if (ActiveProject.HasProject)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/adaptation" Match="NavLinkMatch.Prefix" title="Book & screenplay (studio)" data-testid="nav-adaptation">
                    <span class="bi bi-book-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">@L["Nav.Book"]</span> }
                </NavLink>
            </div>

            <NavMenu_NavItem Enabled="@(ActiveProject.CanCharacters)" Href="/characters" Title='@(ActiveProject.CanCharacters ? "Cast & voices" : ActiveProject.CharactersBlockedReason)' IconClass="bi-people-fill-nav-menu" Label='@(L["Nav.Cast"])' TestId="nav-characters" Collapsed="Collapsed" />

            <NavMenu_NavItem Enabled="@(ActiveProject.CanCharacters)" Href="/locations" Title='@(ActiveProject.CanCharacters ? "Locations & set plates" : ActiveProject.CharactersBlockedReason)' IconClass="bi-geo-alt-fill" Label="Locs" TestId="nav-locations" Collapsed="Collapsed" />

            <NavMenu_NavItem Enabled="@(ActiveProject.CanScenes)" Href="/scenes" Title='@(ActiveProject.CanScenes ? "Scenes & film" : ActiveProject.ScenesBlockedReason)' IconClass="bi-film-nav-menu" Label='@(L["Nav.Film"])' TestId="nav-scenes" Collapsed="Collapsed" />

            <NavMenu_NavItem Enabled="@(ActiveProject.CanReview)" Href="/review" Title='@(ActiveProject.CanReview ? "Review" : ActiveProject.ReviewBlockedReason)' IconClass="bi-check2-square-nav-menu" Label='@(L["Nav.Review"])' TestId="nav-review" Collapsed="Collapsed" />
        }

        @* Estimate always available when signed in — cost breakdown + account spend. *@
        @if (Session.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/cost" title="Estimate & cost — quote, spend, by vendor" data-testid="nav-cost">
                    <span class="bi bi-cash-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">@L["Nav.Estimate"]</span> }
                </NavLink>
            </div>
        }



        @if (Session.IsAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin" title="Admin">
                    <span class="bi bi-shield-lock-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">@L["Nav.Admin"]</span> }
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/users" title="Users & credits" data-testid="nav-admin-users">
                    <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">@L["Nav.UsersAndCredits"]</span> }
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/config" title="Admin config">
                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">@L["Nav.AdminConfig"]</span> }
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/models-catalog" title="Models catalog manager" data-testid="nav-admin-models-catalog">
                    <span class="bi bi-robot-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">@L["Nav.ModelsCatalog"]</span> }
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/learning" title="Learning from reviews" data-testid="nav-learning">
                    <span class="bi bi-lightbulb-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">@L["Nav.Learning"]</span> }
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/book-cache" title="Book text, adaptation artifacts, xAI file_id" data-testid="nav-admin-book-cache">
                    <span class="bi bi-book-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">@L["Nav.BookCache"]</span> }
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/dialogue-timing" title="Compare script vs speech-to-text per line, all speakers" data-testid="nav-admin-dialogue-timing">
                    <span class="bi bi-mic-fill-nav-menu" aria-hidden="true"></span>
                    @if (!Collapsed) { <span class="nav-label">@L["Nav.DialogueTiming"]</span> }
                </NavLink>
            </div>
        }
        </div>@* /nav-main-links *@

        <div class="nav-user-footer"
             @onclick:stopPropagation="true">
            @if (Session.IsLoggedIn)
            {
                <div class="nav-user-menu @(_userMenuOpen ? "is-open" : null) @(Collapsed ? "is-collapsed" : null)">
                    <button type="button"
                            class="nav-user-trigger"
                            data-testid="nav-user-menu"
                            title="@Session.DisplayHandle — account menu"
                            aria-expanded="@_userMenuOpen"
                            aria-haspopup="menu"
                            @onclick="ToggleUserMenu"
                            @onclick:stopPropagation="true">
                        <span class="nav-user-avatar" aria-hidden="true">@UserInitials</span>
                        @if (!Collapsed)
                        {
                            <span class="nav-user-meta">
                                <span class="nav-user-name text-truncate">@Session.DisplayHandle</span>
                                <span class="nav-user-role">@(Session.IsAdmin ? "Admin" : "Account")</span>
                            </span>
                            <span class="nav-user-caret" aria-hidden="true">@(_userMenuOpen ? "▴" : "▾")</span>
                        }
                    </button>
                    @if (_userMenuOpen)
                    {
                        <button type="button"
                                class="nav-user-backdrop"
                                aria-label="Close account menu"
                                @onclick="CloseUserMenu"></button>
                        <div class="nav-user-dropdown" role="menu" @onclick:stopPropagation="true">
                            <div class="nav-user-dropdown-head">
                                <span class="nav-user-avatar nav-user-avatar--lg" aria-hidden="true">@UserInitials</span>
                                <div class="nav-user-dropdown-id">
                                    <div class="nav-user-name text-truncate">@Session.DisplayHandle</div>
                                    <div class="nav-user-role">@(Session.IsAdmin ? "Administrator" : "Signed in")</div>
                                </div>
                            </div>
                            <div class="nav-user-dropdown-section">
                                <span class="small text-muted"><span class="bi bi-globe me-1"></span>@L["Common.Language"]</span>
                                <LanguageSelector />
                            </div>
                            <a class="nav-user-item" role="menuitem" href="/configuration"
                               data-testid="nav-user-configuration">
                                @L["Nav.Settings"]
                            </a>
                            <a class="nav-user-item" role="menuitem" href="/account/costs"
                               data-testid="nav-user-account-costs"
                               @onclick="CloseUserMenu">
                                @L["Nav.AccountCosts"]
                            </a>
                            @if (Session.IsRealAdmin)
                            {
                                <button type="button"
                                        class="nav-user-item"
                                        role="menuitemcheckbox"
                                        aria-checked="@(Session.ViewAsUser ? "true" : "false")"
                                        data-testid="nav-view-as-user"
                                        @onclick="ToggleViewAsUser">
                                    @(Session.ViewAsUser
                                        ? L["Nav.BackToAdmin"]
                                        : L["Nav.ViewAsUser"])
                                </button>
                            }
                            @if (Session.IsAdmin)
                            {
                                <a class="nav-user-item" role="menuitem" href="/admin"
                                   @onclick="CloseUserMenu">
                                    Admin dashboard
                                </a>
                            }
                            <a class="nav-user-item" role="menuitem" href="/about"
                               @onclick="CloseUserMenu">
                                @L["Nav.About"]
                            </a>
                            <button type="button"
                                    class="nav-user-item"
                                    role="menuitem"
                                    title="@MediaFolderTitle(MediaFolder)"
                                    @onclick="ConnectMediaFolderAsync">
                                @MediaFolderLabel(MediaFolder)
                            </button>
                            <button type="button"
                                    class="nav-user-item nav-user-item--danger"
                                    role="menuitem"
                                    data-testid="nav-sign-out"
                                    @onclick="LogoutAsync">
                                @L["Nav.SignOut"]
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="nav-user-menu @(_userMenuOpen ? "is-open" : null) @(Collapsed ? "is-collapsed" : null)">
                    <button type="button"
                            class="nav-user-trigger"
                            data-testid="nav-user-menu"
                            title="Account & Language"
                            aria-expanded="@_userMenuOpen"
                            aria-haspopup="menu"
                            @onclick="ToggleUserMenu"
                            @onclick:stopPropagation="true">
                        <span class="nav-user-avatar nav-user-avatar--ghost" aria-hidden="true">?</span>
                        @if (!Collapsed)
                        {
                            <span class="nav-user-meta">
                                <span class="nav-user-name text-truncate">@L["Nav.SignIn"]</span>
                                <span class="nav-user-role">Guest</span>
                            </span>
                            <span class="nav-user-caret" aria-hidden="true">@(_userMenuOpen ? "▴" : "▾")</span>
                        }
                    </button>
                    @if (_userMenuOpen)
                    {
                        <button type="button"
                                class="nav-user-backdrop"
                                aria-label="Close account menu"
                                @onclick="CloseUserMenu"></button>
                        <div class="nav-user-dropdown" role="menu" @onclick:stopPropagation="true">
                            <div class="nav-user-dropdown-section">
                                <span class="small text-muted"><span class="bi bi-globe me-1"></span>@L["Common.Language"]</span>
                                <LanguageSelector />
                            </div>
                            <a class="nav-user-item" role="menuitem" href="/login" data-testid="nav-sign-in" @onclick="CloseUserMenu">
                                @L["Nav.SignIn"]
                            </a>
                            <a class="nav-user-item" role="menuitem" href="/about" @onclick="CloseUserMenu">
                                @L["Nav.About"]
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </nav>
</div>
