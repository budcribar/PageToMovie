@namespace PageToMovie.Web.Components
@*
  Stage‑1 visual medium preference — Auto or lock before book → Fountain.
*@
@inject EngineApiClient Engine

<div class="card mb-3 border-secondary border-opacity-25" data-testid="visual-medium-card">
    <div class="card-body p-3">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
            <div>
                <div class="fw-semibold">Look & medium</div>
                <div class="small text-body-secondary mb-1">
                    How characters and settings should look in the film
                </div>
                <div class="small text-muted">
                    Applied when the screenplay is written. You can change this before re-import.
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_label))
            {
                <span class="badge text-bg-secondary">@_label</span>
            }
        </div>

        <label class="form-label small mb-1" for="@_selectId">Visual medium</label>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <select id="@_selectId"
                    class="form-select form-select-sm"
                    style="max-width: 22rem;"
                    @bind="_edit"
                    disabled="@(_busy || Disabled)"
                    data-testid="visual-medium-select">
                @foreach (var opt in _options)
                {
                    <option value="@opt.Id">@opt.Label</option>
                }
            </select>
            <button type="button"
                    class="btn btn-sm btn-primary"
                    disabled="@(_busy || Disabled || string.IsNullOrWhiteSpace(_edit))"
                    data-testid="visual-medium-save"
                    @onclick="SaveAsync">
                @(_busy ? "Saving…" : SaveLabel)
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="small text-success mt-2" data-testid="visual-medium-message">@_message</div>
        }
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="small text-danger mt-2" data-testid="visual-medium-error">@_error</div>
        }
    </div>
</div>
