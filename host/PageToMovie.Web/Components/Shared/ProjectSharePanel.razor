@using System.Net.Http.Json
@using PageToMovie.Web.Services
@inject HttpClient Http
@inject ActiveProjectState ActiveProject
@inject EngineApiClient Engine
@inject AdminSessionService Session
@inject ILogger<ProjectSharePanel> Logger

<div class="share-panel" data-testid="project-share-panel">
    <h3 class="share-panel__title">Project sharing</h3>

    @if (string.IsNullOrWhiteSpace(ActiveProject.ProjectId))
    {
        <p class="share-panel__muted">Open a project to manage sharing, locks, and presence.</p>
    }
    else
    {
        <p class="share-panel__id"><code>@ActiveProject.ProjectId</code></p>

        @if (!string.IsNullOrEmpty(ErrorText))
        {
            <div class="share-panel__error">@ErrorText</div>
        }
        @if (!string.IsNullOrEmpty(InfoText))
        {
            <div class="share-panel__info">@InfoText</div>
        }

        <section class="share-panel__section">
            <h4>Access list</h4>
            @if (_acl is null)
            {
                <button class="btn btn-secondary" disabled="@IsBusy" @onclick="LoadAclAsync">Load ACL</button>
            }
            else
            {
                <dl class="share-panel__dl">
                    <dt>Owner</dt>
                    <dd>@_acl.OwnerUserId</dd>
                    <dt>Rev</dt>
                    <dd>@_acl.Rev</dd>
                    <dt>Editors</dt>
                    <dd>@( _acl.Editors.Count == 0 ? "—" : string.Join(", ", _acl.Editors) )</dd>
                    <dt>Viewers</dt>
                    <dd>@( _acl.Viewers.Count == 0 ? "—" : string.Join(", ", _acl.Viewers) )</dd>
                </dl>
            }
        </section>

        <section class="share-panel__section" data-testid="key-mode-section">
            <h4>API keys (I5)</h4>
            <p class="share-panel__muted small mb-2">
                <strong>shared</strong> — gen uses Owner's keys · <strong>personal</strong> — each Editor uses their own.
            </p>
            <div class="share-panel__row">
                <select class="form-input" @bind="_keyMode" disabled="@(IsBusy || !IsOwner)">
                    <option value="personal">personal</option>
                    <option value="shared">shared</option>
                </select>
                <button class="btn btn-primary" disabled="@(IsBusy || !IsOwner)" @onclick="SaveKeyModeAsync"
                        data-testid="key-mode-save">
                    Save key mode
                </button>
            </div>
            @if (!IsOwner)
            {
                <p class="share-panel__muted small">Only the Owner can change key mode.</p>
            }
        </section>

        <section class="share-panel__section">
            <h4>Invite</h4>
            <div class="share-panel__row">
                <input class="form-input" @bind="_inviteUserId" placeholder="User id" />
                <select class="form-input" @bind="_inviteRole">
                    <option value="editor">Editor</option>
                    <option value="viewer">Viewer</option>
                </select>
                <button class="btn btn-primary" disabled="@(IsBusy || string.IsNullOrWhiteSpace(_inviteUserId))" @onclick="InviteAsync">Invite</button>
            </div>
        </section>

        <section class="share-panel__section">
            <h4>Scene lock</h4>
            <div class="share-panel__row">
                <input class="form-input" type="number" min="1" @bind="_sceneNumber" />
                <button class="btn btn-secondary" disabled="@IsBusy" @onclick="AcquireLeaseAsync">Acquire</button>
                <button class="btn btn-secondary" disabled="@IsBusy" @onclick="ReleaseLeaseAsync">Release</button>
                <button class="btn btn-secondary" disabled="@IsBusy" @onclick="RefreshLeaseAsync">Status</button>
            </div>
            @if (LeaseStatus is not null)
            {
                <p class="share-panel__muted">@LeaseStatus</p>
            }
        </section>

        <section class="share-panel__section" data-testid="presence-section">
            <h4>Presence</h4>
            <button class="btn btn-secondary" disabled="@IsBusy" @onclick="LoadPresenceAsync">Refresh</button>
            @if (Presence is { Count: > 0 })
            {
                <ul>
                    @foreach (var p in Presence)
                    {
                        <li><code>@p.UserId</code> · @p.LastSeenUtc.ToString("u")</li>
                    }
                </ul>
            }
            else if (Presence is not null)
            {
                <p class="share-panel__muted">No active presence.</p>
            }
        </section>
    }
</div>
