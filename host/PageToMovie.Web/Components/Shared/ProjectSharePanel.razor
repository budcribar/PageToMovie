@using System.Net.Http.Json
@using PageToMovie.Web.Services
@inject HttpClient Http
@inject ActiveProjectState ActiveProject
@inject ILogger<ProjectSharePanel> Logger

<div class="share-panel">
    <h3 class="share-panel__title">Project sharing</h3>

    @if (string.IsNullOrWhiteSpace(ActiveProject.ProjectId))
    {
        <p class="share-panel__muted">Open a project to manage sharing, locks, and presence.</p>
    }
    else
    {
        <p class="share-panel__id"><code>@ActiveProject.ProjectId</code></p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="share-panel__error">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_info))
        {
            <div class="share-panel__info">@_info</div>
        }

        <section class="share-panel__section">
            <h4>Access list</h4>
            @if (_acl is null)
            {
                <button class="btn btn-secondary" disabled="@_busy" @onclick="LoadAclAsync">Load ACL</button>
            }
            else
            {
                <dl class="share-panel__dl">
                    <dt>Owner</dt>
                    <dd>@_acl.OwnerUserId</dd>
                    <dt>Rev</dt>
                    <dd>@_acl.Rev</dd>
                    <dt>Editors</dt>
                    <dd>@( _acl.Editors.Count == 0 ? "—" : string.Join(", ", _acl.Editors) )</dd>
                    <dt>Viewers</dt>
                    <dd>@( _acl.Viewers.Count == 0 ? "—" : string.Join(", ", _acl.Viewers) )</dd>
                </dl>
            }
        </section>

        <section class="share-panel__section">
            <h4>Invite</h4>
            <div class="share-panel__row">
                <input class="form-input" @bind="_inviteUserId" placeholder="User id" />
                <select class="form-input" @bind="_inviteRole">
                    <option value="editor">Editor</option>
                    <option value="viewer">Viewer</option>
                </select>
                <button class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_inviteUserId))" @onclick="InviteAsync">Invite</button>
            </div>
        </section>

        <section class="share-panel__section">
            <h4>Scene lock</h4>
            <div class="share-panel__row">
                <input class="form-input" type="number" min="1" @bind="_sceneNumber" />
                <button class="btn btn-secondary" disabled="@_busy" @onclick="AcquireLeaseAsync">Acquire</button>
                <button class="btn btn-secondary" disabled="@_busy" @onclick="ReleaseLeaseAsync">Release</button>
                <button class="btn btn-secondary" disabled="@_busy" @onclick="RefreshLeaseAsync">Status</button>
            </div>
            @if (_leaseStatus is not null)
            {
                <p class="share-panel__muted">@_leaseStatus</p>
            }
        </section>

        <section class="share-panel__section">
            <h4>Presence</h4>
            <button class="btn btn-secondary" disabled="@_busy" @onclick="LoadPresenceAsync">Refresh</button>
            @if (_presence is { Count: > 0 })
            {
                <ul>
                    @foreach (var p in _presence)
                    {
                        <li><code>@p.UserId</code> · @p.LastSeenUtc.ToString("u")</li>
                    }
                </ul>
            }
            else if (_presence is not null)
            {
                <p class="share-panel__muted">No active presence.</p>
            }
        </section>
    }
</div>
