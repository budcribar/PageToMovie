@* Waveforms + You / Both. Original play lives on the control row so it never disappears. *@
@using Microsoft.AspNetCore.Components

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Host._takeUrl))
    {
        <div class="d-flex flex-wrap gap-2 mb-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(Host._busy || Host._recording || Host._light > 0 || Host._listening)"
                    data-testid="voice-capture-play-you" @onclick="Host.PlayYouAsync">▶ You</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(Host._busy || Host._recording || Host._light > 0 || Host._listening || string.IsNullOrEmpty(Host._originalUrl))"
                    data-testid="voice-capture-play-both" @onclick="Host.PlayBothAsync">▶ Both</button>
        </div>
    }

    <div class="ptm-wave-row">
        <span class="ptm-wave-label">@(string.IsNullOrWhiteSpace(Host.CharacterLabel) ? "Original" : Host.CharacterLabel)</span>
        <canvas id="ptm-wave-narrator" class="ptm-wave" height="34"></canvas>
    </div>
    @if (!string.IsNullOrEmpty(Host._takeUrl))
    {
        <div class="ptm-wave-row">
            <span class="ptm-wave-label">You</span>
            <canvas id="ptm-wave-you" class="ptm-wave" height="34"></canvas>
        </div>
        @if (Host._score is int sc)
        {
            <div class="mt-1 small fw-semibold @VoiceCaptureStep.ScoreClass(sc)" data-testid="voice-capture-score">@VoiceCaptureStep.ScoreLabel(sc)</div>
        }
    }
</div>
