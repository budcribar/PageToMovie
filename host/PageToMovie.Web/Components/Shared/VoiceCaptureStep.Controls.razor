@* Shared extract of VoiceCaptureStep — original / record / keep / finish *@
@using Microsoft.AspNetCore.Components

<div class="d-flex flex-wrap gap-2">
    <button type="button" class="btn btn-outline-primary"
            disabled="@(Host._busy || Host._recording || Host._light > 0 || Host._listening)"
            data-testid="voice-capture-listen" @onclick="OnListenAsync">
        @(Host._listening ? "▶ Original…" : "▶ Original")
    </button>

    @if (Host._recording)
    {
        <button type="button" class="btn btn-outline-secondary" disabled="@Host._busy"
                data-testid="voice-capture-stop" @onclick="OnStopAsync">
            ⏹ Stop
        </button>
    }
    else if (Host._light > 0)
    {
        <button type="button" class="btn btn-outline-secondary" data-testid="voice-capture-cancel" @onclick="OnCancelAsync">Cancel</button>
    }
    else
    {
        <button type="button" class="btn btn-danger" disabled="@Host._busy"
                data-testid="voice-capture-record" @onclick="OnRecordAsync">
            🔴 @(Host._takeUrl is null ? "Record" : "Re-record")
        </button>

        @if (!string.IsNullOrEmpty(Host._takeUrl))
        {
            <button type="button" class="btn btn-primary" disabled="@Host._busy" data-testid="voice-capture-keep" @onclick="OnKeepAsync">
                Keep & @(Host._i + 1 < Host._phrases.Count ? "next →" : "finish")
            </button>
        }

        @if (Host._kept.Count > 0)
        {
            <button type="button" class="btn btn-success ms-auto" disabled="@Host._busy" data-testid="voice-capture-finish" @onclick="OnFinishAsync">
                ✓ Create my voice (@Host._kept.Count)
            </button>
        }
    }
</div>
