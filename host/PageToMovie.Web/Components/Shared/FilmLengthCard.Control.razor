@namespace PageToMovie.Web.Components
@inject IAppLocalizer L

<div class="fw-semibold mb-2">@L["FilmLength.Title"]</div>
<label class="form-label small mb-1" for="@Host._inputId">@L["FilmLength.TargetLength"]</label>
<div class="d-flex flex-wrap gap-2 align-items-center">
    <input id="@Host._inputId"
           type="number"
           class="form-control form-control-sm"
           style="max-width: 7rem;"
           min="1"
           max="180"
           @bind="Host._edit"
           @bind:event="oninput"
           @bind:after="Host.ScheduleAutosave"
           disabled="@Host.Disabled"
           data-testid="film-length-input" />
    <button type="button"
            class="btn btn-sm btn-outline-secondary"
            disabled="@(Host._saving || Host.Disabled)"
            data-testid="film-length-estimate"
            @onclick="Host.UseEstimateAsync">
        @L.Format("FilmLength.UseEstimate", Host._natural)
    </button>
    @if (Host._busy)
    {
        <span class="small text-muted" data-testid="film-length-saving">Saving…</span>
    }
</div>
@if (!string.IsNullOrWhiteSpace(Host._error))
{
    <div class="small text-danger mt-2" data-testid="film-length-error">@Host._error</div>
}
