<style>.ptm-process-strip-loading { cursor: wait; opacity: 0.9; }</style>
@namespace PageToMovie.Web.Components
@* Shared product path: Setup (0, temporary) → Book → Cast & voice → Estimate → Film → Review
   SimpleMode: Book → Your voice → Film (bait path for library + narrator clone) *@
@inject ActiveProjectState ActiveProject
@inject NavigationManager Nav
@inject IAppLocalizer L

<nav class="ptm-step-strip ptm-step-strip--studio mb-3" aria-label="Studio process steps">
    @if (NeedsSetup)
    {
        <a class="ptm-step @(Active == "setup" ? "is-active" : "")"
           href="configuration"
           title="Connect your AI API keys (bring your own key) before importing a book"
           data-testid="studio-step-setup">
            <span class="ptm-step__num">0</span>
            <span class="ptm-step__body">
                <span class="ptm-step__label">@L["ProcessStrip.Setup"]</span>
                <span class="ptm-step__hint">@L["ProcessStrip.ApiKeys"]</span>
            </span>
        </a>
    }

    @if (UseSimple)
    {
        <a class="ptm-step @(Active == "book" ? "is-active" : "") @(BookLocked ? "is-disabled" : "")"
           href="@(BookLocked ? "javascript:void(0)" : "simple-voice")"
           title="@(BookLocked ? "Connect API keys in Setup first" : "Pick a library story")"
           data-testid="studio-step-book"
           @onclick:preventDefault="@BookLocked">
            <span class="ptm-step__num">1</span>
            <span class="ptm-step__body">
                <span class="ptm-step__label">@L["ProcessStrip.Story"]</span>
                <span class="ptm-step__hint">@L["ProcessStrip.LibraryBook"]</span>
            </span>
        </a>
        <a class="ptm-step @(Active == "cast" ? "is-active" : "")"
           href="simple-voice"
           title="Record your narrator voice — no cast list"
           data-testid="studio-step-cast">
            <span class="ptm-step__num">2</span>
            <span class="ptm-step__body">
                <span class="ptm-step__label">@L["ProcessStrip.YourVoice"]</span>
                <span class="ptm-step__hint">@L["ProcessStrip.RecordDone"]</span>
            </span>
        </a>
        <a class="ptm-step @(Active == "film" ? "is-active" : "") @(!ActiveProject.CanScenes && Active != "film" ? "is-disabled" : "")"
           href="@(ActiveProject.CanScenes || Active == "film" ? "scenes?simple=1" : "javascript:void(0)")"
           title="@(ActiveProject.CanScenes ? "Generate the movie" : ActiveProject.ScenesBlockedReason)"
           data-testid="studio-step-film"
           @onclick:preventDefault="@(!ActiveProject.CanScenes && Active != "film")">
            <span class="ptm-step__num">3</span>
            <span class="ptm-step__body">
                <span class="ptm-step__label">@L["ProcessStrip.Movie"]</span>
                <span class="ptm-step__hint">@L["ProcessStrip.GenerateAll"]</span>
            </span>
        </a>
    }
    else
    {
        <a class="ptm-step @(Active == "book" ? "is-active" : "") @(BookLocked ? "is-disabled" : "")"
           href="@(BookLocked ? "javascript:void(0)" : "adaptation")"
           title="@(BookLocked ? "Connect API keys in Setup first" : "Import book and write screenplay")"
           data-testid="studio-step-book"
           @onclick:preventDefault="@BookLocked">
            <span class="ptm-step__num">1</span>
            <span class="ptm-step__body">
                <span class="ptm-step__label">@L["ProcessStrip.Book"]</span>
                <span class="ptm-step__hint">@L["ProcessStrip.ImportScreenplay"]</span>
            </span>
            @* Advanced/BYOK only: AI model selection status. Click → Settings. Removed at release. *@
            @if (ActiveProject.HasProject)
            {
                <span class="ptm-step__badge ms-auto align-self-center"
                      role="button"
                      tabindex="0"
                      data-testid="studio-step-book-model"
                      title="@(ModelReady ? "AI model selected — click to change in Settings" : "No AI model selected — click to choose one in Settings")"
                      @onclick="GoToModelSettings"
                      @onclick:preventDefault="true"
                      @onclick:stopPropagation="true">
                    @if (ModelReady)
                    {
                        <span class="badge rounded-pill text-bg-success" aria-label="AI model selected">✓</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill text-bg-warning text-dark" aria-label="No AI model selected">⚠</span>
                    }
                </span>
            }
        </a>
        <a class="ptm-step @(Active == "cast" ? "is-active" : "") @(!ActiveProject.CanCharacters && Active != "cast" ? "is-disabled" : "")"
           href="@(ActiveProject.CanCharacters || Active == "cast" ? "characters" : "javascript:void(0)")"
           title="@(ActiveProject.CanCharacters ? "Cast looks and optional voice clone" : ActiveProject.CharactersBlockedReason)"
           data-testid="studio-step-cast"
           @onclick:preventDefault="@(!ActiveProject.CanCharacters && Active != "cast")">
            <span class="ptm-step__num">2</span>
            <span class="ptm-step__body">
                <span class="ptm-step__label">@L["ProcessStrip.CastAndVoice"]</span>
                <span class="ptm-step__hint">@L["ProcessStrip.PhotosCloneSample"]</span>
            </span>
        </a>
        <a class="ptm-step @(Active == "estimate" ? "is-active" : "") @(!ActiveProject.CanEstimate && Active != "estimate" ? "is-disabled" : "")"
           href="@(ActiveProject.CanEstimate || Active == "estimate" ? "cost" : "javascript:void(0)")"
           title="@(ActiveProject.CanEstimate ? "Quote before generate" : ActiveProject.EstimateBlockedReason)"
           data-testid="studio-step-estimate"
           @onclick:preventDefault="@(!ActiveProject.CanEstimate && Active != "estimate")">
            <span class="ptm-step__num">3</span>
            <span class="ptm-step__body">
                <span class="ptm-step__label">@L["ProcessStrip.Estimate"]</span>
                <span class="ptm-step__hint">@L["ProcessStrip.QuoteConfirm"]</span>
            </span>
        </a>
        <a class="ptm-step @(Active == "film" ? "is-active" : "") @(!ActiveProject.CanScenes && Active != "film" ? "is-disabled" : "")"
           href="@(ActiveProject.CanScenes || Active == "film" ? "scenes" : "javascript:void(0)")"
           title="@(ActiveProject.CanScenes ? "Generate clips" : ActiveProject.ScenesBlockedReason)"
           data-testid="studio-step-film"
           @onclick:preventDefault="@(!ActiveProject.CanScenes && Active != "film")">
            <span class="ptm-step__num">4</span>
            <span class="ptm-step__body">
                <span class="ptm-step__label">@L["ProcessStrip.Film"]</span>
                <span class="ptm-step__hint">@L["ProcessStrip.ClipsStitch"]</span>
            </span>
        </a>
        <a class="ptm-step @(Active == "review" ? "is-active" : "") @(!ActiveProject.CanReview && Active != "review" ? "is-disabled" : "")"
           href="@(ActiveProject.CanReview || Active == "review" ? "review" : "javascript:void(0)")"
           title="@(ActiveProject.CanReview ? "Approve and publish" : ActiveProject.ReviewBlockedReason)"
           data-testid="studio-step-review"
           @onclick:preventDefault="@(!ActiveProject.CanReview && Active != "review")">
            <span class="ptm-step__num">5</span>
            <span class="ptm-step__body">
                <span class="ptm-step__label">@L["ProcessStrip.Review"]</span>
                <span class="ptm-step__hint">@L["ProcessStrip.EditAfterward"]</span>
            </span>
        </a>
    }
</nav>
