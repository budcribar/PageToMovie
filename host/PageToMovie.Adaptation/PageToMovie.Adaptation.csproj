<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PageToMovie.Adaptation</RootNamespace>
    <Description>Pure Stage-1 book→Fountain adaptation library. No storage, no HTTP, no ProjectStore.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PageToMovie.Core\PageToMovie.Core.csproj" />
    <ProjectReference Include="..\PageToMovie.Fountain\PageToMovie.Fountain.csproj" />
  </ItemGroup>

  <!-- Stage-1 prompt embeds so Adaptation is self-contained (Railway-safe). -->
  <ItemGroup Condition="Exists('..\..\prompts')">
    <EmbeddedResource Include="..\..\prompts\book_to_fountain.txt"
                      LogicalName="PageToMovie.Adaptation.Prompts.book_to_fountain.txt" />
    <EmbeddedResource Include="..\..\prompts\fountain_reskin.txt"
                      LogicalName="PageToMovie.Adaptation.Prompts.fountain_reskin.txt" />
    <EmbeddedResource Include="..\..\prompts\embellish_scene.txt"
                      LogicalName="PageToMovie.Adaptation.Prompts.embellish_scene.txt" />
    <EmbeddedResource Include="..\..\prompts\trim_scene.txt"
                      LogicalName="PageToMovie.Adaptation.Prompts.trim_scene.txt" />
    <EmbeddedResource Include="..\..\prompts\book_to_index.txt"
                      LogicalName="PageToMovie.Adaptation.Prompts.book_to_index.txt" />
  </ItemGroup>

</Project>
