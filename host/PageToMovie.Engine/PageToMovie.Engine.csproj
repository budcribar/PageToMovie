<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PageToMovie.Core\PageToMovie.Core.csproj" />
    <ProjectReference Include="..\PageToMovie.Adaptation\PageToMovie.Adaptation.csproj" />
    <ProjectReference Include="..\PageToMovie.Fountain\PageToMovie.Fountain.csproj" />
    <ProjectReference Include="..\PageToMovie.Screenplay\PageToMovie.Screenplay.csproj" />
  </ItemGroup>

  <!-- Embed core prompts so Railway /data (projects only) never needs prompts/ on disk. -->
  <ItemGroup Condition="Exists('..\..\prompts')">
    <EmbeddedResource Include="..\..\prompts\fountain_to_cast.txt" LogicalName="PageToMovie.Prompts.fountain_to_cast.txt" />
    <EmbeddedResource Include="..\..\prompts\cast_visual_literalize.txt" LogicalName="PageToMovie.Prompts.cast_visual_literalize.txt" />
    <EmbeddedResource Include="..\..\prompts\book_to_fountain.txt" LogicalName="PageToMovie.Prompts.book_to_fountain.txt" />
    <EmbeddedResource Include="..\..\prompts\clip_gen_rules.txt" LogicalName="PageToMovie.Prompts.clip_gen_rules.txt" />
    <EmbeddedResource Include="..\..\prompts\clip_auto_review.txt" LogicalName="PageToMovie.Prompts.clip_auto_review.txt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Deterministic\Pronunciation\Resources\heteronyms.en-US.json"
                      LogicalName="PageToMovie.Pronunciation.heteronyms.en-US.json"
                      WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.75.0.4207" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.10" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
  </ItemGroup>

</Project>
